#===============================================================================
# 18c. Timing of anti-rejection treatment AFTER the landmark
#-------------------------------------------------------------------------------
# Generalized to an arbitrary post-landmark window, because at a 90-day
# landmark there are now three different windows worth looking at and they
# answer different questions:
#
#   GAP     day 90-365  : treatment that is neither exposure nor outcome. This
#                         is the picture of the contamination reported in
#                         section 7 -- how much, and when.
#   YEAR 1 POST-LM day 90-455 : the year immediately following exposure.
#   OUTCOME day 90-730 : the window the outcome odds ratios are actually about.
#
# READ BEFORE INTERPRETING:
#  1. ARMS ARE FIXED AT THE LANDMARK and are NOT reassigned by post-landmark
#     treatment. For Control, a bar is a FIRST-EVER treatment; for the treated
#     arms it is RE-treatment. Do not read a between-arm height difference as
#     the same event happening more often.
#  2. UNOS follow-up is dense early and annual later, so the raw histogram
#     partly reproduces the VISIT SCHEDULE. The visit-normalised rate figure
#     is the one to interpret.
#  3. No imputed day-0 spike here -- every event carries a real follow-up date.
#===============================================================================

MIN_VISITS_PER_BIN <- 20   # bins thinner than this give unstable rates

postlm_timing_report <- function(start_day, end_day, window_label, slug,
                                 binwidth = 30, break_by = 60) {
  
  span <- end_day - start_day
  if (span <= 0) {
    message("skipping timing report -- empty window: ", window_label)
    return(invisible(NULL))
  }
  
  # Eligibility: still under observation at the START of the window. Without
  # this, an arm with more early deaths looks less treated purely because its
  # members were gone.
  eligible_ids <- df_liver_data_filtered %>%
    filter(!is.na(PTIME), PTIME >= start_day) %>%
    pull(TRR_ID_CODE) %>% unique()
  
  arm_w <- timing_arm_lookup %>% filter(TRR_ID_CODE %in% eligible_ids)
  
  # Built from df_immuno_fol_read, not df_immuno_fol -- the latter was filtered
  # to < 1 year in section 4.
  #
  # The defensive select(-any_of(...)) before the join guards the
  # TX_DATE.x/TX_DATE.y collision if a future extract of
  # liver_immuno_followup.csv ever carries its own TX_DATE.
  visits <- df_immuno_fol_read %>%
    filter(TRR_ID_CODE %in% arm_w$TRR_ID_CODE) %>%
    select(-any_of(c("TX_DATE", "DISCHARGE_DATE"))) %>%
    left_join(df_liver_data_filtered %>% select(TRR_ID_CODE, TX_DATE), by = "TRR_ID_CODE") %>%
    filter(!is.na(TX_DATE)) %>%
    mutate(
      PX_STAT_DATE_FOL = as.Date(PX_STAT_DATE_FOL),
      TX_DATE          = as.Date(TX_DATE),
      FOL_DATE_DAYS_DELTA = time_length(interval(TX_DATE, PX_STAT_DATE_FOL), "days")
    ) %>%
    filter(FOL_DATE_DAYS_DELTA >= start_day, FOL_DATE_DAYS_DELTA <= end_day) %>%
    mutate(
      TREATED_VISIT = if_any(all_of(COLS_TO_CHECK), ~ !is.na(.x) & .x == 1),
      DAY_IN_WINDOW = FOL_DATE_DAYS_DELTA - start_day
    ) %>%
    # intentionally many-to-many when RITUXAN_AS_OWN_ARM is FALSE (see 18b)
    inner_join(arm_w %>% select(TRR_ID_CODE, TIMING_ARM),
               by = "TRR_ID_CODE") %>%
    mutate(TIMING_ARM = factor(as.character(TIMING_ARM), levels = TIMING_LEVELS))
  
  # First treated visit per patient in the window: the histogram is "patients
  # newly treated by day X", not "treatment episodes".
  first_tx <- visits %>%
    filter(TREATED_VISIT) %>%
    group_by(TIMING_ARM, TRR_ID_CODE) %>%
    slice_min(order_by = DAY_IN_WINDOW, n = 1, with_ties = FALSE) %>%
    ungroup()
  
  # Denominators and the ascertainment check. '% seen' is the number to look
  # at first: an arm followed up less often will appear less treated
  # regardless of its true rejection rate.
  denom <- arm_w %>%
    count(TIMING_ARM, .drop = FALSE, name = "n_arm") %>%
    left_join(
      visits %>% group_by(TIMING_ARM, .drop = FALSE) %>%
        summarise(n_seen = n_distinct(TRR_ID_CODE), n_visits = n(), .groups = "drop"),
      by = "TIMING_ARM"
    ) %>%
    left_join(first_tx %>% count(TIMING_ARM, .drop = FALSE, name = "n_treated"),
              by = "TIMING_ARM") %>%
    mutate(across(c(n_seen, n_visits, n_treated), ~ coalesce(.x, 0L)),
           pct_seen    = 100 * n_seen / pmax(n_arm, 1),
           pct_treated = 100 * n_treated / pmax(n_arm, 1))
  
  message("\n[", window_label, "] days ", round(start_day), "-", round(end_day))
  print(denom %>% select(TIMING_ARM, n_arm, n_seen, pct_seen, n_treated, pct_treated))
  
  if (nrow(first_tx) == 0) {
    message("  no treated visits in this window -- plots skipped")
    return(invisible(denom))
  }
  
  # --- Plot A: raw histogram (shows the visit-schedule artifact) ---
  keep(
    ggplot(first_tx, aes(x = DAY_IN_WINDOW)) +
      geom_histogram(binwidth = binwidth, boundary = 0,
                     fill = "steelblue", colour = "white", linewidth = 0.2) +
      geom_text(data = denom,
                aes(x = Inf, y = Inf,
                    label = sprintf("n = %d in arm\n%d treated (%.1f%%)",
                                    n_arm, n_treated, pct_treated)),
                inherit.aes = FALSE, hjust = 1.05, vjust = 1.3, size = 3) +
      facet_wrap(~ TIMING_ARM, ncol = 2, drop = FALSE, scales = "free_y") +
      scale_x_continuous(breaks = seq(0, span, by = break_by), limits = c(0, span),
                         expand = expansion(mult = c(0, 0.02))) +
      scale_y_continuous(expand = expansion(mult = c(0, 0.15))) +
      labs(
        title = paste0("Anti-Rejection Therapy Timing: ", window_label),
        subtitle = paste0("Post-transplant days ", round(start_day), "-", round(end_day),
                          "; arms fixed at ", LM_LABEL, "; ", binwidth, "-day bins"),
        x = paste0("Days since day ", round(start_day), " post-transplant"),
        y = "Patients newly treated",
        caption = "Y axes independent per panel. Shape is driven partly by the visit schedule -- see the rate figure."
      ) +
      theme_minimal() + theme(strip.text = element_text(face = "bold")),
    paste0(slug, "_hist")
  )
  
  # --- Plot B: treatment RATE per visit, schedule divided out ---
  # treated visits / all visits within each bin. A bin with 400 visits and 4
  # treatments is a 1% rate whether or not it happens to be the month everyone
  # is seen.
  rate <- visits %>%
    mutate(bin = floor(DAY_IN_WINDOW / binwidth) * binwidth) %>%
    group_by(TIMING_ARM, bin, .drop = FALSE) %>%
    summarise(n_visits = n(),
              n_treated_visits = sum(TREATED_VISIT, na.rm = TRUE),
              .groups = "drop") %>%
    filter(n_visits >= MIN_VISITS_PER_BIN) %>%
    mutate(rate = n_treated_visits / n_visits)
  
  if (nrow(rate) > 0) {
    keep(
      ggplot(rate, aes(x = bin + binwidth / 2, y = rate, colour = TIMING_ARM)) +
        geom_line(linewidth = 0.8) +
        geom_point(aes(size = n_visits), alpha = 0.7) +
        scale_x_continuous(breaks = seq(0, span, by = break_by), limits = c(0, span)) +
        scale_y_continuous(labels = scales::percent_format(accuracy = 0.1)) +
        scale_colour_brewer(palette = "Dark2", drop = TRUE) +
        scale_size_continuous(range = c(1, 4)) +
        labs(
          title = paste0("Proportion of Visits at Which Therapy Was Given: ", window_label),
          subtitle = paste0(binwidth, "-day bins; bins with < ", MIN_VISITS_PER_BIN, " visits omitted"),
          x = paste0("Days since day ", round(start_day), " post-transplant"),
          y = "Treated visits / all visits", colour = "Arm at landmark", size = "Visits in bin"
        ) +
        theme_minimal() + theme(legend.position = "bottom")    
      , paste0(slug, "_rate_per_visit")
    )
  }
  
  # --- Plot C: naive cumulative incidence over the FULL arm ---
  # Denominator is every eligible patient in the arm, NOT just those treated,
  # so curves plateau at each arm's overall treatment rate and are directly
  # comparable. (stat_ecdf would rescale each arm to 100% and hide exactly the
  # difference of interest.)
  #
  # NAIVE: patients who die or lose the graft mid-window stay in the
  # denominator forever, so this UNDERSTATES cumulative incidence, and does so
  # most in the arm with the most deaths. Aalen-Johansen is the rigorous
  # version if this figure goes in a manuscript.
  cum <- first_tx %>%
    arrange(TIMING_ARM, DAY_IN_WINDOW) %>%
    group_by(TIMING_ARM) %>%
    mutate(cum_n = row_number()) %>%
    ungroup() %>%
    left_join(denom %>% select(TIMING_ARM, n_arm), by = "TIMING_ARM") %>%
    mutate(cum_pct = cum_n / pmax(n_arm, 1)) %>%
    select(TIMING_ARM, DAY_IN_WINDOW, cum_pct)
  
  # Anchor each curve at (0, 0) and carry it to the horizon so the steps render
  # across the full window instead of stopping at the last event.
  cum <- bind_rows(
    denom %>% transmute(TIMING_ARM, DAY_IN_WINDOW = 0, cum_pct = 0),
    cum,
    cum %>% group_by(TIMING_ARM) %>%
      slice_max(DAY_IN_WINDOW, n = 1, with_ties = FALSE) %>%
      mutate(DAY_IN_WINDOW = span) %>% ungroup()
  ) %>%
    arrange(TIMING_ARM, DAY_IN_WINDOW)
  
  keep(
    ggplot(cum, aes(x = DAY_IN_WINDOW, y = cum_pct, colour = TIMING_ARM)) +
      geom_step(linewidth = 0.8) +
      scale_x_continuous(breaks = seq(0, span, by = break_by), limits = c(0, span)) +
      scale_y_continuous(labels = scales::percent_format(accuracy = 0.1)) +
      scale_colour_brewer(palette = "Dark2", drop = TRUE) +
      labs(
        title = paste0("Cumulative Proportion of Each Arm Treated: ", window_label),
        subtitle = "Denominator is the full eligible arm; no competing-risk adjustment",
        x = paste0("Days since day ", round(start_day), " post-transplant"),
        y = "Cumulative % of arm treated", colour = "Arm at landmark"
      ) +
      theme_minimal() + theme(legend.position = "bottom"),
    paste0(slug, "_cuminc")
  )
  
  # --- Summary table ---
  summ <- denom %>%
    left_join(
      first_tx %>% group_by(TIMING_ARM, .drop = FALSE) %>%
        summarise(median_day = median(DAY_IN_WINDOW, na.rm = TRUE),
                  q1_day = quantile(DAY_IN_WINDOW, 0.25, na.rm = TRUE),
                  q3_day = quantile(DAY_IN_WINDOW, 0.75, na.rm = TRUE),
                  .groups = "drop"),
      by = "TIMING_ARM"
    ) %>%
    mutate(
      visits_per_pt_seen = if_else(n_seen > 0, n_visits / n_seen, NA_real_),
      across(where(is.numeric), ~ if_else(is.nan(.x), NA_real_, .x))
    )
  
  keep(
    summ %>%
      mutate(`Median (IQR) day` = if_else(
        is.na(median_day), NA_character_,
        sprintf("%.0f (%.0f\u2013%.0f)", median_day, q1_day, q3_day))) %>%
      select(TIMING_ARM, n_arm, n_seen, pct_seen, visits_per_pt_seen,
             n_treated, pct_treated, `Median (IQR) day`) %>%
      gt() %>%
      fmt_number(columns = c(pct_seen, pct_treated, visits_per_pt_seen), decimals = 1) %>%
      sub_missing(missing_text = "\u2014") %>%
      cols_label(
        TIMING_ARM         = "Arm at landmark",
        n_arm              = "N eligible",
        n_seen             = "N with any visit",
        pct_seen           = "% seen",
        visits_per_pt_seen = "Visits per patient seen",
        n_treated          = "N treated",
        pct_treated        = "% treated",
        `Median (IQR) day` = "Median (IQR) day in window"
      ) %>%
      tab_header(
        title = paste0("Anti-Rejection Therapy: ", window_label),
        subtitle = paste0("Post-transplant days ", round(start_day), "-", round(end_day))
      ) %>%
      tab_options(table.font.size = 13, data_row.padding = px(4),
                  column_labels.font.weight = "bold") %>%
      tab_source_note(paste0(
        "Arms are fixed at ", LM_LABEL, " and are NOT reassigned by treatment in this window; for Control ",
        "a treatment here is a first-ever course, for the treated arms it is re-treatment. Restricted to ",
        "patients still under observation at day ", round(start_day), ". '% seen' is the ascertainment ",
        "check: a patient with no visit is counted as untreated rather than unknown, so an arm followed up ",
        "less often will appear less treated regardless of its true rejection rate. Median and IQR are ",
        "computed among treated patients only. Cumulative incidence is naive with respect to death and ",
        "graft failure during the window.")),
    paste0(slug, "_summary")
  )
  
  invisible(summ)
}

