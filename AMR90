# 14. Propensity Score Matching: Combined vs Steroid, Combined vs Control
#-------------------------------------------------------------------------------
# These matched sets feed the DESCRIPTIVE tables 2 and 3 only. The survival
# analysis rematches within the landmark-eligible cohort (section 20) and the
# year-2 analysis rematches within its own eligible cohort (section 26),
# because applying a downstream eligibility restriction to an already-matched
# set breaks pairs non-randomly.
#
# With DEMO_TABLES_USE_LANDMARK_ARMS = TRUE the arms here are the day-90 arms,
# so these are day-90 matched cohorts on the full cohort denominator.
#===============================================================================
prep_match_df <- function(df) {
  df %>%
    mutate(
      DIAB_BIN = diab_bin(DIAB),
      GENDER = factor(GENDER),
      ETHCAT = factor(ETHCAT),
      DON_TY = factor(DON_TY)
    )
}

match_covariates <- c("AGE", "GENDER", "ETHCAT", "MELD_PELD_LAB_SCORE",
                      "DIAB_BIN", "COLD_ISCH")

# MM_TOTAL (HLA mismatch) is deliberately NOT matched on. It is missing for
# roughly 60% of the cohort -- MM_TOTAL is NA whenever ANY of the six alleles
# is untyped, which in UNOS is the norm. Because matching is complete-case,
# including it discarded the majority of both arms and, worse, discarded them
# non-randomly: centres that type HLA completely differ systematically from
# those that don't.
#
# It is still carried alongside the matching frame so balance can be REPORTED
# on it (addl = in love.plot) without it influencing who gets matched.
balance_only_covariates <- c("MM_TOTAL")

match_formula <- as.formula(paste("treat ~", paste(match_covariates, collapse = " + ")))

report_complete_case_loss <- function(df, label) {
  n_before <- nrow(df)
  n_after  <- nrow(tidyr::drop_na(df, all_of(match_covariates)))
  message("\n[", label, "] complete-case attrition on matching covariates:")
  message("  rows before drop_na: ", n_before,
          " | after: ", n_after,
          " | lost: ", n_before - n_after,
          " (", sprintf("%.1f", 100 * (n_before - n_after) / max(n_before, 1)), "%)")
  
  per_arm <- df %>%
    group_by(treat) %>%
    summarise(before = n(),
              after = sum(complete.cases(across(all_of(match_covariates)))),
              .groups = "drop")
  print(per_arm)
  
  miss_by_var <- sapply(match_covariates, function(v) sum(is.na(df[[v]])))
  message("  missing count by covariate:")
  print(miss_by_var[order(-miss_by_var)])
  invisible(NULL)
}

# Generic 1:1 nearest-neighbour match with caliper, so the three places this
# script matches all use identical settings.
#
# Caliper: without one, 1:1 nearest-neighbour forces a match for every treated
# unit no matter how far the nearest control is, which with small treated arms
# produces pairs that aren't comparable at all. 0.2 SD of the propensity logit
# is the conventional cutoff (Austin 2011); std.caliper = TRUE makes it
# SD-scaled rather than absolute.
run_match <- function(raw_df, label, seed = 1234) {
  report_complete_case_loss(raw_df, label)
  
  # drop_na() with no arguments drops a row with NA in ANY column -- which
  # would re-delete every HLA-untyped patient the moment MM_TOTAL is carried
  # in the frame, silently undoing the point of excluding it from the match.
  # Scope it explicitly to the matching covariates.
  md <- raw_df %>%
    drop_na(all_of(match_covariates)) %>%
    mutate(across(where(is.factor), droplevels))
  
  if (length(unique(md$treat)) < 2 || min(table(md$treat)) < 5) {
    message("skipping match -- too few complete cases in one arm: ", label)
    return(NULL)
  }
  
  set.seed(seed)
  m <- matchit(match_formula, data = md, method = "nearest", distance = "logit",
               ratio = 1, caliper = 0.2, std.caliper = TRUE)
  
  message("[", label, "] treated units unmatched by caliper: ",
          sum(m$treat == 1 & is.na(m$subclass)))
  
  list(matchit = m, match_frame = md, matched_ids = match.data(m)$TRR_ID_CODE)
}

