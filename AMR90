#===============================================================================
# 20b. Hazard Ratios: Landmark Cox Models (sensitivity)
#-------------------------------------------------------------------------------
# The reference arm is an explicit ARGUMENT rather than an emergent property of
# factor level ordering, and the realised direction is echoed back in the
# output -- reading conf.int[1, ] and assuming it matches the requested label
# is how "CDA vs Control" could otherwise end up reporting Control vs
# CDA.
#===============================================================================
run_coxph_lm <- function(data, ref_arm, label) {
  # Skip rather than error if an arm is absent: with a mis-set LANDMARK_DAY the
  # requested reference level may not exist, and relevel()'s message does not
  # say which model or why.
  lv <- levels(droplevels(factor(data$ARM)))
  if (!(ref_arm %in% lv) || length(lv) < 2) {
    message("skipping Cox model -- arm missing from the data: ", label,
            "  (levels present: ", paste(lv, collapse = ", "), ")")
    return(NULL)
  }
  d <- data %>% mutate(ARM = relevel(droplevels(ARM), ref = ref_arm))

  # FIX 5: always called on propensity-matched pairs (see the three callers
  # below); cluster(subclass) accounts for the pairing instead of treating
  # matched patients as an independent sample.
  rhs <- if ("subclass" %in% names(d)) "ARM + cluster(subclass)" else "ARM"
  describe_match_weights(d, label)
  fit <- coxph(as.formula(paste0("Surv(time_lm, event_lm) ~ ", rhs)), data = d,
               weights = match_weights(d))
  s   <- summary(fit)

  zph  <- tryCatch(cox.zph(fit), error = function(e) NULL)
  ph_p <- zph_p_for_term(zph, "ARM", 1L)

  tibble(
    Comparison = label,
    Direction  = paste0(rownames(s$conf.int)[1], "  (ref = ", ref_arm, ")"),
    n          = fit$n,
    events     = fit$nevent,
    HR         = s$conf.int[1, "exp(coef)"],
    CI_lower   = s$conf.int[1, "lower .95"],
    CI_upper   = s$conf.int[1, "upper .95"],
    p_value    = s$coefficients[1, "Pr(>|z|)"],
    ph_test_p  = ph_p
  )
}

