# --- Cox models on the discharge clock ---
run_coxph_dc <- function(data, ref_arm, label, adjusted = FALSE) {
  lv <- levels(droplevels(factor(data$ARM)))
  if (!(ref_arm %in% lv) || length(lv) < 2) {
    message("skipping Cox model -- arm missing from the data: ", label,
            "  (levels present: ", paste(lv, collapse = ", "), ")")
    return(NULL)
  }
  d <- data %>% mutate(ARM = relevel(droplevels(ARM), ref = ref_arm))
  # Drop any column baseline_covs is about to supply BEFORE joining. Without
  # this, a frame descending from df_survival (which carries TX_YEAR and CENTRE)
  # gets TX_YEAR.x / TX_YEAR.y and the adjusted formula can no longer find
  # TX_YEAR -- the identical trap already fixed in match_within_dc() and
  # match_within_landmark(). Dormant while this is only called on matched
  # frames, which already carry DIAB_BIN, but it is one refactor away from live.
  if (!"DIAB_BIN" %in% names(d)) {
    d <- d %>%
      select(-any_of(setdiff(names(baseline_covs), "TRR_ID_CODE"))) %>%
      left_join(baseline_covs, by = "TRR_ID_CODE")
  }

  rhs <- if (adjusted) paste0("ARM", adj_formula_suffix) else "ARM"
  # Always called on a propensity-matched set, never on the raw cohort.
  # cluster(subclass) tells coxph the matched set is not independent, and
  # weights carries the unequal control weights a 1:k match produces. Both are
  # required at MATCH_RATIO > 1; at 1:1 the weights are all 1 and only the
  # clustering does any work.
  if ("subclass" %in% names(d)) rhs <- paste0(rhs, " + cluster(subclass)")
  describe_match_weights(d, label)
  fit <- coxph(as.formula(paste0("Surv(time_dc, event_dc) ~ ", rhs)), data = d,
               weights = match_weights(d))
  s   <- summary(fit)

  zph  <- tryCatch(cox.zph(fit), error = function(e) NULL)
  ph_p <- zph_p_for_term(zph, "ARM", 1L)

  # EVENTS PER PARAMETER. This became a live concern when induction and donor
  # quality entered adj_formula_suffix: the adjusted model now carries roughly
  # 16 parameters, while a matched treated arm can contribute only a few dozen
  # deaths. Below ~10 events per parameter, Cox coefficients are biased away
  # from the null and their CIs are unreliable -- so the number is COMPUTED AND
  # REPORTED rather than left for a reader to work out from the N column.
  #
  # The matched set is already balanced on these covariates, so the adjusted
  # model buys little here; where EPV is low, the MATCHED UNADJUSTED row is the
  # one to report and the adjusted row is a robustness check at best.
  n_par <- length(stats::coef(fit))
  epv   <- if (n_par > 0) fit$nevent / n_par else NA_real_
  if (!is.na(epv) && epv < 10) {
    message(sprintf("  [%s] LOW EVENTS PER PARAMETER: %d events / %d parameters = %.1f",
                    label, fit$nevent, n_par, epv),
            " -- treat this estimate as unstable; prefer the matched unadjusted row.")
  }

  tibble(
    Comparison = label,
    Direction  = paste0(rownames(s$conf.int)[1], "  (ref = ", ref_arm, ")"),
    n          = fit$n,
    events     = fit$nevent,
    n_par      = n_par,
    epv        = epv,
    HR         = s$conf.int[1, "exp(coef)"],
    CI_lower   = s$conf.int[1, "lower .95"],
    CI_upper   = s$conf.int[1, "upper .95"],
    p_value    = s$coefficients[1, "Pr(>|z|)"],
    ph_test_p  = ph_p
  )
}

