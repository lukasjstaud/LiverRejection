# 12. Shared statistical helpers
#===============================================================================
# Chi-square vs. Fisher, decided on EXPECTED cell counts (not observed) -- the
# standard rule of thumb, and more reliable than thresholding on the raw
# observed counts (which over-triggers Fisher on large but lopsided tables and
# under-triggers it on small balanced ones).
safe_chisq_or_fisher <- function(tab) {
  if (any(dim(tab) < 2) || sum(tab) == 0) return(NULL)
  expected <- outer(rowSums(tab), colSums(tab)) / sum(tab)
  if (any(expected < 5)) {
    fisher.test(tab, simulate.p.value = (ncol(tab) > 2 || nrow(tab) > 2))
  } else {
    chisq.test(tab)
  }
}

# Mutually-exclusive organ-transplanted grouping, shared by every table and
# model that reports organ type.
#
# IMPORTANT: there is deliberately no "all four fields missing -> NA" gate.
# TXKID/TXHRT/TXLNG/TXPAN record ADDITIONAL organs transplanted alongside the
# liver; a liver-only recipient has all four blank, and read.csv() turns those
# blanks into real NA. Gating on "at least one field non-NA" would discard
# every liver-only patient and leave a denominator made up almost entirely of
# multi-organ recipients -- which is what once produced an "87% kidney" row in
# a liver transplant cohort.
organ_group <- function(df) {
  case_when(
    df$TXKID %in% c("L", "R", "E") ~ "Kidney",
    df$TXHRT == "Y"                ~ "Heart",
    df$TXLNG %in% c("L", "R", "E") ~ "Lung",
    df$TXPAN %in% c("L", "R", "E") ~ "Pancreas",
    TRUE                           ~ "Liver only"
  )
}

race_group <- function(df) {
  case_when(
    df$ETHCAT == "1"   ~ "White",
    df$ETHCAT == "2"   ~ "Black",
    df$ETHCAT == "4"   ~ "Hispanic",
    df$ETHCAT == "5"   ~ "Asian",
    !is.na(df$ETHCAT)  ~ "Other",
    TRUE               ~ NA_character_
  )
}

# Binary diabetes recode, used identically by the matching, the tables, and
# every adjusted model. Defined once so they cannot disagree.
diab_bin <- function(x) {
  case_when(
    suppressWarnings(as.numeric(x)) %in% 2:5 ~ 1,
    suppressWarnings(as.numeric(x)) == 1     ~ 0,
    TRUE                                     ~ NA_real_
  )
}


