render_or_table <- function(res, title, outcome_phrase, primary = TRUE) {
  if (is.null(res) || nrow(res) == 0) {
    message("no results to render for: ", title)
    return(invisible(NULL))
  }
  res %>%
    mutate(
      `OR (95% CI)` = sprintf("%.2f (%.2f\u2013%.2f)", OR, CI_lower, CI_upper),
      `P value` = case_when(p_value < 0.001 ~ "<0.001", TRUE ~ sprintf("%.3f", p_value))
    ) %>%
    select(Comparison, Model, N, `OR (95% CI)`, `P value`) %>%
    arrange(Comparison, Model) %>%
    gt(groupname_col = "Comparison") %>%
    cols_label(Model = "Model", N = "N in model",
               `OR (95% CI)` = "Odds Ratio (95% CI)", `P value` = "P value") %>%
    tab_header(title = title,
               subtitle = paste0("Exposure: ", EXPOSURE_LABEL,
                                 "; outcome: post-transplant days ",
                                 round(YR2_START), "-", round(YR2_END))) %>%
    tab_options(table.font.size = 13, data_row.padding = px(4),
                column_labels.font.weight = "bold", row_group.font.weight = "bold") %>%
    tab_source_note(paste0(
      if (primary) "PRIMARY ANALYSIS (covariate-adjusted, full eligible cohort). " else "",
      "OR > 1 indicates higher odds of ", outcome_phrase, " relative to the comparison group. Adjusted ",
      "model controls for ", gsub(" \\+ ", ", ", yr2_adj_covs), ". ",
      if (CLUSTER_BY_CENTRE)
        "Standard errors are cluster-robust on transplant centre, because anti-rejection practice is a centre-level pattern and patients within a centre are not independent. "
      else
        "Standard errors assume patients are independent across transplant centres, which for a treatment exposure is optimistic. ",
      "HLA mismatch is NOT included: missing for roughly 60% of the cohort, and because fitting is ",
      "complete-case, including it would restrict the adjusted models to a minority of patients selected ",
      "on HLA-typing availability. N is reported per model so any remaining difference in analysed sample ",
      "between rows is visible. EXPOSURE IS FIXED AT DAY ", round(LANDMARK_DAY), ": the Control arm means ",
      "'not treated in the first ", round(LANDMARK_DAY), " days', and includes patients first treated ",
      "during the day ", round(GAP_START), "-", round(GAP_END), " gap. Eligibility requires survival to ",
      "day ", round(YR2_ELIGIBLE_DAY), ", which is AFTER the exposure window, so these estimates ",
      "condition on a post-exposure variable; see the attrition table for whether that differs by arm."))
}

