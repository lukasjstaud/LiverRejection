  mutate(event = ifelse(PX_STAT == "D", 1, 0))   # confirm "D" is the death code

# Carries every propensity-score covariate, because the discharge (section 19)
# and landmark (section 20) matches build their frames from THIS object rather
# than from the demographic frame. If a covariate is added to match_covariates
# but not here, drop_na() removes the entire cohort and the match "fails" for
# reasons nothing in the log explains.
baseline_covs <- df_liver_data_filtered %>%
  select(TRR_ID_CODE, AGE, GENDER, ETHCAT, MELD_PELD_LAB_SCORE, COLD_ISCH, DIAB,
         TX_YEAR, CENTRE) %>%
  distinct(TRR_ID_CODE, .keep_all = TRUE) %>%
  left_join(df_hla_calc %>% select(TRR_ID_CODE, MM_TOTAL), by = "TRR_ID_CODE") %>%
  left_join(induction_lookup, by = "TRR_ID_CODE") %>%
  left_join(df_deceased_don_fil2 %>%
              select(TRR_ID_CODE, any_of(c("AGE_DON", "GENDER_DON", "BMI_DON",
                                           "DCD_BIN", "DON_COD_CVA_BIN",
                                           "MACHINE_PERF_BIN"))),
            by = "TRR_ID_CODE") %>%
  mutate(
    DIAB_BIN = diab_bin(DIAB),
    GENDER = factor(GENDER),
    ETHCAT = factor(ETHCAT)
  )

stopifnot(all(match_covariates %in% names(baseline_covs)))


# Covariate set for every adjusted survival model, both anchors.
#
# Kept deliberately IN STEP with match_covariates: the adjusted models and the
# propensity score should be answering the confounding question with the same
# variables, so that a difference between the matched and adjusted estimates is
# a difference of METHOD rather than of covariate list.
#
# ETHCAT is in the match but not here, and that is intentional -- it enters the
# Cox models as a multi-level factor with sparse UNOS codes (998, 9, 7) that
# produce unstable coefficients in the matched subsets without changing the arm
# hazard ratio.
#
# COST: adding the donor block makes every ADJUSTED model complete-case on
# donor variables, which excludes living-donor recipients (~4.9% of the cohort).
# The UNADJUSTED models are unaffected, so adjusted and unadjusted rows in the
# same table are no longer fitted on the same patients. The N column in every
# hazard-ratio table is what makes that visible; quote it.
adj_formula_suffix <- paste0(
  " + AGE + GENDER + MELD_PELD_LAB_SCORE + COLD_ISCH + DIAB_BIN",
  if (ADJUST_FOR_ERA) " + TX_YEAR" else "",
  if (ADJUST_FOR_INDUCTION) " + INDUCTION_CAT" else "",
  if (ADJUST_FOR_DONOR && length(DONOR_PS_VARS))
    paste0(" + ", paste(DONOR_PS_VARS, collapse = " + ")) else "",
  if (ADJUST_FOR_MAINTENANCE)
    " + MAINT_TAC_BIN + MAINT_CSA_BIN + MAINT_ANTIMET_BIN + MAINT_MTOR_BIN" else "")

message("\nAdjusted-model covariates:", adj_formula_suffix)

# Cluster-robust variance term appended to Cox models. A model fitted on
# propensity-matched pairs already clusters on `subclass`; coxph() accepts only
# ONE cluster term, and the matched pair is the tighter of the two (pairs are
# nested within nothing in particular, but the pair is what the design created),
# so centre clustering applies to the UNMATCHED, full-cohort models only. Those
# are exactly the models -- fit_dc_3arm, fit_lm_3arm, fit_tv, cox_dc_rej -- whose
# CIs are currently narrowest and least defensible.
centre_cluster_term <- function(d) {
  if (!CLUSTER_BY_CENTRE) return("")
  if ("subclass" %in% names(d)) return("")          # matched set wins
  if (!"CENTRE" %in% names(d)) return("")
  if (n_distinct(d$CENTRE[!is.na(d$CENTRE)]) < 2) return("")
  " + cluster(CENTRE)"
}

# Case weights for a frame that came out of a 1:k match, NULL otherwise.
#
# Passed as an explicit VECTOR (d$weights) rather than by name: coxph() and
# survfit() resolve a bare `weights` argument in a way that can pick up an
# object of that name from the calling environment instead of the column, and
# silently weighting a model by the wrong vector is not a failure that shows up
# in the output. At MATCH_RATIO = 1 every weight is 1 and this is a no-op, which
# is why the models ran correctly before without it.
match_weights <- function(d) if ("weights" %in% names(d)) d$weights else NULL

# Reports how far the weights depart from uniform. Printed once per matched
# model so an unexpectedly lopsided match is visible rather than buried.
describe_match_weights <- function(d, label) {
  w <- match_weights(d)
  if (is.null(w) || isTRUE(all.equal(max(w), min(w)))) return(invisible(NULL))
  message("  [", label, "] control weights range ",
          sprintf("%.3f", min(w)), "-", sprintf("%.3f", max(w)),
          " (effective N = ", sprintf("%.0f", sum(w)^2 / sum(w^2)),
          " of ", length(w), " rows)")
  invisible(NULL)
}

#===============================================================================
# 19. CO-PRIMARY ENDPOINT 1: All-Cause Mortality, Discharge-Anchored
#-------------------------------------------------------------------------------
# WHY THIS SECTION EXISTS, AND WHY IT MAY BE THE BETTER PRIMARY ANALYSIS.
#
# The section 18b timing table showed that EVERY exposed patient in this cohort
# was treated during the index admission -- there is not a single dated
# outpatient anti-rejection event before the landmark. The exposure is
# therefore fully determined at discharge, and it is more accurately described
# as "anti-rejection therapy during the index admission" than as "therapy
# within the first N days". Any landmark between roughly day 30 and day 365
# produces IDENTICAL arms.
#
# That changes what the landmark is buying. A landmark exists to remove
# immortal time, but an exposure that is complete at discharge generates almost
# none: the only guaranteed survival a treated patient carries is survival to
# their own discharge. Anchoring at discharge removes exactly that, and nothing
# more. It does NOT, however, escape paying an early-death price -- it pays a
# different one, on a different set of patients. See WHAT IT COSTS.
#
# The other gain is conceptual. Under the landmark design, the 975 patients
# first treated between day 90 and day 365 are "gap contamination" sitting
# inside the Control arm and attenuating every contrast. Under the discharge
# anchor they are not contamination at all -- they are an OUTCOME
# (post-discharge rejection), analysed as such below.
#
# WHAT IT COSTS:
#   - IN-HOSPITAL DEATHS ARE EXCLUDED, ~2,344 of them. UNOS sets DISCHARGE_DATE
#     to the death date for patients who die during the index admission, so most
#     appear as PTIME == DC_DAY (~2,255) rather than PTIME < DC_DAY (~89); the
#     `filter(PTIME > DC_DAY)` below removes both. Correct in principle -- they
#     could not have completed the exposure -- but ~2,262 are Control against
#     ~82 treated, because an untreated in-hospital death is a Control by
#     construction. The surviving Control arm is survivor-selected in a way the
#     treated arms are not. This belongs in the limitations NEXT TO the
#     landmark's day-90 exclusion, not framed as its absence.
#   - A further ~527 patients are excluded with no death recorded: ~88 at
#     PTIME == DC_DAY with event == 0 (discharged, no follow-up), and ~439 at
#     PTIME < DC_DAY with event == 0, which is PTIME and DISCHARGE_DATE
#     disagreeing across forms rather than a clinical event. The second group is
#     a data-integrity question, not an eligibility one, and is worth chasing.
#   - Patients with no discharge record (LOS unknown) cannot be anchored and
#     are dropped. Reported below.
#   - The time origin now VARIES BY PATIENT. If LOS differs by arm (see the
#     section 7 Step 7b table), the arms are followed over different calendar
#     windows even though the clock starts at 0 for everyone. That is the main
#     thing to check before preferring this design.
#
# Arms are unchanged from arm_at_landmark, so this and the landmark analysis
# cannot disagree about who was exposed -- only about who is eligible and how
# post-discharge treatment is classified.
#===============================================================================

# Include index-admission LOS as a matching covariate in this design. Defensible
# both ways: LOS is a proxy for early severity (so matching on it removes
# confounding), but it is also downstream of the exposure itself (so matching on
# it can over-adjust). Run both and report the difference.
DC_MATCH_ON_LOS <- FALSE

los_lookup <- df_immuno_induc %>%
  select(TRR_ID_CODE, DAYS_HOSP_SP_TX) %>%
  distinct(TRR_ID_CODE, .keep_all = TRUE)

# LOS IS THE TIME ORIGIN in this design, so a corrupt value does not produce a
# missing row -- it produces a patient whose clock starts before their
# transplant. A negative DAYS_HOSP_SP_TX (DISCHARGE_DATE earlier than TX_DATE)
# passes the `PTIME > DC_DAY` filter trivially and is then credited with
# PTIME - DC_DAY days of follow-up, i.e. MORE than their entire post-transplant
# time. Checked rather than assumed: there are none in this extract, but the
# failure is silent if a future extract has them.
n_los_neg <- sum(los_lookup$DAYS_HOSP_SP_TX < 0, na.rm = TRUE)
if (n_los_neg > 0) {
  warning("Index-admission LOS is NEGATIVE for ", n_los_neg, " patient(s): DISCHARGE_DATE ",
          "precedes TX_DATE. These are set to NA rather than anchored, because a negative ",
          "time origin inflates their follow-up past their own PTIME.")
  los_lookup <- los_lookup %>%
    mutate(DAYS_HOSP_SP_TX = if_else(DAYS_HOSP_SP_TX < 0, NA_real_, DAYS_HOSP_SP_TX))
}
message("Index-admission LOS: ", sum(!is.na(los_lookup$DAYS_HOSP_SP_TX)), " known, ",
        sum(is.na(los_lookup$DAYS_HOSP_SP_TX)), " missing, ",
        sum(los_lookup$DAYS_HOSP_SP_TX == 0, na.rm = TRUE), " same-day (LOS = 0), ",
        n_los_neg, " negative")

df_discharge_anchor <- df_survival %>%
  inner_join(arm_at_landmark, by = "TRR_ID_CODE") %>%
  left_join(los_lookup, by = "TRR_ID_CODE") %>%
  mutate(
    ARM = factor(as.character(ARM), levels = ARM_LEVELS),
    DC_DAY = DAYS_HOSP_SP_TX
  )

# --- Attrition into the discharge cohort ---
dc_attrition <- df_discharge_anchor %>%
  group_by(ARM, .drop = FALSE) %>%
  summarise(
    n_assigned   = n(),
    n_no_los     = sum(is.na(DC_DAY)),
    n_no_ptime   = sum(!is.na(DC_DAY) & is.na(PTIME)),
    n_died_predc  = sum(!is.na(DC_DAY) & !is.na(PTIME) & PTIME <= DC_DAY & event == 1),
    n_zero_fu     = sum(!is.na(DC_DAY) & !is.na(PTIME) & PTIME == DC_DAY & event == 0),
    n_incoherent  = sum(!is.na(DC_DAY) & !is.na(PTIME) & PTIME <  DC_DAY & event == 0),
    n_eligible    = sum(!is.na(DC_DAY) & !is.na(PTIME) & PTIME >  DC_DAY),
    pct_lost     = 100 * (n_assigned - n_eligible) / pmax(n_assigned, 1),
    .groups = "drop"
  )

keep(
  dc_attrition %>%
    gt() %>%
    fmt_number(columns = pct_lost, decimals = 1) %>%
    cols_label(
      ARM          = "Arm",
      n_assigned   = "N assigned",
      n_no_los     = "No discharge record",
      n_no_ptime   = "No follow-up time",
      n_died_predc = "Died during index admission",
      n_zero_fu    = "Discharged, no follow-up",
      n_incoherent = "PTIME/discharge date incoherent",
      n_eligible   = "N eligible",
      pct_lost     = "% lost"
    ) %>%
    tab_header(
      title = "Attrition into the Discharge-Anchored Cohort",
      subtitle = "Compare against the landmark attrition table in section 20"
    ) %>%
    tab_options(table.font.size = 13, data_row.padding = px(4),
                column_labels.font.weight = "bold") %>%
    tab_source_note(paste0(
      "Patients with no index-admission record have no discharge date and cannot be anchored; they are ",
      "lost to this design but retained by the landmark design, so the two cohorts are not nested and ",
      "their Ns are not interchangeable. Deaths during the index admission are excluded -- those patients ",
      "could not have completed the exposure -- but note that UNOS records DISCHARGE_DATE as the death date ",
      "for in-hospital deaths, so most appear at PTIME == discharge rather than before it. Because an ",
      "untreated in-hospital death is a Control by construction, this exclusion falls overwhelmingly on the ",
      "Control arm and leaves it survivor-selected relative to the treated arms. Contrast the '% lost' ",
      "column against the landmark table: the two designs discard DIFFERENT early deaths (landmark: all ",
      "deaths before day ", round(LANDMARK_DAY), "; this design: all deaths during the admission), not one ",
      "versus none."))
  , "discharge_attrition")

df_dc <- df_discharge_anchor %>%
  filter(!is.na(DC_DAY), !is.na(PTIME), PTIME > DC_DAY)

message("\nDischarge-anchored cohort: ", nrow(df_dc), " patients of ",
        nrow(df_discharge_anchor), " assigned to an arm",
