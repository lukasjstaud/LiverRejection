# transplant reviewer reads the induction row before anything else in a
# rejection-therapy paper, and it is now also in the propensity score, so the
# table has to show what the match was balancing.
gts_vars <- c("AGE", "GENDER_LBL", "RACE_LBL", "BMI_REC", "DIAB_LBL", "MELD_PELD_LAB_SCORE",
              "ORGAN_LBL", "LIVING_DON_LBL", "COLD_ISCH", "PREV_LIV_LBL",
              "PREV_ANY_LBL", "HLA_MM", "INDUCTION_CAT",
              "PERFUSION_LBL", "PERFUSION_TY_LBL")

gts_labels <- list(
  AGE                 ~ "Recipient Age, y",
  GENDER_LBL          ~ "Sex, n (%)",
  RACE_LBL            ~ "Race/ethnicity, n (%)",
  BMI_REC             ~ "Recipient BMI, kg/m\u00b2",
  DIAB_LBL            ~ "History of Diabetes, n (%)",
  MELD_PELD_LAB_SCORE ~ "MELD, mean (SD)",
  ORGAN_LBL           ~ "Organ Transplanted, n (%)",
  LIVING_DON_LBL      ~ "Living Donor, n (%)",
  COLD_ISCH           ~ "Cold Ischemic Time, hr",
  PREV_LIV_LBL        ~ "Previous Liver Transplant, n (%)",
  PREV_ANY_LBL        ~ "Previous Any Transplant, n (%)",
  HLA_MM              ~ "HLA Mismatch Level (0-6), n (%)",
  INDUCTION_CAT       ~ "Induction Immunosuppression, n (%)",
  PERFUSION_LBL       ~ "Liver Perfusion Used, n (%)",
  PERFUSION_TY_LBL    ~ "Perfusion Type, n (%)"
)

# Categorical-test wrapper so the tables use the SAME chi-square/Fisher rule
# as safe_chisq_or_fisher().
#
# This is not cosmetic. gtsummary's built-in default also falls back to Fisher
# on small expected counts, but calls fisher.test() WITHOUT simulation -- and
# an exact test on a 2x5 or 2x7 table with tens of thousands of patients
# exhausts the workspace and errors, which gtsummary renders as a silently
# BLANK p-value. That is what once emptied the "Previous Any Transplant" and
# "HLA Mismatch Level" rows.
gts_safe_cat_test <- function(data, variable, by, ...) {
  tab <- table(data[[variable]], data[[by]])
  # Fisher fallbacks above 2x2 use simulate.p.value, which is stochastic --
  # seed it so re-running the script reproduces the same table.
  set.seed(1234)
  res <- safe_chisq_or_fisher(tab)
  dplyr::tibble(
    p.value = if (is.null(res)) NA_real_ else res$p.value,
    method  = if (is.null(res)) NA_character_ else res$method
  )
}

# Generalized builder. cont_test = "auto" picks t.test for 2 arms and one-way
# ANOVA for 3+, which matters for Tables 1 and 7: a t-test cannot compare
# three groups, so gtsummary catches the error per-variable and renders a
# BLANK p-value for every continuous row. Use "kruskal.test" if MELD / cold
# ischemic time / donor labs are skewed enough to make ANOVA inappropriate.
build_gts_table <- function(df_combined, group_col, group_lbls = NULL, caption = NULL,
                            vars      = gts_vars,
                            labels    = gts_labels,
                            prep_fn   = prep_gts_df,
                            cont_test = c("auto", "t.test", "aov", "wilcox.test", "kruskal.test"),
                            missing_disp = "no",
                            matched   = FALSE) {
  
  cont_test <- match.arg(cont_test)
  
  d <- prep_fn(df_combined)
  d <- d %>% filter(!is.na(.data[[group_col]]))
  
  # Fail loudly, not silently. If an arm collapses upstream (as it did when the
  # Control definition required a form dated before the landmark), tbl_summary()
  # errors and the table simply never appears, with nothing pointing at the
  # cause. This turns that into a message naming the table and printing the
  # group sizes.
  
  all_na <- vars[vapply(vars, function(v) !v %in% names(d) || all(is.na(d[[v]])), logical(1))]
  if (length(all_na)) {
    message("  dropping all-NA variable(s) from ",
            if (!is.null(caption)) caption else group_col, ": ",
            paste(all_na, collapse = ", "))
    vars   <- setdiff(vars, all_na)
    labels <- labels[vapply(labels, function(f) all.vars(f)[1] %in% vars, logical(1))]
  }
  if (!length(vars)) {
    message("SKIPPING TABLE -- no summarisable variables left")
    return(invisible(NULL))
  }
  
  grp_n <- table(droplevels(factor(d[[group_col]])))
  if (nrow(d) == 0 || length(grp_n) < 2 || any(grp_n < 2)) {
    message("SKIPPING TABLE -- an arm is empty or has < 2 patients: ",
            if (!is.null(caption)) caption else group_col)
    print(grp_n)
    return(invisible(NULL))
  }
  
  n_groups <- nlevels(droplevels(factor(d[[group_col]])))
  if (cont_test == "auto") cont_test <- if (n_groups > 2) "aov" else "t.test"

  cont_lbl <- switch(cont_test,
                     "t.test"       = "Welch two-sample t-test",
                     "aov"          = "One-way ANOVA",
                     "wilcox.test"  = "Wilcoxon rank-sum test",
                     "kruskal.test" = "Kruskal-Wallis test")

  # FIX (Tables 2/3 SMD): a matched cohort is not an independent random
  # sample -- a between-group hypothesis test (t-test/chi-square) on matched
  # pairs mixes leftover imbalance with sampling noise from a test that
  # doesn't know the rows are paired, and can read as "significant" or "not"
  # for reasons unrelated to match quality. Standardized mean difference
  # (SMD) is the balance metric MatchIt itself optimizes against -- the same
  # one plotted in the Love plots -- so matched = TRUE reports that instead
  # of a p-value.
  if (matched && n_groups != 2) {
    stop("build_gts_table(matched = TRUE) requires exactly 2 groups for SMD; got ", n_groups)
  }

  tbl <- d %>%
    select(all_of(group_col), all_of(vars)) %>%
    tbl_summary(
      by = all_of(group_col),
      label = labels,
      statistic = list(
        all_continuous()  ~ "{mean} ({sd})",
        all_categorical() ~ "{n} ({p}%)"
      ),
      digits = list(all_continuous() ~ 1),
      missing = missing_disp
    )

  tbl <- if (matched) {
    tbl %>%
      add_difference(test = everything() ~ "smd") %>%
      modify_footnote(
        estimate ~ paste0(
          "Standardized mean difference (matched cohort). ",
          "|SMD| < 0.1 is conventionally considered balanced.",
          if (MATCH_RATIO > 1) paste0(
            " NOTE: this is a 1:", MATCH_RATIO, " match, so the control column holds up to ",
            MATCH_RATIO, " controls per treated patient and the SMD shown here is UNWEIGHTED. ",
            "The match optimises the WEIGHTED balance, which is what the Love plot for this ",
            "comparison reports (cobalt applies the matching weights automatically); read the ",
            "Love plot, not this column, as the balance evidence.") else ""))
  } else {
    tbl %>%
      add_p(
        test = list(
          all_continuous()  ~ cont_test,
          all_categorical() ~ "gts_safe_cat_test"
        ),
        pvalue_fun = ~ style_pvalue(.x, digits = 3)
      ) %>%
      modify_footnote(p.value ~ paste0(
        cont_lbl,
        "; Pearson's Chi-squared test / Fisher's exact test (simulated p-value where tables exceed 2x2)"))
  }

  tbl <- tbl %>%
    bold_labels() %>%
    modify_header(all_stat_cols() ~ "**{level}**, N = {n}") %>%
    modify_footnote(all_stat_cols() ~ "Mean (SD); n (%)")

  if (!is.null(group_lbls)) {
    for (lv in names(group_lbls)) {
      tbl <- tbl %>% modify_header(
        !!rlang::sym(paste0("stat_", which(levels(factor(d[[group_col]])) == lv))) :=
          paste0("**", group_lbls[[lv]], "**, N = {n}")
      )
    }
  }
  
  if (!is.null(caption)) tbl <- tbl %>% modify_caption(caption)
  
  tbl
}

