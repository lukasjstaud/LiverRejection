# Adjustment covariate set, defined ONCE so the rejection and graft-failure
# models cannot drift apart.
#
# HLA mismatch (MM_TOTAL) is deliberately excluded, for the same reason it was
# removed from the propensity matching: missing for ~60% of the cohort, and
# glm() is complete-case. Including it silently fitted every "Adjusted" model
# on roughly 40% of the cohort while the neighbouring "Unadjusted" model used
# all of it, so the two were never estimated on the same patients and the
# difference between them could not be attributed to the adjustment.
#
# TX_YEAR is included when ADJUST_FOR_ERA is TRUE. It matters more here than in
# the survival models: the outcome window is a FIXED calendar span, so a patient
# accrued late has less opportunity to be observed having the event, and era is
# therefore correlated with the outcome through ascertainment as well as through
# practice.
# Induction and donor quality are included on the same reasoning as in the
# survival models (section 18): a recipient-only adjustment leaves the two
# strongest sources of confounding by indication in place. The complete-case
# cost falls on living-donor recipients, who have no donor record; N is
# reported per model so the resulting difference between adjusted and
# unadjusted samples is visible rather than assumed away.
yr2_adj_covs <- paste0("AGE + GENDER + MELD_PELD_LAB_SCORE + COLD_ISCH + DIAB_BIN",
                       if (ADJUST_FOR_ERA) " + TX_YEAR" else "",
                       if (ADJUST_FOR_INDUCTION) " + INDUCTION_CAT" else "",
                       if (ADJUST_FOR_DONOR && length(DONOR_PS_VARS))
                         paste0(" + ", paste(DONOR_PS_VARS, collapse = " + ")) else "",
                       if (ADJUST_FOR_MAINTENANCE)
                         " + MAINT_TAC_BIN + MAINT_CSA_BIN + MAINT_ANTIMET_BIN + MAINT_MTOR_BIN" else "")

# N is carried into the output tables because COLD_ISCH and DIAB still have
# some missingness, so adjusted and unadjusted models may STILL be fitted on
# slightly different samples. Reporting it makes any gap visible.
tidy_glm_or <- function(fit) {
  co <- summary(fit)$coefficients
  ci <- suppressMessages(confint.default(fit))  # Wald CIs

  # FIX 5: svyglm() (used for matched-pair models clustered on subclass)
  # reports a t-test p-value column ("Pr(>|t|)") instead of glm's z-test
  # ("Pr(>|z|)"). Match by pattern so this works for both model types.
  p_col <- grep("^Pr\\(>\\|[zt]\\|\\)$", colnames(co), value = TRUE)[1]

  tibble(
    term     = rownames(co),
    N        = stats::nobs(fit),
    OR       = exp(co[, "Estimate"]),
    CI_lower = exp(ci[, 1]),
    CI_upper = exp(ci[, 2]),
    p_value  = co[, p_col]
  ) %>%
    filter(term != "(Intercept)")
}

# Generic extractor: labels comparisons from the term name and the reference
# level rather than a hard-coded case_when, so adding Dual Therapy as a fourth
# arm needs no further edits.
or_from <- function(fit, ref_lbl, model_lbl, keep_terms = NULL) {
  out <- tidy_glm_or(fit) %>%
    filter(str_detect(term, "^EXPOSURE_GROUP")) %>%
    mutate(Level = str_remove(term, "^EXPOSURE_GROUP"))
  if (!is.null(keep_terms)) out <- out %>% filter(Level %in% keep_terms)
  out %>%
    mutate(Comparison = paste0(Level, " vs ", ref_lbl), Model = model_lbl) %>%
    select(Comparison, Model, N, OR, CI_lower, CI_upper, p_value)
}

# Returns FOUR fits, not two. `unadj`/`adj` are what gets REPORTED and carry
# centre-clustered standard errors when CLUSTER_BY_CENTRE is on; `glm_unadj`/
# `glm_adj` are the plain binomial fits, kept because the likelihood-ratio
# diagnostics below have no survey-design equivalent (a clustered design has no
# ordinary likelihood, so anova(..., test = "LRT") is not defined for svyglm).
# Point estimates are identical between the two; only the variance differs.
fit_glm_pair <- function(model_df, outcome, ref_lvl) {
  d <- model_df %>% mutate(EXPOSURE_GROUP = relevel(droplevels(EXPOSURE_GROUP), ref = ref_lvl))

  f_unadj <- as.formula(paste(outcome, "~ EXPOSURE_GROUP"))
  f_adj   <- as.formula(paste(outcome, "~ EXPOSURE_GROUP +", yr2_adj_covs))

  g_unadj <- glm(f_unadj, data = d, family = binomial)
  g_adj   <- glm(f_adj,   data = d, family = binomial)

  can_cluster <- CLUSTER_BY_CENTRE && "CENTRE" %in% names(d) &&
    n_distinct(d$CENTRE[!is.na(d$CENTRE)]) > 1

  if (!can_cluster) {
    return(list(unadj = g_unadj, adj = g_adj,
                glm_unadj = g_unadj, glm_adj = g_adj, data = d, clustered = FALSE))
  }

  # ids = ~CENTRE with unit weights is a cluster-robust (sandwich) variance on
  # transplant centre, not a reweighting: the point estimates are unchanged and
  # only the SEs move. quasibinomial() for the same reason as in section 26 --
  # binomial() warns about non-integer successes under a survey design.
  dsgn <- svydesign(ids = ~CENTRE, weights = ~1, data = d %>% filter(!is.na(CENTRE)))

  list(unadj     = svyglm(f_unadj, design = dsgn, family = quasibinomial()),
       adj       = svyglm(f_adj,   design = dsgn, family = quasibinomial()),
       glm_unadj = g_unadj,
       glm_adj   = g_adj,
       data      = d,
       clustered = TRUE)
}

