balance_only_covariates <- c("MM_TOTAL")

match_formula <- as.formula(paste("treat ~", paste(match_covariates, collapse = " + ")))

report_complete_case_loss <- function(df, label) {
  n_before <- nrow(df)
  n_after  <- nrow(tidyr::drop_na(df, all_of(match_covariates)))
  message("\n[", label, "] complete-case attrition on matching covariates:")
  message("  rows before drop_na: ", n_before,
          " | after: ", n_after,
          " | lost: ", n_before - n_after,
          " (", sprintf("%.1f", 100 * (n_before - n_after) / max(n_before, 1)), "%)")
  
  per_arm <- df %>%
    group_by(treat) %>%
    summarise(before = n(),
              after = sum(complete.cases(across(all_of(match_covariates)))),
              .groups = "drop")
  print(per_arm)
  
  miss_by_var <- sapply(match_covariates, function(v) sum(is.na(df[[v]])))
  message("  missing count by covariate:")
  print(miss_by_var[order(-miss_by_var)])
  invisible(NULL)
}

# Generic 1:MATCH_RATIO nearest-neighbour match with caliper, so the three
# places this script matches all use identical settings.
#
# Caliper: without one, nearest-neighbour matching forces a match for every treated
# unit no matter how far the nearest control is, which with small treated arms
# produces pairs that aren't comparable at all. 0.2 SD of the propensity logit
# is the conventional cutoff (Austin 2011); std.caliper = TRUE makes it
# SD-scaled rather than absolute.
run_match <- function(raw_df, label, seed = 1234) {
  report_complete_case_loss(raw_df, label)
  
  # drop_na() with no arguments drops a row with NA in ANY column -- which
  # would re-delete every HLA-untyped patient the moment MM_TOTAL is carried
  # in the frame, silently undoing the point of excluding it from the match.
  # Scope it explicitly to the matching covariates.
  md <- raw_df %>%
    drop_na(all_of(match_covariates)) %>%
    mutate(across(where(is.factor), droplevels))
  
  if (length(unique(md$treat)) < 2 || min(table(md$treat)) < 5) {
    message("skipping match -- too few complete cases in one arm: ", label)
    return(NULL)
  }
  
  set.seed(seed)
  m <- matchit(match_formula, data = md, method = "nearest", distance = "logit",
               ratio = MATCH_RATIO, caliper = 0.2, std.caliper = TRUE)

  mdta <- match.data(m)
  message("[", label, "] 1:", MATCH_RATIO, " match | treated units unmatched by caliper: ",
          sum(m$treat == 1 & is.na(m$subclass)),
          " | matched controls per treated (mean): ",
          sprintf("%.2f", sum(mdta$treat == 0) / max(sum(mdta$treat == 1), 1)))

  # matched_data carries subclass (which matched SET a patient belongs to) and
  # weights. At MATCH_RATIO > 1 the weights are NOT all 1 -- a treated patient
  # who found fewer than MATCH_RATIO controls inside the caliper gives each of
  # the controls it did find a larger weight. Callers must pass both: cluster on
  # subclass, weight on weights. matched_ids is kept for callers that only need
  # the ID list (the descriptive tables), which do not model.
  list(matchit = m, match_frame = md,
       matched_ids  = mdta$TRR_ID_CODE,
       matched_data = mdta %>% select(TRR_ID_CODE, subclass, weights))
}

