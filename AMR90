# --- Propensity matching within the discharge cohort ---
# Matched here rather than reused from section 14 or 18, for the same reason
# given there: the eligibility rule differs, and applying it to an
# already-matched set breaks pairs non-randomly.
dc_match_covariates <- if (DC_MATCH_ON_LOS) c(match_covariates, "DAYS_HOSP_SP_TX") else match_covariates
dc_match_formula    <- as.formula(paste("treat ~", paste(dc_match_covariates, collapse = " + ")))

# exact_centre = TRUE forces every matched pair to come from the SAME transplant
# centre, which removes centre-level confounding by design rather than by
# adjustment. It is only viable where the comparator arm is present in nearly
# every centre holding a treated patient; the function reports the retention so
# that is visible rather than assumed.
match_within_dc <- function(df_in, treat_arm, ctrl_arm, label, seed = 1234,
                            exact_centre = FALSE) {
  d <- df_in %>%
    filter(ARM %in% c(treat_arm, ctrl_arm)) %>%
    mutate(treat = as.integer(ARM == treat_arm)) %>%
    select(-any_of(setdiff(names(baseline_covs), "TRR_ID_CODE"))) %>%
    left_join(baseline_covs, by = "TRR_ID_CODE")

  # CENTRE is carried into the matching frame only when it is being matched on;
  # otherwise it stays out so it cannot affect the complete-case filter.
  md_vars <- c(dc_match_covariates, if (exact_centre) "CENTRE" else NULL)
  md <- d %>% select(TRR_ID_CODE, treat, all_of(md_vars))

  n_before <- nrow(md)
  md <- md %>% drop_na(all_of(md_vars)) %>%
    mutate(across(where(is.factor), droplevels))
  message("\n[", label, "] complete-case: ", n_before, " -> ", nrow(md),
          " (lost ", n_before - nrow(md), ")")

  if (length(unique(md$treat)) < 2 || min(table(md$treat)) < 5) {
    message("skipping match -- too few complete cases in one arm: ", label)
    return(NULL)
  }

  set.seed(seed)
  m <- matchit(dc_match_formula, data = md, method = "nearest", distance = "logit",
               ratio = MATCH_RATIO, caliper = 0.2, std.caliper = TRUE,
               exact = if (exact_centre) "CENTRE" else NULL)
  n_treat_unmatched <- sum(m$treat == 1 & is.na(m$subclass))
  message("[", label, "] 1:", MATCH_RATIO, " match",
          if (exact_centre) " (EXACT on centre)" else "",
          " | treated units unmatched by caliper: ", n_treat_unmatched)
  if (exact_centre) {
    message("  treated retained: ", sum(m$treat == 1) - n_treat_unmatched, " of ",
            sum(m$treat == 1),
            sprintf(" (%.1f%%)", 100 * (sum(m$treat == 1) - n_treat_unmatched) /
                      max(sum(m$treat == 1), 1)),
            " -- a treated patient is dropped here if their own centre holds no ",
            "control within the caliper.")
  }

  # subclass = the matched SET, weights = the unequal control weights that a
  # 1:k match produces. Both are required downstream; see MATCH_RATIO.
  matched <- match.data(m) %>% select(TRR_ID_CODE, subclass, weights)
  list(matchit = m,
       match_frame = md,
       data = d %>%
         inner_join(matched, by = "TRR_ID_CODE") %>%
         mutate(ARM = droplevels(ARM)))
}

