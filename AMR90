#===============================================================================
# UNOS Liver Transplant Anti-Rejection Therapy Analysis
# TIME ORIGIN = DISCHARGE FROM THE INDEX ADMISSION
#
# Parses UNOS liver transplant patients into rejection-therapy groups
# (no rejection / steroid monotherapy / combined therapy / dual therapy),
# builds baseline recipient and donor tables, propensity-score-matches
# treatment arms, and runs landmark + time-varying survival and year-2
# outcome analyses.
#
# TO DO:
# 3.) "Survival curve" based on graft failure

#-------------------------------------------------------------------------------
# WHAT CHANGED IN THIS VERSION, AND WHY
#
# The exposure landmark moved from 365.25 days to 90 days. That is a one-line
# change to a constant, but it is NOT a one-line change to the analysis,
# because several parts of the previous script defined treatment arms from
# year-long ID vectors that had no notion of a landmark at all. Left alone,
# the script would have carried two mutually inconsistent definitions of
# "Steroid group" -- one at day 90 (survival) and one over the full year
# (year-2 outcomes, demographic tables) -- and silently reported both.
#
# Structural changes made to prevent that:
#
#   1. ALL analysis parameters were hoisted into section 0b. Nothing
#      downstream hard-codes 365.25, 730.5, or 90 any more.
#
#   2. The landmark arm assignment (pat_rej_first + assign_arm_at_landmark)
#      moved UP, from the survival section to section 7, so that every
#      downstream section -- demographic tables, propensity matching,
#      survival, year-2 outcomes -- draws its arms from the same object.
#
#   3. The Control definition changed. See section 7; this is the one edit
#      that moves numbers rather than tidying them.
#
#   4. The year-2 outcome sections now take their arms from the landmark
#      assignment instead of the section-6 full-year ID vectors. The grouping
#      column was renamed FIRST_YEAR_GROUP -> EXPOSURE_GROUP, because at a
#      90-day landmark it is no longer a first-year group and leaving the old
#      name invites exactly the wrong sentence in a manuscript.
#
#   5. The appended add-on blocks (donor tables, timing histograms) were
#      folded into the main flow in dependency order rather than left at the
#      end as replacement patches.
#
# READ BEFORE INTERPRETING ANYTHING BELOW.
#
# THE EXPOSURE IS ANTI-REJECTION THERAPY DURING THE INDEX ADMISSION. Every
# exposure event in this cohort is a discharge record; there is not one dated
# outpatient rejection event before the landmark (section 18b confirms this,
# and it is why LANDMARK_DAY no longer affects arm membership at any value
# above INPATIENT_RX_DAY). Describe the exposure that way in the manuscript,
# not as "therapy within N days".
#
# THE TIME ORIGIN IS DISCHARGE, AND THERE ARE EXACTLY TWO PRIMARY ENDPOINTS:
#
#   Section 19   ALL-CAUSE MORTALITY  (co-primary)
#   Section 19c  GRAFT FAILURE        (co-primary; cause-specific Cox is the
#                primary model, Fine-Gray reported alongside, death handled as a
#                competing risk rather than as censoring)
#
# Section 19b (post-discharge anti-rejection therapy) is SECONDARY AND
# DESCRIPTIVE, and was demoted from primary deliberately. It cannot carry a
# causal claim for two reasons that no amount of modelling fixes: it is
# ascertained from the SAME drug fields that define the exposure, and it is not
# the same event in every arm -- a first-ever course in Control against
# RE-treatment in the treated arms. Report it as a description of the
# post-discharge course, never as a treatment effect. Because the exposure is complete at
# discharge, anchoring there removes all the immortal time the design can 
# generate. It excludes deaths during the index admission rather than 
# deaths before day N, so it is not the less-exclusionary design -- it 
# excludes a different, larger, and more Control-weighted set.
#
# SENSITIVITY ANALYSES, same arms, different handling of time:
#   Section 20  landmark-anchored (discards deaths before LANDMARK_DAY; folds
#               post-landmark therapy into Control)
#   Section 21  time-varying exposure (no exclusions, no exposure window)
#   Section 21c side-by-side comparison of the anchors
#
# Sections 22-26 (year-2 binary outcomes) remain TRANSPLANT-anchored and are
# retained for comparability with the earlier version of this analysis. The
# discharge-anchored time-to-event version of the same question is section 19b,
# which is preferred: it uses the full follow-up rather than a fixed window and
# does not require conditioning on survival to day 365.
#
# MULTIPLICITY, stated once here and repeated in the section 27 checklist:
# this script runs well over 40 hypothesis tests and applies no correction to
# any of them. TWO results are primary -- ALL-CAUSE MORTALITY in section 19 and
# GRAFT FAILURE in section 19c.
#
# MULTIPLICITY ACROSS THE TWO IS CONTROLLED BY HIERARCHICAL (FIXED-SEQUENCE)
# TESTING, declared in section 0b (ALPHA_STRATEGY) and evaluated in section 19d:
# mortality is tested first at alpha = 0.05, and graft failure is tested at
# alpha = 0.05 ONLY IF mortality rejects. If mortality does not reject, graft
# failure is descriptive regardless of its p-value. The order is a clinical
# judgement fixed before the run, not a ranking by observed significance.
# Intervals stay at 95% because the full alpha is spent at each step.
#
# ONLY the Steroids vs Control contrast is confirmatory; the CDA arm is
# too small to support one on either endpoint. Every other p-value in
# every other table -- including section 19b, both landmark and time-varying
# sensitivity analyses, every year-2 odds ratio, and all baseline-table
# p-values -- is EXPLORATORY and
# must carry that label in the manuscript. A nominally significant result drawn
# from the exploratory set is hypothesis-generating, not a finding.
#===============================================================================


#===============================================================================
# 0. Libraries
#===============================================================================
required_pkgs <- c(
  "ggplot2", "haven", "tidyr", "dplyr", "knitr", "kableExtra", "stringr",
  "lubridate", "gt", "tibble", "survminer", "survival", "scales",
  "MatchIt", "cobalt", "gtsummary", "webshot2",
  "survey",  # FIX 5: svyglm(), for clustering matched-pair logistic models on subclass
  "smd"      # FIX 5: standardized mean difference for the matched Tables 2/3
)

invisible(lapply(required_pkgs, function(pkg) {
  if (!requireNamespace(pkg, quietly = TRUE)) install.packages(pkg)
  library(pkg, character.only = TRUE)
}))


#===============================================================================
# 0b. Analysis parameters  -- THE ONLY PLACE THESE ARE SET
#-------------------------------------------------------------------------------
# Everything downstream derives from this block. If a number below needs to
# change, change it here and nowhere else; the previous version of this script
# hard-coded 365.25 in five separate places, which is how the landmark and the
# year-2 eligibility rule drifted apart.
#===============================================================================

# --- Exposure ---
# Anti-rejection therapy given in [0, LANDMARK_DAY) defines the arm.
LANDMARK_DAY <- 90

# --- Outcome window ---
# The active analysis window is post-landmark (day 90) through day 730.5;
# it is not the conventional second post-transplant year (days 365-730).
YR2_START        <- 90   # outcome window opens
YR2_END          <- 730.5    # outcome window closes
YR2_ELIGIBLE_DAY <- 90   # must still be under observation here to have an outcome

# --- Ascertainment rule for the FIXED-WINDOW year-2 outcomes (sections 22-26) ---
# The year-2 outcomes are binaries over a fixed calendar span, so an absent
# event only means "no event" if the patient was actually watched for the whole
# span. Requiring survival to YR2_ELIGIBLE_DAY alone does NOT establish that.
#
#   "complete"  (default, correct) -- a patient contributes a 0 only if they
#               were observed through YR2_END. That needs BOTH
#                 (a) enough calendar time to have elapsed since their
#                     transplant, given the data cutoff (administrative), and
#                 (b) their own follow-up clock to reach YR2_END,
#               unless the event itself was observed, in which case the patient
#               is retained regardless -- a known event is information, and
#               dropping it would bias the rate downward.
#   "eligible_only" -- the legacy rule: survival to YR2_ELIGIBLE_DAY and nothing
#               more. Everyone else is scored 0 for a window they were never
#               watched through. Retained ONLY to reproduce the earlier run.
#
# ESTIMAND NOTE: under "complete" the year-2 estimates become "among patients
# observed through day YR2_END", which is a different and narrower population
# than the full eligible cohort. This is a genuine cost. The time-to-event
# analysis in section 19b does not pay it, uses all the follow-up there is, and
# remains the preferred version of the rejection question.
YR2_ASCERTAINMENT <- "complete"   # "complete" | "eligible_only"

if (!YR2_ASCERTAINMENT %in% c("complete", "eligible_only")) {
  stop("YR2_ASCERTAINMENT must be \"complete\" or \"eligible_only\"; got \"",
       YR2_ASCERTAINMENT, "\".")
}

# The dead zone between exposure and outcome. Non-empty only when the landmark
# is earlier than the outcome window, i.e. exactly the situation created by
# moving to 90 days.
GAP_START <- LANDMARK_DAY
GAP_END   <- YR2_START
HAS_GAP   <- GAP_END > GAP_START

# --- Survival horizons, measured FROM THE LANDMARK ---
# At LANDMARK_DAY = 90 these cover post-transplant days 90-455 and 90-820,
# NOT "years 1-2" and "years 1-3" as they did at the 365-day landmark. The
# axis labels and table captions below are built from the constants so they
# cannot go stale.
LM_HORIZON_SHORT <- 365.25
LM_HORIZON_LONG  <- 730.5

# --- Time-varying model horizon, measured from TRANSPLANT ---
TV_HORIZON <- YR2_END

# --- Discharge-anchored design (section 19) ---
# Measured FROM DISCHARGE, not from transplant. Used only by the
# discharge-anchored analysis, which is the design that actually matches an
# exposure known entirely at discharge. See section 19.
DC_HORIZON_SHORT <- 365.25
DC_HORIZON_LONG  <- 730.5

# --- Index-admission treatment timing ---
# The UNOS discharge file records THAT anti-rejection therapy was given during
# the index admission, not WHEN. Day 0 assigns those patients no immortal time
# at all; a positive value would credit them unexposed person-time they may
# not have had. Sensitivity: try DAYS_HOSP_SP_TX / 2.
#
# This matters MORE at a 90-day landmark than it did at 365, because the
# index admission is now a large fraction of the exposure window rather than a
# small one.
INPATIENT_RX_DAY <- 0

# --- Control definition ---
# How a patient qualifies as "observed during the exposure window", and so as
# an eligible Control.
#
#   "interval"  (default, correct for UNOS) -- any index-admission record OR any
#               follow-up form. UNOS follow-up forms report on the INTERVAL
#               since the previous form (or since transplant), which is why
#               TRTREJ6M / TRTREJ1Y exist as interval flags. A patient whose
#               first form is at 6 months HAS been assessed for days 0-90; the
#               assessment is simply recorded later. Excludes only patients
#               with no records at all, which is the real "no data" group.
#   "strict"    -- requires a form DATED before the landmark. Wrong for UNOS:
#               routine follow-up is at 6 months and 1 year, so this discards
#               most of the cohort and collapses the Control arm (which in turn
#               takes every demographic table down with it). Kept only to
#               reproduce that run.
#   "any_year1" -- the original behaviour: any year-1 follow-up form. Differs
#               from "interval" only by excluding patients who have a discharge
#               record but never a follow-up form.
ASSESSMENT_RULE <- "interval"   # "interval" | "strict" | "any_year1"

# --- Which arm definition feeds which section ---
# Both default TRUE so the whole script speaks with one voice. Setting either
# to FALSE reverts that part to the legacy full-year ID vectors, which is
# useful only for reproducing the previous run.
DEMO_TABLES_USE_LANDMARK_ARMS <- TRUE
USE_LANDMARK_ARMS_FOR_YR2     <- TRUE

# Include Dual Therapy as a fourth level in the year-2 models. At a 90-day
# landmark the Dual arm grows substantially, because index-admission
# steroid + ATG/Thymoglobulin combinations now fall inside the exposure
# window. Section 7 prints its N -- check it before leaving this FALSE.
YR2_INCLUDE_DUAL <- FALSE

# --- Rituxan handling in the timing figures ---
# TRUE  -> Rituxan monotherapy becomes its own mutually exclusive arm and
#          "CDA" means Simulect/Thymoglobulin only (bars are disjoint).
# FALSE -> "CDA" keeps its membership; Rituxan is plotted additionally as
#          an overlapping subset (bars double-count).
# In this cohort the Rituxan-monotherapy sub-arm is n = 5, which cannot support
# its own panel or comparison, so FALSE (fold back into CDA) is correct
# here. Check the "Rituxan at landmark" message in section 7 before flipping it.
RITUXAN_AS_OWN_ARM <- FALSE

# --- Follow-up window used to build the year-1 rejection cohort ---
YEAR1_DAYS <- 365.24219

# --- Matching ratio ---
# Controls outnumber every treated arm by two orders of magnitude (Control
# ~82,900 vs CDA ~214), so 1:1 matching discards almost the entire control
# pool and leaves the primary comparison resting on ~24 deaths. Matching k
# controls per treated patient costs nothing -- the controls are there -- and
# buys precision on the control side of the contrast.
#
# Empirically, for CDA vs Control on the discharge anchor:
#   1:1  n=  392  deaths= 24  HR 0.62 (0.27-1.40)   log-CI width 1.63
#   1:2  n=  588  deaths= 40  HR 0.60 (0.28-1.27)                1.50
#   1:4  n=  980  deaths= 65  HR 0.66 (0.33-1.33)                1.39
#   1:8  n= 1761  deaths=101  HR 0.81 (0.41-1.62)                1.38
# Returns stop at 1:4: the interval no longer narrows and the point estimate
# starts drifting, which is the caliper accepting progressively worse matches.
#
# CONSEQUENCE, and it is not optional: at k > 1 the matched controls carry
# UNEQUAL WEIGHTS (a treated patient who found only 2 controls within the
# caliper weights each of them more heavily than one who found 4). Every model
# and every survival curve fitted on a matched set must therefore be weighted.
# Unweighted analysis of a 1:k matched set is biased; at 1:1 it happened not to
# matter, which is why nothing downstream used the weights before.
MATCH_RATIO <- 4

# --- Confounding control: transplant era and transplant centre ---
# Both are omitted from the covariate set in the previous version of this
# script, and both are first-order confounders for a TREATMENT exposure in a
# ten-year multi-centre registry cohort:
#
#   TX_YEAR    Anti-rejection practice, DCD and machine-perfusion uptake, and
#              allocation policy all moved substantially between 2015 and 2025.
#              The arms are not balanced on accrual date -- the matched CDA
#              arm loses far more patients to administrative censoring by day 720
#              than its matched Controls do, which is era imbalance made visible
#              in the risk table.
#   CTR_CODE   Whether a given biopsy is treated with pulse steroids or with
#              thymoglobulin is largely a centre-level practice pattern, not a
#              patient-level decision. Treating 85,863 patients from ~148 centres
#              as independent understates every standard error in the script.
#
# ADJUST_FOR_ERA adds TX_YEAR to the matching and to every adjusted model.
# CLUSTER_BY_CENTRE adds cluster-robust variance on CTR_CODE to the models that
# are not already clustered on a matched pair. Expect CIs to WIDEN; that
# widening is the correct inference, not a loss.
ADJUST_FOR_ERA    <- TRUE
CLUSTER_BY_CENTRE <- TRUE

# --- Centre as CONFOUNDING, not just clustering (section 19e) ---
# CLUSTER_BY_CENTRE above fixes the INFERENCE: patients within a centre are not
# independent, so the standard errors must account for it. It does NOT touch the
# point estimate, and the point estimate is where centre does its damage --
# centre predicts BOTH which anti-rejection drug is given (it is largely an
# institutional protocol, not a patient-level decision) AND the outcome (volume,
# ICU practice, case mix). That is confounding, and a cluster-robust variance
# leaves it entirely intact.
#
# Two designs that DO remove it, both run in section 19e:
#   strata(CENTRE)   -- every centre gets its own baseline hazard, so all
#         comparisons become within-centre. Removes measured AND unmeasured
#         centre-level confounding of baseline risk for the price of one term.
#         Costs no patients: a stratum contributes as long as it holds one event
#         and more than one arm, which does NOT require several treated patients
#         in that centre.
#   exact = "CENTRE" in the match -- compares patients treated differently at
#         the SAME institution. Stronger still, but it can only match a treated
#         patient to a control from their own centre, so it is feasible only
#         where the comparator arm is present in essentially every centre.
#
# Both are SENSITIVITY analyses. The primary models stay as they are, because in
# this cohort the centre-stratified estimates barely move for the confirmatory
# contrast -- which is itself the result worth reporting.
CENTRE_SENSITIVITY <- TRUE

# Column holding the transplant centre. LISTING_CTR_CODE is the alternative;
# in this extract both resolve to 148 distinct centres.
CENTRE_COL <- "CTR_CODE"

# --- MULTIPLICITY: confirmatory testing strategy ---
# There are TWO co-primary endpoints (mortality, section 19; graft failure,
# section 19c). Two tests at alpha = 0.05 give a family-wise error rate of up to
# 1 - 0.95^2 = 9.75% -- less than that here, because the two endpoints are
# positively correlated (death is the competing event for graft failure), but
# the exact value is unknowable without the correlation, which is why the
# conventions below are all conservative bounds.
#
# THIS MUST BE FIXED BEFORE THE NUMBERS ARE READ. Declared here, evaluated
# mechanically in section 19d, and printed in the section 27 checklist, so the
# strategy is a property of the script rather than a sentence written into the
# manuscript afterwards.
#
#   "hierarchical" (in use) -- fixed-sequence testing. Endpoints are tested IN
#         THE DECLARED ORDER, each at the full ALPHA_TOTAL. Testing stops at the
#         first endpoint that fails; everything after it is DESCRIPTIVE ONLY, no
#         matter how small its p-value. Family-wise error is preserved exactly,
#         and the first endpoint keeps full power.
#         The order is a CLINICAL claim and must be defensible as one: mortality
#         is first because it is the harder endpoint, the least dependent on
#         registry ascertainment, and the one a clinician acts on. It is not
#         ordered by which p-value came out smaller.
#   "bonferroni" -- both endpoints tested at ALPHA_TOTAL / 2 (0.025), i.e. 97.5%
#         confidence intervals. More conservative, no ordering required. Kept as
#         the fallback if a reviewer objects to the sequence.
#   "none" -- no multiplicity control. For exploratory runs only; the checklist
#         will say so loudly.
ALPHA_STRATEGY <- "hierarchical"   # "hierarchical" | "bonferroni" | "none"
ALPHA_TOTAL    <- 0.05

if (!ALPHA_STRATEGY %in% c("hierarchical", "bonferroni", "none")) {
  stop("ALPHA_STRATEGY must be \"hierarchical\", \"bonferroni\" or \"none\"; got \"",
       ALPHA_STRATEGY, "\".")
}

# The confirmatory contrast. Steroids vs Control is the ONLY adequately powered
# comparison in this cohort: the CDA arm carries ~198 patients, ~14 deaths
# and ~5 graft failures, so no multiplicity scheme makes it confirmatory. Every
# other arm contrast is exploratory by design, not by outcome.
CONFIRMATORY_ARM <- "Steroids"

# Which model provides the confirmatory p-value for each endpoint. Both
# endpoints use the SAME model type, so the two steps of the sequence are
# comparable.
#   "full_cohort_adjusted" (in use) -- the whole discharge cohort with the full
#         covariate set. Adequate events per parameter on both endpoints, and it
#         does not condition on a caliper match.
#   "matched" -- the propensity-matched estimate instead.
CONFIRMATORY_MODEL <- "full_cohort_adjusted"   # "full_cohort_adjusted" | "matched"

# Confidence level for the reported intervals. Hierarchical testing spends the
# full alpha at each step, so intervals stay at 95%; Bonferroni does not, so its
# intervals must widen to match the alpha actually being spent, or the table
# will show a CI that excludes the null while the test does not reject.
CONF_LEVEL <- if (ALPHA_STRATEGY == "bonferroni") 1 - ALPHA_TOTAL / 2 else 1 - ALPHA_TOTAL

# --- Confounding control: INDUCTION IMMUNOSUPPRESSION ---
# The single most consequential omission from the previous covariate set. The
# induction agent is chosen AT TRANSPLANT, before any rejection episode, and it
# determines BOTH arms of the causal question:
#   - it changes the risk of the event being treated (depletional induction
#     lowers early rejection rates), and
#   - it predicts which drug a centre reaches for when rejection does occur (a
#     unit that gives Thymoglobulin induction is the unit that gives
#     Thymoglobulin for rejection).
# A propensity score that omits it is not balancing the main driver of
# treatment assignment. It is pre-exposure, so including it cannot over-adjust.
#
# INDUCTION_CAT is built in section 4b as a mutually exclusive hierarchy:
#   Depletional > IL-2 receptor antagonist > Other biologic > Steroid only > None
# All five levels come from the discharge form's *_IND columns and are COMPLETE
# in this extract -- "None" is a real category (no induction agent recorded),
# not missing data, so including it costs no complete-case attrition.
ADJUST_FOR_INDUCTION <- TRUE

# --- Confounding control: DONOR QUALITY ---
# The arms were previously matched on RECIPIENT covariates only, which left
# every donor-side difference as residual confounding -- and the donor tables
# (16b) are the evidence that those differences exist. Donor age, DCD status
# and machine perfusion all move early graft dysfunction, which is what a
# biopsy is taken for.
#
# DONOR_PS_VARS is deliberately parsimonious rather than the whole donor file:
# these are the DRI-style components that are (a) complete in this extract and
# (b) plausibly prior to the exposure. Donor labs (AST/ALT/bilirubin/creatinine)
# are excluded as heavily skewed and partly post-procurement; LI_FIBROSIS is
# excluded for missingness (~57%), on the same grounds as HLA mismatch.
ADJUST_FOR_DONOR <- TRUE
DONOR_PS_VARS <- c("AGE_DON", "GENDER_DON", "BMI_DON",
                   "DCD_BIN", "DON_COD_CVA_BIN", "MACHINE_PERF_BIN")

# CONSEQUENCE, and it is not optional: LIVING-DONOR RECIPIENTS HAVE NO
# DECEASED-DONOR RECORD, so every DONOR_PS_VARS column is NA for them and
# complete-case matching DROPS THEM. In this extract that is 4,217 of 85,863
# (4.9%). With ADJUST_FOR_DONOR = TRUE the matched analyses therefore estimate
# an effect among DECEASED-DONOR recipients, and the manuscript must say so.
# Section 14 prints the exact attrition. Setting this FALSE restores the whole
# cohort at the cost of leaving donor quality unbalanced.

# --- Maintenance immunosuppression: DELIBERATELY OFF ---
# Tacrolimus vs cyclosporine, antimetabolite and mTOR use at discharge are
# recorded on the SAME form, for the SAME admission, as the anti-rejection
# therapy that defines the exposure. A patient treated for rejection during the
# index admission frequently has their maintenance regimen changed BECAUSE of
# it. Matching on a variable that is a consequence of the exposure removes part
# of the effect being estimated (over-adjustment) and can induce collider bias.
#
# It is available behind this flag because a reviewer may ask for it as a
# sensitivity analysis; run it, report it as such, and do not make it primary.
ADJUST_FOR_MAINTENANCE <- FALSE

# NOTE ON MATCH YIELD: a richer propensity score is a harder score to match on.
# Expect more treated units to fall outside the 0.2-SD caliper and the matched
# Ns to fall relative to the recipient-only match. That is the price of
# balancing on donor and induction, and the unmatched-by-caliper count printed
# by run_match() is the number to report.

# --- Derived display constants ---
LM_LABEL       <- paste0("day ", round(LANDMARK_DAY), " post-transplant")
EXPOSURE_LABEL <- paste0("first ", round(LANDMARK_DAY), " days post-transplant")
LM_SHORT_END   <- LANDMARK_DAY + LM_HORIZON_SHORT
LM_LONG_END    <- LANDMARK_DAY + LM_HORIZON_LONG

# Bin widths scale with the landmark: 14-day bins across 90 days would give
# six bars.
TIMING_BINWIDTH <- if (LANDMARK_DAY <= 120) 7 else 14
TIMING_BREAK_BY <- if (LANDMARK_DAY <= 120) 15 else 60

# --- Parameter validation ---
# These are all failure modes that otherwise surface hundreds of lines later as
# a cryptic error in an unrelated function.
if (LANDMARK_DAY <= INPATIENT_RX_DAY) {
  stop("LANDMARK_DAY (", LANDMARK_DAY, ") must be GREATER than INPATIENT_RX_DAY (",
       INPATIENT_RX_DAY, ").\n",
       "  The exposure filter is `REJ_TX_DAY < LANDMARK_DAY`, and index-admission therapy is\n",
       "  imputed to day ", INPATIENT_RX_DAY, ". A landmark at or below that value excludes every\n",
       "  treated patient, collapses all arms into Control, and the first Cox model fails with\n",
       "  \"'ref' must be an existing level\".\n",
       "  In this cohort ALL exposure events occur on the imputed day, so any LANDMARK_DAY > ",
       INPATIENT_RX_DAY, "\n",
       "  yields IDENTICAL arms -- 1, 30, 90 and 365 are interchangeable for arm membership.\n",
       "  If the intent was to have no landmark at all, use the discharge-anchored design in\n",
       "  section 19 rather than setting LANDMARK_DAY to 0.")
}
if (LM_HORIZON_SHORT <= 0 || LM_HORIZON_LONG <= 0) {
  stop("LM_HORIZON_SHORT and LM_HORIZON_LONG must both be > 0; a zero-length horizon censors ",
       "every patient at t = 0 and yields an empty survival fit.")
}
if (DC_HORIZON_SHORT <= 0 || DC_HORIZON_LONG <= 0) {
  stop("DC_HORIZON_SHORT and DC_HORIZON_LONG must both be > 0.")
}
if (YR2_END <= YR2_START) {
  stop("YR2_END (", YR2_END, ") must exceed YR2_START (", YR2_START, ").")
}
if (YR2_START < LANDMARK_DAY) {
  stop("YR2_START (", YR2_START, ") is BEFORE the landmark (", LANDMARK_DAY, ").\n",
       "  The outcome window would then overlap the exposure window, so the same treatment\n",
       "  episode could be counted as both exposure and outcome for one patient.")
}
if (YR2_ELIGIBLE_DAY < LANDMARK_DAY) {
  stop("YR2_ELIGIBLE_DAY (", YR2_ELIGIBLE_DAY, ") is before the landmark (", LANDMARK_DAY, ").")
}

message("\n=== Analysis parameters ===")
message("  Exposure window : [0, ", LANDMARK_DAY, ") days post-transplant")
message("  Gap window      : ", if (HAS_GAP) paste0("[", GAP_START, ", ", GAP_END, ") days") else "none",
        "  <- neither exposure nor outcome")
message("  Outcome window  : (", YR2_START, ", ", YR2_END, "] days post-transplant")
message("  Survival window : landmark to day ", round(LM_LONG_END), " post-transplant")

#===============================================================================
# 0c. Output saving  -- every figure as PNG, every table as PNG *and* editable
#===============================================================================
OUTPUT_DIR  <- "~/Local Documents/AOT/Analysis/Output/AMR"   # <- SET THIS
SAVE_OUTPUT <- TRUE
FIG_W <- 9; FIG_H <- 6; FIG_H_SURV <- 8; FIG_DPI <- 300
DF_PNG_MAX_ROWS <- 100   # plain data frames longer than this go to CSV instead

# PNG tables are fine for reading a run; they are NOT submittable. Journals
# require tables as editable text (copy-editing, accessibility, typesetting), so
# every table is ALSO written to tables_editable/ as .docx where the object
# supports it and .csv/.html otherwise. Same index prefix and slug as the PNG,
# so the two directories line up file-for-file.
SAVE_EDITABLE_TABLES <- TRUE

# Output filenames carry a sequential index (001_, 002_, ...) assigned in run
# order. That makes them sort correctly, but it also means ADDING OR REMOVING
# ANY OUTPUT RENUMBERS EVERYTHING AFTER IT. Writing a new run on top of an old
# one therefore leaves orphans: files whose index no longer corresponds to what
# their name says, sitting in the same directory as the current results and
# indistinguishable from them. That is how a superseded hazard-ratio table ends
# up in a manuscript.
#
# So prior output is MOVED (never deleted) into a timestamped archive before a
# run begins, leaving figures/ and tables/ containing exactly one run.
ARCHIVE_PRIOR_OUTPUT <- TRUE

out_path <- normalizePath(path.expand(OUTPUT_DIR), mustWork = FALSE)
if (SAVE_OUTPUT) {
  out_subdirs <- c("figures", "tables", if (SAVE_EDITABLE_TABLES) "tables_editable")

  # NB: the loop variable below is `.osd`, not `sd`. A bare `sd` here assigns a
  # character string over stats::sd in the global environment, and gtsummary
  # then fails to resolve the "{sd}" in its statistic templates with the
  # thoroughly unhelpful "Value must be a named list of functions".
  if (ARCHIVE_PRIOR_OUTPUT) {
    prior <- unlist(lapply(out_subdirs, function(.osd) {
      list.files(file.path(out_path, .osd), full.names = TRUE, no.. = TRUE)
    }))
    prior <- prior[!grepl("(^|/)\\.DS_Store$", prior)]

    if (length(prior)) {
      stamp    <- format(Sys.time(), "%Y%m%d_%H%M%S")
      arch_dir <- file.path(out_path, paste0("archive_", stamp))
      for (.osd in out_subdirs) dir.create(file.path(arch_dir, .osd), recursive = TRUE,
                                           showWarnings = FALSE)
      moved <- vapply(prior, function(f) {
        file.rename(f, file.path(arch_dir, basename(dirname(f)), basename(f)))
      }, logical(1))
      message("Archived ", sum(moved), " file(s) from the previous run to: ", arch_dir)
      if (any(!moved)) warning("Could not archive ", sum(!moved), " prior output file(s); ",
                               "they remain in place and may be stale.")
    }
  }

  for (.osd in out_subdirs) dir.create(file.path(out_path, .osd), recursive = TRUE,
                                       showWarnings = FALSE)
  rm(.osd)
  message("Saving output to: ", out_path)
}

# flextable/officer are only needed for the .docx export, so they are checked
# lazily rather than added to required_pkgs -- a missing package downgrades the
# export to .html/.csv instead of triggering an install mid-run.
.HAS_FLEXTABLE <- requireNamespace("flextable", quietly = TRUE)
if (SAVE_EDITABLE_TABLES && !.HAS_FLEXTABLE) {
  message("flextable not installed: editable tables will be written as .html/.csv ",
          "rather than .docx. install.packages('flextable') for Word output.")
}

.out_counter <- 0L

# Counter prefix so files sort in run order rather than alphabetically.
.out_file <- function(name, ext, subdir) {
  .out_counter <<- .out_counter + 1L
  slug <- gsub("[^A-Za-z0-9]+", "_", name)
  slug <- gsub("^_|_$", "", substr(slug, 1, 80))
  file.path(out_path, subdir, sprintf("%03d_%s.%s", .out_counter, slug, ext))
}

# Companion path in tables_editable/ carrying the SAME index and slug as the
# PNG that was just written, so table 013 is 013 in both directories.
.editable_path <- function(png_path, ext) {
  file.path(out_path, "tables_editable",
            sub("\\.png$", paste0(".", ext), basename(png_path)))
}

# Editable writer. Everything is wrapped in try(): an export failure must not
# take down a run that has already produced the PNG.
.save_editable <- function(x, png_path) {
  if (!SAVE_OUTPUT || !SAVE_EDITABLE_TABLES) return(invisible(NULL))
  try({
    if (inherits(x, "gtsummary")) {
      if (.HAS_FLEXTABLE) {
        flextable::save_as_docx(gtsummary::as_flex_table(x),
                                path = .editable_path(png_path, "docx"))
      } else {
        gt::gtsave(gtsummary::as_gt(x), .editable_path(png_path, "html"))
      }

    } else if (inherits(x, "gt_tbl")) {
      # gt can emit .docx directly in recent versions; fall back to .html when
      # it cannot, which every gt version supports.
      ok <- tryCatch({ gt::gtsave(x, .editable_path(png_path, "docx")); TRUE },
                     error = function(e) FALSE)
      if (!ok) gt::gtsave(x, .editable_path(png_path, "html"))

    } else if (inherits(x, "knitr_kable")) {
      writeLines(as.character(x), .editable_path(png_path, "html"))

    } else if (is.data.frame(x)) {
      write.csv(x, .editable_path(png_path, "csv"), row.names = FALSE)
    }
  }, silent = TRUE)
  invisible(NULL)
}

# keep(x, "name") prints x exactly as print(x) would AND writes a PNG (plus, for
# tables, an editable companion in tables_editable/).
# Dispatches on class: ggplot, ggsurvplot, gt, gtsummary, kable, data.frame.
keep <- function(x, name) {
  if (is.null(x)) return(invisible(NULL))
  print(x)
  if (!SAVE_OUTPUT) return(invisible(x))

  try({
    if (inherits(x, "ggsurvplot")) {
      # NOT ggsave: a ggsurvplot is a list (curve + risk table), so ggsave
      # writes only the last-drawn ggplot and silently drops the risk table.
      f <- .out_file(name, "png", "figures")
      png(f, width = FIG_W, height = FIG_H_SURV, units = "in", res = FIG_DPI)
      print(x); dev.off()

    } else if (inherits(x, "gg") || inherits(x, "ggplot")) {
      ggsave(.out_file(name, "png", "figures"), plot = x,
             width = FIG_W, height = FIG_H, dpi = FIG_DPI, bg = "white")

    } else if (inherits(x, "gt_tbl")) {
      f <- .out_file(name, "png", "tables")
      gt::gtsave(x, f)
      .save_editable(x, f)

    } else if (inherits(x, "gtsummary")) {
      f <- .out_file(name, "png", "tables")
      gt::gtsave(gtsummary::as_gt(x), f)
      .save_editable(x, f)

    } else if (inherits(x, "knitr_kable")) {
      f <- .out_file(name, "png", "tables")
      kableExtra::save_kable(x, f)
      .save_editable(x, f)

    } else if (is.data.frame(x)) {
      if (nrow(x) <= DF_PNG_MAX_ROWS) {
        f <- .out_file(name, "png", "tables")
        gt::gtsave(gt::gt(x), f)
        .save_editable(x, f)
      } else {
        message("keep(): ", nrow(x), " rows is too many for a PNG -- writing CSV: ", name)
        write.csv(x, .out_file(name, "csv", "tables"), row.names = FALSE)
      }

    } else {
      message("keep(): no save method for class ", paste(class(x), collapse = "/"),
              " -- printed only: ", name)
    }
  }, silent = FALSE)

  invisible(x)
}

