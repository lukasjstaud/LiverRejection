# the colliding, non-key columns to "TX_DATE.x"/"TX_DATE.y" etc. -- so there
# is then no plain "TX_DATE" column left for arrange()/mutate() to find.
# Dropping any pre-existing copies first (any_of() so this is a no-op if they
# aren't present) guarantees the join produces one clean, unsuffixed copy of
# each from the master file.
df_immuno_induc <- df_immuno_induc |>
  semi_join(df_liver_data_filtered, by = "TRR_ID_CODE") |>
  mutate(NUM_ANTI_REJ_RXED = rowSums(across(all_of(COLS_TO_CHECK)) == 1, na.rm = TRUE)) |>
  select(-any_of(c("TX_DATE", "DISCHARGE_DATE", "DEATH_DATE"))) |>
  left_join(df_liver_data_filtered %>%
              select(TRR_ID_CODE, TX_DATE, DISCHARGE_DATE, DEATH_DATE), by = "TRR_ID_CODE") |>
  arrange(TX_DATE) |>
  mutate(
    DISCHARGE_DATE = as.Date(DISCHARGE_DATE),
    TX_DATE = as.Date(TX_DATE)
  ) %>%
  mutate(DAYS_HOSP_SP_TX = time_length(interval(TX_DATE, DISCHARGE_DATE), "days"))

# Length of stay now carries analytic weight, not just descriptive weight: it
# is what decides whether an index admission covers the whole 90-day exposure
# window (see the Control definition in section 7). Worth eyeballing.
message("Index admission length of stay (days):")
print(summary(df_immuno_induc$DAYS_HOSP_SP_TX))
message("  admissions extending past the landmark (day ", LANDMARK_DAY, "): ",
        sum(df_immuno_induc$DAYS_HOSP_SP_TX >= LANDMARK_DAY, na.rm = TRUE))


#===============================================================================
# 4b. INDUCTION AND MAINTENANCE IMMUNOSUPPRESSION  (propensity-score covariates)
#-------------------------------------------------------------------------------
# The same discharge file that records anti-rejection therapy (*_ANTIREJ) also
# records induction (*_IND) and maintenance (*_MAINT) agents. The previous
# version of this script read only the _ANTIREJ columns, which is why induction
# -- the strongest single predictor of both rejection risk and of which drug is
# used to treat it -- was absent from every model.
#
# INDUCTION IS PRE-EXPOSURE. It is given at transplant, before any rejection
# episode, so it is a confounder in the strict sense and belongs in the
# propensity score. MAINTENANCE IS NOT: it is recorded on the same form for the
# same admission and is routinely changed BECAUSE of a rejection episode, so it
# is at least partly a consequence of the exposure. See ADJUST_FOR_MAINTENANCE
# in section 0b for why it is off by default.
#===============================================================================

IND_TAIL   <- "_IND"
MAINT_TAIL <- "_MAINT"

# Mutually exclusive induction hierarchy, ordered by immunologic potency. A
# patient given Thymoglobulin AND Simulect AND steroids is Depletional: the
# strongest agent is the one that characterises the regimen.
IND_DEPLETIONAL <- paste0(c("THYMOGLOBULIN", "ATGAM", "CAMPATH", "ALG",
                            "NRATGNRATS", "OKT3"), IND_TAIL)
IND_IL2RA       <- paste0(c("SIMULECT", "ZENAPAX"), IND_TAIL)
IND_OTHER_BIO   <- paste0(c("RITUXAN"), IND_TAIL)
IND_STEROID     <- paste0(c("STEROIDS"), IND_TAIL)

# Maintenance classes, used only when ADJUST_FOR_MAINTENANCE is TRUE.
MAINT_TAC     <- paste0(c("PROGRAF", "GENERICTACROLIMUS", "ENVARSUSXR", "ASTAGRAFXL"), MAINT_TAIL)
MAINT_CSA     <- paste0(c("NEORAL", "SANDIMMUNE", "GENGRAF", "SANGCYA",
                          "GENERICCYCLOSPORIN", "CYCLOSPORIN", "EON"), MAINT_TAIL)
MAINT_ANTIMET <- paste0(c("CELLCEPT", "MYFORTIC", "GENERICMMF", "GENERICMYFORTIC",
                          "IMURAN"), MAINT_TAIL)
MAINT_MTOR    <- paste0(c("RAPAMUNE", "ZORTRESS", "GENERICSIROLIMUS"), MAINT_TAIL)
MAINT_STER    <- paste0(c("STEROIDS"), MAINT_TAIL)

# any_of() throughout: a drug absent from this extract is skipped rather than
# erroring, exactly as with the _ANTIREJ columns.
any_flag <- function(df, cols) {
  cols <- intersect(cols, names(df))
  if (!length(cols)) return(rep(FALSE, nrow(df)))
  as.logical(rowSums(sapply(cols, function(cn) {
    v <- suppressWarnings(as.numeric(df[[cn]]))
    !is.na(v) & v == 1
  }), na.rm = TRUE) > 0)
}

induction_lookup <- df_immuno_induc %>%
  distinct(TRR_ID_CODE, .keep_all = TRUE)

induction_lookup <- induction_lookup %>%
  mutate(
    .dep   = any_flag(induction_lookup, IND_DEPLETIONAL),
    .il2   = any_flag(induction_lookup, IND_IL2RA),
    .obio  = any_flag(induction_lookup, IND_OTHER_BIO),
    .ster  = any_flag(induction_lookup, IND_STEROID),
    INDUCTION_CAT = factor(
      case_when(
        .dep  ~ "Depletional",
        .il2  ~ "IL-2 receptor antagonist",
        .obio ~ "Other biologic",
        .ster ~ "Steroid only",
        TRUE  ~ "None recorded"
      ),
      levels = c("None recorded", "Steroid only", "IL-2 receptor antagonist",
                 "Depletional", "Other biologic")
    ),
    MAINT_TAC_BIN     = as.integer(any_flag(induction_lookup, MAINT_TAC)),
    MAINT_CSA_BIN     = as.integer(any_flag(induction_lookup, MAINT_CSA)),
    MAINT_ANTIMET_BIN = as.integer(any_flag(induction_lookup, MAINT_ANTIMET)),
    MAINT_MTOR_BIN    = as.integer(any_flag(induction_lookup, MAINT_MTOR)),
    MAINT_STER_BIN    = as.integer(any_flag(induction_lookup, MAINT_STER))
  ) %>%
  select(TRR_ID_CODE, INDUCTION_CAT, ends_with("_BIN"))

# Reference level is "None recorded" because it is the largest single category
# after steroid-only and is the natural "no biologic induction" comparator.
message("\nInduction regimen at transplant (from the discharge form):")
print(table(induction_lookup$INDUCTION_CAT, useNA = "ifany"))
message("  patients in cohort with NO discharge record (no induction data): ",
        length(setdiff(tx_ids_to_keep, induction_lookup$TRR_ID_CODE)))

# A level with almost no one in it cannot be balanced and will destabilise the
# propensity model rather than improve it. Collapse it into "Other biologic"
# rather than carrying a 33-patient dummy through every match.
ind_n <- table(induction_lookup$INDUCTION_CAT)
tiny_ind <- names(ind_n)[ind_n > 0 & ind_n < 50 &
                           !names(ind_n) %in% c("None recorded", "Other biologic")]
if (length(tiny_ind)) {
  message("  collapsing induction level(s) with n < 50 into 'Other biologic': ",
          paste(tiny_ind, collapse = ", "))
  # Base-R level merge (assigning duplicate labels collapses those levels), so
  # this does not add a forcats dependency to required_pkgs.
  .lv <- levels(induction_lookup$INDUCTION_CAT)
  .lv[.lv %in% tiny_ind] <- "Other biologic"
  levels(induction_lookup$INDUCTION_CAT) <- .lv
  rm(.lv)
}
induction_lookup <- induction_lookup %>%
  mutate(INDUCTION_CAT = droplevels(INDUCTION_CAT))

if (ADJUST_FOR_MAINTENANCE) {
  message("Maintenance immunosuppression at discharge (n with each class):")
  print(colSums(induction_lookup %>% select(ends_with("_BIN")), na.rm = TRUE))
  message("  WARNING: maintenance is concurrent with the exposure and is partly a ",
          "CONSEQUENCE of it. Report any model that includes it as a sensitivity ",
          "analysis, never as primary. See ADJUST_FOR_MAINTENANCE in section 0b.")
}


#===============================================================================
# 5. Year-1 rejection vs. no-rejection cohorts (source frames for everything)
#-------------------------------------------------------------------------------
# These frames are landmark-agnostic. They record WHO was treated and WHEN
# across all of year 1; section 7 is what applies the 90-day cut.
#===============================================================================
# Patients treated for rejection during the index admission.
# distinct() guards against a duplicated discharge record silently
# double-counting a patient later on.
pat_rej_array_dis <- df_immuno_induc %>%
  filter(NUM_ANTI_REJ_RXED >= 1) %>%
  mutate(DISCHARGE_DATE = as.Date(DISCHARGE_DATE)) %>%
  select(TRR_ID_CODE, TX_DATE, DISCHARGE_DATE, DAYS_HOSP_SP_TX,
         NUM_ANTI_REJ_RXED, all_of(COLS_TO_CHECK)) %>%
  distinct(TRR_ID_CODE, .keep_all = TRUE)

inpatient_reject_ID_vect <- pat_rej_array_dis |> pull(TRR_ID_CODE)

# First instance of rejection therapy recorded at a follow-up visit within
# year 1 (patients already flagged as inpatient rejectors get their running
# count bumped by one so they aren't double-counted as a "first" event here).
pat_rej_array_fol <- df_immuno_fol_calc %>%
  mutate(
    REJECT_RUNNING_COUNT = if_else(
      TRR_ID_CODE %in% inpatient_reject_ID_vect,
      REJECT_RUNNING_COUNT + 1,
      REJECT_RUNNING_COUNT
    )
  ) |>
  filter(REJECT_RUNNING_COUNT == 1, NUM_ANTI_REJ_RXED >= 1) %>%
  group_by(TRR_ID_CODE) %>%
  slice_min(order_by = PX_STAT_DATE_FOL, n = 1, with_ties = FALSE) %>%
  ungroup() %>%
  select(
    TRR_ID_CODE, TRR_FOL_ID_CODE, TX_DATE, DISCHARGE_DATE, PX_STAT_DATE_FOL,
    FOL_DATE_DAYS_DELTA, REJECT_RUNNING_COUNT, NUM_ANTI_REJ_RXED,
    all_of(COLS_TO_CHECK)
  ) %>%
  mutate(DISCHARGE_DATE = as.Date(DISCHARGE_DATE))

# Combine inpatient + follow-up rejection events into one array.
# source is coerced to integer so slice_min(source) elsewhere orders it
# numerically (1 = discharge event, 2 = follow-up event).
pat_rej_array <- bind_rows(pat_rej_array_dis, pat_rej_array_fol, .id = "source") %>%
  mutate(source = as.integer(source))

# Rejector IDs, defined once from the combined array, and used to define the
# year-1 control cohort BY EXCLUSION. A row-wise REJECT_RUNNING_COUNT == 0
# filter alone would retain rows from patients who were rejection-free early
# but treated later in year 1.
rejector_ids <- unique(pat_rej_array$TRR_ID_CODE)

pat_ctrl_array <- df_immuno_fol_calc %>%
  filter(!TRR_ID_CODE %in% rejector_ids) %>%
  filter(REJECT_RUNNING_COUNT == 0) %>%   # redundant given the exclusion above; belt-and-braces
  select(
    TRR_ID_CODE, TRR_FOL_ID_CODE, TX_DATE, DISCHARGE_DATE, PX_STAT_DATE_FOL,
    FOL_DATE_DAYS_DELTA, REJECT_RUNNING_COUNT, NUM_ANTI_REJ_RXED, all_of(COLS_TO_CHECK)
  ) %>%
  group_by(TRR_ID_CODE) %>%
  slice_max(order_by = PX_STAT_DATE_FOL, n = 1, with_ties = FALSE) %>%
  ungroup()

# Patients with NO follow-up rows at all never enter df_immuno_fol and are
# therefore neither cases nor controls. If that group is large, "no rejection"
# is partly "no data".
message("Patients in cohort with no year-1 follow-up rows: ",
        length(setdiff(tx_ids_to_keep,
                       union(rejector_ids, pat_ctrl_array$TRR_ID_CODE))))


#===============================================================================
# 6. LEGACY full-year treatment-arm ID vectors
#-------------------------------------------------------------------------------
# These are the arms the previous version of the script used everywhere. They
# are retained for exactly two purposes: the reconciliation report in section
# 7, and reproducing the old run via the DEMO_TABLES_USE_LANDMARK_ARMS /
# USE_LANDMARK_ARMS_FOR_YR2 switches.
#
# DO NOT use them to define an analysis arm directly. They classify a patient
# from whichever pat_rej_array row happened to match, with no deduplication
# and no notion of the landmark, so a patient treated with steroids inpatient
# and Thymoglobulin at month 8 can appear in two vectors at once.
#===============================================================================
monotherapy_reject <- pat_rej_array |> filter(NUM_ANTI_REJ_RXED < 2)

rituxan_id_all_vect <- monotherapy_reject %>%
  filter(RITUXAN_ANTIREJ == 1) %>% pull(TRR_ID_CODE)

steroid_id_all_vect <- monotherapy_reject %>%
  filter(STEROIDS_ANTIREJ == 1) %>% pull(TRR_ID_CODE)

thymo_id_all_vect <- monotherapy_reject %>%
  filter(THYMOGLOBULIN_ANTIREJ == 1) %>% pull(TRR_ID_CODE)

simulect_id_all_vect <- monotherapy_reject %>%
  filter(SIMULECT_ANTIREJ == 1) %>% pull(TRR_ID_CODE)

dual_therapy_id_vect <- pat_rej_array %>%
  filter(STEROIDS_ANTIREJ == 1) %>%
  filter(SIMULECT_ANTIREJ == 1 | THYMOGLOBULIN_ANTIREJ == 1 | RITUXAN_ANTIREJ == 1) |>
  pull(TRR_ID_CODE)

rituxan_any_id_vect <- pat_rej_array %>%
  filter(RITUXAN_ANTIREJ == 1) %>% pull(TRR_ID_CODE)

arm2_ID_vect <- unique(c(simulect_id_all_vect, thymo_id_all_vect, rituxan_id_all_vect))

ctrl_id_vect <- pat_ctrl_array %>% pull(TRR_ID_CODE)

stopifnot(length(intersect(arm2_ID_vect, ctrl_id_vect)) == 0)
stopifnot(length(intersect(steroid_id_all_vect, ctrl_id_vect)) == 0)

# Legacy arms expressed in the same one-row-per-patient shape as the landmark
# assignment, so the two can be swapped by a switch downstream.
legacy_arm_lookup <- tibble(TRR_ID_CODE = unique(c(rejector_ids, ctrl_id_vect))) %>%
  mutate(ARM = case_when(
    TRR_ID_CODE %in% dual_therapy_id_vect ~ "Dual Therapy",
    TRR_ID_CODE %in% steroid_id_all_vect  ~ "Steroids",
    TRR_ID_CODE %in% arm2_ID_vect         ~ "CDA",
    TRR_ID_CODE %in% ctrl_id_vect         ~ "Control",
    TRUE                                  ~ "Other Rejection"
  ))


#===============================================================================
# 7. TREATMENT TIMING AND LANDMARK ARM ASSIGNMENT  (moved up from section 17)
#-------------------------------------------------------------------------------
# This section is the hinge of the whole script. Every arm used anywhere below
# -- demographic tables, propensity matching, survival, year-2 outcomes --
# comes from arm_at_landmark, so there is exactly one definition of "Steroid
# group" in the file.
#
# It used to live inside the survival section, which is why the year-2
# sections and the demographic tables had grown their own, different, arm
# definitions from the section-6 vectors.
#===============================================================================

# --- Step 1: day of FIRST anti-rejection treatment, per patient ---
# Timing sources and their caveats:
#   source == 1 (index admission) -> INPATIENT_RX_DAY (0). The discharge file
#     records THAT therapy was given, not WHEN.
#   source == 2 (outpatient) -> FOL_DATE_DAYS_DELTA, the date of the VISIT at
#     which the drug was recorded. The treatment happened at some point since
#     the previous visit, so this is an UPPER BOUND on the true treatment day.
#
# At a 90-day landmark that upper bound has teeth. A patient treated on day 80
# but not seen until their day-100 visit is recorded at day 100 and lands in
# Control. Misclassification therefore runs one way only: from treated into
# Control, never the reverse. It biases treated-vs-Control contrasts toward
# the null, in the same direction as the gap contamination below.
pat_rej_first <- pat_rej_array %>%
  group_by(TRR_ID_CODE) %>%
  slice_min(order_by = source, n = 1, with_ties = FALSE) %>%
  ungroup() %>%
  mutate(
    REJ_TX_DAY = if_else(source == 1L,
                         as.numeric(INPATIENT_RX_DAY),
                         as.numeric(FOL_DATE_DAYS_DELTA))
  )

message("Rejectors with unusable REJ_TX_DAY (should be 0): ",
        sum(is.na(pat_rej_first$REJ_TX_DAY)))
message("Distribution of first anti-rejection treatment day (all year-1 rejectors):")
print(summary(pat_rej_first$REJ_TX_DAY))
message("  treated before landmark (day ", LANDMARK_DAY, "): ",
        sum(pat_rej_first$REJ_TX_DAY < LANDMARK_DAY, na.rm = TRUE),
        " of ", nrow(pat_rej_first),
        sprintf(" (%.1f%%)", 100 * mean(pat_rej_first$REJ_TX_DAY < LANDMARK_DAY, na.rm = TRUE)))

# --- Step 2: arm assignment AS OF a given landmark ---
# Arms are mutually exclusive and derived from the patient's FIRST
# anti-rejection event only, which is the classification coherent with a
# time-to-event design.
#
# THE CONTROL DEFINITION IS THE SUBSTANTIVE CHANGE AT 90 DAYS. Two issues that
# did not exist at a 365-day landmark:
#
#   (a) CONTAMINATION BY DESIGN. A patient first treated on day 200 is not in
#       treated_before and therefore becomes a Control. That is the correct
#       treat-as-of-landmark semantics, but it means the Control arm is no
#       longer "never treated" -- it is "not treated in the first 90 days".
#       Quantified in Step 4 below.
#
#   (b) ASSESSMENT AND EXPOSURE WINDOWS CAME APART. The old code took
#       assessed_ids from any visit in year 1. At a 365-day landmark the
#       assessment and exposure windows were the same interval, so this was
#       invisible. At 90 days they separate -- but the fix is NOT to require a
#       form dated before day 90. UNOS follow-up forms report on the INTERVAL
#       since the previous form (or since transplant), so a patient whose first
#       form is at 6 months has been assessed for days 0-90; the assessment is
#       simply recorded later. ASSESSMENT_RULE = "interval" is therefore the
#       correct setting for UNOS; "strict" is retained only to reproduce the
#       earlier, wrong run, which collapsed the Control arm and with it every
#       demographic table.
assign_arm_at_landmark <- function(landmark_day,
                                   assessment_rule = ASSESSMENT_RULE,
                                   pat_rej_first_src = pat_rej_first,
                                   fol_calc_src = df_immuno_fol_calc) {

  treated_before <- pat_rej_first_src %>%
    filter(!is.na(REJ_TX_DAY), REJ_TX_DAY < landmark_day)
  
  mono <- treated_before %>% filter(NUM_ANTI_REJ_RXED < 2)
  
  steroid_lm <- mono %>% filter(STEROIDS_ANTIREJ == 1) %>% pull(TRR_ID_CODE)
  
  combined_lm <- mono %>%
    filter(SIMULECT_ANTIREJ == 1 | THYMOGLOBULIN_ANTIREJ == 1 | RITUXAN_ANTIREJ == 1) %>%
    pull(TRR_ID_CODE)
  
  dual_lm <- treated_before %>%
    filter(STEROIDS_ANTIREJ == 1,
           SIMULECT_ANTIREJ == 1 | THYMOGLOBULIN_ANTIREJ == 1 | RITUXAN_ANTIREJ == 1) %>%
    pull(TRR_ID_CODE)
  
  assessed_ids <- switch(
    assessment_rule,
    
    # Any record at all: the discharge record documents from day 0, and the
    # first follow-up form reports back to transplant.
    "interval" = unique(c(df_immuno_induc$TRR_ID_CODE,
                          fol_calc_src$TRR_ID_CODE)),

    # Form dated inside the window, or still admitted at the landmark.
    "strict" = unique(c(
      fol_calc_src %>%
        filter(FOL_DATE_DAYS_DELTA < landmark_day) %>% pull(TRR_ID_CODE),
      df_immuno_induc %>%
        filter(!is.na(DAYS_HOSP_SP_TX), DAYS_HOSP_SP_TX >= landmark_day) %>%
        pull(TRR_ID_CODE)
    )),

    "any_year1" = unique(fol_calc_src$TRR_ID_CODE),
    
    stop("unknown ASSESSMENT_RULE: ", assessment_rule)
  )
  
  control_lm <- setdiff(assessed_ids, treated_before$TRR_ID_CODE)
  
  tibble(TRR_ID_CODE = unique(c(treated_before$TRR_ID_CODE, control_lm))) %>%
    mutate(ARM = case_when(
      TRR_ID_CODE %in% dual_lm     ~ "Dual Therapy",
      TRR_ID_CODE %in% steroid_lm  ~ "Steroids",
      TRR_ID_CODE %in% combined_lm ~ "CDA",
      TRR_ID_CODE %in% control_lm  ~ "Control",
      TRUE                         ~ "Other Rejection"
    ))
}

arm_at_landmark <- assign_arm_at_landmark(LANDMARK_DAY)

ARM_LEVELS <- c("Control", "Steroids", "CDA", "Dual Therapy", "Other Rejection")
arm_at_landmark <- arm_at_landmark %>%
  mutate(ARM = factor(ARM, levels = ARM_LEVELS))

message("\nArm sizes at landmark day ", LANDMARK_DAY, ":")
print(table(arm_at_landmark$ARM, useNA = "ifany"))

# Catch a collapsed arm here, where the cause is visible, rather than 800 lines
# later inside relevel() where it is not.
arm_n <- table(arm_at_landmark$ARM)
if (sum(arm_n[setdiff(ARM_LEVELS, "Control")]) == 0) {
  stop("EVERY treated arm is empty -- all ", sum(arm_n), " patients are Control.\n",
       "  Almost always this means LANDMARK_DAY (", LANDMARK_DAY, ") is at or below the day ",
       "exposure events are recorded.\n",
       "  Exposure filter: REJ_TX_DAY < LANDMARK_DAY. Observed REJ_TX_DAY range: ",
       paste(range(pat_rej_first$REJ_TX_DAY, na.rm = TRUE), collapse = " to "), ".\n",
       "  Raise LANDMARK_DAY above ", min(pat_rej_first$REJ_TX_DAY, na.rm = TRUE), ".")
}
small_arms <- names(arm_n)[arm_n > 0 & arm_n < 10 & names(arm_n) != "Control"]
if (length(small_arms)) {
  warning("Arm(s) with fewer than 10 patients: ", paste(small_arms, collapse = ", "),
          ". Comparisons involving them will be unstable or skipped.")
}

# --- Step 3: how much the assessment rule matters ---
# "strict" is shown only to document how the Control arm collapses under it.
ctrl_by_rule <- vapply(
  c("interval", "any_year1", "strict"),
  function(r) sum(assign_arm_at_landmark(LANDMARK_DAY, r)$ARM == "Control"),
  numeric(1)
)
message("\nControl arm size by assessment rule at day ", LANDMARK_DAY, ":")
print(ctrl_by_rule)
message("  in use: ", ASSESSMENT_RULE)
if (ctrl_by_rule[["strict"]] < 0.5 * ctrl_by_rule[["interval"]]) {
  message("  As expected: routine UNOS follow-up is at 6mo/1yr, so requiring a form DATED",
          " before day ", LANDMARK_DAY, " discards most Controls. Do not use 'strict'.")
}

n_ctrl_strict <- ctrl_by_rule[["strict"]]   # names kept for the section 27 checklist
n_ctrl_loose  <- ctrl_by_rule[["any_year1"]]

# Under "interval", a patient with a discharge record but NO follow-up form
# still counts as an observed Control. Their "no rejection" rests entirely on
# the index admission, and they will also have no year-2 visit -- where the
# code treats "no visit" as "no rejection". That is the same assumption
# applied twice to the same patients, so it is worth knowing how many there
# are before quoting any Control-arm rate.
ctrl_now <- assign_arm_at_landmark(LANDMARK_DAY) %>%
  filter(ARM == "Control") %>% pull(TRR_ID_CODE)
ctrl_discharge_only <- setdiff(ctrl_now, unique(df_immuno_fol_calc$TRR_ID_CODE))
message("  Controls resting on a discharge record only (no follow-up form): ",
        length(ctrl_discharge_only), " of ", length(ctrl_now),
        sprintf(" (%.1f%%)", 100 * length(ctrl_discharge_only) / max(length(ctrl_now), 1)))

# Patients in the cohort who are in NO arm. Under ASSESSMENT_RULE = "interval"
# this means NO RECORDS AT ALL -- neither a discharge record nor any follow-up
# form -- which is the genuine "no data" group rather than a artefact of form
# timing. They are excluded from every analysis below.
unassigned_ids <- setdiff(tx_ids_to_keep, arm_at_landmark$TRR_ID_CODE)
message("  patients excluded entirely (no records of any kind): ",
        length(unassigned_ids), " of ", length(tx_ids_to_keep),
        sprintf(" (%.1f%%)", 100 * length(unassigned_ids) / max(length(tx_ids_to_keep), 1)))

# --- Step 4: gap contamination -- the headline limitation of this design ---
# How many day-90 "Controls" were actually treated later in year 1? At a
# 365-day landmark this is zero by construction. At 90 days it is the price of
# the shorter exposure window and it attenuates every treated-vs-Control
# contrast toward the null.
control_at_lm <- arm_at_landmark %>% filter(ARM == "Control") %>% pull(TRR_ID_CODE)

gap_contamination <- if (HAS_GAP) {
  pat_rej_first %>%
    filter(TRR_ID_CODE %in% control_at_lm,
           !is.na(REJ_TX_DAY), REJ_TX_DAY >= GAP_START, REJ_TX_DAY < GAP_END)
} else {
  pat_rej_first[0, ]
}

message(sprintf(
  "\nGAP CONTAMINATION: Controls at day %g later treated in day %g-%g: %d of %d (%.1f%%)",
  LANDMARK_DAY, GAP_START, GAP_END,
  nrow(gap_contamination), length(control_at_lm),
  100 * nrow(gap_contamination) / max(length(control_at_lm), 1)))

# Sensitivity handle: a "clean" comparator excluding gap-treated Controls.
# Use ALONGSIDE the main arms, never instead of them -- excluding patients on
# the basis of a post-landmark event reintroduces exactly the selection the
# landmark design exists to remove.
arm_at_landmark_clean_ctrl <- arm_at_landmark %>%
  filter(!TRR_ID_CODE %in% gap_contamination$TRR_ID_CODE)

# --- Step 5: reconciliation against the legacy full-year vectors ---
# These will NOT agree closely any more, and that is the point: the difference
# is the population of patients first treated between day 90 and day 365, who
# the legacy vectors call treated and the landmark design calls Control.
reconcile_arm <- function(arm_name, old_vect) {
  new_vect <- arm_at_landmark %>% filter(ARM == arm_name) %>% pull(TRR_ID_CODE)
  message(sprintf("  %-14s landmark n=%5d | legacy n=%5d | landmark-only=%4d | legacy-only=%4d",
                  arm_name, length(new_vect), length(old_vect),
                  length(setdiff(new_vect, old_vect)),
