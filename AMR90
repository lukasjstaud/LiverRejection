#===============================================================================
# 21. SENSITIVITY ANALYSIS: Time-Varying Exposure Cox Model
#-------------------------------------------------------------------------------
# The landmark design removes immortal time bias by DISCARDING everyone who
# died before the landmark, and it forces treatment after the landmark to count
# as non-exposure. The time-varying (Mantel-Byar) approach removes the same
# bias without doing either: every patient starts untreated at transplant and
# switches state on the day they are first treated, whenever that is.
#
# THIS MODEL IS MORE IMPORTANT AT A 90-DAY LANDMARK THAN IT WAS AT 365. It is
# the analysis that does NOT throw the day 90-365 treatments into the Control
# arm, so comparing it against the landmark HRs directly bounds how much the
# gap contamination is costing.
#
# Counting-process (start, stop] format, so each patient may occupy more than
# one row. No cluster/robust variance is needed: the segments from a single
# patient are non-overlapping in time and the partial likelihood handles them.
#-------------------------------------------------------------------------------
# FIX 1 (year-1 truncation): assign_arm_at_landmark(Inf) below is supposed to
# use treatment timing over ALL available follow-up, not just year 1. But its
# defaults (pat_rej_first, df_immuno_fol_calc) are built from df_immuno_fol,
# which is deliberately capped at FOL_DATE_DAYS_DELTA < YEAR1_DAYS (section 4).
# A patient first treated on, say, day 400 has no row in that capped frame, so
# REJ_TX_DAY is NA for them and they are scored untreated for the rest of
# follow-up -- including the time after day 400 when they were actually on
# treatment. This rebuilds the same pipeline (sections 4-7) from the
# uncapped df_immuno_fol_read, capped at TV_HORIZON instead of YEAR1_DAYS, so
# late-starting patients are correctly captured. Only this Mantel-Byar model
# uses these _tv frames; every other section (including arm_at_landmark
# itself) is untouched and still uses the year-1-capped frames on purpose --
# see the section-4 note on why the year-1 window is needed elsewhere.
#===============================================================================
df_immuno_fol_tv <- df_immuno_fol_read %>%
  filter(TRR_ID_CODE %in% tx_ids_to_keep) %>%
  select(-any_of(c("TX_DATE", "DISCHARGE_DATE", "TRTREJ6M", "TRTREJ1Y"))) %>%
  left_join(df_liver_data_filtered %>%
              select(TRR_ID_CODE, TX_DATE, DISCHARGE_DATE, TRTREJ6M, TRTREJ1Y),
            by = "TRR_ID_CODE") %>%
  filter(!is.na(TX_DATE)) %>%
  mutate(
    PX_STAT_DATE_FOL = as.Date(PX_STAT_DATE_FOL),
    TX_DATE = as.Date(TX_DATE)
  ) %>%
  mutate(FOL_DATE_DAYS_DELTA = time_length(interval(TX_DATE, PX_STAT_DATE_FOL), "days")) %>%
  filter(FOL_DATE_DAYS_DELTA >= 0 & FOL_DATE_DAYS_DELTA < TV_HORIZON) %>%
  arrange(PX_STAT_DATE_FOL) %>%
  group_by(TRR_ID_CODE) %>%
  mutate(REJECT_RUNNING_COUNT = cumsum(if_any(all_of(COLS_TO_CHECK), ~ !is.na(.) & . == 1))) %>%
  ungroup() %>%
  mutate(NUM_ANTI_REJ_RXED = rowSums(across(all_of(COLS_TO_CHECK)) == 1, na.rm = TRUE))

pat_rej_array_fol_tv <- df_immuno_fol_tv %>%
  mutate(
    REJECT_RUNNING_COUNT = if_else(
      TRR_ID_CODE %in% inpatient_reject_ID_vect,
      REJECT_RUNNING_COUNT + 1,
      REJECT_RUNNING_COUNT
    )
  ) |>
  filter(REJECT_RUNNING_COUNT == 1, NUM_ANTI_REJ_RXED >= 1) %>%
  group_by(TRR_ID_CODE) %>%
  slice_min(order_by = PX_STAT_DATE_FOL, n = 1, with_ties = FALSE) %>%
  ungroup() %>%
  select(
    TRR_ID_CODE, TRR_FOL_ID_CODE, TX_DATE, DISCHARGE_DATE, PX_STAT_DATE_FOL,
    FOL_DATE_DAYS_DELTA, REJECT_RUNNING_COUNT, NUM_ANTI_REJ_RXED,
    all_of(COLS_TO_CHECK)
  ) %>%
  mutate(DISCHARGE_DATE = as.Date(DISCHARGE_DATE))

pat_rej_array_tv <- bind_rows(pat_rej_array_dis, pat_rej_array_fol_tv, .id = "source") %>%
  mutate(source = as.integer(source))

pat_rej_first_tv <- pat_rej_array_tv %>%
  group_by(TRR_ID_CODE) %>%
  slice_min(order_by = source, n = 1, with_ties = FALSE) %>%
  ungroup() %>%
  mutate(
    REJ_TX_DAY = if_else(source == 1L,
                         as.numeric(INPATIENT_RX_DAY),
                         as.numeric(FOL_DATE_DAYS_DELTA))
  )

message("Time-varying model: rejectors first captured only after day ", YEAR1_DAYS,
        " (missed by the year-1-capped frame): ",
        length(setdiff(pat_rej_first_tv$TRR_ID_CODE, pat_rej_first$TRR_ID_CODE)))

arm_all_time <- assign_arm_at_landmark(
  Inf,
  pat_rej_first_src = pat_rej_first_tv,
  fol_calc_src = df_immuno_fol_tv
)   # exposure over all available follow-up, through TV_HORIZON

tv_base <- df_survival %>%
  filter(!is.na(PTIME), PTIME > 0) %>%
  select(TRR_ID_CODE, PTIME, event, TX_YEAR, CENTRE) %>%
  left_join(pat_rej_first_tv %>% select(TRR_ID_CODE, REJ_TX_DAY), by = "TRR_ID_CODE") %>%
  left_join(arm_all_time, by = "TRR_ID_CODE") %>%
  filter(!is.na(ARM))

# Segment 1: untreated person-time, from day 0 until first treatment (or until
# end of follow-up for patients never treated).
tv_seg_untreated <- tv_base %>%
  mutate(
    tstart = 0,
    tstop = case_when(
      is.na(REJ_TX_DAY)   ~ PTIME,        # never treated
      REJ_TX_DAY <= 0     ~ NA_real_,     # treated at baseline: no untreated time
      REJ_TX_DAY >= PTIME ~ PTIME,        # treatment recorded at/after last follow-up
      TRUE                ~ REJ_TX_DAY
    ),
    ev = case_when(
      is.na(REJ_TX_DAY)   ~ as.numeric(event),
      REJ_TX_DAY <= 0     ~ NA_real_,
      REJ_TX_DAY >= PTIME ~ as.numeric(event),
      TRUE                ~ 0             # censored at the moment of switching
    ),
    RX_STATE = "None"
  ) %>%
  filter(!is.na(tstop), tstop > tstart)

# Segment 2: treated person-time, from first treatment to end of follow-up.
tv_seg_treated <- tv_base %>%
  filter(!is.na(REJ_TX_DAY), REJ_TX_DAY < PTIME) %>%
  mutate(
    tstart = pmax(REJ_TX_DAY, 0),
    tstop  = PTIME,
    ev     = as.numeric(event),
    RX_STATE = as.character(ARM)
  ) %>%
  filter(tstop > tstart)

tv_data <- bind_rows(tv_seg_untreated, tv_seg_treated) %>%
  select(TRR_ID_CODE, tstart, tstop, ev, RX_STATE, TX_YEAR, CENTRE) %>%
  mutate(RX_STATE = factor(RX_STATE,
                           levels = c("None", "Steroids", "CDA", "Dual Therapy", "Other Rejection"))) %>%
  arrange(TRR_ID_CODE, tstart)

stopifnot(all(tv_data$tstop > tv_data$tstart))
message("Time-varying dataset: ", nrow(tv_data), " rows for ",
        n_distinct(tv_data$TRR_ID_CODE), " patients; ", sum(tv_data$ev), " deaths")
print(
  table(tv_data$RX_STATE, tv_data$ev)
)

# Administrative censoring at a chosen horizon, measured from TRANSPLANT.
truncate_tv <- function(tv, horizon) {
  tv %>%
    filter(tstart < horizon) %>%
    mutate(ev = if_else(tstop > horizon, 0, ev), tstop = pmin(tstop, horizon)) %>%
    filter(tstop > tstart)
}

tv_trunc <- truncate_tv(tv_data, TV_HORIZON)

# Era enters as a covariate; centre enters as a cluster. Neither was present in
# the previous version, which is why this model's CIs were the narrowest in the
# script despite it being the least confounder-controlled.
fit_tv <- coxph(
  as.formula(paste0("Surv(tstart, tstop, ev) ~ RX_STATE",
                    if (ADJUST_FOR_ERA) " + TX_YEAR" else "",
                    centre_cluster_term(tv_trunc))),
  data = tv_trunc)
print(
  summary(fit_tv)
)
print(
  cox.zph(fit_tv)
)

# Only the exposure-state rows belong in the published table; TX_YEAR is a
# nuisance term. Its coefficient is still visible in the summary() print above.
tv_s <- summary(fit_tv)
tv_hr_table <- tv_s$conf.int %>%
  as.data.frame() %>%
  tibble::rownames_to_column("term") %>%
  mutate(p_value = tv_s$coefficients[, "Pr(>|z|)"]) %>%
  filter(str_detect(term, "^RX_STATE")) %>%
  transmute(
    Comparison = paste0(str_remove(term, "^RX_STATE"), " vs untreated person-time"),
    `HR (95% CI)` = sprintf("%.2f (%.2f\u2013%.2f)", `exp(coef)`, `lower .95`, `upper .95`),
    `P value` = if_else(p_value < 0.001, "<0.001", sprintf("%.3f", p_value))
  )

keep(
  tv_hr_table %>%
    gt() %>%
    tab_header(
      title = paste0("Time-Varying Exposure Cox Model, Mortality to Day ", round(TV_HORIZON)),
      subtitle = "Sensitivity analysis -- no patients excluded, no exposure window"
    ) %>%
    tab_options(table.font.size = 13, data_row.padding = px(4), column_labels.font.weight = "bold") %>%
    tab_source_note(paste0(
      "Anti-rejection therapy modelled as a time-dependent covariate: every patient contributes untreated ",
      "person-time from transplant until their first anti-rejection treatment, then treated person-time ",
      "thereafter. Unlike the landmark analysis this discards no patients AND imposes no exposure window, so ",
      "treatment given after day ", round(LANDMARK_DAY), " is counted as treatment rather than folded into ",
      "the Control arm. Comparing these hazard ratios against the landmark table therefore bounds how much ",
      "the landmark's Control contamination is costing: if they diverge materially, report both. Follow-up ",
      "administratively censored at day ", round(TV_HORIZON), " post-transplant. Treatment timing for ",
      "therapy given during the index admission is approximated (see INPATIENT_RX_DAY)."))
  , "hr_time_varying")

# --- Optional: quantify the bias by reproducing the naive analysis ---
# Fits the ORIGINAL, BIASED transplant-anchored model alongside the corrected
# ones. The point is not to report it but to show how far the estimate moves
# once the immortal time is removed. Do not use this HR for anything else.
SHOW_NAIVE_COMPARISON <- FALSE

if (SHOW_NAIVE_COMPARISON) {
  df_naive <- df_survival %>%
    inner_join(arm_all_time, by = "TRR_ID_CODE") %>%
    filter(!is.na(PTIME)) %>%
    mutate(
      event_h = if_else(PTIME <= TV_HORIZON, event, 0),
      time_h  = pmin(PTIME, TV_HORIZON),
      ARM = relevel(factor(as.character(ARM)), ref = "Control")
    ) %>%
    filter(ARM %in% c("Control", "Steroids", "CDA")) %>%
    mutate(ARM = droplevels(ARM))
  
  fit_naive <- coxph(Surv(time_h, event_h) ~ ARM, data = df_naive)
  
  message("\n--- BIASED (transplant-anchored) vs CORRECTED ---")
  message("Biased HRs (immortal time present, DO NOT REPORT):")
  print(round(summary(fit_naive)$conf.int[, c(1, 3, 4)], 3))
  message("Landmark HRs (corrected, exposure window imposed):")
  print(round(summary(fit_lm_3arm)$conf.int[, c(1, 3, 4)], 3))
  message("Time-varying HRs (corrected, no exclusions, no exposure window):")
  print(round(summary(fit_tv)$conf.int[, c(1, 3, 4)], 3))
}


#-------------------------------------------------------------------------------
# 21c. Anchor comparison: does the time origin change the answer?
#-------------------------------------------------------------------------------
# The arms are IDENTICAL across these three designs -- only eligibility and the
# treatment of post-landmark therapy differ. So a material divergence is
# informative about the design, not about the exposure.
#-------------------------------------------------------------------------------
design_comparison <- bind_rows(
  hr_results_lm %>% mutate(Design = paste0("Landmark day ", round(LANDMARK_DAY))),
  hr_results_dc %>% filter(!grepl("adjusted", Comparison)) %>%
    mutate(Design = "Discharge-anchored")
) %>%
  select(Design, Comparison, n, events, HR, CI_lower, CI_upper, p_value)

keep(
  design_comparison %>%
    mutate(`HR (95% CI)` = sprintf("%.2f (%.2f\u2013%.2f)", HR, CI_lower, CI_upper),
           `P value` = case_when(p_value < 0.001 ~ "<0.001", TRUE ~ sprintf("%.3f", p_value))) %>%
    select(Design, Comparison, n, events, `HR (95% CI)`, `P value`) %>%
    gt(groupname_col = "Design") %>%
    tab_header(
      title = "Same Arms, Different Time Origin",
      subtitle = "Landmark vs discharge-anchored mortality hazard ratios"
    ) %>%
    tab_options(table.font.size = 13, data_row.padding = px(4),
                column_labels.font.weight = "bold", row_group.font.weight = "bold") %>%
    tab_source_note(paste0(
      "Both designs use the SAME exposure arms (anti-rejection therapy during the index admission), so any ",
      "difference is attributable to the time origin and eligibility rule, not to who was exposed. The ",
      "landmark design conditions on survival to day ", round(LANDMARK_DAY),
      " and folds post-landmark treatment into Control; the discharge design conditions only on surviving ",
      "the admission and treats post-discharge therapy as an outcome. Where they agree, the finding is ",
      "robust to the design choice. Where they diverge, report both and say why."))
  , "anchor_comparison")


#===============================================================================
# 22. Year-2 Anti-Rejection Treatment, Stratified by Exposure Group
#-------------------------------------------------------------------------------
# REWIRED. This section used to build its arms from the section-6 full-year ID
# vectors, which have no notion of a landmark. It now takes them from the same
# assignment as everything else, so "Steroids" means the same set of patients
# here as it does in the survival section.
#
# THE COLUMN WAS RENAMED FIRST_YEAR_GROUP -> EXPOSURE_GROUP. At a 90-day
# landmark it is not a first-year group, and leaving the old name is how a
# results paragraph ends up describing the wrong exposure.
#
# STATUS: SECONDARY. This block is TRANSPLANT-anchored and is retained for
# comparability with the earlier version of the analysis. The primary version
# of this question is section 19b, which measures time from discharge to first
# post-discharge anti-rejection therapy using the full follow-up.
#
# DESIGN CAVEAT: exposure is fixed at the index admission but eligibility here
# requires surviving to YR2_ELIGIBLE_DAY. If treatment affects mortality in
# between, this conditions on a post-exposure variable and the odds ratios
# carry a selection component -- a problem section 19b does not have, because
# its eligibility (survival to discharge) coincides with the exposure. The
# attrition table in section 20 is the diagnostic; if the arms differ there,
# prefer 19b and say why.
#===============================================================================

yr2_arm_source <- if (USE_LANDMARK_ARMS_FOR_YR2) arm_at_landmark else legacy_arm_lookup

yr2_arms_keep <- c("Control", "Steroids", "CDA",
                   if (YR2_INCLUDE_DUAL) "Dual Therapy" else NULL)

exposure_group_lookup <- yr2_arm_source %>%
  filter(ARM %in% yr2_arms_keep) %>%
  distinct(TRR_ID_CODE, .keep_all = TRUE) %>%
  transmute(TRR_ID_CODE,
            EXPOSURE_GROUP = factor(as.character(ARM), levels = yr2_arms_keep))

message("\nYear-2 exposure groups (source: ",
        if (USE_LANDMARK_ARMS_FOR_YR2) paste0("landmark ", LM_LABEL) else "legacy full-year vectors",
        "):")
print(table(exposure_group_lookup$EXPOSURE_GROUP))
if (!YR2_INCLUDE_DUAL) {
  message("  Dual Therapy patients excluded from the year-2 models: ",
          sum(yr2_arm_source$ARM == "Dual Therapy"),
          "  (set YR2_INCLUDE_DUAL <- TRUE to model them)")
}

# --- Step 1: candidate cohort ---
# ORDER MATTERS AND HAS CHANGED. Eligibility used to be applied here, before the
# outcome was known, which made it impossible to keep a patient on the strength
# of an observed event. The outcome is now computed FIRST (steps 2-3) and
# eligibility applied AFTER (step 3b), so a patient treated on day 200 who then
# died on day 300 is retained as the event they are, rather than dropped for
# having short follow-up.
yr2_candidate_ids <- df_liver_data_filtered %>%
  filter(!is.na(PTIME), PTIME >= YR2_ELIGIBLE_DAY) %>%
  pull(TRR_ID_CODE)

# --- Step 2: outcome-window-only follow-up (not cumulative from transplant) ---
df_immuno_fol_yr2 <- df_immuno_fol_read %>%
  filter(TRR_ID_CODE %in% tx_ids_to_keep, TRR_ID_CODE %in% yr2_candidate_ids) %>%
  select(-any_of(c("TX_DATE", "DISCHARGE_DATE"))) %>%
  left_join(df_liver_data_filtered %>% select(TRR_ID_CODE, TX_DATE, DISCHARGE_DATE),
            by = "TRR_ID_CODE") %>%
  filter(!is.na(TX_DATE)) %>%
  mutate(
    PX_STAT_DATE_FOL = as.Date(PX_STAT_DATE_FOL),
    TX_DATE = as.Date(TX_DATE),
    FOL_DATE_DAYS_DELTA = time_length(interval(TX_DATE, PX_STAT_DATE_FOL), "days")
  ) %>%
  filter(FOL_DATE_DAYS_DELTA > YR2_START & FOL_DATE_DAYS_DELTA <= YR2_END) %>%
  arrange(PX_STAT_DATE_FOL) %>%
  mutate(NUM_ANTI_REJ_RXED_ROW = rowSums(across(all_of(COLS_TO_CHECK)) == 1, na.rm = TRUE))

# --- Step 3: per-patient summary of outcome-window treatment ---
df_yr2_patient_summary <- df_immuno_fol_yr2 %>%
  group_by(TRR_ID_CODE) %>%
  summarise(
    across(all_of(COLS_TO_CHECK), ~ as.integer(any(.x == 1, na.rm = TRUE))),
    NUM_FOLLOWUPS_YR2 = n(),
    .groups = "drop"
  ) %>%
  mutate(
    NUM_DRUGS_YR2    = rowSums(across(all_of(COLS_TO_CHECK))),
    ANY_ANTI_REJ_YR2 = as.integer(NUM_DRUGS_YR2 >= 1)
  )

# --- Step 3b: ascertainment -- who can actually be SCORED on this window ---
# A patient contributes a 0 only if they were watched through YR2_END, or if the
# event was observed. See YR2_ASCERTAINMENT in section 0b for why the old rule
# (survival to day 90 and nothing more) was wrong: it scored a patient
# transplanted eight months before the data cutoff as "no rejection through day
# 730", which is not something the data can say.
# distinct() before setNames(): a duplicated TRR_ID_CODE would make name-based
# lookup return the first match silently rather than erroring.
yr2_ptime_src <- df_liver_data_filtered %>%
  distinct(TRR_ID_CODE, .keep_all = TRUE)
yr2_ptime <- setNames(suppressWarnings(as.numeric(yr2_ptime_src$PTIME)),
                      yr2_ptime_src$TRR_ID_CODE)

yr2_had_event <- setNames(df_yr2_patient_summary$ANY_ANTI_REJ_YR2 == 1L,
                          df_yr2_patient_summary$TRR_ID_CODE)

yr2_eligible_ids <- yr2_ascertained_ids(
  ids       = yr2_candidate_ids,
  obs_time  = yr2_ptime,
  had_event = yr2_had_event,
  label     = "Anti-rejection treatment")

# --- Step 4: attach exposure group to the eligible cohort ---
all_ids_by_group <- exposure_group_lookup %>%
  filter(TRR_ID_CODE %in% yr2_eligible_ids)

df_yr2_by_group <- all_ids_by_group %>%
  left_join(df_yr2_patient_summary, by = "TRR_ID_CODE") %>%
  mutate(
    HAS_YR2_FOLLOWUP = !is.na(NUM_FOLLOWUPS_YR2),
    ANY_ANTI_REJ_YR2 = coalesce(ANY_ANTI_REJ_YR2, 0L),
    across(all_of(COLS_TO_CHECK), ~ coalesce(.x, 0L))
  )
# NOTE: patients with HAS_YR2_FOLLOWUP == FALSE have no recorded visit in the
# outcome window at all. They are coded ANY_ANTI_REJ_YR2 = 0, which assumes
# "no visit" means "no rejection", not "unknown". The N_with_yr2_followup
# column below is what makes that assumption auditable.

# --- Step 5: group-level summary ---
year2_group_summary <- df_yr2_by_group %>%
  group_by(EXPOSURE_GROUP, .drop = FALSE) %>%
  summarise(
    N                   = n(),
    N_with_yr2_followup = sum(HAS_YR2_FOLLOWUP),
    Pct_with_followup   = 100 * N_with_yr2_followup / pmax(N, 1),
    N_rejected_yr2      = sum(ANY_ANTI_REJ_YR2),
    Pct_rejected_yr2    = 100 * N_rejected_yr2 / pmax(N, 1),
    .groups = "drop"
  )

keep(
  year2_group_summary %>%
    gt() %>%
    fmt_number(columns = c(Pct_with_followup, Pct_rejected_yr2), decimals = 1) %>%
    cols_label(
      EXPOSURE_GROUP      = paste0("Group as of ", LM_LABEL),
      N                   = "N (eligible cohort)",
      N_with_yr2_followup = "N with outcome-window follow-up",
      Pct_with_followup   = "% followed up",
      N_rejected_yr2      = "N treated in outcome window",
      Pct_rejected_yr2    = "% treated"
    ) %>%
    tab_header(title = "Anti-Rejection Treatment During the Outcome Window, by Exposure Group",
               subtitle = paste0("Exposure: ", EXPOSURE_LABEL,
                                 "; outcome: post-transplant days ", round(YR2_START), "-", round(YR2_END))) %>%
    tab_options(table.font.size = 13, data_row.padding = px(4), column_labels.font.weight = "bold") %>%
    tab_source_note(paste0(
      "Eligible cohort restricted to patients still under observation at day ", round(YR2_ELIGIBLE_DAY),
      if (YR2_ASCERTAINMENT == "complete") paste0(
        " AND observed through day ", round(YR2_END), " (or observed to have the event). Patients whose ",
        "transplant is too recent for ", round(YR2_END), " days to have elapsed by the data cutoff (",
        format(DATA_CUTOFF), "), and those whose own follow-up ended earlier, are EXCLUDED rather than ",
        "counted as untreated -- a fixed-window binary can only score a patient who was watched for the ",
        "whole window. This narrows the estimand to 'among patients observed through day ",
        round(YR2_END), "'; the time-to-event analysis in section 19b does not pay that cost and is ",
        "the preferred version of this question.")
      else paste0(
        " ONLY (YR2_ASCERTAINMENT = 'eligible_only'). Patients not observed through day ", round(YR2_END),
        " are counted as untreated rather than excluded, which understates every rate below."),
      " Exposure groups are fixed at day ", round(LANDMARK_DAY), " and are NOT reassigned by treatment in ",
      "between: patients first treated in the day ", round(GAP_START), "-", round(GAP_END), " gap remain in ",
      "Control, which attenuates every contrast below. Compare '% followed up' across arms before reading ",
      "'% treated' -- a patient with no recorded visit is counted as untreated rather than unknown."))
  , "year2_rejection_by_arm")

tab_yr2 <- table(df_yr2_by_group$EXPOSURE_GROUP, df_yr2_by_group$ANY_ANTI_REJ_YR2)
print(
  tab_yr2
)
print(
  safe_chisq_or_fisher(tab_yr2)
)

# --- Step 6: which drugs were used in the outcome window, by exposure group ---
drug_freq_by_group_yr2 <- df_yr2_by_group %>%
  select(EXPOSURE_GROUP, all_of(COLS_TO_CHECK)) %>%
  group_by(EXPOSURE_GROUP, .drop = FALSE) %>%
  summarise(N = n(), across(all_of(COLS_TO_CHECK), sum), .groups = "drop") %>%
  pivot_longer(-c(EXPOSURE_GROUP, N), names_to = "Drug", values_to = "Frequency") %>%
  mutate(Drug = str_remove(Drug, COL_TAIL), Freq_Per_Patient = Frequency / pmax(N, 1)) %>%
  arrange(EXPOSURE_GROUP, desc(Freq_Per_Patient))

keep(
  drug_freq_by_group_yr2 %>%
    filter(Frequency > 0) %>%
    select(EXPOSURE_GROUP, Drug, N, Frequency, Freq_Per_Patient) %>%
    kable(
      caption = "Outcome-Window Anti-Rejection Drug Use per Patient, by Exposure Group",
      col.names = c("Exposure Group", "Drug", "Group N", "Patients Treated", "Rate per Patient"),
      digits = 3
    ) %>%
    kable_styling(bootstrap_options = c("striped", "hover", "condensed"))
  , "year2_drug_use_by_arm")

# coord_cartesian() zooms without dropping data, unlike scale_y_continuous(limits=),
# which would silently discard any bar above the ceiling.
yr2_bar_ceiling <- max(0.03, 1.1 * max(drug_freq_by_group_yr2$Freq_Per_Patient, na.rm = TRUE))

keep(
  drug_freq_by_group_yr2 %>%
    filter(Frequency > 0) %>%
    ggplot(aes(x = reorder(Drug, -Freq_Per_Patient), y = Freq_Per_Patient, fill = EXPOSURE_GROUP)) +
    geom_col(position = "dodge") +
    scale_y_continuous(labels = scales::percent_format(accuracy = 0.1)) +
    coord_cartesian(ylim = c(0, yr2_bar_ceiling)) +
    labs(
      title = "Outcome-Window Anti-Rejection Drug Use per Patient, by Exposure Group",
      subtitle = paste0("Groups fixed at ", LM_LABEL),
      x = "Drug", y = "Fraction of Group Treated", fill = "Exposure Group"
    ) +
    theme_minimal() +
    theme(axis.text.x = element_text(angle = 45, hjust = 1))
  , "year2_drug_use_by_arm_plot")

# --- Step 7: patient-level detail ---
print(
  df_yr2_by_group %>%
    select(TRR_ID_CODE, EXPOSURE_GROUP, HAS_YR2_FOLLOWUP, ANY_ANTI_REJ_YR2,
           NUM_DRUGS_YR2, all_of(COLS_TO_CHECK)) %>%
    arrange(EXPOSURE_GROUP, desc(ANY_ANTI_REJ_YR2)) %>%
    head(20)
)


#===============================================================================
# 23. Statistical Analysis: Outcome-Window Anti-Rejection Treatment
#===============================================================================
# Induction and donor covariates are joined here for the same reason they are
# joined into baseline_covs: the propensity match in section 26 builds its
# frame from this object, and a covariate named in match_covariates but absent
# from the frame empties it via drop_na().
covariates_yr2 <- df_liver_data_filtered %>%
  select(TRR_ID_CODE, AGE, GENDER, MELD_PELD_LAB_SCORE, COLD_ISCH, DIAB,
         TX_YEAR, CENTRE) %>%
  mutate(DIAB_BIN = diab_bin(DIAB), GENDER = factor(GENDER)) %>%
  distinct(TRR_ID_CODE, .keep_all = TRUE) %>%
  left_join(df_hla_calc %>% select(TRR_ID_CODE, MM_TOTAL), by = "TRR_ID_CODE") %>%
