# --- Step 6: propensity matching WITHIN the landmark cohort ---
# Redone here rather than reusing the section-14 matches, which were fit on
# the full cohort: applying the landmark restriction afterwards would break
# matched pairs non-randomly (the patient who died at day 60 is dropped, their
# match is not), reintroducing the imbalance matching existed to remove.
#
# Tables 2 and 3 therefore describe the FULL-COHORT matched sets, while this
# section reports its own Ns and its own balance. Don't quote one table's N
# alongside the other's hazard ratio.
match_within_landmark <- function(df_lm, treat_arm, ctrl_arm, label, seed = 1234) {
  
  # Drop any column baseline_covs is about to supply BEFORE joining. df_lm
  # descends from df_survival, which now carries TX_YEAR and CENTRE, and
  # baseline_covs carries them too -- without this the join silently produces
  # TX_YEAR.x / TX_YEAR.y and match_covariates can no longer find TX_YEAR.
  # match_within_dc() has always done this; match_within_landmark() had not
  # needed to until era and centre were added to both frames.
  d <- df_lm %>%
    filter(ARM %in% c(treat_arm, ctrl_arm)) %>%
    mutate(treat = as.integer(ARM == treat_arm)) %>%
    select(-any_of(setdiff(names(baseline_covs), "TRR_ID_CODE"))) %>%
    left_join(baseline_covs, by = "TRR_ID_CODE")
  
  md <- d %>% select(TRR_ID_CODE, treat, all_of(match_covariates), any_of(balance_only_covariates))
  res <- run_match(md, label, seed = seed)
  if (is.null(res)) return(NULL)

  # FIX 5: join subclass in rather than just filtering to matched_ids, so
  # run_coxph_lm()/run_coxph_lm_adj() can cluster on the matched pair.
  list(
    matchit     = res$matchit,
    match_frame = res$match_frame,
    data = d %>%
      inner_join(res$matched_data, by = "TRR_ID_CODE") %>%
      mutate(ARM = droplevels(ARM))
  )
}

