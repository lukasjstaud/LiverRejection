#===============================================================================
# 0b. Analysis parameters  -- THE ONLY PLACE THESE ARE SET
#-------------------------------------------------------------------------------
# Everything downstream derives from this block. If a number below needs to
# change, change it here and nowhere else; the previous version of this script
# hard-coded 365.25 in five separate places, which is how the landmark and the
# year-2 eligibility rule drifted apart.
#===============================================================================

# --- Exposure ---
# Anti-rejection therapy given in [0, LANDMARK_DAY) defines the arm.
LANDMARK_DAY <- 90

# --- Outcome window ---
# The active analysis window is post-landmark (day 90) through day 730.5;
# it is not the conventional second post-transplant year (days 365-730).
YR2_START        <- 90   # outcome window opens
YR2_END          <- 730.5    # outcome window closes
YR2_ELIGIBLE_DAY <- 365.25   # must still be under observation here to have an outcome

# The dead zone between exposure and outcome. Non-empty only when the landmark
# is earlier than the outcome window, i.e. exactly the situation created by
# moving to 90 days.
GAP_START <- LANDMARK_DAY
GAP_END   <- YR2_START
HAS_GAP   <- GAP_END > GAP_START

# --- Survival horizons, measured FROM THE LANDMARK ---
# At LANDMARK_DAY = 90 these cover post-transplant days 90-455 and 90-820,
# NOT "years 1-2" and "years 1-3" as they did at the 365-day landmark. The
# axis labels and table captions below are built from the constants so they
# cannot go stale.
LM_HORIZON_SHORT <- 365.25
LM_HORIZON_LONG  <- 730.5

# --- Time-varying model horizon, measured from TRANSPLANT ---
TV_HORIZON <- YR2_END

# --- Discharge-anchored design (section 19) ---
# Measured FROM DISCHARGE, not from transplant. Used only by the
# discharge-anchored analysis, which is the design that actually matches an
# exposure known entirely at discharge. See section 19.
DC_HORIZON_SHORT <- 365.25
DC_HORIZON_LONG  <- 730.5

# --- Index-admission treatment timing ---
# The UNOS discharge file records THAT anti-rejection therapy was given during
# the index admission, not WHEN. Day 0 assigns those patients no immortal time
# at all; a positive value would credit them unexposed person-time they may
# not have had. Sensitivity: try DAYS_HOSP_SP_TX / 2.
#
# This matters MORE at a 90-day landmark than it did at 365, because the
# index admission is now a large fraction of the exposure window rather than a
# small one.
INPATIENT_RX_DAY <- 0

# --- Control definition ---
# How a patient qualifies as "observed during the exposure window", and so as
# an eligible Control.
#
#   "interval"  (default, correct for UNOS) -- any index-admission record OR any
#               follow-up form. UNOS follow-up forms report on the INTERVAL
#               since the previous form (or since transplant), which is why
#               TRTREJ6M / TRTREJ1Y exist as interval flags. A patient whose
#               first form is at 6 months HAS been assessed for days 0-90; the
#               assessment is simply recorded later. Excludes only patients
#               with no records at all, which is the real "no data" group.
#   "strict"    -- requires a form DATED before the landmark. Wrong for UNOS:
#               routine follow-up is at 6 months and 1 year, so this discards
#               most of the cohort and collapses the Control arm (which in turn
#               takes every demographic table down with it). Kept only to
#               reproduce that run.
#   "any_year1" -- the original behaviour: any year-1 follow-up form. Differs
#               from "interval" only by excluding patients who have a discharge
#               record but never a follow-up form.
ASSESSMENT_RULE <- "interval"   # "interval" | "strict" | "any_year1"

# --- Which arm definition feeds which section ---
# Both default TRUE so the whole script speaks with one voice. Setting either
# to FALSE reverts that part to the legacy full-year ID vectors, which is
# useful only for reproducing the previous run.
DEMO_TABLES_USE_LANDMARK_ARMS <- TRUE
USE_LANDMARK_ARMS_FOR_YR2     <- TRUE

# Include Dual Therapy as a fourth level in the year-2 models. At a 90-day
# landmark the Dual arm grows substantially, because index-admission
# steroid + ATG/Thymoglobulin combinations now fall inside the exposure
# window. Section 7 prints its N -- check it before leaving this FALSE.
YR2_INCLUDE_DUAL <- FALSE

# --- Rituxan handling in the timing figures ---
# TRUE  -> Rituxan monotherapy becomes its own mutually exclusive arm and
#          "Combined" means Simulect/Thymoglobulin only (bars are disjoint).
# FALSE -> "Combined" keeps its membership; Rituxan is plotted additionally as
#          an overlapping subset (bars double-count).
# In this cohort the Rituxan-monotherapy sub-arm is n = 5, which cannot support
# its own panel or comparison, so FALSE (fold back into Combined) is correct
# here. Check the "Rituxan at landmark" message in section 7 before flipping it.
RITUXAN_AS_OWN_ARM <- FALSE

# --- Follow-up window used to build the year-1 rejection cohort ---
YEAR1_DAYS <- 365.24219

# --- Derived display constants ---
LM_LABEL       <- paste0("day ", round(LANDMARK_DAY), " post-transplant")
EXPOSURE_LABEL <- paste0("first ", round(LANDMARK_DAY), " days post-transplant")
LM_SHORT_END   <- LANDMARK_DAY + LM_HORIZON_SHORT
LM_LONG_END    <- LANDMARK_DAY + LM_HORIZON_LONG

# Bin widths scale with the landmark: 14-day bins across 90 days would give
# six bars.
TIMING_BINWIDTH <- if (LANDMARK_DAY <= 120) 7 else 14
TIMING_BREAK_BY <- if (LANDMARK_DAY <= 120) 15 else 60

# --- Parameter validation ---
# These are all failure modes that otherwise surface hundreds of lines later as
# a cryptic error in an unrelated function.
if (LANDMARK_DAY <= INPATIENT_RX_DAY) {
  stop("LANDMARK_DAY (", LANDMARK_DAY, ") must be GREATER than INPATIENT_RX_DAY (",
       INPATIENT_RX_DAY, ").\n",
       "  The exposure filter is `REJ_TX_DAY < LANDMARK_DAY`, and index-admission therapy is\n",
       "  imputed to day ", INPATIENT_RX_DAY, ". A landmark at or below that value excludes every\n",
       "  treated patient, collapses all arms into Control, and the first Cox model fails with\n",
       "  \"'ref' must be an existing level\".\n",
       "  In this cohort ALL exposure events occur on the imputed day, so any LANDMARK_DAY > ",
       INPATIENT_RX_DAY, "\n",
       "  yields IDENTICAL arms -- 1, 30, 90 and 365 are interchangeable for arm membership.\n",
       "  If the intent was to have no landmark at all, use the discharge-anchored design in\n",
       "  section 19 rather than setting LANDMARK_DAY to 0.")
}
if (LM_HORIZON_SHORT <= 0 || LM_HORIZON_LONG <= 0) {
  stop("LM_HORIZON_SHORT and LM_HORIZON_LONG must both be > 0; a zero-length horizon censors ",
       "every patient at t = 0 and yields an empty survival fit.")
}
if (DC_HORIZON_SHORT <= 0 || DC_HORIZON_LONG <= 0) {
  stop("DC_HORIZON_SHORT and DC_HORIZON_LONG must both be > 0.")
}
if (YR2_END <= YR2_START) {
  stop("YR2_END (", YR2_END, ") must exceed YR2_START (", YR2_START, ").")
}
if (YR2_START < LANDMARK_DAY) {
  stop("YR2_START (", YR2_START, ") is BEFORE the landmark (", LANDMARK_DAY, ").\n",
       "  The outcome window would then overlap the exposure window, so the same treatment\n",
       "  episode could be counted as both exposure and outcome for one patient.")
}
if (YR2_ELIGIBLE_DAY < LANDMARK_DAY) {
  stop("YR2_ELIGIBLE_DAY (", YR2_ELIGIBLE_DAY, ") is before the landmark (", LANDMARK_DAY, ").")
}

message("\n=== Analysis parameters ===")
message("  Exposure window : [0, ", LANDMARK_DAY, ") days post-transplant")
message("  Gap window      : ", if (HAS_GAP) paste0("[", GAP_START, ", ", GAP_END, ") days") else "none",
        "  <- neither exposure nor outcome")
message("  Outcome window  : (", YR2_START, ", ", YR2_END, "] days post-transplant")
message("  Survival window : landmark to day ", round(LM_LONG_END), " post-transplant")

