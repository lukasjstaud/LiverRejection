# 20. SENSITIVITY ANALYSIS: Landmark-Anchored Survival
#-------------------------------------------------------------------------------
# NOT THE PRIMARY ANALYSIS -- see section 19. Retained because it is the design
# a reader may expect, and because agreement between the two anchors is the
# strongest available evidence that the result is not an artefact of either.
#
# Arms are IDENTICAL to section 19. What differs:
#   - Eligibility: survival to day LANDMARK_DAY post-transplant, rather than
#     survival to one's own discharge. This DISCARDS early deaths that the
#     primary analysis retains.
#   - Post-landmark therapy is folded into the Control arm rather than treated
#     as an outcome, which attenuates every treated-vs-Control contrast.
#
# Because all exposure events occur on the imputed index-admission day,
# LANDMARK_DAY no longer affects arm membership at all -- any value above
# INPATIENT_RX_DAY gives the same arms. It now controls only how many early
# deaths are excluded.
#===============================================================================


# --- Step 2: build the landmark survival dataset ---
# Three things happen together and all three are necessary:
#   (a) arms assigned from exposure BEFORE the landmark,
#   (b) patients not still under observation AT the landmark are DROPPED,
#   (c) the clock is reset so t = 0 is the landmark.
# Doing (a) without (b) and (c) is exactly the original bug.
build_landmark_surv <- function(landmark_day, horizon_days) {
  arms <- assign_arm_at_landmark(landmark_day)
  
  out <- df_survival %>%
    inner_join(arms, by = "TRR_ID_CODE") %>%
    filter(!is.na(PTIME), PTIME >= landmark_day) %>%     # (b)
    mutate(
      time_raw = PTIME - landmark_day,                   # (c)
      event_lm = if_else(time_raw <= horizon_days, event, 0),
      time_lm  = pmin(time_raw, horizon_days),
      ARM = factor(as.character(ARM), levels = ARM_LEVELS)
    )
  
  n_zero <- sum(out$time_lm == 0)
  if (n_zero > 0) {
    message("  note: ", n_zero, " patient(s) have exactly 0 days of post-landmark follow-up")
  }
  out
}

df_lm_short <- build_landmark_surv(LANDMARK_DAY, LM_HORIZON_SHORT)
df_lm_long  <- build_landmark_surv(LANDMARK_DAY, LM_HORIZON_LONG)

# --- Step 3: landmark attrition, at BOTH cut points ---
# The second one is new and matters: the survival analysis is eligible at day
# 90 but the YEAR-2 OUTCOME analysis requires survival to day 365. If mortality
# between day 90 and day 365 differs by arm, the year-2 models condition on a
# post-exposure variable and acquire a selection component. This table is how
# to check that.
attrition_at <- function(day, label) {
  assign_arm_at_landmark(LANDMARK_DAY) %>%
    left_join(df_survival %>% select(TRR_ID_CODE, PTIME), by = "TRR_ID_CODE") %>%
    group_by(ARM) %>%
    summarise(
      n_assigned = n(),
      n_observed = sum(!is.na(PTIME) & PTIME >= day),
      n_lost     = n_assigned - n_observed,
      pct_lost   = 100 * n_lost / n_assigned,
      .groups = "drop"
    ) %>%
    mutate(Checkpoint = label, .before = 1)
}

landmark_attrition <- bind_rows(
  attrition_at(LANDMARK_DAY,     paste0("Landmark (day ", round(LANDMARK_DAY), ")")),
  attrition_at(YR2_ELIGIBLE_DAY, paste0("Year-2 eligibility (day ", round(YR2_ELIGIBLE_DAY), ")"))
)

