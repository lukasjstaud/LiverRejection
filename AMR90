# Restricting to HAS_DECEASED_DON == 1 inside the prep function (rather than
# in each caller) means the "N =" in each column header is the DECEASED-DONOR N
# for that arm, not the arm's total N. Those differ by the living-donor
# recipients, so quote a donor-table N only alongside donor-table results.
#
# Unknown-code handling: UNOS uses out-of-range sentinels for "unknown"
# (HIST_DIABETES_DON == 998, "U" for Y/N/U history fields, "U"/"I"/"ND" for
# serology). These map to NA rather than forming their own level, because a
# level called "U" competes for percentage share with the real categories and
# drags an expected cell count under 5, flipping the row to a simulated Fisher
# test for no reason. missing = "ifany" then shows how many are unknown.
prep_donor_gts_df <- function(df) {
  donor_join_cols <- setdiff(names(df_deceased_don_fil2), "TRR_ID_CODE")
  df %>%
    select(-any_of(donor_join_cols)) %>%          # drop stale copies before joining
    left_join(df_deceased_don_fil2, by = "TRR_ID_CODE") %>%
    filter(!is.na(HAS_DECEASED_DON), HAS_DECEASED_DON == 1L) %>%
    ensure_cols(c("AGE_DON", "GENDER_DON", "HGT_CM_DON", "WGT_KG_DON", "BMI_DON",
                  "ETHCAT_DON", "HIST_HTN_DON", "HIST_DM_DON", "COD_DON",
                  "CREAT_DON", "SGOT_DON", "SGPT_DON", "TBILI_DON", "HCV_DON",
                  "DCD_DON", "LI_FIBROSIS", "LI_MACHINE_PERFUSION",
                  "LI_MACHINE_PERFUSION_TY")) %>%
    mutate(
      across(any_of(c("AGE_DON", "HGT_CM_DON", "WGT_KG_DON", "BMI_DON",
                      "CREAT_DON", "SGOT_DON", "SGPT_DON", "TBILI_DON")),
             ~ suppressWarnings(as.numeric(.x))),
      
      DON_SEX_LBL = case_when(
        GENDER_DON == "M" ~ "Male",
        GENDER_DON == "F" ~ "Female",
        TRUE ~ NA_character_
      ),
      
      DON_RACE_LBL = case_when(
        as.character(ETHCAT_DON) == "1" ~ "White",
        as.character(ETHCAT_DON) == "2" ~ "Black/African American",
        as.character(ETHCAT_DON) == "4" ~ "Hispanic/Latino",
        as.character(ETHCAT_DON) == "5" ~ "Asian",
        !is.na(ETHCAT_DON)              ~ "Other",
        TRUE ~ NA_character_
      ),
      
      DON_HTN_LBL = case_when(
        HIST_HTN_DON == "Y" ~ "Yes",
        HIST_HTN_DON == "N" ~ "No",
        TRUE ~ NA_character_
      ),
      
      # HIST_DIABETES_DON mirrors the recipient DIAB coding: 1 = No,
      # 2-5 = Yes (by duration), 998 = Unknown.
      DON_DM_LBL = case_when(
        suppressWarnings(as.numeric(HIST_DM_DON)) %in% 2:5 ~ "Yes",
        suppressWarnings(as.numeric(HIST_DM_DON)) == 1     ~ "No",
        HIST_DM_DON == "Y" ~ "Yes",
        HIST_DM_DON == "N" ~ "No",
        TRUE ~ NA_character_
      ),
      
      # COD_CAD_DON: 1 Anoxia, 2 Cerebrovascular/Stroke, 3 Head Trauma,
      # 4 CNS Tumor, 999 Other.
      DON_COD_LBL = case_when(
        as.character(COD_DON) == "1"   ~ "Anoxia",
        as.character(COD_DON) == "2"   ~ "Cerebrovascular/Stroke",
        as.character(COD_DON) == "3"   ~ "Head trauma",
        as.character(COD_DON) == "4"   ~ "CNS tumor",
        as.character(COD_DON) == "999" ~ "Other",
        !is.na(COD_DON)                ~ "Other",
        TRUE ~ NA_character_
      ),
      DON_COD_CVA_LBL = case_when(
        is.na(DON_COD_LBL) ~ NA_character_,
        DON_COD_LBL == "Cerebrovascular/Stroke" ~ "Yes",
        TRUE ~ "No"
      ),
      
      DON_HCV_LBL = case_when(
        HCV_DON == "P" ~ "Yes",
        HCV_DON == "N" ~ "No",
        TRUE ~ NA_character_
      ),
      
      DON_DCD_LBL = case_when(
        DCD_DON == "Y" ~ "Yes",
        DCD_DON == "N" ~ "No",
        TRUE ~ NA_character_
      ),
      
      DON_PERFUSION_LBL = case_when(
        LI_MACHINE_PERFUSION == "Y" ~ "Yes",
        LI_MACHINE_PERFUSION == "N" ~ "No",
        TRUE ~ NA_character_
      ),
      DON_PERFUSION_TY_LBL = case_when(
        as.character(LI_MACHINE_PERFUSION_TY) == "1" ~ "Normothermic",
        as.character(LI_MACHINE_PERFUSION_TY) == "2" ~ "Hypothermic",
        TRUE ~ NA_character_
      ),
      DON_FIBROSIS_STAGE = factor(suppressWarnings(as.numeric(LI_FIBROSIS)), levels = 0:6),
      DON_FIBROSIS_ANY_LBL = case_when(
        suppressWarnings(as.numeric(LI_FIBROSIS)) == 0     ~ "No",
        suppressWarnings(as.numeric(LI_FIBROSIS)) %in% 1:6 ~ "Yes",
        TRUE ~ NA_character_
      )
    )
}

