# 16. Demographic Tables 1-7 (gtsummary)
#-------------------------------------------------------------------------------
#   Table 1: Rejection vs Rituxan vs Control                     (3-arm)
#   Table 2: CDA vs Steroid            (propensity matched)
#   Table 3: CDA vs No Rejection       (propensity matched)
#   Table 4: CDA vs Steroid            (unmatched)
#   Table 5: CDA vs No Rejection       (unmatched)
#   Table 6: Any Therapy (Steroid + CDA) vs No Rejection    (unmatched)
#   Table 7: All four arms (Control / Steroids / CDA / Dual)
#
# ALL of these now describe arms AS OF THE LANDMARK (unless
# DEMO_TABLES_USE_LANDMARK_ARMS is FALSE). "Control" means "not treated in the
# first 90 days", NOT "never treated" -- see the gap contamination figure in
# section 7 and say so in any table legend.
#
# Continuous vars: mean (SD). Categorical: n (%). Multi-level categorical
# variables get ONE p-value on the group header row.
#===============================================================================

prep_gts_df <- function(df) {
  df %>%
    ensure_cols(c("LI_MACHINE_PERFUSION", "LI_MACHINE_PERFUSION_TY",
                  "MM_TOTAL", "PREV_TX", "PREV_TX_ANY_N", "DON_TY",
                  "INDUCTION_CAT")) %>%
    mutate(
      AGE                 = as.numeric(AGE),
      MELD_PELD_LAB_SCORE = as.numeric(MELD_PELD_LAB_SCORE),
      BMI_REC             = as.numeric(BMI_REC),
      COLD_ISCH           = as.numeric(COLD_ISCH),
      GENDER_LBL = case_when(
        GENDER == "M" ~ "Male",
        GENDER == "F" ~ "Female",
        TRUE ~ NA_character_
      ),
      RACE_LBL = race_group(.),
      DIAB_LBL = case_when(
        diab_bin(DIAB) == 1 ~ "Yes",
        diab_bin(DIAB) == 0 ~ "No",
        TRUE ~ NA_character_
      ),
      ORGAN_LBL = organ_group(.),
      LIVING_DON_LBL = case_when(
        DON_TY == "L" ~ "Yes",
        !is.na(DON_TY) ~ "No",
        TRUE ~ NA_character_
      ),
      PREV_LIV_LBL = case_when(
        PREV_TX == "Y" ~ "Yes",
        !is.na(PREV_TX) ~ "No",
        TRUE ~ NA_character_
      ),
      PREV_ANY_LBL = ifelse(is.na(PREV_TX_ANY_N), "0", as.character(PREV_TX_ANY_N)),
      HLA_MM = factor(MM_TOTAL, levels = 0:6),
      PERFUSION_LBL = case_when(
        LI_MACHINE_PERFUSION == "Y" ~ "Yes",
        !is.na(LI_MACHINE_PERFUSION) ~ "No",
        TRUE ~ NA_character_
      ),
      PERFUSION_TY_LBL = case_when(
        as.character(LI_MACHINE_PERFUSION_TY) == "1" ~ "Normothermic",
        as.character(LI_MACHINE_PERFUSION_TY) == "2" ~ "Hypothermic",
        TRUE ~ NA_character_
      )
    )
}

