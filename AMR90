    MM_DR = locus_mismatch(RDR1, RDR2, DDR1_final, DDR2_final),
    MM_TOTAL = if_else(any(is.na(c(MM_A, MM_B, MM_DR))), NA_integer_, MM_A + MM_B + MM_DR)
  ) %>%
