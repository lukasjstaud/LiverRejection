#===============================================================================
# 18. Shared survival infrastructure
#-------------------------------------------------------------------------------
# Objects used by BOTH anchors, defined once so the primary (discharge, section
# 19) and sensitivity (landmark, section 20) analyses cannot drift apart on the
# event definition or the covariate set.
#
# ANCHOR CHOICE, stated once and applied throughout:
#
#   DISCHARGE IS THE TIME ORIGIN. Every exposure event in this cohort is an
#   index-admission record -- no dated outpatient rejection event occurs before
#   the landmark (section 18b) -- so the exposure is complete at discharge.
#   Anchoring there removes all the immortal time the design can generate: the
#   guaranteed survival to one's own discharge, and nothing more. It also lets
#   post-discharge therapy be modelled as an outcome rather than folded into the
#   Control arm as contamination.
#
#   WHAT IT DISCARDS -- stated plainly, because an earlier version of this
#   comment claimed it discarded nothing. UNOS populates DISCHARGE_DATE with the
#   DEATH DATE for patients who die during the index admission, so PTIME ==
#   DISCHARGE_DATE is an in-hospital death, not a same-day discharge. There are
#   ~2,344 of them here (~2,255 at PTIME == DC_DAY, ~89 before it) and all are
#   excluded. The exclusion is correct -- they could not have completed the
#   exposure -- but it is neither small nor arm-neutral: ~2,262 are Control
#   against ~82 across the treated arms. A patient who dies in hospital without
#   ever receiving anti-rejection therapy is a Control BY CONSTRUCTION, since
#   the exposure requires surviving long enough to be treated. The surviving
#   Control arm is therefore selected on having survived the admission while the
#   treated arms are not, which biases treated-vs-Control contrasts AGAINST
#   treatment.
#
#   So the two anchors differ in WHICH early deaths they discard, not in whether
#   they discard any: the landmark drops every death before day LANDMARK_DAY,
#   the discharge anchor drops every death during the index admission. Section
#   21 (time-varying) is the only design in this script that retains all of
#   them, which makes it load-bearing rather than supplementary.
#
#   The landmark analysis is retained in section 20 as a SENSITIVITY analysis on
#   the SAME arms. Because arms are identical across anchors, any divergence
#   between sections 19 and 20 is attributable to the time origin and the
#   eligibility rule alone -- which is what makes section 21c worth reporting.
#===============================================================================

# scale_x_continuous() REPLACES the scale survminer builds from
# break.time.by, so the replacement must carry the same breaks explicitly or
# the tick marks silently disappear.
fix_origin <- function(p, break_by = NULL, max_time = NULL, y_min = 0, y_max = 1) {
  x_scale <- if (!is.null(break_by) && !is.null(max_time)) {
    ggplot2::scale_x_continuous(
      expand = ggplot2::expansion(mult = c(0, 0.02)),
      breaks = seq(0, max_time, by = break_by)
    )
  } else {
    ggplot2::scale_x_continuous(expand = ggplot2::expansion(mult = c(0, 0.02)))
  }

  # y_min > 0 (survival curves) or y_max < 1 (event-probability curves)
  # truncates the y axis. coord_cartesian(), NOT scale_y_continuous(limits =):
  # the scale form DROPS data outside the range, which on a survival curve
  # deletes the segment that fell past the limit and leaves a curve that appears
  # to stop. coord_cartesian() zooms only.
  p$plot <- suppressMessages(
    p$plot + x_scale +
      ggplot2::scale_y_continuous(expand = ggplot2::expansion(mult = c(0, 0.02))) +
      ggplot2::coord_cartesian(ylim = c(y_min, y_max))
  )

  # Any truncated axis must say so on the figure itself -- the panel will be
  # lifted into a manuscript without this script's console output.
  # A raised FLOOR and a lowered CEILING are not the same thing and must not
  # carry the same caption. Raising the floor on a survival curve cuts the axis
  # through the middle of the scale and magnifies the gap between arms -- that
  # is the truncation reviewers object to. Lowering the ceiling on a curve that
  # rises from zero does not: zero is the real origin of a cumulative-incidence
  # quantity, so the axis is scaled, not truncated. Labelling the second as
  # "truncated" would invite a correction that is not warranted.
  if (y_min > 0) {
    p$plot <- p$plot +
      ggplot2::labs(caption = sprintf(
        paste0("CAUTION: y-axis TRUNCATED at %.2f and does not span 0-1. ",
               "Between-arm separation is visually magnified; read the axis before the gap."),
        y_min))
  } else if (y_max < 1) {
    p$plot <- p$plot +
      ggplot2::labs(caption = sprintf(
        paste0("Y-axis scaled to the observed range (0-%.0f%%). The baseline is a true zero, ",
               "so the axis is scaled, not truncated."),
        100 * y_max))
  }

  if (!is.null(p$table)) {
    p$table <- suppressMessages(p$table + x_scale)
    
    # Anchor the day-0 count to the axis instead of centring it there; all
    # other counts stay centred on their tick. survminer sets hjust as a fixed
    # param, which would override the mapping, so clear it first.
    for (i in seq_along(p$table$layers)) {
      if (inherits(p$table$layers[[i]]$geom, "ggplot2::GeomText") ||
          inherits(p$table$layers[[i]]$geom, "GeomText")) {
        p$table$layers[[i]]$aes_params$hjust <- NULL
        p$table$layers[[i]]$mapping <- utils::modifyList(
          p$table$layers[[i]]$mapping,
          ggplot2::aes(hjust = ifelse(time <= 0, 0, 0.5))
        )
      }
    }
  }
  p
}

# --- Survival y-axis scale ---
# THE TRUNCATION IS OFF. It used to default to a floor of 0.75, which is the
# single most common statistical-review complaint about a survival figure: a
# y-axis that starts at 0.75 magnifies a 2-percentage-point difference into a
# visually dramatic gap, and a reader who does not check the axis label reads
# separation that is not there. It is not fixed by annotating the axis; the
# annotation is read by the reviewer and not by the reader skimming figures.
#
# The honest options are (a) plot the full 0-1 survival axis, or (b) plot the
# EVENT scale, which rises from a true zero and therefore uses the resolution
# without ever truncating anything. KM_PLOT_SCALE chooses between them.
#
#   "survival" (default) -- survival probability on a full 0-1 axis. Safe, and
#                what a journal expects to see. In this cohort mortality is low
#                enough that all three curves sit in the top ~10% of the panel
#                and the separation is genuinely hard to see -- which is an
#                accurate impression of an effect this size, not a defect.
#   "event"    -- cumulative mortality, 1 - KM, rising from 0. The axis top is
#                taken from the highest upper confidence band actually reached,
#                so the panel is filled WITHOUT a truncated baseline. This is
#                the version to use if the figure needs to show the contrast
#                legibly; it is not a truncated axis, because zero is the real
#                origin of the quantity being plotted.
#
# All-cause mortality has no competing event, so 1 - KM is a valid cumulative
# incidence here. Do NOT reuse this switch for graft failure or re-treatment --
# those have a competing risk and already have proper Aalen-Johansen figures
# (plot_cif, sections 19b/19c).
KM_PLOT_SCALE <- "survival"     # "survival" | "event"

if (!KM_PLOT_SCALE %in% c("survival", "event")) {
  stop("KM_PLOT_SCALE must be \"survival\" or \"event\"; got \"", KM_PLOT_SCALE, "\".")
}

# Retained ONLY as an escape hatch for a slide deck, where a zoomed panel is
# sometimes wanted and the audience can be told. Setting this TRUE reintroduces
# a truncated axis and the figure should not go into a manuscript.
KM_TRUNCATE_Y <- FALSE
KM_Y_FLOOR    <- 0.75

km_y_min <- function(fit, floor_at = KM_Y_FLOOR) {
  if (!KM_TRUNCATE_Y) return(0)          # full axis: no truncation
  lo <- suppressWarnings(min(c(fit$lower, fit$surv), na.rm = TRUE))
  if (!is.finite(lo)) return(floor_at)
  if (lo < floor_at) max(0, floor(lo * 20) / 20) else floor_at
}

# Ceiling for the event scale. survfit stores SURVIVAL, so the plotted curve is
# 1 - surv and its UPPER band is 1 - lower; using fit$upper would size the axis
# off the wrong bound.
km_y_max_event <- function(fit) {
  hi <- suppressWarnings(max(1 - c(fit$lower, fit$surv), na.rm = TRUE))
  if (!is.finite(hi)) return(1)
  min(1, ceiling(hi * 20) / 20)
}

if (KM_TRUNCATE_Y) {
  warning("KM_TRUNCATE_Y is TRUE: survival figures will use a truncated y-axis, ",
          "which exaggerates between-arm separation. Do not submit these panels.")
}
message("Survival figure scale: ", KM_PLOT_SCALE,
        " | y-axis truncation: ", if (KM_TRUNCATE_Y) "ON (not submittable)" else "OFF")

# --- Reverse-KM median follow-up ---
# The median of the observed time variable is NOT median follow-up: it is pulled
# down by every patient whose time ended in an event rather than in censoring.
# The reverse Kaplan-Meier (Schemper-Smith) swaps the roles of event and
# censoring and answers the question a reader actually asks -- "how long were
# these patients watched?". Journals ask for it by name for any primary
# time-to-event endpoint, and it was absent from this script entirely.
# --- Proportional-hazards p-value for a specific model TERM ---
# cox.zph() returns ONE ROW PER TERM plus a GLOBAL row. summary()$conf.int
# returns ONE ROW PER COEFFICIENT. Those are different lengths whenever a term
# is a multi-level factor, which ARM always is and INDUCTION_CAT now is too.
#
# Indexing the zph table positionally against the coefficient table is therefore
# wrong in two distinct ways, and both were live in this script:
#   - with many coefficients it overruns the table and errors with "subscript
#     out of bounds" (the adjusted full-cohort mortality model, 18 coefficients
#     against ~13 terms);
#   - with exactly two coefficients it silently succeeds and reports the GLOBAL
#     row as if it were the second arm's PH test, because GLOBAL is row 2.
# The second is worse: it puts a wrong number in a results table.
#
# Look the term up BY NAME and recycle its single p across however many
# coefficient rows that term produced. The PH test is a term-level test; there
# is no separate p per factor level.
zph_p_for_term <- function(zph, term = "ARM", n_out = 1L) {
  if (is.null(zph) || is.null(zph$table)) return(rep(NA_real_, n_out))
  rn <- rownames(zph$table)
  i  <- which(rn == term)
  if (!length(i)) return(rep(NA_real_, n_out))
  rep(unname(zph$table[i[1], "p"]), n_out)
}

reverse_km_median <- function(time, event) {
  ok <- !is.na(time) & !is.na(event) & time > 0
  if (sum(ok) < 2) return(NA_real_)
  tab <- tryCatch(
    summary(survfit(Surv(time[ok], 1 - as.numeric(event[ok])) ~ 1))$table,
    error = function(e) NULL)
  if (is.null(tab)) return(NA_real_)
  unname(tab[["median"]])
}

# --- Competing-risks cumulative incidence (Aalen-Johansen) ---
# Defined ONCE here and used by every cumulative-incidence figure in the script
# (post-discharge therapy in 19b, graft failure in 19c, post-landmark therapy in
# 18c), so no figure can quietly revert to the 1 - KM version.
#
# WHY THIS AND NOT 1 - KM. A Kaplan-Meier "event probability" curve treats death
# as censoring, i.e. as though the patient could still have had the event later.
# For any outcome a dead patient cannot experience -- graft failure,
# re-treatment for rejection -- that OVERSTATES cumulative incidence, and it
# overstates it MOST in the arm with the most deaths. In this cohort the treated
# arms have the higher mortality, so 1 - KM systematically flatters them. The
# Aalen-Johansen estimator keeps the competing event in the accounting and the
# curves sum to at most 1 across states.
#
# Requires a survfit() fitted with a FACTOR status variable whose first level is
# censoring, e.g. factor(x, 0:2, c("censored", "<event>", "death")).
cif_tidy <- function(fit, state) {
  j <- which(fit$states == state)
  if (length(j) != 1) {
    stop("cif_tidy(): state \"", state, "\" not found in the fit. States present: ",
         paste(fit$states, collapse = ", "),
         ".\n  This is a multi-state survfit; check the labels on the status factor.")
  }
  if (is.null(fit$strata)) {
    stop("cif_tidy(): the fit has no strata. Fit with ~ ARM (or ~ TIMING_ARM) ",
         "so each arm gets its own curve.")
  }
  tibble(
    time  = fit$time,
    STRAT = sub("^[^=]+=", "", rep(names(fit$strata), fit$strata)),
    cif   = fit$pstate[, j],
    lo    = fit$lower[, j],
    hi    = fit$upper[, j]
  )
}

# Shared renderer, so the three cumulative-incidence figures cannot drift apart
# in axis handling or in how the truncation is disclosed.
plot_cif <- function(cif_df, title, subtitle, xlab, ylab, legend_title,
                     break_by, max_time, levels_order = ARM_LEVELS) {
  d <- cif_df %>%
    mutate(STRAT = factor(STRAT, levels = intersect(levels_order, unique(STRAT))))

  # coord_cartesian(), never scale_y_continuous(limits =): the scale form drops
  # data outside the range and truncates the curve itself rather than the view.
  y_top <- min(1, ceiling(max(d$hi, na.rm = TRUE) * 20) / 20)

  ggplot(d, aes(x = time, y = cif, colour = STRAT, fill = STRAT)) +
    geom_ribbon(aes(ymin = lo, ymax = hi), alpha = 0.15, colour = NA) +
    geom_step(linewidth = 0.8) +
    scale_x_continuous(breaks = seq(0, max_time, by = break_by),
                       expand = expansion(mult = c(0, 0.02))) +
    scale_y_continuous(labels = scales::percent_format(accuracy = 0.1),
                       expand = expansion(mult = c(0, 0.02))) +
    coord_cartesian(ylim = c(0, y_top)) +
    scale_colour_brewer(palette = "Dark2", drop = TRUE) +
    scale_fill_brewer(palette = "Dark2", drop = TRUE) +
    labs(title = title, subtitle = subtitle, x = xlab, y = ylab,
         colour = legend_title, fill = legend_title,
         caption = sprintf(paste0("Aalen-Johansen estimator; death treated as a competing risk, not as ",
                                  "censoring. Y-axis truncated to 0-%.0f%%."), 100 * y_top)) +
    theme_minimal() + theme(legend.position = "bottom")
}

# --- Graft failure, on the transplant clock ---
# Moved up from section 24 so the discharge-anchored time-to-event analysis
# (section 19c) and the legacy fixed-window binary (section 24) cannot drift
# apart on what a graft failure is or when it happened.
#
# GRF_FAIL_EVENT is derived from the PRESENCE of a graft-failure date. A patient
