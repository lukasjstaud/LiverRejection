#-------------------------------------------------------------------------------
# 19b. SECONDARY (DESCRIPTIVE) OUTCOME: Post-Discharge Anti-Rejection Therapy
#-------------------------------------------------------------------------------
# DEMOTED FROM PRIMARY. The co-primary endpoints are mortality (19) and graft
# failure (19c). This section is retained because the post-discharge course is
# worth describing, but it is not a comparative endpoint:
#
#   1. THE OUTCOME IS THE EXPOSURE INSTRUMENT. Both are ascertained from the
#      same anti-rejection drug fields on the same UNOS forms. A between-arm
#      difference here is partly a difference in how intensively a centre
#      records and repeats those drugs.
#   2. THE ARMS ARE NOT MEASURING THE SAME EVENT. For Control this is a
#      FIRST-EVER course of anti-rejection therapy; for Steroids and CDA it
#      is RE-treatment after an episode already treated. Those have different
#      baseline hazards for reasons that have nothing to do with the exposure.
#
# So: report the cumulative incidence descriptively, by arm, and do not describe
# the hazard ratio below as an effect of treatment. It is here to characterise
# follow-up, and to show what the landmark design was calling "gap
# contamination" inside its Control arm.
#
# Under the landmark design these events were "gap contamination" inside the
# Control arm. Here they are at least measured: time from discharge to
# first anti-rejection therapy recorded at any follow-up visit.
#
# Built from ALL follow-up (df_immuno_fol_read), not the year-1 frame, so
# events after day 365 count. Uses every treated visit, not just the patient's
# first-ever event, because an inpatient-treated patient's later outpatient
# course is exactly what this outcome is about.
#-------------------------------------------------------------------------------
# BUG FIX. This used to take min(FOL_DAY) over ALL treated visits and then
# require that minimum to fall after discharge. For a patient with a treated
# visit BEFORE discharge and another AFTER it, the minimum is the pre-discharge
# one, the `> DC_DAY` test failed, and the later re-treatment was DISCARDED --
# the patient was scored as never re-treated.
#
# That error was not arm-neutral. Having an early treated follow-up visit is
# precisely what characterises the treated arms, so re-treatment was
# undercounted in Steroids and CDA and counted correctly in Control, which
# pushes the contrast in a specific direction. The section header already
# claimed this used "every treated visit"; now it does.
#
# The fix is to restrict to visits strictly after the patient's own discharge
# BEFORE taking the minimum.
fol_treated_visits <- df_immuno_fol_read %>%
  filter(TRR_ID_CODE %in% df_dc$TRR_ID_CODE) %>%
  select(-any_of(c("TX_DATE", "DISCHARGE_DATE"))) %>%
  left_join(df_liver_data_filtered %>% select(TRR_ID_CODE, TX_DATE), by = "TRR_ID_CODE") %>%
  left_join(df_dc %>% select(TRR_ID_CODE, DC_DAY), by = "TRR_ID_CODE") %>%
  filter(!is.na(TX_DATE)) %>%
  mutate(
    PX_STAT_DATE_FOL = as.Date(PX_STAT_DATE_FOL),
    TX_DATE          = as.Date(TX_DATE),
    FOL_DAY          = time_length(interval(TX_DATE, PX_STAT_DATE_FOL), "days"),
    TREATED_VISIT    = if_any(all_of(COLS_TO_CHECK), ~ !is.na(.x) & .x == 1)
  ) %>%
  filter(TREATED_VISIT, !is.na(FOL_DAY))

all_fol_rej_day <- fol_treated_visits %>%
  filter(FOL_DAY > DC_DAY) %>%                      # <- the fix
  group_by(TRR_ID_CODE) %>%
  summarise(first_fol_rej_day = min(FOL_DAY), .groups = "drop")

# Quantify what the old rule was throwing away, so the correction is auditable
# rather than a silent change in the numbers between runs.
old_rule_ids <- fol_treated_visits %>%
  group_by(TRR_ID_CODE) %>%
  summarise(min_any = min(FOL_DAY), dc = first(DC_DAY), .groups = "drop") %>%
  filter(!is.na(dc), min_any > dc) %>%
  pull(TRR_ID_CODE)

message("\nPost-discharge re-treatment ascertainment:")
message("  patients with a treated visit after discharge (correct rule): ",
        nrow(all_fol_rej_day))
message("  patients the previous min()-over-all-visits rule would have found: ",
        length(old_rule_ids))
message("  RECOVERED by the fix (had a pre-discharge treated visit masking a later one): ",
        length(setdiff(all_fol_rej_day$TRR_ID_CODE, old_rule_ids)))

df_dc_rej <- df_dc %>%
  left_join(all_fol_rej_day, by = "TRR_ID_CODE") %>%
  mutate(
    # only events strictly after discharge qualify
    rej_day_post_dc = if_else(!is.na(first_fol_rej_day) & first_fol_rej_day > DC_DAY,
                              first_fol_rej_day - DC_DAY, NA_real_),
    fu_days_post_dc = PTIME - DC_DAY,
    rej_event = if_else(!is.na(rej_day_post_dc) &
                          rej_day_post_dc <= pmin(fu_days_post_dc, DC_HORIZON_LONG), 1L, 0L),
    rej_time  = pmin(coalesce(rej_day_post_dc, Inf), fu_days_post_dc, DC_HORIZON_LONG),

    # Competing-risk status. A patient who dies without being re-treated has NOT
    # "not yet been re-treated" -- they can never be re-treated, and treating
    # their death as censoring (which is what a Kaplan-Meier event curve does)
    # credits them with future event risk they do not have. Since the treated
    # arms carry the higher mortality, that error is not symmetric across arms.
    #   0 = still under observation, untreated (or censored at the horizon)
    #   1 = anti-rejection therapy after discharge
    #   2 = died after discharge without recorded post-discharge therapy
    # A death AFTER a recorded re-treatment is not a competing event: the event
    # of interest already happened, which is why status 1 is tested first.
    rej_status = case_when(
      rej_event == 1L                                  ~ 1L,
      event == 1L & fu_days_post_dc <= DC_HORIZON_LONG ~ 2L,
      TRUE                                             ~ 0L
    )
  ) %>%
  filter(is.finite(rej_time), rej_time > 0) %>%
  mutate(rej_status_f = factor(rej_status, levels = 0:2,
                               labels = c("censored", "anti-rejection therapy", "death")))

keep(
  df_dc_rej %>%
    group_by(ARM, .drop = FALSE) %>%
    summarise(n = n(), n_rej = sum(rej_event),
              pct_rej = 100 * n_rej / pmax(n, 1),
              n_death_cr = sum(rej_status == 2L),
              pct_death  = 100 * n_death_cr / pmax(n, 1),
              median_fu = median(rej_time), .groups = "drop") %>%
    gt() %>%
    fmt_number(columns = c(pct_rej, pct_death, median_fu), decimals = 1) %>%
    cols_label(ARM = "Arm at discharge", n = "N", n_rej = "N re-treated",
               pct_rej = "% re-treated",
               n_death_cr = "N died untreated (competing)",
               pct_death = "% competing death",
               median_fu = "Median observed time, d") %>%
    tab_header(title = "Post-Discharge Anti-Rejection Therapy, by Index-Admission Exposure",
               subtitle = "Secondary, descriptive outcome -- not a treatment-effect estimate") %>%
    tab_options(table.font.size = 13, data_row.padding = px(4),
                column_labels.font.weight = "bold") %>%
    tab_source_note(paste0(
      "SECONDARY / DESCRIPTIVE. The co-primary endpoints are mortality (section 19) and graft failure ",
      "(section 19c). Time from discharge to the first anti-rejection therapy recorded at any follow-up ",
      "visit, censored at last follow-up or ", round(DC_HORIZON_LONG), " days post-discharge. For Control ",
      "this is a first-ever course; for the treated arms it is re-treatment, so the arms are not measuring ",
      "the same event and a raw between-arm difference must not be read as a treatment effect. The outcome ",
      "is also ascertained from the same drug fields that define the exposure. Deaths without recorded ",
      "re-treatment are COMPETING EVENTS, shown here and handled as such in the cumulative-incidence ",
      "figure below. Ascertainment applies too -- a patient with no follow-up visit is counted as ",
      "untreated. 'Median observed time' is the median of the censored time variable, not a reverse-KM ",
      "median follow-up."))
  , "postdischarge_rejection_summary")

# ARM is relevelled in a precomputed column rather than inline in the formula.
# Inline relevel() made the term names carry the whole call, which the display
# code below then had to strip with a regex; it also cannot coexist cleanly with
# an added cluster() term.
df_dc_rej_3arm <- df_dc_rej %>%
  filter(ARM %in% c("Steroids", "CDA", "Control")) %>%
  mutate(ARM = relevel(droplevels(ARM), ref = "Control"))

print(table(df_dc_rej_3arm$ARM, df_dc_rej_3arm$rej_status_f))

# --- Cumulative incidence, competing risks accounted for ---
# REPLACES the previous 1 - Kaplan-Meier "event probability" curve. That curve
# treated death after discharge as censoring, i.e. as though a dead patient
# might still be re-treated for rejection later, which inflates the estimated
# incidence -- most in the arm with the most deaths, which here is a treated
# arm. Aalen-Johansen keeps the competing deaths in the accounting. See the
# note on cif_tidy() in section 18.
fit_dc_rej_cif <- survfit(Surv(rej_time, rej_status_f) ~ ARM, data = df_dc_rej_3arm)

keep(
  plot_cif(
    cif_tidy(fit_dc_rej_cif, "anti-rejection therapy"),
    title    = "Post-Discharge Anti-Rejection Therapy (Aalen-Johansen Cumulative Incidence)",
    subtitle = "Secondary descriptive outcome; death after discharge treated as a competing risk",
    xlab     = "Days since discharge",
    ylab     = "Cumulative incidence of anti-rejection therapy",
    legend_title = "Arm at discharge",
    break_by = 180, max_time = DC_HORIZON_LONG)
  , "cuminc_postdischarge_rejection")

# --- Cause-specific Cox (rate among those still alive and untreated) ---
# `rej_status == 1L` rather than `rej_event`: identical numerically, but it
# names the competing-risks framing in the formula so the model cannot be
# mistaken for the subdistribution model fitted below.
cox_dc_rej <- coxph(
  as.formula(paste0("Surv(rej_time, rej_status == 1L) ~ ARM",
                    centre_cluster_term(df_dc_rej_3arm))),
  data = df_dc_rej_3arm)
print(summary(cox_dc_rej))

# --- Fine-Gray subdistribution model (reported alongside) ---
# Same pairing as the graft-failure endpoint in 19c: cause-specific answers
# "among patients still at risk, how fast?", Fine-Gray answers "what share of
# these patients ends up re-treated?". Where they disagree, the disagreement is
# the competing mortality and both belong in the table.
fg_dc_rej <- tryCatch({
  fg <- finegray(Surv(rej_time, rej_status_f) ~ .,
                 data = df_dc_rej_3arm %>% select(ARM, rej_time, rej_status_f),
                 etype = "anti-rejection therapy")
  coxph(Surv(fgstart, fgstop, fgstatus) ~ ARM, data = fg, weights = fgwt)
}, error = function(e) {
  message("Fine-Gray model failed for post-discharge therapy (", conditionMessage(e),
          ") -- reporting cause-specific only")
  NULL
})
if (!is.null(fg_dc_rej)) print(summary(fg_dc_rej))

# --- Matched cause-specific models, one per comparison ---
# Mirrors run_grf_dc() in section 19c: reuses the SAME propensity-matched sets
# built in section 19 (dc_match_combined_steroid / _combined_control /
# _steroid_control) rather than rematching, so the matched Ns here are the
# same patients as the matched mortality and graft-failure rows. Until this
# was added, 19b was the only discharge-anchored outcome reported on the
# unmatched cohort only -- the full-cohort cause-specific/Fine-Gray rows below
# still carry whatever confounding the propensity score was built to remove.
run_rej_dc <- function(match_res, ref_arm, label) {
  if (is.null(match_res)) return(NULL)
  d <- match_res$data %>%
    left_join(all_fol_rej_day, by = "TRR_ID_CODE") %>%
    mutate(
      rej_day_post_dc = if_else(!is.na(first_fol_rej_day) & first_fol_rej_day > DC_DAY,
                                first_fol_rej_day - DC_DAY, NA_real_),
      fu_days_post_dc = PTIME - DC_DAY,
      rej_event = if_else(!is.na(rej_day_post_dc) &
                            rej_day_post_dc <= pmin(fu_days_post_dc, DC_HORIZON_LONG), 1L, 0L),
      rej_time  = pmin(coalesce(rej_day_post_dc, Inf), fu_days_post_dc, DC_HORIZON_LONG),
      # Same competing-risk coding as df_dc_rej above: a death after discharge
      # with no recorded re-treatment is a competing event, not censoring.
      rej_status = case_when(
        rej_event == 1L                                   ~ 1L,
        event == 1L & fu_days_post_dc <= DC_HORIZON_LONG  ~ 2L,
        TRUE                                               ~ 0L
      )
    ) %>%
    filter(is.finite(rej_time), rej_time > 0) %>%
    mutate(ARM = relevel(droplevels(ARM), ref = ref_arm))

  if (nlevels(d$ARM) < 2 || sum(d$rej_status == 1L) < 5) {
    message("skipping post-discharge rejection model -- fewer than 5 events: ", label)
    return(NULL)
  }

  describe_match_weights(d, label)
  fit <- coxph(as.formula(paste0("Surv(rej_time, rej_status == 1L) ~ ARM",
                                 if ("subclass" %in% names(d)) " + cluster(subclass)" else "")),
               data = d, weights = match_weights(d))
  s <- summary(fit)
  tibble(
    Comparison = label,
    Direction  = paste0(rownames(s$conf.int)[1], "  (ref = ", ref_arm, ")"),
    n          = fit$n,
    events     = sum(d$rej_status == 1L),
    HR         = s$conf.int[1, "exp(coef)"],
    CI_lower   = s$conf.int[1, "lower .95"],
    CI_upper   = s$conf.int[1, "upper .95"],
    p_value    = s$coefficients[1, "Pr(>|z|)"],
    ph_test_p  = NA_real_
  )
}

hr_results_dc_rej_matched <- bind_rows(
  run_rej_dc(dc_match_combined_steroid, "Steroids", "CDA vs Steroids (matched)"),
  run_rej_dc(dc_match_combined_control, "Control",  "CDA vs Control (matched)"),
  run_rej_dc(dc_match_steroid_control,  "Control",  "Steroids vs Control (matched)")
)
if (!is.null(hr_results_dc_rej_matched)) print(hr_results_dc_rej_matched)

# --- Save the model above as a table, same convention as hr_discharge_anchored ---
# ARM is now relevelled in the data frame, so the terms are plain "ARMSteroids"
# and only the "ARM" prefix has to come off for display.
s_dc_rej   <- summary(cox_dc_rej)
zph_dc_rej <- tryCatch(cox.zph(cox_dc_rej), error = function(e) NULL)

hr_results_dc_rej <- tibble(
  Comparison = rownames(s_dc_rej$conf.int),
  Direction  = "cause-specific",
  n          = cox_dc_rej$n,
  events     = cox_dc_rej$nevent,
  HR         = s_dc_rej$conf.int[, "exp(coef)"],
  CI_lower   = s_dc_rej$conf.int[, "lower .95"],
  CI_upper   = s_dc_rej$conf.int[, "upper .95"],
  p_value    = s_dc_rej$coefficients[, "Pr(>|z|)"],
  ph_test_p  = zph_p_for_term(zph_dc_rej, "ARM", nrow(s_dc_rej$conf.int))
) %>%
  mutate(Comparison = paste0(str_remove(Comparison, "^ARM"), " vs Control"))

fg_rej_rows <- if (!is.null(fg_dc_rej)) {
  s_fg_rej <- summary(fg_dc_rej)
  tibble(
    Comparison = paste0(str_remove(rownames(s_fg_rej$conf.int), "^ARM"), " vs Control"),
    Direction  = "subdistribution",
    # NOT fg_dc_rej$n: finegray() expands each patient into many time-weighted
    # rows, so the model's own n is a row count. The N a reader needs is the
    # number of PATIENTS described.
    n          = nrow(df_dc_rej_3arm),
    events     = fg_dc_rej$nevent,
    HR         = s_fg_rej$conf.int[, "exp(coef)"],
    CI_lower   = s_fg_rej$conf.int[, "lower .95"],
    CI_upper   = s_fg_rej$conf.int[, "upper .95"],
    p_value    = s_fg_rej$coefficients[, "Pr(>|z|)"],
    ph_test_p  = NA_real_
  )
} else NULL

keep(
  bind_rows(hr_results_dc_rej_matched, hr_results_dc_rej, fg_rej_rows) %>%
    mutate(
      `HR (95% CI)` = sprintf("%.2f (%.2f–%.2f)", HR, CI_lower, CI_upper),
      `P value` = case_when(p_value < 0.001 ~ "<0.001", TRUE ~ sprintf("%.3f", p_value)),
      `PH test P` = case_when(is.na(ph_test_p) ~ NA_character_,
                              ph_test_p < 0.001 ~ "<0.001",
                              TRUE ~ sprintf("%.3f", ph_test_p))
    ) %>%
    select(Comparison, Direction, n, events, `HR (95% CI)`, `P value`, `PH test P`) %>%
    gt() %>%
    sub_missing(missing_text = "—") %>%
    cols_label(Comparison = "Comparison", Direction = "Model type",
               n = "N",
               events = "N re-treated",
               `HR (95% CI)` = "Hazard Ratio (95% CI)", `P value` = "P value",
               `PH test P` = "PH Assumption P") %>%
    tab_header(
      title = "Hazard Ratio for Post-Discharge Anti-Rejection Therapy",
      subtitle = paste0("SECONDARY outcome; time origin = discharge from the index admission; follow-up to ",
                        round(DC_HORIZON_LONG), " days post-discharge")
    ) %>%
    tab_options(table.font.size = 13, data_row.padding = px(4),
                column_labels.font.weight = "bold") %>%
    tab_source_note(paste0(
      "SECONDARY / DESCRIPTIVE OUTCOME, ref = Control. The co-primary ",
      "endpoints are mortality (section 19) and graft failure (section 19c). This hazard ratio is NOT a ",
      "treatment-effect estimate: for Control it models time to FIRST-EVER post-discharge anti-rejection ",
      "therapy, for Steroids/CDA time to RE-treatment, and the outcome is ascertained from the same ",
      "drug fields that define the exposure. MATCHED rows (top) reuse the SAME 1:", MATCH_RATIO,
      " propensity-matched sets built in section 19 for the mortality and graft-failure endpoints -- weighted ",
      "and clustered on the matched set, cause-specific only -- so the matched Ns here describe the same ",
      "patients as the matched rows in the mortality and graft-failure tables. CAUSE-SPECIFIC (full cohort) ",
      "rows model the rate among patients still alive and untreated, 3-arm, unmatched; SUBDISTRIBUTION ",
      "(Fine-Gray) rows model the effect on cumulative incidence with competing deaths retained in the risk ",
      "set, also unmatched. Death after discharge without recorded re-treatment is a COMPETING EVENT, not ",
      "censoring. For the full-cohort (cause-specific/subdistribution) rows, N and N re-treated are model ",
      "totals across all three arms, not per-row; for the matched rows they are specific to that comparison. ",
      "PH test does not apply to the Fine-Gray rows or to the matched rows (not computed)."))
  , "hr_postdischarge_rejection")

#-------------------------------------------------------------------------------
# 19c. CO-PRIMARY ENDPOINT 2: Graft Failure, Discharge-Anchored, Time-to-Event
#-------------------------------------------------------------------------------
# REPLACES section 24-25 as the primary graft-failure analysis, for two reasons
# that the fixed-window binary cannot fix:
#
#   1. IT USES ALL THE FOLLOW-UP. The binary needs a patient watched through day
#      YR2_END before it can score them, which is why the CDA arm collapses
#      from ~198 to ~93 there. A time-to-event model needs no such restriction:
#      a patient with 300 days of follow-up contributes 300 days of it. The
#      arm-size problem in the year-2 models is an artefact of the instrument,
#      not of the cohort.
#
#   2. IT TREATS DEATH AS A COMPETING RISK. GRF_FAIL_EVENT is derived from the
#      presence of a graft-failure date, so a patient who dies with a working
#      graft has GRF_FAIL_EVENT == 0 and the binary counts them as a graft
#      SUCCESS. That is not a rounding error here: the treated arms have higher
#      mortality, so the arm with more deaths is credited with more surviving
#      grafts, biasing the contrast toward treatment.
#
# TWO MODELS, because they answer different questions and a reviewer will ask
# which one is being reported:
#   CAUSE-SPECIFIC Cox -- the rate of graft failure among patients still alive
#     with a functioning graft. This is the aetiological question ("does the
#     therapy damage the graft?") and is the primary model here.
#   FINE-GRAY subdistribution -- the effect on the cumulative INCIDENCE of graft
#     failure, with deaths retained in the risk set. This is the prognostic
#     question ("what share of these patients will lose the graft?"). Reported
#     alongside; where the two disagree, the disagreement IS the competing-risk
#     effect and both belong in the manuscript.
#
# Time origin is discharge, matching section 19, so the two primary outcomes
# share an anchor and an eligible cohort.
#-------------------------------------------------------------------------------

df_dc_grf <- df_dc %>%
  left_join(df_graft_time %>% select(TRR_ID_CODE, GRF_FAIL_EVENT, GRF_TIME_DAYS),
            by = "TRR_ID_CODE") %>%
  mutate(
    # Both clocks restarted at discharge.
    grf_day_post_dc = GRF_TIME_DAYS - DC_DAY,
    fu_days_post_dc = PTIME - DC_DAY,

    # Competing-risk status: 0 = censored, 1 = graft failure, 2 = death with a
    # functioning graft. A death that FOLLOWS a graft failure is not a competing
    # event -- the graft failure already happened and is the event of interest.
    grf_time_raw = if_else(GRF_FAIL_EVENT == 1L,
                           grf_day_post_dc,
                           fu_days_post_dc),
    grf_status_raw = case_when(
      GRF_FAIL_EVENT == 1L ~ 1L,   # graft failure
      event == 1L          ~ 2L,   # died, graft never recorded as failed
      TRUE                 ~ 0L    # alive with functioning graft at last contact
    )
  ) %>%
  # Administrative censoring at the shared horizon.
  mutate(
    grf_status = if_else(!is.na(grf_time_raw) & grf_time_raw > DC_HORIZON_LONG,
                         0L, grf_status_raw),
    grf_time   = pmin(grf_time_raw, DC_HORIZON_LONG)
  )

# WHO IS DROPPED, AND WHY. `filter(grf_time > 0)` removes patients whose graft
# clock had already run out at the moment their survival clock starts -- almost
# all of them grafts recorded as failed DURING the index admission. Excluding
# them is right (the event precedes the time origin, so including it would be
# immortal time in reverse), but the exclusion was silent, and it falls on a
# co-primary endpoint. It is now counted and printed.
grf_pre_dc <- df_dc_grf %>%
  filter(is.na(grf_time) | grf_time <= 0)

message("\nGraft-failure cohort: excluded ", nrow(grf_pre_dc), " of ", nrow(df_dc_grf),
        " discharge-cohort patients whose graft clock ends at or before discharge")
if (nrow(grf_pre_dc)) {
  message("  of these, graft failures recorded before/at discharge: ",
          sum(grf_pre_dc$GRF_FAIL_EVENT == 1L, na.rm = TRUE),
          " | non-events with an incoherent graft date: ",
          sum(grf_pre_dc$GRF_FAIL_EVENT != 1L, na.rm = TRUE))
  message("  by arm:")
  print(table(grf_pre_dc$ARM, useNA = "ifany"))
}
n_grf_excluded    <- nrow(grf_pre_dc)
n_grf_excl_events <- sum(grf_pre_dc$GRF_FAIL_EVENT == 1L, na.rm = TRUE)

df_dc_grf <- df_dc_grf %>%
  filter(!is.na(grf_time), grf_time > 0) %>%
  mutate(grf_status_f = factor(grf_status, levels = 0:2,
                               labels = c("censored", "graft failure", "death")))

message("Discharge-anchored graft-failure cohort: ", nrow(df_dc_grf),
        " of ", nrow(df_dc), " in the discharge cohort")
print(table(df_dc_grf$ARM, df_dc_grf$grf_status_f))

keep(
  df_dc_grf %>%
    group_by(ARM, .drop = FALSE) %>%
    summarise(
      n           = n(),
      n_grf       = sum(grf_status == 1L),
      pct_grf     = 100 * n_grf / pmax(n, 1),
      n_death_cr  = sum(grf_status == 2L),
      pct_death   = 100 * n_death_cr / pmax(n, 1),
      med_fu      = median(grf_time),
      .groups = "drop"
    ) %>%
    gt() %>%
    fmt_number(columns = c(pct_grf, pct_death, med_fu), decimals = 1) %>%
    cols_label(ARM = "Arm at discharge", n = "N",
               n_grf = "N graft failures", pct_grf = "% graft failure",
               n_death_cr = "N deaths, graft functioning",
               pct_death = "% competing death",
               med_fu = "Median observed time, d") %>%
    tab_header(
      title = "Graft Failure and Competing Death, Discharge-Anchored",
      subtitle = paste0("Time origin = discharge; follow-up to ",
                        round(DC_HORIZON_LONG), " days post-discharge")) %>%
    tab_options(table.font.size = 13, data_row.padding = px(4),
                column_labels.font.weight = "bold") %>%
    tab_source_note(paste0(
      "Unlike the fixed-window binary in section 24, no patient is required to have been observed ",
      "through day ", round(YR2_END), " -- everyone contributes the follow-up they have, which is why ",
      "the arm Ns here are the full discharge-cohort Ns. The '% competing death' column is the reason a ",
      "binary graft-failure outcome misleads: those patients are counted as NOT having graft failure, ",
      "and they are more common in the treated arms, so the binary credits the higher-mortality arm with ",
      "better graft survival. 'Median observed time' is the median of the censored follow-up variable; ",
      "reverse-KM median follow-up for this cohort is in the follow-up table in section 19. EXCLUSIONS: ",
      n_grf_excluded, " patient(s) whose graft clock ends at or before their own discharge are not in this ",
      "table (", n_grf_excl_events, " of them grafts recorded as failed during the index admission, the ",
      "rest incoherent graft dates). Their event precedes the time origin, so including them would be ",
      "immortal time in reverse; the count is stated here because the exclusion falls on a co-primary ",
      "endpoint and was previously silent."))
  , "dc_graft_failure_summary")

# --- Cumulative incidence, competing risks accounted for ---
fit_dc_grf_cif <- survfit(Surv(grf_time, grf_status_f) ~ ARM,
                          data = df_dc_grf %>%
                            filter(ARM %in% c("Steroids", "CDA", "Control")) %>%
                            mutate(ARM = droplevels(ARM)))

# cif_tidy()/plot_cif() live in section 18 and are shared with the
# post-discharge-therapy curve in 19b, so the two competing-risks figures cannot
# drift apart in estimator or in axis handling. They are built with ggplot
# directly rather than through ggsurvplot(): survminer's surv_summary() assumes
# a two-state survfit and errors on a multi-state (competing-risks) object with
# "arguments imply differing number of rows", and fix_origin() is likewise
# survminer-specific.
keep(
  plot_cif(
    cif_tidy(fit_dc_grf_cif, "graft failure"),
    title    = "Graft Failure After Discharge (Aalen-Johansen Cumulative Incidence)",
    subtitle = "Co-primary endpoint; death with a functioning graft treated as a competing risk",
    xlab     = "Days since discharge",
    ylab     = "Cumulative incidence of graft failure",
    legend_title = "Arm at discharge",
    break_by = 180, max_time = DC_HORIZON_LONG)
  , "cuminc_dc_graft_failure")

# --- Model 1: cause-specific Cox (primary) ---
df_dc_grf_3arm <- df_dc_grf %>%
  filter(ARM %in% c("Steroids", "CDA", "Control")) %>%
  mutate(ARM = relevel(droplevels(ARM), ref = "Control"))

# Named rather than joined inline, so the centre-stratified refit in section 19e
# is demonstrably the SAME model on the SAME frame with one term changed. When
# this join was written inline, any divergence between the two would have been
# invisible.
df_dc_grf_3arm_adj <- df_dc_grf_3arm %>%
  select(-any_of(setdiff(names(baseline_covs), "TRR_ID_CODE"))) %>%
  left_join(baseline_covs, by = "TRR_ID_CODE")

cox_dc_grf <- coxph(
  as.formula(paste0("Surv(grf_time, grf_status == 1L) ~ ARM",
                    adj_formula_suffix, centre_cluster_term(df_dc_grf_3arm_adj))),
  data = df_dc_grf_3arm_adj)
print(summary(cox_dc_grf))

# --- Model 2: Fine-Gray subdistribution (sensitivity) ---
# finegray() expands the data with time-varying weights that keep the competing
# deaths in the risk set; the resulting model MUST be fitted with those weights.
# `~ .` puts every column of the frame on the right-hand side and carries all of
# them through the expansion. Restricted to the three variables the model needs,
# matching the post-discharge-therapy Fine-Gray in 19b.
#
# This is a MEMORY fix, not a correctness fix -- checked rather than assumed:
# finegray() does NOT drop rows for NAs in unused right-hand-side columns, so
# the row and event counts are identical either way. What differs is the width
# of the expanded frame, and finegray() multiplies rows by roughly the number of
# distinct event times, so on ~82,000 patients the difference between carrying 3
# columns and carrying 20 (several of them Dates) is gigabytes.
fg_dc_grf <- tryCatch({
  fg <- finegray(Surv(grf_time, grf_status_f) ~ .,
                 data = df_dc_grf_3arm %>% select(ARM, grf_time, grf_status_f),
                 etype = "graft failure")
  coxph(Surv(fgstart, fgstop, fgstatus) ~ ARM, data = fg, weights = fgwt)
}, error = function(e) {
  message("Fine-Gray model failed (", conditionMessage(e), ") -- reporting cause-specific only")
  NULL
})
if (!is.null(fg_dc_grf)) {
  # The subdistribution model must describe the same patients as the
  # cause-specific one; if it does not, the two rows in the table are not
  # comparable and the difference is not a competing-risk effect.
  if (fg_dc_grf$nevent != sum(df_dc_grf_3arm$grf_status == 1L)) {
    warning("Fine-Gray event count (", fg_dc_grf$nevent, ") does not match the cause-specific ",
            "event count (", sum(df_dc_grf_3arm$grf_status == 1L),
            "); the two models are not fitted on the same data.")
  }
}
if (!is.null(fg_dc_grf)) print(summary(fg_dc_grf))

# --- Matched cause-specific models, one per comparison ---
run_grf_dc <- function(match_res, ref_arm, label) {
  if (is.null(match_res)) return(NULL)
  d <- match_res$data %>%
    left_join(df_graft_time %>% select(TRR_ID_CODE, GRF_FAIL_EVENT, GRF_TIME_DAYS),
              by = "TRR_ID_CODE") %>%
    mutate(
      grf_time_raw = if_else(GRF_FAIL_EVENT == 1L, GRF_TIME_DAYS - DC_DAY, PTIME - DC_DAY),
      grf_status   = case_when(GRF_FAIL_EVENT == 1L ~ 1L, event == 1L ~ 2L, TRUE ~ 0L),
      grf_status   = if_else(!is.na(grf_time_raw) & grf_time_raw > DC_HORIZON_LONG, 0L, grf_status),
      grf_time     = pmin(grf_time_raw, DC_HORIZON_LONG)
    ) %>%
    filter(!is.na(grf_time), grf_time > 0) %>%
    mutate(ARM = relevel(droplevels(ARM), ref = ref_arm))

  if (nlevels(d$ARM) < 2 || sum(d$grf_status == 1L) < 5) {
    message("skipping graft-failure model -- fewer than 5 failures: ", label)
    return(NULL)
  }

  describe_match_weights(d, label)
  fit <- coxph(as.formula(paste0("Surv(grf_time, grf_status == 1L) ~ ARM",
                                 if ("subclass" %in% names(d)) " + cluster(subclass)" else "")),
               data = d, weights = match_weights(d))
  s <- summary(fit)
  tibble(
    Comparison = label,
    Direction  = paste0(rownames(s$conf.int)[1], "  (ref = ", ref_arm, ")"),
    n          = fit$n,
    events     = sum(d$grf_status == 1L),
    HR         = s$conf.int[1, "exp(coef)"],
    CI_lower   = s$conf.int[1, "lower .95"],
    CI_upper   = s$conf.int[1, "upper .95"],
    p_value    = s$coefficients[1, "Pr(>|z|)"]
  )
}

hr_results_dc_grf <- bind_rows(
  run_grf_dc(dc_match_combined_steroid, "Steroids", "CDA vs Steroids (matched)"),
  run_grf_dc(dc_match_combined_control, "Control",  "CDA vs Control (matched)"),
  run_grf_dc(dc_match_steroid_control,  "Control",  "Steroids vs Control (matched)")
)

# Whole-cohort rows from the two 3-arm models, so the table shows the adjusted
# full-cohort result next to the matched ones.
s_cs <- summary(cox_dc_grf)
cs_rows <- tibble(
  Comparison = paste0(str_remove(rownames(s_cs$conf.int), "^ARM"),
                      " vs Control (full cohort, adjusted)"),
  Direction  = "cause-specific",
  n          = cox_dc_grf$n,
  events     = cox_dc_grf$nevent,
  HR         = s_cs$conf.int[, "exp(coef)"],
  CI_lower   = s_cs$conf.int[, "lower .95"],
  CI_upper   = s_cs$conf.int[, "upper .95"],
  p_value    = s_cs$coefficients[, "Pr(>|z|)"]
) %>% filter(str_detect(Comparison, "^(Steroids|CDA|Dual)"))

fg_rows <- if (!is.null(fg_dc_grf)) {
  s_fg <- summary(fg_dc_grf)
  tibble(
    Comparison = paste0(str_remove(rownames(s_fg$conf.int), "^ARM"),
                        " vs Control (full cohort, Fine-Gray)"),
    Direction  = "subdistribution",
    # NOT fg_dc_grf$n: finegray() expands each patient into many time-weighted
    # rows, so the model's n is a row count in the millions. The N a reader
    # needs is the number of PATIENTS the model describes.
    n          = nrow(df_dc_grf_3arm),
    events     = fg_dc_grf$nevent,
    HR         = s_fg$conf.int[, "exp(coef)"],
    CI_lower   = s_fg$conf.int[, "lower .95"],
    CI_upper   = s_fg$conf.int[, "upper .95"],
    p_value    = s_fg$coefficients[, "Pr(>|z|)"]
  )
} else NULL

keep(
  bind_rows(hr_results_dc_grf, cs_rows, fg_rows) %>%
    mutate(
      `HR (95% CI)` = sprintf("%.2f (%.2f–%.2f)", HR, CI_lower, CI_upper),
      `P value` = case_when(p_value < 0.001 ~ "<0.001", TRUE ~ sprintf("%.3f", p_value))
    ) %>%
    select(Comparison, Direction, n, events, `HR (95% CI)`, `P value`) %>%
    gt() %>%
    cols_label(Comparison = "Comparison", Direction = "Model type", n = "N",
               events = "Graft failures", `HR (95% CI)` = "Hazard Ratio (95% CI)",
               `P value` = "P value") %>%
    tab_header(
      title = "Hazard Ratios for Graft Failure, Discharge-Anchored",
      subtitle = paste0("Time origin = discharge; follow-up to ",
                        round(DC_HORIZON_LONG), " days post-discharge")) %>%
    tab_options(table.font.size = 13, data_row.padding = px(4),
                column_labels.font.weight = "bold") %>%
    tab_source_note(paste0(
      "CO-PRIMARY ENDPOINT 2 (graft failure), replacing the fixed-window binary in sections 24-25. Every ",
      "patient contributes the follow-up they have, so no one is excluded for having been transplanted ",
      "too recently. CAUSE-SPECIFIC rows model the rate of graft failure among patients still alive with ",
      "a functioning graft (aetiological question); FINE-GRAY rows model the effect on cumulative ",
      "incidence with competing deaths retained in the risk set (prognostic question). Where the two ",
      "diverge, the divergence is the competing-risk effect and both should be reported. Matched rows ",
      "are 1:", MATCH_RATIO, " propensity-matched, weighted, and clustered on the matched set. Death ",
      "with a functioning graft is a COMPETING EVENT here, not a graft success -- which is the error the ",
      "binary version makes."))
  , "hr_dc_graft_failure")

#===============================================================================
# 19d. CONFIRMATORY TESTING: multiplicity control across the co-primary endpoints
#-------------------------------------------------------------------------------
# Evaluates the strategy declared in section 0b MECHANICALLY, so the result is
# whatever the pre-specified rule produces rather than a sentence composed after
# looking at the p-values.
#
# Under "hierarchical", the endpoints are tested in the declared order, each at
# the full alpha. The moment one fails, testing STOPS: every later endpoint is
# descriptive only, regardless of its p-value. That is the price of keeping full
# power on the first endpoint, and it is why the ordering had to be justified
# clinically before the run.
#
# Only the CONFIRMATORY_ARM contrast is tested. Everything else in this script --
# the other arm contrasts, both sensitivity anchors, every year-2 odds ratio,
# every baseline-table p-value -- is exploratory and must be labelled as such.
#===============================================================================

# Pull the confirmatory p-value for one endpoint out of its results frame,
# without assuming a row exists: a comparison that could not be estimated must
# produce NA and a clear reason, not an error or a silently wrong row.
confirm_p <- function(res, pattern, endpoint_label) {
  if (is.null(res) || !nrow(res)) {
    return(tibble(Endpoint = endpoint_label, HR = NA_real_, CI_lower = NA_real_,
                  CI_upper = NA_real_, p_value = NA_real_,
                  Note = "no results frame"))
  }
  hit <- res %>% filter(grepl(pattern, Comparison))
  if (nrow(hit) != 1) {
    return(tibble(Endpoint = endpoint_label, HR = NA_real_, CI_lower = NA_real_,
                  CI_upper = NA_real_, p_value = NA_real_,
                  Note = paste0(nrow(hit), " rows matched \"", pattern, "\"")))
  }
  hit %>% transmute(Endpoint = endpoint_label, HR, CI_lower, CI_upper, p_value,
                    Note = NA_character_)
}

# Row patterns differ by model choice. Both endpoints are read from the SAME
# model type so the two steps of the sequence are comparable.
conf_pattern <- if (CONFIRMATORY_MODEL == "full_cohort_adjusted") {
  paste0("^", CONFIRMATORY_ARM, " vs Control \\(full cohort, adjusted\\)$")
} else {
  paste0("^", CONFIRMATORY_ARM, " vs Control \\(matched\\)$")
}

confirmatory <- bind_rows(
  confirm_p(if (CONFIRMATORY_MODEL == "full_cohort_adjusted") mort_cohort_rows else hr_results_dc,
            conf_pattern, "1. All-cause mortality (section 19)"),
  confirm_p(if (CONFIRMATORY_MODEL == "full_cohort_adjusted") cs_rows else hr_results_dc_grf,
            conf_pattern, "2. Graft failure, cause-specific (section 19c)")
)

# --- Apply the strategy ---
n_ep <- nrow(confirmatory)
confirmatory <- confirmatory %>%
  mutate(
    alpha = switch(ALPHA_STRATEGY,
                   hierarchical = ALPHA_TOTAL,
                   bonferroni   = ALPHA_TOTAL / n_ep,
                   none         = ALPHA_TOTAL)
  )

if (ALPHA_STRATEGY == "hierarchical") {
  # Walk the sequence. `gate_open` stays TRUE only while every preceding
  # endpoint has rejected; once it closes it never reopens.
  gate_open <- TRUE
  outcome   <- character(n_ep)
  for (i in seq_len(n_ep)) {
    p_i <- confirmatory$p_value[i]
    if (!gate_open) {
      outcome[i] <- "Not tested — sequence stopped earlier"
    } else if (is.na(p_i)) {
      outcome[i] <- "Not estimable — sequence stops"
      gate_open  <- FALSE
    } else if (p_i < confirmatory$alpha[i]) {
      outcome[i] <- "Significant — sequence continues"
    } else {
      outcome[i] <- "Not significant — sequence stops here"
      gate_open  <- FALSE
    }
  }
  confirmatory$Outcome <- outcome
} else {
  confirmatory <- confirmatory %>%
    mutate(Outcome = case_when(
      is.na(p_value)      ~ "Not estimable",
      p_value < alpha     ~ "Significant",
      TRUE                ~ "Not significant"))
}

message("\n=== CONFIRMATORY TESTING (", ALPHA_STRATEGY, ", total alpha = ", ALPHA_TOTAL, ") ===")
message("Contrast: ", CONFIRMATORY_ARM, " vs Control | model: ", CONFIRMATORY_MODEL)
for (i in seq_len(n_ep)) {
  message(sprintf("  %-46s HR %.2f (%.2f-%.2f), p = %s  [alpha %.4f] -> %s",
                  confirmatory$Endpoint[i], confirmatory$HR[i],
                  confirmatory$CI_lower[i], confirmatory$CI_upper[i],
                  if (is.na(confirmatory$p_value[i])) "NA" else
                    format.pval(confirmatory$p_value[i], digits = 3, eps = 0.001),
                  confirmatory$alpha[i], confirmatory$Outcome[i]))
}
if (ALPHA_STRATEGY == "hierarchical" && any(grepl("stops", confirmatory$Outcome))) {
  message("  NOTE: the sequence stopped. Every endpoint after the stop is DESCRIPTIVE ONLY")
  message("        and must not be reported as a confirmed finding, whatever its p-value.")
}

keep(
  confirmatory %>%
    mutate(
      `HR (95% CI)` = if_else(is.na(HR), coalesce(Note, "not estimable"),
                              sprintf("%.2f (%.2f–%.2f)", HR, CI_lower, CI_upper)),
      `P value`  = case_when(is.na(p_value)  ~ "—",
                             p_value < 0.001 ~ "<0.001",
                             TRUE ~ sprintf("%.3f", p_value)),
      `Alpha`    = sprintf("%.4f", alpha)
    ) %>%
    select(Endpoint, `HR (95% CI)`, `P value`, `Alpha`, Outcome) %>%
    gt() %>%
    cols_label(Endpoint = "Endpoint (tested in this order)",
               `HR (95% CI)` = "Hazard Ratio (95% CI)", `P value` = "P value",
               `Alpha` = "Alpha at this step", Outcome = "Result") %>%
    tab_header(
      title = paste0("Confirmatory Testing: ", CONFIRMATORY_ARM, " vs Control"),
      subtitle = paste0(
        switch(ALPHA_STRATEGY,
               hierarchical = "Hierarchical (fixed-sequence) testing",
               bonferroni   = "Bonferroni-split alpha",
               none         = "NO multiplicity control"),
        "; total alpha = ", ALPHA_TOTAL)) %>%
    tab_options(table.font.size = 13, data_row.padding = px(4),
                column_labels.font.weight = "bold") %>%
    tab_source_note(paste0(
      "PRE-SPECIFIED MULTIPLICITY CONTROL across the two co-primary endpoints. ",
      if (ALPHA_STRATEGY == "hierarchical") paste0(
        "Endpoints are tested in the order shown, each at the full alpha of ", ALPHA_TOTAL,
        ". Testing stops at the first endpoint that does not reject; any endpoint below that point is ",
        "DESCRIPTIVE ONLY and must not be reported as confirmed, however small its p-value. The ordering ",
        "is a clinical judgement made before the analysis -- mortality precedes graft failure because it ",
        "is the harder endpoint, the least dependent on registry ascertainment, and the one that drives ",
        "clinical decisions -- not a ranking by observed significance. Because the full alpha is spent at ",
        "each step, the intervals remain 95%. ")
      else if (ALPHA_STRATEGY == "bonferroni") paste0(
        "Each endpoint is tested at ", ALPHA_TOTAL, "/", n_ep, " = ",
        signif(ALPHA_TOTAL / n_ep, 3), ". Intervals are reported at ",
        round(100 * CONF_LEVEL, 1), "% to match the alpha actually spent. ")
      else "NO correction is applied; these p-values are exploratory. ",
      "ONLY the ", CONFIRMATORY_ARM, " vs Control contrast is confirmatory. The CDA arm carries too ",
      "few patients and events (see the follow-up table in section 19) to support a confirmatory claim on ",
      "either endpoint, and no multiplicity scheme changes that -- it is a power limitation, not an alpha ",
      "one. Every other contrast in this script, both sensitivity anchors, all year-2 odds ratios and all ",
      "baseline-table p-values remain EXPLORATORY."))
  , "confirmatory_testing")


#===============================================================================
# 19e. SENSITIVITY ANALYSIS: Centre-Level Confounding
#-------------------------------------------------------------------------------
# CLUSTER_BY_CENTRE corrects the standard errors. It does not correct the
# ESTIMATE. Centre predicts both the exposure (which anti-rejection drug a unit
# reaches for is institutional protocol) and the outcome (volume, ICU practice,
# case mix), so it confounds the contrast, and a cluster-robust variance leaves
# that confounding completely intact. This section removes it two ways and
# reports what changes.
#
#   MODEL 1  strata(CENTRE): each centre carries its own baseline hazard, so all
#            comparisons are within-centre. Removes measured AND unmeasured
#            centre-level confounding of baseline risk.
#            IT COSTS NO PATIENTS. A stratum contributes to the arm coefficient
#            whenever it holds one event and more than one arm -- it does not
#            need several treated patients in that centre. In this cohort all
#            198 CDA patients sit in informative strata, because Control is
#            present in every centre that holds a CDA patient.
#            What it costs is PRECISION: within-centre comparison uses less
#            information, so the intervals on the small arms widen.
#
#   MODEL 2  exact = "CENTRE" in the propensity match: a treated patient can only
#            be matched to a control from their OWN centre. Stronger than
#            stratification, but only feasible where the comparator saturates the
#            centres. Run for the confirmatory contrast (Steroids vs Control),
#            where Control is present in every centre; NOT run for CDA vs
#            Steroids, where the comparator is far sparser.
#
# These are SENSITIVITY analyses. The primary models are unchanged, and the
# confirmatory gate in 19d runs on them, not on these.
#===============================================================================

if (CENTRE_SENSITIVITY && CLUSTER_BY_CENTRE && n_distinct(df_dc_3arm_adj$CENTRE) > 1) {

  # Tidy the ARM rows out of a fitted Cox model into comparable form.
  arm_rows <- function(fit, endpoint, model_lbl, n_patients = NULL) {
    s  <- summary(fit)
    ci <- s$conf.int
    co <- s$coefficients
    keep_r <- grepl("^ARM", rownames(ci))
    if (!any(keep_r)) return(NULL)
    p_col <- grep("^Pr\\(>\\|[zt]\\|\\)$", colnames(co), value = TRUE)[1]
    tibble(
      Endpoint  = endpoint,
      Model     = model_lbl,
      Arm       = sub("^ARM", "", rownames(ci)[keep_r]),
      n         = if (is.null(n_patients)) fit$n else n_patients,
      events    = fit$nevent,
      HR        = ci[keep_r, "exp(coef)"],
      CI_lower  = ci[keep_r, "lower .95"],
      CI_upper  = ci[keep_r, "upper .95"],
      p_value   = co[keep_r, p_col]
    )
  }

  # --- Model 1: centre-stratified refits of both co-primary endpoints ---
  # Identical to the primary models except that cluster(CENTRE) is replaced by
  # strata(CENTRE): stratification already accounts for between-centre
  # differences in baseline risk, and coxph takes one or the other.
  cox_mort_strat <- coxph(
    as.formula(paste0("Surv(time_dc, event_dc) ~ ARM", adj_formula_suffix,
                      " + strata(CENTRE)")),
    data = df_dc_3arm_adj)
  print(summary(cox_mort_strat))

  cox_grf_strat <- coxph(
    as.formula(paste0("Surv(grf_time, grf_status == 1L) ~ ARM", adj_formula_suffix,
                      " + strata(CENTRE)")),
    data = df_dc_grf_3arm_adj)
  print(summary(cox_grf_strat))

  message("\nCentre-stratified models: mortality n = ", cox_mort_strat$n,
          " events = ", cox_mort_strat$nevent,
          " | graft failure n = ", cox_grf_strat$n,
          " events = ", cox_grf_strat$nevent)
  message("  Compare against the primary models: identical n and events means ",
          "stratification cost no patients, only precision.")

  # --- Model 2: centre-exact propensity match, confirmatory contrast only ---
  dc_match_steroid_control_centre <- match_within_dc(
    df_dc_long, "Steroids", "Control",
    "Discharge: Steroid vs Control (centre-exact)", exact_centre = TRUE)

  centre_matched_mort <- if (!is.null(dc_match_steroid_control_centre)) {
    run_coxph_dc(dc_match_steroid_control_centre$data, "Control",
                 "Steroids vs Control (centre-exact matched)")
  } else NULL

  centre_matched_grf <- if (!is.null(dc_match_steroid_control_centre)) {
    run_grf_dc(dc_match_steroid_control_centre, "Control",
               "Steroids vs Control (centre-exact matched)")
  } else NULL

  # --- Assemble the comparison ---
  centre_sens <- bind_rows(
    arm_rows(cox_dc_mort_adj,  "Mortality",     "Primary: adjusted + centre-clustered"),
    arm_rows(cox_mort_strat,   "Mortality",     "Sensitivity: centre-STRATIFIED"),
    if (!is.null(centre_matched_mort)) centre_matched_mort %>%
      transmute(Endpoint = "Mortality", Model = "Sensitivity: centre-EXACT matched",
                Arm = "Steroids", n, events, HR, CI_lower, CI_upper, p_value),
    arm_rows(cox_dc_grf,       "Graft failure", "Primary: adjusted + centre-clustered"),
    arm_rows(cox_grf_strat,    "Graft failure", "Sensitivity: centre-STRATIFIED"),
    if (!is.null(centre_matched_grf)) centre_matched_grf %>%
      transmute(Endpoint = "Graft failure", Model = "Sensitivity: centre-EXACT matched",
                Arm = "Steroids", n, events, HR, CI_lower, CI_upper, p_value)
  ) %>%
    filter(Arm %in% c("Steroids", "CDA")) %>%
    # log-scale CI width is the honest precision comparison: hazard ratios are
    # multiplicative, so an arithmetic CI width is not comparable across
    # estimates centred at different values.
    mutate(logCI_width = log(CI_upper) - log(CI_lower))

  print(centre_sens)

  keep(
    centre_sens %>%
      mutate(
        `HR (95% CI)` = sprintf("%.2f (%.2f–%.2f)", HR, CI_lower, CI_upper),
        `P value` = case_when(p_value < 0.001 ~ "<0.001", TRUE ~ sprintf("%.3f", p_value)),
        `log-CI width` = sprintf("%.2f", logCI_width)
      ) %>%
      select(Endpoint, Arm, Model, n, events, `HR (95% CI)`, `P value`, `log-CI width`) %>%
      gt(groupname_col = "Endpoint") %>%
      cols_label(Arm = "Arm (ref = Control)", Model = "Model", n = "N", events = "Events",
                 `HR (95% CI)` = "Hazard Ratio (95% CI)", `P value` = "P value",
                 `log-CI width` = "log-CI width (precision)") %>%
      tab_header(
        title = "Centre-Level Confounding: Sensitivity Analyses",
        subtitle = "Does controlling for transplant centre by DESIGN change the estimate?") %>%
      tab_options(table.font.size = 13, data_row.padding = px(4),
                  column_labels.font.weight = "bold", row_group.font.weight = "bold") %>%
      tab_source_note(paste0(
        "Cluster-robust standard errors (the primary models) correct the INFERENCE for non-independence ",
        "within centres but leave the POINT ESTIMATE untouched -- they do not control centre as a ",
        "confounder. These two designs do. CENTRE-STRATIFIED gives every centre its own baseline hazard, ",
        "so all comparisons are within-centre; it costs no patients, because a stratum contributes ",
        "whenever it holds one event and more than one arm. CENTRE-EXACT MATCHED restricts every matched ",
        "pair to a single institution, and is run only for Steroids vs Control, the one contrast whose ",
        "comparator is present in essentially every centre. The column to read is the HAZARD RATIO, not ",
        "the p-value: if the estimate is stable across all three rows, centre-level confounding is not ",
        "driving the result, which is the claim these analyses exist to support. 'log-CI width' quantifies ",
        "what the stronger designs cost in precision -- hazard ratios are multiplicative, so widths are ",
        "compared on the log scale. Both sensitivity models are EXPLORATORY: the confirmatory gate in ",
        "section 19d runs on the primary models."))
    , "centre_confounding_sensitivity")

} else {
  message("\nSection 19e skipped: CENTRE_SENSITIVITY = ", CENTRE_SENSITIVITY,
          ", CLUSTER_BY_CENTRE = ", CLUSTER_BY_CENTRE,
          " (a centre variable with >1 level is required).")
  centre_sens <- NULL
}


#===============================================================================
# 20. SENSITIVITY ANALYSIS: Landmark-Anchored Survival
#-------------------------------------------------------------------------------
# NOT THE PRIMARY ANALYSIS -- see section 19. Retained because it is the design
# a reader may expect, and because agreement between the two anchors is the
# strongest available evidence that the result is not an artefact of either.
#
# Arms are IDENTICAL to section 19. What differs:
#   - Eligibility: survival to day LANDMARK_DAY post-transplant, rather than
#     survival to one's own discharge. This DISCARDS early deaths that the
#     primary analysis retains.
#   - Post-landmark therapy is folded into the Control arm rather than treated
#     as an outcome, which attenuates every treated-vs-Control contrast.
#
# Because all exposure events occur on the imputed index-admission day,
# LANDMARK_DAY no longer affects arm membership at all -- any value above
# INPATIENT_RX_DAY gives the same arms. It now controls only how many early
# deaths are excluded.
#===============================================================================


# --- Step 2: build the landmark survival dataset ---
# Three things happen together and all three are necessary:
#   (a) arms assigned from exposure BEFORE the landmark,
#   (b) patients not still under observation AT the landmark are DROPPED,
#   (c) the clock is reset so t = 0 is the landmark.
# Doing (a) without (b) and (c) is exactly the original bug.
build_landmark_surv <- function(landmark_day, horizon_days) {
  arms <- assign_arm_at_landmark(landmark_day)
  
  out <- df_survival %>%
    inner_join(arms, by = "TRR_ID_CODE") %>%
    filter(!is.na(PTIME), PTIME >= landmark_day) %>%     # (b)
    mutate(
      time_raw = PTIME - landmark_day,                   # (c)
      event_lm = if_else(time_raw <= horizon_days, event, 0),
      time_lm  = pmin(time_raw, horizon_days),
      ARM = factor(as.character(ARM), levels = ARM_LEVELS)
    )
  
  n_zero <- sum(out$time_lm == 0)
  if (n_zero > 0) {
    message("  note: ", n_zero, " patient(s) have exactly 0 days of post-landmark follow-up")
  }
  out
}

