  "ANTILFA1", "ANTIICAM1", "IL1RECEPTORANTAGONIST", "ANTIIL6", "ANTITNF",
  "SOLUBLEIL1RECEPTOR", "ALDESLEUKIN", "T10B9", "SANDIMMUNE",
  "DEOXYSPERGUALIN", "NEORAL", "SANGCYA", "THYMOGLOBULIN", "ZENAPAX",
  "SIMULECT", "GENGRAF", "ZORTRESS", "EON", "MYFORTIC", "GENERICCYCLOSPORIN",
