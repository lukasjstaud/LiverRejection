# Shared ascertainment rule for the fixed-window year-2 outcomes. Both outcomes
# call this, on their OWN clock (PTIME for treatment, GRF_TIME_DAYS for graft
# failure), so the two cannot drift apart on what "observed" means.
#
#   ids        candidate patient IDs
#   obs_time   named numeric: that patient's observed time on the relevant clock
#   had_event  named logical: the event was observed inside the window
yr2_ascertained_ids <- function(ids, obs_time, had_event, label) {
  ids <- unique(ids)
  ot  <- obs_time[ids]
  ev  <- had_event[ids]
  ev[is.na(ev)] <- FALSE

  pfu <- setNames(potential_fu$POTENTIAL_FU_DAYS, potential_fu$TRR_ID_CODE)[ids]

  at_risk_at_start <- !is.na(ot) & ot >= YR2_ELIGIBLE_DAY

  if (YR2_ASCERTAINMENT == "eligible_only") {
    keep_id <- at_risk_at_start
  } else {
    watched_through <- !is.na(ot)  & ot  >= YR2_END &
                       !is.na(pfu) & pfu >= YR2_END
    keep_id <- at_risk_at_start & (watched_through | ev)
  }

  message("\n[", label, "] year-2 ascertainment (rule: ", YR2_ASCERTAINMENT, ")")
  message("  at risk at day ", round(YR2_ELIGIBLE_DAY), ": ", sum(at_risk_at_start))
  if (YR2_ASCERTAINMENT == "complete") {
    message("    dropped, insufficient CALENDAR time since transplant: ",
            sum(at_risk_at_start & !ev & (is.na(pfu) | pfu < YR2_END)))
    message("    dropped, own follow-up ended before day ", round(YR2_END), ": ",
            sum(at_risk_at_start & !ev & !is.na(pfu) & pfu >= YR2_END &
                  (is.na(ot) | ot < YR2_END)))
    message("    retained on an observed event despite short follow-up: ",
            sum(at_risk_at_start & ev &
                  (is.na(ot) | ot < YR2_END | is.na(pfu) | pfu < YR2_END)))
  }
  message("  analysed: ", sum(keep_id),
          sprintf(" (%.1f%% of those at risk at day %s)",
                  100 * sum(keep_id) / max(sum(at_risk_at_start), 1),
                  round(YR2_ELIGIBLE_DAY)))

  ids[keep_id]
}

