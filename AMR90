# 10b. Donor covariates in analysis-ready form (propensity score / adjustment)
#-------------------------------------------------------------------------------
# The donor TABLES in section 16b need labelled character levels ("Yes"/"No").
# A propensity model needs numeric indicators. Deriving both from the same
# source columns here, on df_deceased_don_fil2 itself, means the donor table and
# the donor covariate in the match cannot disagree about who was a DCD donor.
#
# Coding note: "Y"/"N" is mapped explicitly rather than with as.integer(x ==
# "Y"). UNOS carries out-of-range sentinels in these fields (LI_MACHINE_PERFUSION
# has a stray code in this extract), and the == form would silently score every
# sentinel as 0 -- i.e. as a confident "no machine perfusion" -- instead of NA.
yn_bin <- function(x) {
  x <- as.character(x)
  case_when(x == "Y" ~ 1L, x == "N" ~ 0L, TRUE ~ NA_integer_)
}

