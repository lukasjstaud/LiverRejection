# 26. Outcome-Window Results: Propensity-Matched Sensitivity Analysis
#-------------------------------------------------------------------------------
# Sections 23 and 25 are the PRIMARY analysis: covariate-adjusted logistic
# regression on the full eligible cohort. This section repeats both outcomes on
# propensity-matched arms so the two approaches to confounding control can be
# compared.
#
# WHY MATCH HERE RATHER THAN REUSE THE SECTION-14 / SECTION-20 MATCHES:
#   - Section 14 matched on the full cohort.
#   - Section 20 matched within the SURVIVAL landmark cohort (PTIME >= 90).
#   Neither is the outcome cohort, which is defined by a different eligibility
#   rule (PTIME >= 365 for treatment; GRF_TIME_DAYS >= 365 for graft failure)
#   applied to a different denominator. Applying a downstream restriction to an
#   already-matched set breaks pairs non-randomly and reintroduces the
#   imbalance matching removed, so each outcome is matched on its OWN eligible
#   cohort with pairs intact.
#
# ESTIMAND NOTE: matching is pairwise, so unlike the pooled regression above,
# each comparison is its own 1:MATCH_RATIO matched cohort. "CDA vs Control"
# and "Steroids vs Control" do NOT share a control set and their Ns are not
# additive.
#===============================================================================

# ETHCAT is the only match covariate not already carried in the model frames.
ethcat_yr2 <- df_liver_data_filtered %>%
  select(TRR_ID_CODE, ETHCAT) %>%
  distinct(TRR_ID_CODE, .keep_all = TRUE) %>%
  mutate(ETHCAT = factor(ETHCAT))

match_yr2_outcome <- function(model_df, outcome, treat_grp, ctrl_grp, label, seed = 1234) {
  
  d <- model_df %>%
    filter(EXPOSURE_GROUP %in% c(treat_grp, ctrl_grp)) %>%
    mutate(EXPOSURE_GROUP = droplevels(EXPOSURE_GROUP)) %>%
    left_join(ethcat_yr2, by = "TRR_ID_CODE") %>%
    mutate(treat = as.integer(EXPOSURE_GROUP == treat_grp))
  
  # A comparison that cannot be estimated must still appear in the table.
  # Returning NULL here dropped "CDA vs Control" out of the graft-failure
  # sensitivity table entirely, so the exported figure read as a planned
  # two-comparison analysis instead of a three-comparison analysis with one
  # non-estimable cell -- the reader could not tell the difference between
  # "we didn't run it" and "it has no events".
  not_estimable <- function(n, note) {
    tibble(Comparison = label, Model = "Not estimable", N = n,
           OR = NA_real_, CI_lower = NA_real_, CI_upper = NA_real_,
           p_value = NA_real_, Note = note)
  }

  md  <- d %>% select(TRR_ID_CODE, treat, all_of(match_covariates))
  res <- run_match(md, label, seed = seed)
  if (is.null(res)) {
    return(not_estimable(nrow(md),
                         "no match: too few complete cases in one arm"))
  }

  # FIX 5: join subclass/weights instead of filtering to matched_ids, so the
  # models below can be fit on the matched-pair design rather than treating
  # matched patients as an independent sample.
  dm <- d %>%
    inner_join(res$matched_data, by = "TRR_ID_CODE") %>%
    mutate(EXPOSURE_GROUP = relevel(droplevels(EXPOSURE_GROUP), ref = ctrl_grp))

  # Guard against a zero-event arm, which makes the OR non-estimable: the
  # likelihood is maximized at an infinite coefficient, so glm/svyglm would
  # return a huge point estimate with a CI spanning several orders of
  # magnitude rather than anything interpretable. Report the event counts
  # instead of a number, and keep the row.
  ev <- tapply(dm[[outcome]], dm$EXPOSURE_GROUP, sum, na.rm = TRUE)
  ev_txt <- paste(names(ev), ev, sep = " = ", collapse = ", ")
  if (any(ev == 0)) {
    message("non-estimable OR -- an arm has zero events after matching: ", label,
            " (events by arm: ", ev_txt, ")")
    return(not_estimable(nrow(dm),
                         paste0("not estimable — zero events after matching (", ev_txt, ")")))
  }

  # svyglm() with ids = ~subclass clusters the standard errors on the matched
  # pair, so a pair that moves together in outcome doesn't get counted as two
  # independent observations. quasibinomial() avoids the "non-integer #
  # successes" warning svyglm gives with binomial() on weighted/matched data;
  # the point estimates are identical to binomial(), only the dispersion
  # handling differs.
  dsgn <- svydesign(ids = ~subclass, weights = ~weights, data = dm)
  f_unadj <- svyglm(as.formula(paste(outcome, "~ EXPOSURE_GROUP")),
                     design = dsgn, family = quasibinomial())
  f_adj   <- svyglm(as.formula(paste(outcome, "~ EXPOSURE_GROUP +", yr2_adj_covs)),
                     design = dsgn, family = quasibinomial())

  bind_rows(
    or_from(f_unadj, ctrl_grp, "Unadjusted"),
    or_from(f_adj,   ctrl_grp, "Adjusted")
  ) %>%
    mutate(Comparison = label, Note = NA_character_)
}

render_yr2_matched_table <- function(res, title, outcome_phrase) {
  if (is.null(res) || nrow(res) == 0) {
    message("no matched results to render for: ", title)
    return(invisible(NULL))
  }

  # Note is only present on rows match_yr2_outcome could not estimate; add it
  # if absent so this renderer still works on any older result frame.
  if (!"Note" %in% names(res)) res$Note <- NA_character_

  res %>%
    mutate(
      `OR (95% CI)` = if_else(
        is.na(OR), Note, sprintf("%.2f (%.2f\u2013%.2f)", OR, CI_lower, CI_upper)),
      `P value` = case_when(
        is.na(p_value)  ~ "\u2014",
        p_value < 0.001 ~ "<0.001",
        TRUE            ~ sprintf("%.3f", p_value))
    ) %>%
    select(Comparison, Model, N, `OR (95% CI)`, `P value`) %>%
    arrange(Comparison, Model) %>%
    gt(groupname_col = "Comparison") %>%
    cols_label(Model = "Model", N = "N in matched model",
               `OR (95% CI)` = "Odds Ratio (95% CI)", `P value` = "P value") %>%
    tab_header(title = title,
               subtitle = paste0("Sensitivity analysis: 1:", MATCH_RATIO,
                                 " propensity-matched arms")) %>%
    tab_options(table.font.size = 13, data_row.padding = px(4),
                column_labels.font.weight = "bold", row_group.font.weight = "bold") %>%
    tab_source_note(paste0(
      "OR > 1 indicates higher odds of ", outcome_phrase, " relative to the comparison group. ",
      "SENSITIVITY ANALYSIS: each comparison is a separate 1:", MATCH_RATIO,
      " nearest-neighbour propensity match ",
      "(caliper 0.2 SD of the propensity logit; ", paste(match_covariates, collapse = ", "),
      "; HLA mismatch excluded for missingness), performed on that outcome's own eligible cohort with ",
      "pairs intact. The 'Adjusted' model additionally fits the same covariates on the matched set. ",
      "Because each comparison has its own matched control set, Ns are not additive across comparisons. ",
      "Exposure groups are fixed at ", LM_LABEL, ". Compare against the full-cohort adjusted regression, ",
      "which is the primary analysis. Every planned comparison is listed: a comparison whose matched set ",
      "contains no events in one arm has no finite odds ratio and is shown as 'Not estimable' with its ",
      "event counts, rather than being omitted from the table."))
}

