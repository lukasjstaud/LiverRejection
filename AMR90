# --- KM helper, discharge clock ---
plot_dc_km <- function(df, arms_keep, horizon, break_by, title) {
  d <- df %>% filter(ARM %in% arms_keep) %>% mutate(ARM = droplevels(ARM))
  if (nlevels(d$ARM) < 2) {
    message("skipping plot -- fewer than 2 non-empty arms: ", title)
    return(invisible(NULL))
  }
  # Weighted when the frame came from a 1:k match, so the curve shown matches
  # the model reported. survdiff() has no weights argument, so on a matched set
  # the log-rank p is the UNWEIGHTED one; the Cox p in the hazard-ratio tables
  # is the reportable test, and the label below says so.
  w <- match_weights(d)
  fit <- survfit(Surv(time_dc, event_dc) ~ ARM, data = d, weights = w)
  sd_test  <- survdiff(Surv(time_dc, event_dc) ~ ARM, data = d)
  pv       <- 1 - pchisq(sd_test$chisq, length(sd_test$n) - 1)
  pval_lbl <- if (pv < 0.001) "log-rank p < 0.001" else sprintf("log-rank p = %.3f", pv)
  if (!is.null(w) && !isTRUE(all.equal(max(w), min(w))))
    pval_lbl <- paste0(pval_lbl, " (unweighted; see HR table)")
  
  as_event <- identical(KM_PLOT_SCALE, "event")
  p <- ggsurvplot(
    fit, data = d, pval = pval_lbl, conf.int = TRUE, risk.table = TRUE,
    fun = if (as_event) "event" else NULL,
    break.time.by = break_by, legend.title = "Group", legend.labs = levels(d$ARM),
    xlab = "Days since discharge from the index admission",
    ylab = if (as_event) "Cumulative mortality" else "Survival Probability",
    title = title
  )
  # Event scale starts at a true zero, so nothing is truncated and the ceiling
  # is free to follow the data; survival scale spans the full 0-1.
  fix_origin(p, break_by = break_by, max_time = horizon,
             y_min = if (as_event) 0 else km_y_min(fit),
             y_max = if (as_event) km_y_max_event(fit) else 1)
}

