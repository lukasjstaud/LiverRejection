      n_observed = "N still observed",
      n_lost     = "N excluded",
      pct_lost   = "% excluded"
    ) %>%
    tab_header(title = "Attrition by Arm, at the Landmark and at Year-2 Eligibility") %>%
    tab_options(table.font.size = 13, data_row.padding = px(4),
                column_labels.font.weight = "bold", row_group.font.weight = "bold") %>%
    tab_source_note(paste0(
      "TOP BLOCK: patients excluded from the survival analysis because they were no longer under ",
      "observation at day ", round(LANDMARK_DAY), ". A markedly higher exclusion rate in Control is the ",
      "immortal time bias made explicit. BOTTOM BLOCK: the additional attrition required by the year-2 ",
      "outcome analyses, which need survival to day ", round(YR2_ELIGIBLE_DAY), ". Because exposure is ",
      "fixed at day ", round(LANDMARK_DAY), " but eligibility for the year-2 outcome is at day ",
      round(YR2_ELIGIBLE_DAY), ", any BETWEEN-ARM difference in the bottom block means the year-2 models ",
      "condition on a post-exposure variable, and their odds ratios carry a selection component. ",
      "Differences here belong in the limitations."))
  , "landmark_attrition")


# --- Step 4: KM plotting helper ---
# The log-rank p-value is computed here and passed to ggsurvplot as a
# pre-formatted STRING rather than via pval = TRUE, because survminer
# re-evaluates the model formula in the calling frame when asked to compute it
# itself, which breaks when the data lives in a function-local variable.
plot_landmark_km <- function(df, arms_keep, horizon, break_by, title) {
  d <- df %>% filter(ARM %in% arms_keep) %>% mutate(ARM = droplevels(ARM))
  
  if (nlevels(d$ARM) < 2) {
    message("skipping plot -- fewer than 2 non-empty arms: ", title)
    return(invisible(NULL))
  }
  
  fit <- survfit(Surv(time_lm, event_lm) ~ ARM, data = d)
  
  sd_test  <- survdiff(Surv(time_lm, event_lm) ~ ARM, data = d)
  pv       <- 1 - pchisq(sd_test$chisq, length(sd_test$n) - 1)
  pval_lbl <- if (pv < 0.001) "log-rank p < 0.001" else sprintf("log-rank p = %.3f", pv)
  
  p <- ggsurvplot(
    fit, data = d, pval = pval_lbl, conf.int = TRUE, risk.table = TRUE,
    break.time.by = break_by, legend.title = "Group", legend.labs = levels(d$ARM),
    xlab = paste0("Days since landmark (", LM_LABEL, ")"),
    ylab = "Survival Probability", title = title
  )
  fix_origin(p, break_by = break_by, max_time = horizon)
}

