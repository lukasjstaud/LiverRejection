               subtitle = paste0("Landmark at ", LM_LABEL)) %>%
    tab_options(table.font.size = 13, data_row.padding = px(4), column_labels.font.weight = "bold") %>%
    tab_source_note(paste0(
      "Same landmark propensity-matched cohorts as the unadjusted table, with the Cox model additionally ",
      "adjusted for recipient age, gender, MELD score, cold ischemic time, and diabetes status. Because ",
      "several of these covariates were also used in the matching, this is adjustment layered on top of ",
      "matching -- residual imbalance after matching (per the Love plots) is the reason for including it."))
  , "hr_landmark_adjusted")


#===============================================================================
# 21. SENSITIVITY ANALYSIS: Time-Varying Exposure Cox Model
#-------------------------------------------------------------------------------
# The landmark design removes immortal time bias by DISCARDING everyone who
# died before the landmark, and it forces treatment after the landmark to count
# as non-exposure. The time-varying (Mantel-Byar) approach removes the same
# bias without doing either: every patient starts untreated at transplant and
# switches state on the day they are first treated, whenever that is.
#
# THIS MODEL IS MORE IMPORTANT AT A 90-DAY LANDMARK THAN IT WAS AT 365. It is
# the analysis that does NOT throw the day 90-365 treatments into the Control
# arm, so comparing it against the landmark HRs directly bounds how much the
# gap contamination is costing.
#
# Counting-process (start, stop] format, so each patient may occupy more than
# one row. No cluster/robust variance is needed: the segments from a single
# patient are non-overlapping in time and the partial likelihood handles them.
#===============================================================================
arm_all_time <- assign_arm_at_landmark(Inf)   # exposure over all available follow-up

tv_base <- df_survival %>%
  filter(!is.na(PTIME), PTIME > 0) %>%
  select(TRR_ID_CODE, PTIME, event) %>%
  left_join(pat_rej_first %>% select(TRR_ID_CODE, REJ_TX_DAY), by = "TRR_ID_CODE") %>%
  left_join(arm_all_time, by = "TRR_ID_CODE") %>%
  filter(!is.na(ARM))

# Segment 1: untreated person-time, from day 0 until first treatment (or until
# end of follow-up for patients never treated).
tv_seg_untreated <- tv_base %>%
  mutate(
    tstart = 0,
    tstop = case_when(
      is.na(REJ_TX_DAY)   ~ PTIME,        # never treated
      REJ_TX_DAY <= 0     ~ NA_real_,     # treated at baseline: no untreated time
      REJ_TX_DAY >= PTIME ~ PTIME,        # treatment recorded at/after last follow-up
      TRUE                ~ REJ_TX_DAY
    ),
    ev = case_when(
      is.na(REJ_TX_DAY)   ~ as.numeric(event),
      REJ_TX_DAY <= 0     ~ NA_real_,
      REJ_TX_DAY >= PTIME ~ as.numeric(event),
      TRUE                ~ 0             # censored at the moment of switching
    ),
    RX_STATE = "None"
  ) %>%
  filter(!is.na(tstop), tstop > tstart)

# Segment 2: treated person-time, from first treatment to end of follow-up.
tv_seg_treated <- tv_base %>%
  filter(!is.na(REJ_TX_DAY), REJ_TX_DAY < PTIME) %>%
  mutate(
    tstart = pmax(REJ_TX_DAY, 0),
    tstop  = PTIME,
    ev     = as.numeric(event),
    RX_STATE = as.character(ARM)
  ) %>%
  filter(tstop > tstart)

tv_data <- bind_rows(tv_seg_untreated, tv_seg_treated) %>%
  select(TRR_ID_CODE, tstart, tstop, ev, RX_STATE) %>%
  mutate(RX_STATE = factor(RX_STATE,
                           levels = c("None", "Steroids", "Combined", "Dual Therapy", "Other Rejection"))) %>%
  arrange(TRR_ID_CODE, tstart)

stopifnot(all(tv_data$tstop > tv_data$tstart))
message("Time-varying dataset: ", nrow(tv_data), " rows for ",
        n_distinct(tv_data$TRR_ID_CODE), " patients; ", sum(tv_data$ev), " deaths")
print(
  table(tv_data$RX_STATE, tv_data$ev)
)

# Administrative censoring at a chosen horizon, measured from TRANSPLANT.
truncate_tv <- function(tv, horizon) {
  tv %>%
    filter(tstart < horizon) %>%
    mutate(ev = if_else(tstop > horizon, 0, ev), tstop = pmin(tstop, horizon)) %>%
    filter(tstop > tstart)
}

tv_trunc <- truncate_tv(tv_data, TV_HORIZON)

fit_tv <- coxph(Surv(tstart, tstop, ev) ~ RX_STATE, data = tv_trunc)
print(
  summary(fit_tv)
)
print(
  cox.zph(fit_tv)
)

tv_hr_table <- summary(fit_tv)$conf.int %>%
  as.data.frame() %>%
  tibble::rownames_to_column("term") %>%
  transmute(
    Comparison = paste0(str_remove(term, "^RX_STATE"), " vs untreated person-time"),
    `HR (95% CI)` = sprintf("%.2f (%.2f\u2013%.2f)", `exp(coef)`, `lower .95`, `upper .95`),
    `P value` = {
      p <- summary(fit_tv)$coefficients[, "Pr(>|z|)"]
      if_else(p < 0.001, "<0.001", sprintf("%.3f", p))
    }
  )

keep(
  tv_hr_table %>%
    gt() %>%
    tab_header(
      title = paste0("Time-Varying Exposure Cox Model, Mortality to Day ", round(TV_HORIZON)),
      subtitle = "Sensitivity analysis -- no patients excluded, no exposure window"
    ) %>%
    tab_options(table.font.size = 13, data_row.padding = px(4), column_labels.font.weight = "bold") %>%
    tab_source_note(paste0(
      "Anti-rejection therapy modelled as a time-dependent covariate: every patient contributes untreated ",
      "person-time from transplant until their first anti-rejection treatment, then treated person-time ",
      "thereafter. Unlike the landmark analysis this discards no patients AND imposes no exposure window, so ",
      "treatment given after day ", round(LANDMARK_DAY), " is counted as treatment rather than folded into ",
      "the Control arm. Comparing these hazard ratios against the landmark table therefore bounds how much ",
      "the landmark's Control contamination is costing: if they diverge materially, report both. Follow-up ",
      "administratively censored at day ", round(TV_HORIZON), " post-transplant. Treatment timing for ",
      "therapy given during the index admission is approximated (see INPATIENT_RX_DAY)."))
  , "hr_time_varying")

# --- Optional: quantify the bias by reproducing the naive analysis ---
# Fits the ORIGINAL, BIASED transplant-anchored model alongside the corrected
# ones. The point is not to report it but to show how far the estimate moves
# once the immortal time is removed. Do not use this HR for anything else.
SHOW_NAIVE_COMPARISON <- FALSE

if (SHOW_NAIVE_COMPARISON) {
  df_naive <- df_survival %>%
    inner_join(arm_all_time, by = "TRR_ID_CODE") %>%
    filter(!is.na(PTIME)) %>%
    mutate(
      event_h = if_else(PTIME <= TV_HORIZON, event, 0),
      time_h  = pmin(PTIME, TV_HORIZON),
      ARM = relevel(factor(as.character(ARM)), ref = "Control")
    ) %>%
    filter(ARM %in% c("Control", "Steroids", "Combined")) %>%
    mutate(ARM = droplevels(ARM))
  
  fit_naive <- coxph(Surv(time_h, event_h) ~ ARM, data = df_naive)
  
  message("\n--- BIASED (transplant-anchored) vs CORRECTED ---")
  message("Biased HRs (immortal time present, DO NOT REPORT):")
  print(round(summary(fit_naive)$conf.int[, c(1, 3, 4)], 3))
  message("Landmark HRs (corrected, exposure window imposed):")
  print(round(summary(fit_lm_3arm)$conf.int[, c(1, 3, 4)], 3))
  message("Time-varying HRs (corrected, no exclusions, no exposure window):")
  print(round(summary(fit_tv)$conf.int[, c(1, 3, 4)], 3))
}


