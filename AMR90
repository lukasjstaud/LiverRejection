# 26. Outcome-Window Results: Propensity-Matched Sensitivity Analysis
#-------------------------------------------------------------------------------
# Sections 23 and 25 are the PRIMARY analysis: covariate-adjusted logistic
# regression on the full eligible cohort. This section repeats both outcomes on
# propensity-matched arms so the two approaches to confounding control can be
# compared.
#
# WHY MATCH HERE RATHER THAN REUSE THE SECTION-14 / SECTION-20 MATCHES:
#   - Section 14 matched on the full cohort.
#   - Section 20 matched within the SURVIVAL landmark cohort (PTIME >= 90).
#   Neither is the outcome cohort, which is defined by a different eligibility
#   rule (PTIME >= 365 for treatment; GRF_TIME_DAYS >= 365 for graft failure)
#   applied to a different denominator. Applying a downstream restriction to an
#   already-matched set breaks pairs non-randomly and reintroduces the
#   imbalance matching removed, so each outcome is matched on its OWN eligible
#   cohort with pairs intact.
#
# ESTIMAND NOTE: matching is pairwise, so unlike the pooled regression above,
# each comparison is its own 1:1 matched cohort. "Combined vs Control" and
# "Steroids vs Control" do NOT share a control set and their Ns are not
# additive.
#===============================================================================

# ETHCAT is the only match covariate not already carried in the model frames.
ethcat_yr2 <- df_liver_data_filtered %>%
  select(TRR_ID_CODE, ETHCAT) %>%
  distinct(TRR_ID_CODE, .keep_all = TRUE) %>%
  mutate(ETHCAT = factor(ETHCAT))

match_yr2_outcome <- function(model_df, outcome, treat_grp, ctrl_grp, label, seed = 1234) {
  
  d <- model_df %>%
    filter(EXPOSURE_GROUP %in% c(treat_grp, ctrl_grp)) %>%
    mutate(EXPOSURE_GROUP = droplevels(EXPOSURE_GROUP)) %>%
    left_join(ethcat_yr2, by = "TRR_ID_CODE") %>%
    mutate(treat = as.integer(EXPOSURE_GROUP == treat_grp))
  
  md  <- d %>% select(TRR_ID_CODE, treat, all_of(match_covariates))
  res <- run_match(md, label, seed = seed)
  if (is.null(res)) return(NULL)
  
  dm <- d %>%
    filter(TRR_ID_CODE %in% res$matched_ids) %>%
    mutate(EXPOSURE_GROUP = relevel(droplevels(EXPOSURE_GROUP), ref = ctrl_grp))
  
  # Guard against a zero-event arm, which makes the OR non-estimable.
  ev <- tapply(dm[[outcome]], dm$EXPOSURE_GROUP, sum, na.rm = TRUE)
  if (any(ev == 0)) {
    message("skipping models -- an arm has zero events after matching: ", label,
            " (events by arm: ", paste(names(ev), ev, sep = "=", collapse = ", "), ")")
    return(NULL)
  }
  
  f_unadj <- glm(as.formula(paste(outcome, "~ EXPOSURE_GROUP")), data = dm, family = binomial)
  f_adj   <- glm(as.formula(paste(outcome, "~ EXPOSURE_GROUP +", yr2_adj_covs)),
                 data = dm, family = binomial)
  
  bind_rows(
    or_from(f_unadj, ctrl_grp, "Unadjusted"),
    or_from(f_adj,   ctrl_grp, "Adjusted")
  ) %>%
    mutate(Comparison = label)
}

render_yr2_matched_table <- function(res, title, outcome_phrase) {
  if (is.null(res) || nrow(res) == 0) {
    message("no matched results to render for: ", title)
    return(invisible(NULL))
  }
  res %>%
    mutate(
      `OR (95% CI)` = sprintf("%.2f (%.2f\u2013%.2f)", OR, CI_lower, CI_upper),
      `P value` = case_when(p_value < 0.001 ~ "<0.001", TRUE ~ sprintf("%.3f", p_value))
    ) %>%
    select(Comparison, Model, N, `OR (95% CI)`, `P value`) %>%
    arrange(Comparison, Model) %>%
    gt(groupname_col = "Comparison") %>%
    cols_label(Model = "Model", N = "N in matched model",
               `OR (95% CI)` = "Odds Ratio (95% CI)", `P value` = "P value") %>%
    tab_header(title = title, subtitle = "Sensitivity analysis: 1:1 propensity-matched arms") %>%
    tab_options(table.font.size = 13, data_row.padding = px(4),
                column_labels.font.weight = "bold", row_group.font.weight = "bold") %>%
    tab_source_note(paste0(
      "OR > 1 indicates higher odds of ", outcome_phrase, " relative to the comparison group. ",
      "SENSITIVITY ANALYSIS: each comparison is a separate 1:1 nearest-neighbour propensity match ",
      "(caliper 0.2 SD of the propensity logit; age, gender, ethnicity, MELD, diabetes, cold ischemic ",
      "time; HLA mismatch excluded for missingness), performed on that outcome's own eligible cohort with ",
      "pairs intact. The 'Adjusted' model additionally fits the same covariates on the matched set. ",
      "Because each comparison has its own matched control set, Ns are not additive across comparisons. ",
      "Exposure groups are fixed at ", LM_LABEL, ". Compare against the full-cohort adjusted regression, ",
      "which is the primary analysis."))
}

