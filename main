#===============================================================================
# 9. Deceased donor data
#===============================================================================
# A single donor can map to more than one recipient (split liver), and
# df_deceased_don itself contains some duplicate DONOR_IDs (see the check
# below). Either produces duplicated rows here, which would otherwise
# multiply every downstream demographic count once joined onto the recipient
# tables -- distinct() on the recipient key mirrors what df_hla_calc already
# does above.
df_deceased_don_fil2 <- df_deceased_don_fil %>%
  left_join(df_liver_data_filtered |> select(DONOR_ID, TRR_ID_CODE), by = "DONOR_ID") |>
  select(TRR_ID_CODE, AGE_DON, LI_MACHINE_PERFUSION, LI_MACHINE_PERFUSION_TY, LI_FIBROSIS, NON_HRT_DON) |>
  filter(!is.na(TRR_ID_CODE)) |>
  distinct(TRR_ID_CODE, .keep_all = TRUE)

# Diagnostic: confirms whether the source file itself carries duplicate donor
# IDs (the reason distinct() above is necessary rather than optional).
df_deceased_don_fil %>% count(DONOR_ID) %>% filter(n > 1)


#===============================================================================
# 10. Anti-rejection therapy frequency tables (descriptive)
#===============================================================================
freq_long <- freq_drug_fol_antirej_indiv %>%
  pivot_longer(
    cols = c(rej6m_count, rej1y_count),
    names_to = "rej_period",
    values_to = "rej_count"
  ) %>%
  mutate(rej_period = recode(rej_period, "rej6m_count" = "6-Month", "rej1y_count" = "1-Year"))
# NOTE: freq_long is not currently plotted anywhere below; kept in case a
# downstream chart references it.

followup_12m_anti_rej_table <- data.frame(
  AntiRejectionTherapy = str_remove(COLS_TO_CHECK, COL_TAIL),
  Frequency = sapply(df_immuno_fol[COLS_TO_CHECK], function(x) sum(x == 1, na.rm = TRUE))
)

followup_12m_anti_rej_table %>%
  arrange(desc(Frequency)) %>%
  kable(caption = "Frequency of Anti-Rejection Therapies Used At Follow up < 1 year s/p Liver Transplant") %>%
  kable_styling(bootstrap_options = c("striped", "hover", "condensed"))

post_tx_anti_rej_table <- data.frame(
  AntiRejectionTherapy = str_remove(COLS_TO_CHECK, COL_TAIL),
  Frequency = sapply(df_immuno_induc[COLS_TO_CHECK], function(x) sum(x == 1, na.rm = TRUE))
)

post_tx_anti_rej_table %>%
  arrange(desc(Frequency)) %>%
  kable(caption = "Frequency of Anti-Rejection Therapies Used While Admitted s/p Liver Transplant") %>%
  kable_styling(bootstrap_options = c("striped", "hover", "condensed"))


#===============================================================================
# 11. Shared statistical helpers
#===============================================================================
# Chi-square vs. Fisher, decided on EXPECTED cell counts (not observed) --
# the standard rule of thumb, and more reliable than thresholding on the raw
# observed counts (which over-triggers Fisher on large but lopsided tables and
# under-triggers it on small balanced ones).
safe_chisq_or_fisher <- function(tab) {
  if (any(dim(tab) < 2) || sum(tab) == 0) return(NULL)
  expected <- outer(rowSums(tab), colSums(tab)) / sum(tab)
  if (any(expected < 5)) {
    fisher.test(tab, simulate.p.value = (ncol(tab) > 2 || nrow(tab) > 2))
  } else {
    chisq.test(tab)
  }
}

# Mutually-exclusive organ-transplanted grouping, shared by every table and
# model that reports organ type. A liver-kidney-pancreas patient must land in
# exactly one bucket, not be double-counted in both "Kidney" and "Pancreas".
#
# IMPORTANT: there is deliberately no "all four fields missing -> NA" gate
# here. TXKID/TXHRT/TXLNG/TXPAN record ADDITIONAL organs transplanted
# alongside the liver; a liver-only recipient has all four blank. Because the
# read.csv() calls above pass na.strings = c("", " ", "NA", "."), those blanks
# arrive as real NA -- so gating on "at least one field non-NA" would discard
# every liver-only patient and leave a denominator made up almost entirely of
# multi-organ recipients (which is exactly what produced an "87% kidney"
# row in a liver transplant cohort). In this cohort every patient received a
# liver by definition, so all-blank means "Liver only", not "unknown".
#
# Consequence: this variable has no missing category. If a genuinely unknown
# organ record ever needs to be distinguished from a liver-only one, that has
# to come from an explicit missingness code, not from blankness.
organ_group <- function(df) {
  case_when(
    df$TXKID %in% c("L", "R", "E") ~ "Kidney",
    df$TXHRT == "Y"                ~ "Heart",
    df$TXLNG %in% c("L", "R", "E") ~ "Lung",
    df$TXPAN %in% c("L", "R", "E") ~ "Pancreas",
    TRUE                           ~ "Liver only"
  )
}

# Race bucketing, also shared between tables and p-value tests.
race_group <- function(df) {
  case_when(
    df$ETHCAT == "1"   ~ "White",
    df$ETHCAT == "2"   ~ "Black",
    df$ETHCAT == "4"   ~ "Hispanic",
    df$ETHCAT == "5"   ~ "Asian",
    !is.na(df$ETHCAT)  ~ "Other",
    TRUE               ~ NA_character_
  )
}


#===============================================================================
# 12. Demographic cohort tables (per-patient, one row each)
#===============================================================================
# Rejection cohort: one row per patient, preferring the earlier (discharge)
# event when a patient has both an inpatient and a follow-up rejection row.
# slice_min(source) is used rather than a filter that could drop a patient
# entirely when they had two source==1 rows (both would satisfy a "delete if
# duplicated" filter, rather than being deduplicated to one).
pat_rej_demo_table <- pat_rej_array %>%
  left_join(df_liver_data_filtered %>%
              select(TRR_ID_CODE, AGE, BMI_REC, GENDER, ETHCAT, MELD_PELD_LAB_SCORE,
                     TXKID, TXHRT, TXLNG, TXPAN,
                     PREV_TX, PREV_TX_ANY_N, DON_TY, COLD_ISCH, DIAB), by = "TRR_ID_CODE") |>
  group_by(TRR_ID_CODE) %>%
  slice_min(order_by = source, n = 1, with_ties = FALSE) %>%
  ungroup() %>%
  mutate(REJ_STAT = 1L) |>
  left_join(df_deceased_don_fil2, by = "TRR_ID_CODE") |>
  left_join(df_hla_calc, by = "TRR_ID_CODE")

pat_ctrl_demo_table <- pat_ctrl_array %>%
  left_join(df_liver_data_filtered %>%
              select(TRR_ID_CODE, AGE, BMI_REC, GENDER, ETHCAT, MELD_PELD_LAB_SCORE,
                     TXKID, TXHRT, TXLNG, TXPAN,
                     PREV_TX, PREV_TX_ANY_N, DON_TY, COLD_ISCH, DIAB), by = "TRR_ID_CODE") |>
  mutate(DISCHARGE_DATE = as.Date(DISCHARGE_DATE)) %>%
  mutate(REJ_STAT = 0L) %>%
  filter(!TRR_ID_CODE %in% pat_rej_demo_table$TRR_ID_CODE) |>  # redundant post-cleanup, kept defensively
  left_join(df_deceased_don_fil2, by = "TRR_ID_CODE") |>
  left_join(df_hla_calc, by = "TRR_ID_CODE")

pat_all_demo_table <- bind_rows(pat_rej_demo_table, pat_ctrl_demo_table)

pat_ritux_demo_table    <- pat_rej_demo_table %>% filter(TRR_ID_CODE %in% rituxan_any_id_vect)
pat_steroid_demo_table  <- pat_rej_demo_table |> filter(TRR_ID_CODE %in% steroid_id_all_vect)
pat_combined_demo_table <- pat_rej_demo_table |> filter(TRR_ID_CODE %in% arm2_ID_vect)

# Double-checking: all three of these should come back empty.
pat_rej_demo_table  %>% count(TRR_ID_CODE) %>% filter(n > 1)
pat_ctrl_demo_table %>% count(TRR_ID_CODE) %>% filter(n > 1)

overlap_ids <- intersect(pat_rej_demo_table$TRR_ID_CODE, pat_ctrl_demo_table$TRR_ID_CODE)
length(overlap_ids)

df_liver_data_filtered %>% count(TRR_ID_CODE) %>% filter(n > 1)


#===============================================================================
# 13. Propensity Score Matching: Combined vs Steroid, Combined vs Control
#===============================================================================
prep_match_df <- function(df) {
  df %>%
    mutate(
      DIAB_BIN = case_when(
        as.numeric(DIAB) %in% 2:5 ~ 1,
        as.numeric(DIAB) == 1     ~ 0,
        TRUE                      ~ NA_real_
      ),
      GENDER = factor(GENDER),
      ETHCAT = factor(ETHCAT),
      DON_TY = factor(DON_TY)
    )
}

match_covariates <- c("AGE", "GENDER", "ETHCAT", "MELD_PELD_LAB_SCORE",
                      "DIAB_BIN", "COLD_ISCH")

# MM_TOTAL (HLA mismatch) is deliberately NOT matched on. It is missing for
# roughly 60% of the cohort -- MM_TOTAL is NA whenever ANY of the six alleles
# is untyped, which in UNOS is the norm rather than the exception. Because
# matching is complete-case, including it discarded the majority of both arms
# and, worse, discarded them non-randomly: centres that type HLA completely
# differ systematically from those that don't. Buying balance on a variable
# observed in 40% of patients was costing more in selection bias than it
# removed in confounding.
#
# It is still carried alongside the matching frame so covariate balance can be
# REPORTED on it (via the addl = argument to love.plot below) without it
# influencing who gets matched, and it remains in the descriptive tables and
# in the adjusted year-2 regression models.
balance_only_covariates <- c("MM_TOTAL")

match_formula <- as.formula(paste("treat ~", paste(match_covariates, collapse = " + ")))

# drop_na() on the matching covariates can quietly gut the cohort -- MM_TOTAL
# is NA whenever any of the six alleles is missing (common in UNOS), and cold
# ischemic time is patchy too. This reports complete-case attrition per arm
# AND per covariate so it's clear which variable is doing the damage before
# trusting the matched Ns.
report_complete_case_loss <- function(df, label) {
  n_before <- nrow(df)
  n_after  <- nrow(tidyr::drop_na(df, all_of(match_covariates)))
  message("\n[", label, "] complete-case attrition on matching covariates:")
  message("  rows before drop_na: ", n_before,
          " | after: ", n_after,
          " | lost: ", n_before - n_after,
          " (", sprintf("%.1f", 100 * (n_before - n_after) / max(n_before, 1)), "%)")
  
  per_arm <- df %>%
    group_by(treat) %>%
    summarise(before = n(),
              after = sum(complete.cases(across(all_of(match_covariates)))),
              .groups = "drop")
  print(per_arm)
  
  miss_by_var <- sapply(match_covariates, function(v) sum(is.na(df[[v]])))
  message("  missing count by covariate:")
  print(miss_by_var[order(-miss_by_var)])
  invisible(NULL)
}

# --- Comparison 1: Combined vs Steroid ---
match_df_combined_steroid_raw <- bind_rows(
  prep_match_df(pat_combined_demo_table) %>% mutate(treat = 1),
  prep_match_df(pat_steroid_demo_table)  %>% mutate(treat = 0)
) %>%
  select(TRR_ID_CODE, treat, all_of(match_covariates), any_of(balance_only_covariates))

report_complete_case_loss(match_df_combined_steroid_raw, "Combined vs Steroid")

# drop_na() with no arguments drops a row with NA in ANY column -- which would
# re-delete every HLA-untyped patient the moment MM_TOTAL is carried in the
# frame, silently undoing the point of excluding it from the match. Scope it
# explicitly to the matching covariates.
match_df_combined_steroid <- match_df_combined_steroid_raw %>%
  drop_na(all_of(match_covariates))

set.seed(1234)

# Caliper added: 1:1 nearest-neighbour with no caliper forces a match for
# every treated unit no matter how far away the nearest control is, which
# with small treated arms can produce pairs that aren't comparable at all.
# 0.2 SD of the propensity logit is the conventional cutoff (Austin 2011);
# std.caliper = TRUE makes it SD-scaled rather than absolute.
m_combined_steroid <- matchit(
  match_formula,
  data        = match_df_combined_steroid,
  method      = "nearest",
  distance    = "logit",
  ratio       = 1,
  caliper     = 0.2,
  std.caliper = TRUE
)

summary(m_combined_steroid)  # check balance (Std. Mean Diff should shrink toward 0)

# With a caliper, some treated units go unmatched -- worth reporting since a
# large drop changes who the estimand applies to.
message("[Combined vs Steroid] treated units unmatched by caliper: ",
        sum(m_combined_steroid$treat == 1 & is.na(m_combined_steroid$subclass)))

matched_combined_steroid <- match.data(m_combined_steroid)

combined_ids_1 <- matched_combined_steroid %>% filter(treat == 1) %>% pull(TRR_ID_CODE)
steroid_ids    <- matched_combined_steroid %>% filter(treat == 0) %>% pull(TRR_ID_CODE)

pat_combined_demo_table_m_steroid <- pat_combined_demo_table %>% filter(TRR_ID_CODE %in% combined_ids_1)
pat_steroid_demo_table_m          <- pat_steroid_demo_table  %>% filter(TRR_ID_CODE %in% steroid_ids)

# --- Comparison 2: Combined vs Control (No Rejection) ---
match_df_combined_ctrl_raw <- bind_rows(
  prep_match_df(pat_combined_demo_table) %>% mutate(treat = 1),
  prep_match_df(pat_ctrl_demo_table)     %>% mutate(treat = 0)
) %>%
  select(TRR_ID_CODE, treat, all_of(match_covariates), any_of(balance_only_covariates))

report_complete_case_loss(match_df_combined_ctrl_raw, "Combined vs Control")

match_df_combined_ctrl <- match_df_combined_ctrl_raw %>%
  drop_na(all_of(match_covariates))

set.seed(1234)

m_combined_ctrl <- matchit(
  match_formula,
  data        = match_df_combined_ctrl,
  method      = "nearest",
  distance    = "logit",
  ratio       = 1,
  caliper     = 0.2,
  std.caliper = TRUE
)

summary(m_combined_ctrl)

message("[Combined vs Control] treated units unmatched by caliper: ",
        sum(m_combined_ctrl$treat == 1 & is.na(m_combined_ctrl$subclass)))

matched_combined_ctrl <- match.data(m_combined_ctrl)

combined_ids_2 <- matched_combined_ctrl %>% filter(treat == 1) %>% pull(TRR_ID_CODE)
ctrl_ids       <- matched_combined_ctrl %>% filter(treat == 0) %>% pull(TRR_ID_CODE)

pat_combined_demo_table_m_ctrl <- pat_combined_demo_table %>% filter(TRR_ID_CODE %in% combined_ids_2)
pat_ctrl_demo_table_m          <- pat_ctrl_demo_table     %>% filter(TRR_ID_CODE %in% ctrl_ids)


#===============================================================================
# 14. Love Plots: Covariate Balance Before/After Matching
#-------------------------------------------------------------------------------
# addl = passes MM_TOTAL (HLA mismatch) in as a covariate to REPORT balance on
# without it having influenced the matching -- so it is possible to see
# whether the arms happen to differ on HLA despite not being matched on it.
# cobalt handles its missingness by adding an explicit <NA> indicator, which
# doubles as a check on whether HLA typing itself differs between arms.
# If cobalt errors on this, dropping the addl = argument returns the plain
# matched-covariate plot.
#===============================================================================
love.plot(
  m_combined_steroid,
  binary = "std", stats = "mean.diffs", abs = TRUE, var.order = "unadjusted",
  thresholds = c(m = 0.1), title = "Covariate Balance: Combined vs Steroid",
  sample.names = c("Unmatched", "Matched"),
  addl = match_df_combined_steroid[balance_only_covariates]
)

love.plot(
  m_combined_ctrl,
  binary = "std", stats = "mean.diffs", abs = TRUE, var.order = "unadjusted",
  thresholds = c(m = 0.1), title = "Covariate Balance: Combined vs Control",
  sample.names = c("Unmatched", "Matched"),
  addl = match_df_combined_ctrl[balance_only_covariates]
)


#===============================================================================
# 15. Demographic Tables 1-6 (gtsummary)
#-------------------------------------------------------------------------------
# Reproduces the standard "Characteristic / Group A / Group B / P value"
# reference style for all six cohort comparisons, from the cohort data
# frames built above:
#   Table 1: Rejection vs Rituxan vs Control                     (3-arm)
#   Table 2: Combined vs Steroid            (propensity matched)
#   Table 3: Combined vs No Rejection       (propensity matched)
#   Table 4: Combined vs Steroid            (unmatched)
#   Table 5: Combined vs No Rejection       (unmatched)
#   Table 6: Steroid + Combined (pooled) vs No Rejection (unmatched)
#
# Continuous vars: mean (SD). Categorical vars: n (%). Multi-level categorical
# variables get ONE p-value on the group header row, not repeated per level.
#===============================================================================

# --- Step 0: shared display-ready recodes, built from calc's existing helpers ---
prep_gts_df <- function(df) {
  df %>%
    mutate(
      AGE   = as.numeric(AGE),
      MELD_PELD_LAB_SCORE = as.numeric(MELD_PELD_LAB_SCORE),
      BMI_REC = as.numeric(BMI_REC),
      COLD_ISCH = as.numeric(COLD_ISCH),
      GENDER_LBL = case_when(
        GENDER == "M" ~ "Male",
        GENDER == "F" ~ "Female",
        TRUE ~ NA_character_
      ),
      RACE_LBL = race_group(.),
      DIAB_LBL = case_when(
        as.numeric(DIAB) %in% 2:5 ~ "Yes",
        as.numeric(DIAB) == 1     ~ "No",
        TRUE ~ NA_character_
      ),
      ORGAN_LBL = organ_group(.),
      LIVING_DON_LBL = case_when(
        DON_TY == "L" ~ "Yes",
        !is.na(DON_TY) ~ "No",
        TRUE ~ NA_character_
      ),
      PREV_LIV_LBL = case_when(
        PREV_TX == "Y" ~ "Yes",
        !is.na(PREV_TX) ~ "No",
        TRUE ~ NA_character_
      ),
      PREV_ANY_LBL = ifelse(is.na(PREV_TX_ANY_N), "0", as.character(PREV_TX_ANY_N)),
      HLA_MM = factor(MM_TOTAL, levels = 0:6),
      PERFUSION_LBL = case_when(
        LI_MACHINE_PERFUSION == "Y" ~ "Yes",
        !is.na(LI_MACHINE_PERFUSION) ~ "No",
        TRUE ~ NA_character_
      ),
      PERFUSION_TY_LBL = case_when(
        LI_MACHINE_PERFUSION_TY == "1" ~ "Normothermic",
        LI_MACHINE_PERFUSION_TY == "2" ~ "Hypothermic",
        TRUE ~ NA_character_
      )
    )
}

# Row order for every table.
gts_vars <- c("AGE", "GENDER_LBL", "RACE_LBL", "BMI_REC", "DIAB_LBL", "MELD_PELD_LAB_SCORE",
              "ORGAN_LBL", "LIVING_DON_LBL", "COLD_ISCH", "PREV_LIV_LBL",
              "PREV_ANY_LBL", "HLA_MM", "PERFUSION_LBL", "PERFUSION_TY_LBL")

gts_labels <- list(
  AGE                 ~ "Recipient Age, y",
  GENDER_LBL          ~ "Sex, n (%)",
  RACE_LBL            ~ "Race/ethnicity, n (%)",
  BMI_REC             ~ "Recipient BMI, kg/m\u00b2",
  DIAB_LBL            ~ "History of Diabetes, n (%)",
  MELD_PELD_LAB_SCORE ~ "MELD, mean (SD)",
  ORGAN_LBL           ~ "Organ Transplanted, n (%)",
  LIVING_DON_LBL      ~ "Living Donor, n (%)",
  COLD_ISCH           ~ "Cold Ischemic Time, hr",
  PREV_LIV_LBL        ~ "Previous Liver Transplant, n (%)",
  PREV_ANY_LBL        ~ "Previous Any Transplant, n (%)",
  HLA_MM              ~ "HLA Mismatch Level (0-6), n (%)",
  PERFUSION_LBL       ~ "Liver Perfusion Used, n (%)",
  PERFUSION_TY_LBL    ~ "Perfusion Type, n (%)"
)

# Categorical-test wrapper so the tables use the SAME chi-square/Fisher rule as
# safe_chisq_or_fisher() (expected cell counts < 5 -> Fisher, with
# simulate.p.value for anything bigger than 2x2).
#
# This is not just cosmetic consistency. gtsummary's built-in default also
# falls back to Fisher on small expected counts, but calls fisher.test()
# WITHOUT simulation -- and an exact test on a 2x5 or 2x7 table with tens of
# thousands of patients exhausts fisher.test()'s workspace and errors, which
# gtsummary renders as a silently BLANK p-value. That is what emptied the
# "Previous Any Transplant" and "HLA Mismatch Level" rows: a sparse level
# (e.g. 2 patients with 4 prior transplants) pushed an expected count under 5,
# and the resulting exact test was uncomputable at this N.
gts_safe_cat_test <- function(data, variable, by, ...) {
  tab <- table(data[[variable]], data[[by]])
  # Fisher fallbacks on tables larger than 2x2 use simulate.p.value, which is
  # stochastic -- seed it so re-running the script reproduces the same table.
  set.seed(1234)
  res <- safe_chisq_or_fisher(tab)
  dplyr::tibble(
    p.value = if (is.null(res)) NA_real_ else res$p.value,
    method  = if (is.null(res)) NA_character_ else res$method
  )
}

# --- Step 1: generic 2-arm (or 3-arm) table builder ---
build_gts_table <- function(df_combined, group_col, group_lbls = NULL, caption = NULL) {
  
  d <- prep_gts_df(df_combined)
  
  tbl <- d %>%
    select(all_of(group_col), all_of(gts_vars)) %>%
    tbl_summary(
      by = all_of(group_col),
      label = gts_labels,
      statistic = list(
        all_continuous()  ~ "{mean} ({sd})",
        all_categorical() ~ "{n} ({p}%)"
      ),
      digits = list(all_continuous() ~ 1),
      missing = "no"
    ) %>%
    add_p(
      test = list(
        all_continuous()  ~ "t.test",              # Welch two-sample t-test
        all_categorical() ~ "gts_safe_cat_test"    # chi-square / Fisher, per expected counts
      ),
      pvalue_fun = ~ style_pvalue(.x, digits = 3)
    ) %>%
    bold_labels() %>%
    modify_header(all_stat_cols() ~ "**{level}**, N = {n}") %>%
    modify_footnote(all_stat_cols() ~ "Mean (SD); n (%)") %>%
    modify_footnote(p.value ~ "Welch two-sample t-test; Pearson's Chi-squared test / Fisher's exact test (simulated p-value where tables exceed 2x2)")
  
  if (!is.null(group_lbls)) {
    for (lv in names(group_lbls)) {
      tbl <- tbl %>% modify_header(
        !!rlang::sym(paste0("stat_", which(levels(factor(d[[group_col]])) == lv))) :=
          paste0("**", group_lbls[[lv]], "**, N = {n}")
      )
    }
  }
  
  if (!is.null(caption)) tbl <- tbl %>% modify_caption(caption)
  
  tbl
}

# --- Step 2: assemble each comparison and render ---

## Table 1: Rejection vs Rituxan vs Control (3-arm)
tbl1_df <- bind_rows(
  pat_rej_demo_table   %>% mutate(REJ_GROUP = "Rejection"),
  pat_ritux_demo_table %>% mutate(REJ_GROUP = "Rituxan"),
  pat_ctrl_demo_table  %>% mutate(REJ_GROUP = "Control")
) %>%
  mutate(REJ_GROUP = factor(REJ_GROUP, levels = c("Rejection", "Rituxan", "Control")))

gts_table1 <- build_gts_table(
  tbl1_df, "REJ_GROUP",
  caption = "**Table 1. Baseline Characteristics: Rejection vs. Rituxan vs. Control**"
)
gts_table1

## Table 2: Combined vs Steroid (propensity matched)
tbl2_df <- bind_rows(
  pat_combined_demo_table_m_steroid %>% mutate(REJ_GROUP = "Combined"),
  pat_steroid_demo_table_m          %>% mutate(REJ_GROUP = "Steroid")
) %>%
  mutate(REJ_GROUP = factor(REJ_GROUP, levels = c("Combined", "Steroid")))

gts_table2 <- build_gts_table(
  tbl2_df, "REJ_GROUP",
  caption = "**Table 2. Combined vs. Steroid (Propensity Matched)**"
)
gts_table2

