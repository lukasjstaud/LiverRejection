# --- Step 2: thin wrapper -------------------------------------------------
build_donor_table <- function(df_combined, group_col = "REJ_GROUP", caption = NULL) {
  build_gts_table(
    df_combined, group_col,
    caption      = caption,
    vars         = donor_vars,
    labels       = donor_labels,
    prep_fn      = prep_donor_gts_df,
    cont_test    = "auto",       # t-test for 2 arms, one-way ANOVA for 3+
    missing_disp = "ifany"       # show how many donors are Unknown per field
  )
}

# --- Step 3: one donor table per rejection-group comparison ---------------
# tbl1_df ... tbl6_df already exist from section 15 and already carry the
# donor columns via the pat_*_demo_table joins, so no new cohort assembly is
# needed here.

## Donor Table 1D: Rejection vs Rituxan vs Control (3-arm)
gts_donor1 <- build_donor_table(
  tbl1_df,
  caption = "**Table 1D. Deceased Donor Characteristics: Rejection vs. Rituxan vs. Control**"
)
gts_donor1

## Donor Table 2D: Combined vs Steroid (propensity matched)
gts_donor2 <- build_donor_table(
  tbl2_df,
  caption = "**Table 2D. Deceased Donor Characteristics: Combined vs. Steroid (Propensity Matched)**"
)
gts_donor2

## Donor Table 3D: Combined vs No Rejection (propensity matched)
gts_donor3 <- build_donor_table(
  tbl3_df,
  caption = "**Table 3D. Deceased Donor Characteristics: Combined vs. No Rejection (Propensity Matched)**"
)
gts_donor3

