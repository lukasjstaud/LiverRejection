love.plot(
  m_combined_steroid,
  binary = "std", stats = "mean.diffs", abs = TRUE, var.order = "unadjusted",
  thresholds = c(m = 0.1), title = "Covariate Balance: Combined vs Steroid",
  sample.names = c("Unmatched", "Matched")
)

love.plot(
  m_combined_ctrl,
  binary = "std", stats = "mean.diffs", abs = TRUE, var.order = "unadjusted",
  thresholds = c(m = 0.1), title = "Covariate Balance: Combined vs Control",
  sample.names = c("Unmatched", "Matched")
)


#===============================================================================
# 15. Demographic Tables 1-6 (gtsummary)
#-------------------------------------------------------------------------------
# Reproduces the standard "Characteristic / Group A / Group B / P value"
# reference style for all six cohort comparisons, from the cohort data
# frames built above:
#   Table 1: Rejection vs Rituxan vs Control                     (3-arm)
#   Table 2: Combined vs Steroid            (propensity matched)
#   Table 3: Combined vs No Rejection       (propensity matched)
#   Table 4: Combined vs Steroid            (unmatched)
#   Table 5: Combined vs No Rejection       (unmatched)
#   Table 6: Steroid + Combined (pooled) vs No Rejection (unmatched)
#
# Continuous vars: mean (SD). Categorical vars: n (%). Multi-level categorical
# variables get ONE p-value on the group header row, not repeated per level.
#===============================================================================

# --- Step 0: shared display-ready recodes, built from calc's existing helpers ---
prep_gts_df <- function(df) {
  df %>%
    mutate(
      AGE   = as.numeric(AGE),
      MELD_PELD_LAB_SCORE = as.numeric(MELD_PELD_LAB_SCORE),
      COLD_ISCH = as.numeric(COLD_ISCH),
      GENDER_LBL = case_when(
        GENDER == "M" ~ "Male",
        GENDER == "F" ~ "Female",
        TRUE ~ NA_character_
      ),
      RACE_LBL = race_group(.),
      DIAB_LBL = case_when(
        as.numeric(DIAB) %in% 2:5 ~ "Yes",
        as.numeric(DIAB) == 1     ~ "No",
        TRUE ~ NA_character_
      ),
      ORGAN_LBL = organ_group(.),
      LIVING_DON_LBL = case_when(
        DON_TY == "L" ~ "Yes",
        !is.na(DON_TY) ~ "No",
        TRUE ~ NA_character_
      ),
      PREV_LIV_LBL = case_when(
        PREV_TX == "Y" ~ "Yes",
        !is.na(PREV_TX) ~ "No",
        TRUE ~ NA_character_
      ),
      PREV_ANY_LBL = ifelse(is.na(PREV_TX_ANY_N), "0", as.character(PREV_TX_ANY_N)),
      HLA_MM = factor(MM_TOTAL, levels = 0:6),
      PERFUSION_LBL = case_when(
        LI_MACHINE_PERFUSION == "Y" ~ "Yes",
        !is.na(LI_MACHINE_PERFUSION) ~ "No",
        TRUE ~ NA_character_
      ),
      PERFUSION_TY_LBL = case_when(
        LI_MACHINE_PERFUSION_TY == "1" ~ "Normothermic",
        LI_MACHINE_PERFUSION_TY == "2" ~ "Hypothermic",
        TRUE ~ NA_character_
      )
    )
}

# Row order for every table.
gts_vars <- c("AGE", "GENDER_LBL", "RACE_LBL", "DIAB_LBL", "MELD_PELD_LAB_SCORE",
              "ORGAN_LBL", "LIVING_DON_LBL", "COLD_ISCH", "PREV_LIV_LBL",
              "PREV_ANY_LBL", "HLA_MM", "PERFUSION_LBL", "PERFUSION_TY_LBL")

gts_labels <- list(
  AGE                 ~ "Recipient Age, y",
  GENDER_LBL          ~ "Sex, n (%)",
  RACE_LBL            ~ "Race/ethnicity, n (%)",
  DIAB_LBL            ~ "History of Diabetes, n (%)",
  MELD_PELD_LAB_SCORE ~ "MELD, mean (SD)",
  ORGAN_LBL           ~ "Organ Transplanted, n (%)",
  LIVING_DON_LBL      ~ "Living Donor, n (%)",
  COLD_ISCH           ~ "Cold Ischemic Time, hr",
  PREV_LIV_LBL        ~ "Previous Liver Transplant, n (%)",
  PREV_ANY_LBL        ~ "Previous Any Transplant, n (%)",
  HLA_MM              ~ "HLA Mismatch Level (0-6), n (%)",
  PERFUSION_LBL       ~ "Liver Perfusion Used, n (%)",
  PERFUSION_TY_LBL    ~ "Perfusion Type, n (%)"
)

# Categorical-test wrapper so the tables use the SAME chi-square/Fisher rule as
# safe_chisq_or_fisher() (expected cell counts < 5 -> Fisher, with
# simulate.p.value for anything bigger than 2x2).
#
# This is not just cosmetic consistency. gtsummary's built-in default also
# falls back to Fisher on small expected counts, but calls fisher.test()
# WITHOUT simulation -- and an exact test on a 2x5 or 2x7 table with tens of
# thousands of patients exhausts fisher.test()'s workspace and errors, which
# gtsummary renders as a silently BLANK p-value. That is what emptied the
# "Previous Any Transplant" and "HLA Mismatch Level" rows: a sparse level
# (e.g. 2 patients with 4 prior transplants) pushed an expected count under 5,
# and the resulting exact test was uncomputable at this N.
gts_safe_cat_test <- function(data, variable, by, ...) {
  tab <- table(data[[variable]], data[[by]])
  # Fisher fallbacks on tables larger than 2x2 use simulate.p.value, which is
  # stochastic -- seed it so re-running the script reproduces the same table.
  set.seed(1234)
  res <- safe_chisq_or_fisher(tab)
  dplyr::tibble(
    p.value = if (is.null(res)) NA_real_ else res$p.value,
    method  = if (is.null(res)) NA_character_ else res$method
  )
}

# --- Step 1: generic 2-arm (or 3-arm) table builder ---
build_gts_table <- function(df_combined, group_col, group_lbls = NULL, caption = NULL) {
  
  d <- prep_gts_df(df_combined)
  
  tbl <- d %>%
    select(all_of(group_col), all_of(gts_vars)) %>%
    tbl_summary(
      by = all_of(group_col),
      label = gts_labels,
      statistic = list(
        all_continuous()  ~ "{mean} ({sd})",
        all_categorical() ~ "{n} ({p}%)"
      ),
      digits = list(all_continuous() ~ 1),
      missing = "no"
    ) %>%
    add_p(
      test = list(
        all_continuous()  ~ "t.test",              # Welch two-sample t-test
        all_categorical() ~ "gts_safe_cat_test"    # chi-square / Fisher, per expected counts
      ),
      pvalue_fun = ~ style_pvalue(.x, digits = 3)
    ) %>%
    bold_labels() %>%
    modify_header(all_stat_cols() ~ "**{level}**, N = {n}") %>%
    modify_footnote(all_stat_cols() ~ "Mean (SD); n (%)") %>%
    modify_footnote(p.value ~ "Welch two-sample t-test; Pearson's Chi-squared test / Fisher's exact test (simulated p-value where tables exceed 2x2)")
  
  if (!is.null(group_lbls)) {
    for (lv in names(group_lbls)) {
      tbl <- tbl %>% modify_header(
        !!rlang::sym(paste0("stat_", which(levels(factor(d[[group_col]])) == lv))) :=
          paste0("**", group_lbls[[lv]], "**, N = {n}")
      )
    }
  }
  
  if (!is.null(caption)) tbl <- tbl %>% modify_caption(caption)
  
  tbl
}

# --- Step 2: assemble each comparison and render ---

## Table 1: Rejection vs Rituxan vs Control (3-arm)
tbl1_df <- bind_rows(
  pat_rej_demo_table   %>% mutate(REJ_GROUP = "Rejection"),
