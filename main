#===============================================================================
# 25. Year-2 Outcomes: Propensity-Matched Sensitivity Analysis
#-------------------------------------------------------------------------------
# The year-2 tables above (sections 22 and 24) are the PRIMARY analysis:
# covariate-adjusted logistic regression on the full landmark cohort. This
# section repeats both outcomes on propensity-matched arms as a SENSITIVITY
# analysis, so the two approaches to confounding control can be compared.
#
# WHY MATCH HERE RATHER THAN REUSE THE SECTION-13 / SECTION-17 MATCHES:
#   - The section-13 matches were fit on the full year-1 demographic cohort.
#   - The section-17 matches were fit within the *survival* landmark cohort
#     (patients with PTIME >= landmark), a different eligibility rule.
#   Neither is the year-2 outcome cohort, which is defined by a DIFFERENT
#   landmark restriction (PTIME >= 365.25 for rejection; GRF_TIME_DAYS >=
#   365.25 for graft failure) applied to a DIFFERENT denominator. As the
#   section-17 comment explains, applying a downstream restriction to an
#   already-matched set breaks pairs non-randomly and reintroduces the
#   imbalance matching removed. So each outcome is matched on its OWN eligible
#   cohort, pairs intact.
#
# COVARIATES: same set as match_covariates MINUS HLA (removed cohort-wide in
# section 13 for 60% missingness), i.e. AGE, GENDER, ETHCAT, MELD, DIAB_BIN,
# COLD_ISCH. ETHCAT is not carried in the year-2 model frames, so it is joined
# in here.
#
# ESTIMAND NOTE: matching is pairwise between two arms, so unlike the pooled
# 3-level regression above, each matched comparison is its own 1:1 matched
# cohort. "Combined vs Control" and "Steroid vs Control" therefore do NOT share
# a control set and their Ns will not add up to a single control group.
#===============================================================================

# ETHCAT for the year-2 cohort (the only match covariate not already present).
ethcat_yr2 <- df_liver_data_filtered %>%
  select(TRR_ID_CODE, ETHCAT) %>%
  distinct(TRR_ID_CODE, .keep_all = TRUE) %>%
  mutate(ETHCAT = factor(ETHCAT))

# Generic: match two first-year groups within a year-2 model frame, then fit
# unadjusted + adjusted logistic models on the matched set for a given binary
# outcome. Returns the OR rows for both models, or NULL if an arm is too small.
match_yr2_outcome <- function(model_df, outcome, treat_grp, ctrl_grp, label, seed = 1234) {
  
  d <- model_df %>%
    filter(FIRST_YEAR_GROUP %in% c(treat_grp, ctrl_grp)) %>%
    mutate(FIRST_YEAR_GROUP = droplevels(FIRST_YEAR_GROUP)) %>%
    left_join(ethcat_yr2, by = "TRR_ID_CODE") %>%
    mutate(treat = as.integer(FIRST_YEAR_GROUP == treat_grp))
  
  md <- d %>% select(TRR_ID_CODE, treat, all_of(match_covariates))
  report_complete_case_loss(md, label)
  md <- md %>% drop_na(all_of(match_covariates)) %>% mutate(across(where(is.factor), droplevels))
  
  if (length(unique(md$treat)) < 2 || min(table(md$treat)) < 5) {
    message("skipping match -- too few complete cases in one arm: ", label)
    return(NULL)
  }
  
  set.seed(seed)
  m <- matchit(match_formula, data = md, method = "nearest",
               distance = "logit", ratio = 1, caliper = 0.2, std.caliper = TRUE)
  message("[", label, "] treated units unmatched by caliper: ",
          sum(m$treat == 1 & is.na(m$subclass)))
  
  matched_ids <- match.data(m)$TRR_ID_CODE
  dm <- d %>%
    filter(TRR_ID_CODE %in% matched_ids) %>%
    mutate(FIRST_YEAR_GROUP = relevel(droplevels(FIRST_YEAR_GROUP), ref = ctrl_grp))
  
  # Guard against a zero-event arm (would make the OR non-estimable).
  ev <- tapply(dm[[outcome]], dm$FIRST_YEAR_GROUP, sum, na.rm = TRUE)
  if (any(ev == 0)) {
    message("skipping models -- an arm has zero year-2 events after matching: ", label,
            " (events by arm: ", paste(names(ev), ev, sep = "=", collapse = ", "), ")")
    return(NULL)
  }
  
  f_unadj <- glm(as.formula(paste(outcome, "~ FIRST_YEAR_GROUP")), data = dm, family = binomial)
  f_adj   <- glm(as.formula(paste(outcome, "~ FIRST_YEAR_GROUP +", yr2_adj_covs)),
                 data = dm, family = binomial)
  
  bind_rows(
    tidy_glm_or(f_unadj) %>% filter(str_detect(term, "^FIRST_YEAR_GROUP")) %>% mutate(Model = "Unadjusted"),
    tidy_glm_or(f_adj)   %>% filter(str_detect(term, "^FIRST_YEAR_GROUP")) %>% mutate(Model = "Adjusted")
  ) %>%
    mutate(Comparison = label) %>%
    select(Comparison, Model, N, OR, CI_lower, CI_upper, p_value)
}

# Small helper to render a matched OR results tibble as a gt table.
render_yr2_matched_table <- function(res, title, outcome_phrase) {
  if (is.null(res) || nrow(res) == 0) {
    message("no matched results to render for: ", title)
    return(invisible(NULL))
  }
  res %>%
    mutate(
      `OR (95% CI)` = sprintf("%.2f (%.2f\u2013%.2f)", OR, CI_lower, CI_upper),
      `P value` = case_when(p_value < 0.001 ~ "<0.001", TRUE ~ sprintf("%.3f", p_value))
    ) %>%
    select(Comparison, Model, N, `OR (95% CI)`, `P value`) %>%
    arrange(Comparison, Model) %>%
    gt(groupname_col = "Comparison") %>%
    cols_label(Model = "Model", N = "N in matched model",
               `OR (95% CI)` = "Odds Ratio (95% CI)", `P value` = "P value") %>%
    tab_header(title = title, subtitle = "Sensitivity analysis: 1:1 propensity-matched arms") %>%
    tab_options(table.font.size = 13, data_row.padding = px(4),
                column_labels.font.weight = "bold", row_group.font.weight = "bold") %>%
    tab_source_note(paste0(
      "OR > 1 indicates higher odds of ", outcome_phrase, " relative to the comparison group. ",
      "SENSITIVITY ANALYSIS: each comparison is a separate 1:1 nearest-neighbour propensity match ",
      "(caliper 0.2 SD of the propensity logit; age, gender, ethnicity, MELD, diabetes, cold ischemic time; ",
      "HLA mismatch excluded for missingness). Matching is performed on the year-2 eligible cohort with pairs ",
      "intact. The 'Adjusted' model additionally fits the same covariates on the matched set. Because each ",
      "comparison has its own matched control set, Ns across comparisons are not additive. Compare against the ",
      "full-cohort adjusted-regression table, which is the primary analysis."))
}

# --- Outcome 1: Year-2 anti-rejection treatment ---
matched_or_rej_yr2 <- bind_rows(
  match_yr2_outcome(df_yr2_model, "ANY_ANTI_REJ_YR2", "Steroid",  "Control", "Steroid vs Control"),
  match_yr2_outcome(df_yr2_model, "ANY_ANTI_REJ_YR2", "Combined", "Control", "Combined vs Control"),
  match_yr2_outcome(df_yr2_model, "ANY_ANTI_REJ_YR2", "Combined", "Steroid", "Combined vs Steroid")
)

matched_or_rej_yr2

render_yr2_matched_table(
  matched_or_rej_yr2,
  "Odds of Anti-Rejection Treatment in Year 2 (Propensity-Matched Sensitivity Analysis)",
  "being treated for rejection in year 2"
)

# --- Outcome 2: Year-2 graft failure ---
matched_or_grf_yr2 <- bind_rows(
  match_yr2_outcome(df_grf_yr2_model, "ANY_GRF_FAIL_YR2", "Steroid",  "Control", "Steroid vs Control"),
  match_yr2_outcome(df_grf_yr2_model, "ANY_GRF_FAIL_YR2", "Combined", "Control", "Combined vs Control"),
  match_yr2_outcome(df_grf_yr2_model, "ANY_GRF_FAIL_YR2", "Combined", "Steroid", "Combined vs Steroid")
)

matched_or_grf_yr2

render_yr2_matched_table(
  matched_or_grf_yr2,
  "Odds of Graft Failure in Year 2 (Propensity-Matched Sensitivity Analysis)",
  "graft failure in year 2"
)

