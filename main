)
gts_donor6

## Donor Table 7D: all four therapy arms at once (Steroid / Combined / Dual /
## Control), which is the closest analogue to the 3-column reference table.
## Built from the SAME first-event arm assignment used by the survival section
## (assign_arm_at_landmark), not from the section-6 ID vectors, so a patient
## with both an inpatient and an outpatient record lands in exactly one arm.
## Requires section 17 to have run.
if (exists("arm_at_landmark")) {
  tbl7_df <- pat_all_demo_table %>%
    inner_join(arm_at_landmark, by = "TRR_ID_CODE") %>%
    filter(ARM %in% c("Control", "Steroids", "Combined", "Dual Therapy")) %>%
    mutate(REJ_GROUP = factor(ARM, levels = c("Control", "Steroids", "Combined", "Dual Therapy"))) %>%
    distinct(TRR_ID_CODE, .keep_all = TRUE)
  
  gts_donor7 <- build_donor_table(
    tbl7_df,
    caption = "**Table 7D. Deceased Donor Characteristics by Anti-Rejection Therapy Arm**"
  )
  print(gts_donor7)
  
  # Matching recipient-side table on the same four arms, for symmetry.
  gts_recipient7 <- build_gts_table(
    tbl7_df, "REJ_GROUP", cont_test = "auto",
    caption = "**Table 7. Recipient Characteristics by Anti-Rejection Therapy Arm**"
  )
  print(gts_recipient7)
}

# --- Step 4: export -------------------------------------------------------
# gtsummary tables render in the Viewer/knit output; use one of these to save.
# library(flextable); library(officer)
# read_docx() |>
#   body_add_flextable(as_flex_table(gts_donor1)) |>
#   body_add_break() |>
#   body_add_flextable(as_flex_table(gts_donor2)) |>
#   print(target = "donor_tables.docx")
#
# gt::gtsave(as_gt(gts_donor1), "table1D.html")

# NOTES / things to check before trusting this output:
# 1. These arms were propensity-matched on RECIPIENT covariates only. Donor
#    characteristics were never balanced, so a significant donor-side p-value
#    in Table 2D/3D is a real finding about residual confounding, not a
#    matching failure. That is arguably the most useful thing these tables do:
#    if donor age or DCD status differs between matched arms, it belongs in
#    the adjusted models.
# 2. Continuous donor labs (AST, ALT, bilirubin, creatinine) are heavily
#    right-skewed. Mean (SD) with ANOVA is what the reference table format
#    asks for, but consider cont_test = "kruskal.test" and
#    statistic = "{median} ({p25}, {p75})" for those rows specifically.

#===============================================================================
# 17b. Timing of first anti-rejection treatment within the landmark window
#-------------------------------------------------------------------------------
# Depends on: pat_rej_first (17 Step 1), arm_at_landmark (17 Step 2),
#             LANDMARK_DAY, INPATIENT_RX_DAY.
#
# READ BEFORE INTERPRETING:
#  1. Control has no bars -- it is defined by the ABSENCE of treatment before
#     the landmark. The empty panel is intentional.
#  2. The day-0 bar is imputed, not observed (INPATIENT_RX_DAY). Fill colour
#     separates it from genuinely dated outpatient events.
#  3. Outpatient x-values are FOL_DATE_DAYS_DELTA, the date of the VISIT at
#     which the drug was recorded -- an upper bound on the true treatment day.
#     Peaks at ~180 and ~365 days reflect the visit schedule.
#===============================================================================

# TRUE  -> Rituxan monotherapy becomes its own mutually exclusive arm, and
#          "Combined" means Simulect/Thymoglobulin only (bars are disjoint).
# FALSE -> "Combined" keeps its original membership and Rituxan is plotted
#          additionally as an overlapping subset (bars then double-count).
RITUXAN_AS_OWN_ARM <- FALSE

TIMING_BINWIDTH <- 14   # days per bin

tx_timing_base <- pat_rej_first %>%
  filter(!is.na(REJ_TX_DAY), REJ_TX_DAY >= 0, REJ_TX_DAY < LANDMARK_DAY) %>%
  left_join(arm_at_landmark, by = "TRR_ID_CODE") %>%
  filter(!is.na(ARM)) %>%
  mutate(
    # NA-safe: a bare `RITUXAN_ANTIREJ == 1` propagates NA into the logical
    # and silently sends those patients to the case_when() fallback.
    RITUX_MONO = NUM_ANTI_REJ_RXED < 2 &
      !is.na(RITUXAN_ANTIREJ) & RITUXAN_ANTIREJ == 1,
    SRC_LBL = if_else(source == 1L,
                      "Index admission (day imputed to 0)",
                      "Outpatient follow-up visit")
  )

tx_timing <- if (RITUXAN_AS_OWN_ARM) {
  tx_timing_base %>%
    mutate(TIMING_ARM = case_when(
      ARM == "Combined" &  RITUX_MONO ~ "Rituxan only",
      ARM == "Combined" & !RITUX_MONO ~ "Combined (non-Rituxan)",
      TRUE                            ~ as.character(ARM)
    ))
} else {
  bind_rows(
    tx_timing_base %>% mutate(TIMING_ARM = as.character(ARM)),
    tx_timing_base %>% filter(RITUX_MONO) %>%
      mutate(TIMING_ARM = "Rituxan only (subset of Combined)")
  )
}

# Level order fixed here, with Control last and ALWAYS present so facet_wrap
# (drop = FALSE) renders its empty panel.
timing_levels <- intersect(
  c("Steroids", "Combined (non-Rituxan)", "Combined", "Rituxan only",
    "Rituxan only (subset of Combined)", "Dual Therapy", "Other Rejection"),
  unique(tx_timing$TIMING_ARM)
)
timing_levels <- c(timing_levels, "Control")

tx_timing <- tx_timing %>%
  mutate(TIMING_ARM = factor(TIMING_ARM, levels = timing_levels))

# --- Per-arm N annotations -----------------------------------------------
# Control's N comes from arm_at_landmark (patients assigned to it), not from
# tx_timing (which has no Control rows at all).
n_control <- sum(arm_at_landmark$ARM == "Control")

timing_n <- tx_timing %>%
  count(TIMING_ARM, .drop = FALSE, name = "n_treated") %>%
  mutate(
    lbl = if_else(
      TIMING_ARM == "Control",
      paste0("n = ", n_control, " assigned\n0 treated (arm definition)"),
      paste0("n = ", n_treated, " treated")
    )
  )

# --- Plot A: faceted histogram, split by timing source --------------------
# scales = "free_y" because Steroids typically dwarfs the other arms; counts
# are therefore NOT comparable across panels by bar height. Use Plot B or C
# for cross-arm comparison.
p_timing_facet <- ggplot(tx_timing, aes(x = REJ_TX_DAY, fill = SRC_LBL)) +
  geom_histogram(binwidth = TIMING_BINWIDTH, boundary = 0,
                 colour = "white", linewidth = 0.2) +
  geom_text(data = timing_n, aes(x = Inf, y = Inf, label = lbl),
            inherit.aes = FALSE, hjust = 1.05, vjust = 1.3, size = 3) +
  facet_wrap(~ TIMING_ARM, ncol = 2, drop = FALSE, scales = "free_y") +
  scale_x_continuous(breaks = seq(0, LANDMARK_DAY, by = 60),
                     limits = c(0, LANDMARK_DAY),
                     expand = expansion(mult = c(0, 0.02))) +
  scale_y_continuous(expand = expansion(mult = c(0, 0.15))) +
  scale_fill_manual(values = c("Index admission (day imputed to 0)" = "grey60",
                               "Outpatient follow-up visit" = "steelblue")) +
  labs(
    title = "Timing of First Anti-Rejection Therapy, by Arm",
    subtitle = paste0("First post-transplant year (landmark day ",
                      round(LANDMARK_DAY), "); ", TIMING_BINWIDTH, "-day bins"),
    x = "Days since transplant", y = "Patients", fill = "Timing source",
    caption = "Y axes are independent per panel. Day-0 bar is imputed, not observed."
  ) +
  theme_minimal() +
  theme(legend.position = "bottom",
        strip.text = element_text(face = "bold"))

print(p_timing_facet)

# --- Plot B: overlaid distributions, day 0 dropped ------------------------
# Density rather than counts so arms of very different size are comparable.
# Excluding day 0 removes the imputed point mass that would otherwise dominate
# every curve identically.
tx_timing_dated <- tx_timing %>% filter(REJ_TX_DAY > 0)

p_timing_overlay <- ggplot(tx_timing_dated,
                           aes(x = REJ_TX_DAY, colour = TIMING_ARM)) +
  geom_freqpoly(aes(y = after_stat(density)),
                binwidth = TIMING_BINWIDTH, boundary = 0, linewidth = 0.8) +
  scale_x_continuous(breaks = seq(0, LANDMARK_DAY, by = 60),
                     limits = c(0, LANDMARK_DAY)) +
  scale_colour_brewer(palette = "Dark2", drop = TRUE) +
  labs(
    title = "First Anti-Rejection Therapy: Distribution of Treatment Day",
    subtitle = "Index-admission (day-0 imputed) events excluded; density-scaled for cross-arm comparison",
    x = "Days since transplant", y = "Density", colour = "Arm"
  ) +
  theme_minimal() +
  theme(legend.position = "bottom")

print(p_timing_overlay)

# --- Plot C: cumulative proportion treated --------------------------------
# The estimate least sensitive to bin width AND to visit-date clustering: a
# step at day 180 in a histogram is ambiguous, but the ECDF still reads
# correctly as "x% of this arm had been treated by day 180."
p_timing_ecdf <- ggplot(tx_timing, aes(x = REJ_TX_DAY, colour = TIMING_ARM)) +
  stat_ecdf(geom = "step", linewidth = 0.8, na.rm = TRUE) +
  scale_x_continuous(breaks = seq(0, LANDMARK_DAY, by = 60),
                     limits = c(0, LANDMARK_DAY)) +
  scale_y_continuous(labels = scales::percent_format(accuracy = 1),
                     limits = c(0, 1)) +
  scale_colour_brewer(palette = "Dark2", drop = TRUE) +
  labs(
    title = "Cumulative Proportion of Each Treated Arm Already Treated, by Day",
    subtitle = "Denominator is the arm's treated patients, not the full cohort",
    x = "Days since transplant", y = "Cumulative % of arm treated", colour = "Arm"
  ) +
  theme_minimal() +
  theme(legend.position = "bottom")

print(p_timing_ecdf)

# --- Summary table --------------------------------------------------------
# Median/IQR computed on DATED events only; including the imputed zeros would
# drag the median toward 0 by an amount that depends entirely on what fraction
# of the arm was treated inpatient.
timing_summary <- tx_timing %>%
  group_by(TIMING_ARM, .drop = FALSE) %>%
  summarise(
    n_treated   = n(),
    n_inpatient = sum(source == 1L, na.rm = TRUE),
    n_dated     = sum(REJ_TX_DAY > 0, na.rm = TRUE),
    median_day  = median(REJ_TX_DAY[REJ_TX_DAY > 0], na.rm = TRUE),
    q1_day      = quantile(REJ_TX_DAY[REJ_TX_DAY > 0], 0.25, na.rm = TRUE),
    q3_day      = quantile(REJ_TX_DAY[REJ_TX_DAY > 0], 0.75, na.rm = TRUE),
    pct_by_30   = 100 * mean(REJ_TX_DAY <= 30,  na.rm = TRUE),
    pct_by_90   = 100 * mean(REJ_TX_DAY <= 90,  na.rm = TRUE),
    pct_by_180  = 100 * mean(REJ_TX_DAY <= 180, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  mutate(across(where(is.numeric), ~ if_else(is.nan(.x), NA_real_, .x)))

timing_summary %>%
  mutate(
    `Median (IQR), d` = if_else(
      is.na(median_day), NA_character_,
      sprintf("%.0f (%.0f\u2013%.0f)", median_day, q1_day, q3_day)
    )
  ) %>%
  select(TIMING_ARM, n_treated, n_inpatient, n_dated,
         `Median (IQR), d`, pct_by_30, pct_by_90, pct_by_180) %>%
  gt() %>%
  fmt_number(columns = c(pct_by_30, pct_by_90, pct_by_180), decimals = 1) %>%
  sub_missing(missing_text = "\u2014") %>%
  cols_label(
    TIMING_ARM  = "Arm",
    n_treated   = "N treated",
    n_inpatient = "N index admission",
    n_dated     = "N with observed date",
    pct_by_30   = "% by d30",
    pct_by_90   = "% by d90",
    pct_by_180  = "% by d180"
  ) %>%
  tab_header(
    title = "Timing of First Anti-Rejection Therapy Within the Landmark Window",
    subtitle = paste0("Landmark day ", round(LANDMARK_DAY), " post-transplant")
  ) %>%
  tab_options(table.font.size = 13, data_row.padding = px(4),
              column_labels.font.weight = "bold") %>%
  tab_source_note("Control is treated-by-definition-never and so has no timing row content; its N appears in the faceted figure. Median and IQR use only events with an observed follow-up date -- index-admission therapy is recorded without a date and is imputed to day 0 (INPATIENT_RX_DAY), so including it would bias the median downward in proportion to each arm's inpatient share. The cumulative percentages DO include the imputed day-0 events, and are therefore upper bounds on how early each arm was treated.")

