#===============================================================================
# 17. Survival Analysis -- Landmark Design
#-------------------------------------------------------------------------------
# IMMORTAL TIME BIAS.
#
# Defining group membership from anti-rejection treatment received during
# YEAR 1, but starting the survival clock at TRANSPLANT (day 0), is immortal
# time bias, and it is not a small effect:
#
#   * A patient who died on day 40 could not possibly have received a month-6
#     rejection treatment. They are therefore forced into the Control arm by
#     construction -- not because they avoided rejection, but because they
#     died before they could be observed having one.
#   * Every patient in the Steroids / Combined / Dual arms is GUARANTEED to
#     have survived at least until their treatment date. That guaranteed
#     survival is "immortal time," and a naive KM curve credits it to the
#     treatment.
#   * The result is that treated arms look structurally protected early on,
#     and the Control arm absorbs all the early deaths -- biasing in the
#     direction of making anti-rejection treatment look beneficial.
#
# The year-2 sections below already handle this correctly with
# landmark_ids_yr1. This section applies the same logic to the primary
# survival analysis, plus a time-varying-exposure Cox model as a sensitivity
# analysis that uses the full follow-up without discarding anyone.
#
# DESIGN:
#   1. Fix a landmark day L (default 365.25, matching the year-2 sections).
#   2. Exposure is whatever anti-rejection treatment was given in [0, L).
#   3. Only patients still under observation AT L enter the analysis.
#   4. The survival clock is reset to start at L.
#   Nobody in any arm can have died before L, so no arm carries immortal time.
#
# CONSEQUENCE FOR INTERPRETATION -- READ THIS:
#   Time on the x-axis is DAYS SINCE THE LANDMARK, not days since transplant.
#   With L = 365.25, the "1-year" curve covers post-transplant years 1-2 and
#   the "2-year" curve covers years 1-3. These are conditional survival
#   estimates (survival given you reached 1 year), the correct quantity for a
#   year-1 exposure, but NOT the same estimand as a transplant-anchored plot.
#   Label it as such in any manuscript.
#
#   Everyone who died in year 1 is excluded. That is the price of the
#   landmark design, and the reason the time-varying model below is included
#   alongside it.
#===============================================================================

# scale_x_continuous() replaces (rather than adds to) the scale survminer
# builds from break.time.by, so the replacement scale must carry the same
# breaks explicitly or the tick marks silently disappear.
fix_origin <- function(p, break_by = NULL, max_time = NULL) {
  x_scale <- if (!is.null(break_by) && !is.null(max_time)) {
    ggplot2::scale_x_continuous(
      expand = ggplot2::expansion(mult = c(0, 0.02)),
      breaks = seq(0, max_time, by = break_by)
    )
  } else {
    ggplot2::scale_x_continuous(expand = ggplot2::expansion(mult = c(0, 0.02)))
  }
  
  p$plot <- suppressMessages(
    p$plot +
      x_scale +
      ggplot2::scale_y_continuous(expand = ggplot2::expansion(mult = c(0, 0.02)), limits = c(0, 1))
  )
  # keep the risk table on the same x scale so the columns stay aligned
  if (!is.null(p$table)) {
    p$table <- suppressMessages(p$table + x_scale)
  }
  p
}

# --- Step 0: analysis parameters ---
# LANDMARK_DAY is the single knob controlling this whole section. 365.25 keeps
# the exposure definition identical to the rest of the script. Setting it
# lower (e.g. 90) retains more patients and more post-landmark follow-up, at
# the cost of only counting rejections treated in the first 90 days --
# rejections after that are then treated as non-exposure (a
# treat-as-of-landmark analysis). Running both and comparing is a reasonable
# sensitivity analysis.
LANDMARK_DAY <- 365.25

# Horizons are measured FROM THE LANDMARK, not from transplant.
LM_HORIZON_SHORT <- 365.25   # 1 year of post-landmark follow-up
LM_HORIZON_LONG  <- 730.5    # 2 years of post-landmark follow-up

# Day (post-transplant) assigned to anti-rejection therapy given during the
# index admission. The UNOS discharge file records THAT it was given, not
# WHEN, so day 0 is used: it assigns these patients no immortal time at all.
# A positive value would credit them unexposed person-time they may not have
# had. Sensitivity: try DAYS_HOSP_SP_TX / 2.
INPATIENT_RX_DAY <- 0

# --- Step 1: day of FIRST anti-rejection treatment, per patient ---
# Without this, a landmark or time-varying design is impossible.
#
# Sources and their timing caveats:
#   source == 1 (index admission) -> INPATIENT_RX_DAY, see above.
#   source == 2 (outpatient)      -> FOL_DATE_DAYS_DELTA, the date of the
#      follow-up VISIT at which the drug was recorded. The actual treatment
#      happened at some point in the interval since the previous visit, so
#      this is an upper bound on the true treatment day -- granting slightly
#      MORE unexposed person-time than reality, which is conservative here.
pat_rej_first <- pat_rej_array %>%
  group_by(TRR_ID_CODE) %>%
  slice_min(order_by = source, n = 1, with_ties = FALSE) %>%
  ungroup() %>%
  mutate(
    REJ_TX_DAY = if_else(source == 1L,
                         as.numeric(INPATIENT_RX_DAY),
                         as.numeric(FOL_DATE_DAYS_DELTA))
  )

message("Rejectors with unusable REJ_TX_DAY (should be 0): ",
        sum(is.na(pat_rej_first$REJ_TX_DAY)))
summary(pat_rej_first$REJ_TX_DAY)

# --- Step 2: arm assignment AS OF a given landmark ---
# Arms are mutually exclusive and derived from the patient's FIRST
# anti-rejection event only -- this differs subtly from
# steroid_id_all_vect/arm2_ID_vect above, which were built from pat_rej_array
# without deduplication (a patient with both an inpatient and an outpatient
# record could be classified from whichever row happened to match).
# First-event classification is the one coherent with a time-to-event design.
assign_arm_at_landmark <- function(landmark_day) {
  
  treated_before <- pat_rej_first %>%
    filter(!is.na(REJ_TX_DAY), REJ_TX_DAY < landmark_day)
  
  mono <- treated_before %>% filter(NUM_ANTI_REJ_RXED < 2)
  
  steroid_lm <- mono %>% filter(STEROIDS_ANTIREJ == 1) %>% pull(TRR_ID_CODE)
  
  combined_lm <- mono %>%
    filter(SIMULECT_ANTIREJ == 1 | THYMOGLOBULIN_ANTIREJ == 1 | RITUXAN_ANTIREJ == 1) %>%
    pull(TRR_ID_CODE)
  
  dual_lm <- treated_before %>%
    filter(STEROIDS_ANTIREJ == 1,
           SIMULECT_ANTIREJ == 1 | THYMOGLOBULIN_ANTIREJ == 1 | RITUXAN_ANTIREJ == 1) %>%
    pull(TRR_ID_CODE)
  
  # Controls: assessed at least once (so "no rejection" means observed, not
  # missing) and no anti-rejection therapy recorded before the landmark.
  assessed_ids <- unique(df_immuno_fol_calc$TRR_ID_CODE)
  control_lm   <- setdiff(assessed_ids, treated_before$TRR_ID_CODE)
  
  tibble(TRR_ID_CODE = unique(c(treated_before$TRR_ID_CODE, control_lm))) %>%
    mutate(ARM = case_when(
      TRR_ID_CODE %in% dual_lm     ~ "Dual Therapy",
      TRR_ID_CODE %in% steroid_lm  ~ "Steroids",
      TRR_ID_CODE %in% combined_lm ~ "Combined",
      TRR_ID_CODE %in% control_lm  ~ "Control",
      TRUE                         ~ "Other Rejection"
    ))
}

arm_at_landmark <- assign_arm_at_landmark(LANDMARK_DAY)
table(arm_at_landmark$ARM, useNA = "ifany")

# Reconciliation against the original ID vectors. At LANDMARK_DAY = 365.25
# these should agree almost exactly; any difference is the deduplication
# effect described above, not the landmark itself. Reported rather than
# asserted, so a real discrepancy is visible instead of fatal.
reconcile_arm <- function(arm_name, old_vect) {
  new_vect <- arm_at_landmark %>% filter(ARM == arm_name) %>% pull(TRR_ID_CODE)
  message(sprintf("  %-14s new n=%4d | old n=%4d | new-only=%3d | old-only=%3d",
                  arm_name, length(new_vect), length(old_vect),
                  length(setdiff(new_vect, old_vect)),
                  length(setdiff(old_vect, new_vect))))
}
message("Arm reconciliation (first-event classification vs original vectors):")
reconcile_arm("Steroids",     steroid_id_all_vect)
reconcile_arm("Combined",     arm2_ID_vect)
reconcile_arm("Dual Therapy", dual_therapy_id_vect)
reconcile_arm("Control",      ctrl_id_vect)

# --- Step 3: base survival frame ---
df_survival <- df_liver_data_filtered |>
  select(TRR_ID_CODE, TX_DATE, COMPOSITE_DEATH_DATE, RETXDATE, PTIME, PX_STAT, PX_STAT_DATE) |>
  mutate(PTIME = suppressWarnings(as.numeric(PTIME))) |>
  distinct(TRR_ID_CODE, .keep_all = TRUE) |>
  mutate(event = ifelse(PX_STAT == "D", 1, 0))   # confirm "D" is the death code

baseline_covs <- df_liver_data_filtered %>%
  select(TRR_ID_CODE, AGE, GENDER, ETHCAT, MELD_PELD_LAB_SCORE, COLD_ISCH, DIAB) %>%
  distinct(TRR_ID_CODE, .keep_all = TRUE) %>%
  left_join(df_hla_calc %>% select(TRR_ID_CODE, MM_TOTAL), by = "TRR_ID_CODE") %>%
  mutate(
    DIAB_BIN = case_when(
      as.numeric(DIAB) %in% 2:5 ~ 1,
      as.numeric(DIAB) == 1     ~ 0,
      TRUE                      ~ NA_real_
    ),
    GENDER = factor(GENDER),
    ETHCAT = factor(ETHCAT)
  )

# --- Step 4: build the landmark survival dataset ---
# This is where the bias is actually removed. Three things happen together
# and all three are necessary:
#   (a) arms are assigned from exposure BEFORE the landmark,
#   (b) patients not still under observation AT the landmark are DROPPED,
#   (c) the clock is reset so t = 0 is the landmark, not transplant.
# Doing (a) without (b) and (c) is exactly the original bug.
build_landmark_surv <- function(landmark_day, horizon_days) {
  arms <- assign_arm_at_landmark(landmark_day)
  
  out <- df_survival %>%
    inner_join(arms, by = "TRR_ID_CODE") %>%
    filter(!is.na(PTIME), PTIME >= landmark_day) %>%     # (b) landmark restriction
    mutate(
      time_raw = PTIME - landmark_day,                   # (c) clock reset
      event_lm = if_else(time_raw <= horizon_days, event, 0),
      time_lm  = pmin(time_raw, horizon_days),
      ARM = factor(ARM, levels = c("Control", "Steroids", "Combined",
                                   "Dual Therapy", "Other Rejection"))
    )
  
  n_zero <- sum(out$time_lm == 0)
  if (n_zero > 0) {
    message("  note: ", n_zero, " patient(s) have exactly 0 days of post-landmark follow-up")
  }
  out
}

df_lm_short <- build_landmark_surv(LANDMARK_DAY, LM_HORIZON_SHORT)
df_lm_long  <- build_landmark_surv(LANDMARK_DAY, LM_HORIZON_LONG)

# How much cohort did the landmark cost, and from which arm? If Control loses
# a far larger share than the treated arms, that IS the immortal time bias,
# quantified -- those are the early deaths the naive analysis silently
# assigned to Control.
landmark_attrition <- assign_arm_at_landmark(LANDMARK_DAY) %>%
  left_join(df_survival %>% select(TRR_ID_CODE, PTIME), by = "TRR_ID_CODE") %>%
  group_by(ARM) %>%
  summarise(
    n_before_landmark = n(),
    n_at_landmark     = sum(!is.na(PTIME) & PTIME >= LANDMARK_DAY),
    n_lost            = n_before_landmark - n_at_landmark,
    pct_lost          = 100 * n_lost / n_before_landmark,
    .groups = "drop"
  )

landmark_attrition %>%
  gt() %>%
  fmt_number(columns = pct_lost, decimals = 1) %>%
  cols_label(
    ARM               = "Arm",
    n_before_landmark = "N assigned to arm",
    n_at_landmark     = paste0("N still observed at day ", round(LANDMARK_DAY)),
    n_lost            = "N excluded by landmark",
    pct_lost          = "% excluded"
  ) %>%
  tab_header(title = "Landmark Attrition by Arm") %>%
  tab_options(table.font.size = 13, data_row.padding = px(4), column_labels.font.weight = "bold") %>%
  tab_source_note("Patients excluded because they were no longer under observation at the landmark. A markedly higher exclusion rate in the Control arm is the immortal time bias made explicit: under a transplant-anchored design those deaths were counted against Control while every treated patient was guaranteed to have survived to their treatment date.")

# --- Step 5: KM plotting helper ---
# The log-rank p-value is computed here and passed to ggsurvplot as a
# pre-formatted STRING rather than via pval = TRUE, because survminer
# re-evaluates the model formula in the calling frame when asked to compute
# the p-value itself, which breaks when the data lives in a function-local
# variable.
plot_landmark_km <- function(df, arms_keep, horizon, break_by, title) {
  d <- df %>% filter(ARM %in% arms_keep) %>% mutate(ARM = droplevels(ARM))
  
  if (nlevels(d$ARM) < 2) {
    message("skipping plot -- fewer than 2 non-empty arms: ", title)
    return(invisible(NULL))
  }
  
  fit <- survfit(Surv(time_lm, event_lm) ~ ARM, data = d)
  
  sd_test  <- survdiff(Surv(time_lm, event_lm) ~ ARM, data = d)
  pv       <- 1 - pchisq(sd_test$chisq, length(sd_test$n) - 1)
  pval_lbl <- if (pv < 0.001) "log-rank p < 0.001" else sprintf("log-rank p = %.3f", pv)
  
  p <- ggsurvplot(
    fit, data = d, pval = pval_lbl, conf.int = TRUE, risk.table = TRUE,
    break.time.by = break_by, legend.title = "Group", legend.labs = levels(d$ARM),
    xlab = paste0("Days since landmark (day ", round(LANDMARK_DAY), " post-transplant)"),
    ylab = "Survival Probability", title = title
  )
  fix_origin(p, break_by = break_by, max_time = horizon)
}

# --- Step 6: descriptive KM curves on the unmatched landmark cohort ---
print(plot_landmark_km(
  df_lm_short, c("Steroids", "Combined", "Control"), LM_HORIZON_SHORT, 90,
  "Conditional Survival, Years 1-2 Post-Transplant (Landmark, Unmatched)"
))

print(plot_landmark_km(
  df_lm_long, c("Steroids", "Combined", "Control"), LM_HORIZON_LONG, 180,
  "Conditional Survival, Years 1-3 Post-Transplant (Landmark, Unmatched)"
))

print(plot_landmark_km(
  df_lm_long, c("Steroids", "Dual Therapy"), LM_HORIZON_LONG, 180,
  "Steroids vs Dual Therapy (Landmark, Unmatched)"
))

print(plot_landmark_km(
  df_lm_long, c("Dual Therapy", "Combined"), LM_HORIZON_LONG, 180,
  "Dual Therapy vs Combined (Landmark, Unmatched)"
))

fit_lm_3arm_short <- survfit(Surv(time_lm, event_lm) ~ ARM,
                             data = df_lm_short %>%
                               filter(ARM %in% c("Steroids", "Combined", "Control")) %>%
                               mutate(ARM = droplevels(ARM)))
summary(fit_lm_3arm_short, times = LM_HORIZON_SHORT)

fit_lm_3arm_long <- survfit(Surv(time_lm, event_lm) ~ ARM,
                            data = df_lm_long %>%
                              filter(ARM %in% c("Steroids", "Combined", "Control")) %>%
                              mutate(ARM = droplevels(ARM)))
summary(fit_lm_3arm_long, times = LM_HORIZON_LONG)

# --- Step 7: propensity matching WITHIN the landmark cohort ---
# Matching is redone here rather than reusing m_combined_steroid/m_combined_ctrl
# from section 13. Those were fit on the full year-1 cohort; applying the
# landmark restriction afterwards would break matched pairs non-randomly (the
# patient who died at month 6 is dropped, their match is not), reintroducing
# the imbalance the matching existed to remove. Matching within the eligible
# cohort keeps pairs intact.
#
# Tables 2 and 3 above therefore describe the YEAR-1 matched cohorts, while
# this section reports its own Ns and its own balance. Don't quote one
# table's N alongside the other's hazard ratio.
match_within_landmark <- function(df_lm, treat_arm, ctrl_arm, label, seed = 1234) {
  
  d <- df_lm %>%
    filter(ARM %in% c(treat_arm, ctrl_arm)) %>%
    mutate(treat = as.integer(ARM == treat_arm)) %>%
    left_join(baseline_covs, by = "TRR_ID_CODE")
  
  md <- d %>% select(TRR_ID_CODE, treat, all_of(match_covariates))
  report_complete_case_loss(md, label)
  
  md <- md %>%
    drop_na() %>%
    mutate(across(where(is.factor), droplevels))
  
  if (length(unique(md$treat)) < 2 || min(table(md$treat)) < 5) {
    message("skipping match -- too few complete cases in one arm: ", label)
    return(NULL)
  }
  
  set.seed(seed)
  m <- matchit(
    match_formula, data = md, method = "nearest", distance = "logit",
    ratio = 1, caliper = 0.2, std.caliper = TRUE
  )
  
  message("[", label, "] treated units unmatched by caliper: ",
          sum(m$treat == 1 & is.na(m$subclass)))
  
  matched_ids <- match.data(m)$TRR_ID_CODE
  
  list(
    matchit = m,
    data = d %>% filter(TRR_ID_CODE %in% matched_ids) %>% mutate(ARM = droplevels(ARM))
  )
}

lm_match_steroid_combined <- match_within_landmark(
  df_lm_long, treat_arm = "Combined", ctrl_arm = "Steroids",
  label = "Landmark: Combined vs Steroid"
)

lm_match_combined_control <- match_within_landmark(
  df_lm_long, treat_arm = "Combined", ctrl_arm = "Control",
  label = "Landmark: Combined vs Control"
)

# --- Balance ---
if (!is.null(lm_match_steroid_combined)) {
  summary(lm_match_steroid_combined$matchit)
  print(love.plot(lm_match_steroid_combined$matchit,
                  binary = "std", stats = "mean.diffs", abs = TRUE,
                  var.order = "unadjusted", thresholds = c(m = 0.1),
                  title = "Landmark Cohort Balance: Combined vs Steroid",
                  sample.names = c("Unmatched", "Matched")))
}

if (!is.null(lm_match_combined_control)) {
  summary(lm_match_combined_control$matchit)
  print(love.plot(lm_match_combined_control$matchit,
                  binary = "std", stats = "mean.diffs", abs = TRUE,
                  var.order = "unadjusted", thresholds = c(m = 0.1),
                  title = "Landmark Cohort Balance: Combined vs Control",
                  sample.names = c("Unmatched", "Matched")))
}

# --- Matched KM curves ---
if (!is.null(lm_match_steroid_combined)) {
  print(plot_landmark_km(
    lm_match_steroid_combined$data, c("Steroids", "Combined"),
    LM_HORIZON_LONG, 180, "Combined vs Steroids (Landmark, Propensity Matched)"
  ))
}

if (!is.null(lm_match_combined_control)) {
  print(plot_landmark_km(
    lm_match_combined_control$data, c("Control", "Combined"),
    LM_HORIZON_LONG, 180, "Combined vs Control (Landmark, Propensity Matched)"
  ))
}


#===============================================================================
# 18. Hazard Ratios: Landmark Cox Models
#-------------------------------------------------------------------------------
# The reference arm is an explicit ARGUMENT rather than an emergent property
# of factor level ordering, and the realised direction is echoed back in the
# output -- reading conf.int[1, ] and assuming it matches the requested label
# is how "Combined vs Control" could otherwise end up reporting Control vs
# Combined instead.
#===============================================================================
run_coxph_lm <- function(data, ref_arm, label) {
  d <- data %>% mutate(ARM = relevel(droplevels(ARM), ref = ref_arm))
  
  fit <- coxph(Surv(time_lm, event_lm) ~ ARM, data = d)
  s   <- summary(fit)
  
  zph  <- tryCatch(cox.zph(fit), error = function(e) NULL)
  ph_p <- if (!is.null(zph)) zph$table[1, "p"] else NA_real_
  
  tibble(
    Comparison = label,
    Direction  = paste0(rownames(s$conf.int)[1], "  (ref = ", ref_arm, ")"),
    n          = fit$n,
    events     = fit$nevent,
    HR         = s$conf.int[1, "exp(coef)"],
    CI_lower   = s$conf.int[1, "lower .95"],
    CI_upper   = s$conf.int[1, "upper .95"],
    p_value    = s$coefficients[1, "Pr(>|z|)"],
    ph_test_p  = ph_p
  )
}

hr_results_lm <- bind_rows(
  if (!is.null(lm_match_steroid_combined))
    run_coxph_lm(lm_match_steroid_combined$data, ref_arm = "Steroids", label = "Combined vs Steroids"),
  if (!is.null(lm_match_combined_control))
    run_coxph_lm(lm_match_combined_control$data, ref_arm = "Control", label = "Combined vs Control"),
  run_coxph_lm(df_lm_long %>% filter(ARM %in% c("Steroids", "Dual Therapy")),
               ref_arm = "Steroids", label = "Dual Therapy vs Steroids (unmatched)")
)

hr_results_lm

# Overall 3-arm model on the unmatched landmark cohort.
df_lm_3arm <- df_lm_long %>%
  filter(ARM %in% c("Steroids", "Combined", "Control")) %>%
  mutate(ARM = relevel(droplevels(ARM), ref = "Control"))

fit_lm_3arm <- coxph(Surv(time_lm, event_lm) ~ ARM, data = df_lm_3arm)
summary(fit_lm_3arm)
cox.zph(fit_lm_3arm)

hr_table_lm <- hr_results_lm %>%
  mutate(
    `HR (95% CI)` = sprintf("%.2f (%.2f\u2013%.2f)", HR, CI_lower, CI_upper),
    `P value` = case_when(p_value < 0.001 ~ "<0.001", TRUE ~ sprintf("%.3f", p_value)),
    `PH test P` = case_when(
      is.na(ph_test_p) ~ NA_character_,
      ph_test_p < 0.001 ~ "<0.001",
      TRUE ~ sprintf("%.3f", ph_test_p)
    )
  ) %>%
  select(Comparison, Direction, n, events, `HR (95% CI)`, `P value`, `PH test P`)

hr_table_lm %>%
  gt() %>%
  cols_label(
    Comparison = "Comparison", Direction = "Model direction", n = "N", events = "Deaths",
    `HR (95% CI)` = "Hazard Ratio (95% CI)", `P value` = "P value", `PH test P` = "PH Assumption P"
  ) %>%
  tab_header(
    title    = "Hazard Ratios for Mortality (Landmark Cox Models)",
    subtitle = paste0("Landmark at day ", round(LANDMARK_DAY),
                      "; follow-up from landmark to day ", round(LM_HORIZON_LONG))
  ) %>%
  tab_options(table.font.size = 13, data_row.padding = px(4), column_labels.font.weight = "bold") %>%
  tab_source_note("LANDMARK DESIGN: exposure defined over the first year post-transplant; only patients still under observation at the landmark are included; the survival clock starts AT the landmark. This removes the immortal time bias present in transplant-anchored analyses of a year-1 exposure. Hazard ratios are therefore for CONDITIONAL survival (given survival to 1 year), not overall post-transplant survival. Matched comparisons use 1:1 nearest-neighbour propensity matching performed WITHIN the landmark cohort (caliper 0.2 SD of the propensity logit; age, gender, ethnicity, MELD, diabetes, cold ischemic time, HLA mismatch). PH Assumption P from cox.zph().")

# --- Forest plots ---
ggforest(fit_lm_3arm, data = df_lm_3arm)

if (!is.null(lm_match_combined_control)) {
  d_fp <- lm_match_combined_control$data %>% mutate(ARM = relevel(droplevels(ARM), ref = "Control"))
  ggforest(coxph(Surv(time_lm, event_lm) ~ ARM, data = d_fp), data = d_fp)
}


#===============================================================================
# 19. Covariate-Adjusted Landmark Hazard Ratios
#===============================================================================
adj_formula_suffix <- " + AGE + GENDER + MELD_PELD_LAB_SCORE + COLD_ISCH + DIAB_BIN"

run_coxph_lm_adj <- function(data, ref_arm, label) {
  d <- data %>% mutate(ARM = relevel(droplevels(ARM), ref = ref_arm))
  
  # matched frames already carry baseline covariates; unmatched ones may not
  if (!"DIAB_BIN" %in% names(d)) {
    d <- d %>% left_join(baseline_covs, by = "TRR_ID_CODE")
  }
  
  fit <- coxph(as.formula(paste0("Surv(time_lm, event_lm) ~ ARM", adj_formula_suffix)), data = d)
  s <- summary(fit)
  
  tibble(
    Comparison = label,
    Direction  = paste0(rownames(s$conf.int)[1], "  (ref = ", ref_arm, ")"),
    n          = fit$n,
    events     = fit$nevent,
    HR         = s$conf.int[1, "exp(coef)"],
    CI_lower   = s$conf.int[1, "lower .95"],
    CI_upper   = s$conf.int[1, "upper .95"],
    p_value    = s$coefficients[1, "Pr(>|z|)"]
  )
}

hr_adj_results_lm <- bind_rows(
  if (!is.null(lm_match_steroid_combined))
    run_coxph_lm_adj(lm_match_steroid_combined$data, "Steroids", "Combined vs Steroids (adjusted)"),
  if (!is.null(lm_match_combined_control))
    run_coxph_lm_adj(lm_match_combined_control$data, "Control", "Combined vs Control (adjusted)")
)

hr_adj_results_lm

hr_adj_table_lm <- hr_adj_results_lm %>%
  mutate(
    `HR (95% CI)` = sprintf("%.2f (%.2f\u2013%.2f)", HR, CI_lower, CI_upper),
    `P value` = case_when(p_value < 0.001 ~ "<0.001", TRUE ~ sprintf("%.3f", p_value))
  ) %>%
  select(Comparison, Direction, n, events, `HR (95% CI)`, `P value`)

hr_adj_table_lm %>%
  gt() %>%
  cols_label(
    Comparison = "Comparison", Direction = "Model direction", n = "N", events = "Deaths",
    `HR (95% CI)` = "Adjusted Hazard Ratio (95% CI)", `P value` = "P value"
  ) %>%
  tab_header(title = "Covariate-Adjusted Landmark Hazard Ratios") %>%
  tab_options(table.font.size = 13, data_row.padding = px(4), column_labels.font.weight = "bold") %>%
  tab_source_note("Same landmark propensity-matched cohorts as the unadjusted table, with the Cox model additionally adjusted for recipient age, gender, MELD score, cold ischemic time, and diabetes status. Because several of these covariates were also used in the matching, this is adjustment layered on top of matching -- residual imbalance after matching (per the Love plots) is the reason for including it.")


#===============================================================================
# 20. Sensitivity Analysis: Time-Varying Exposure Cox Model
#-------------------------------------------------------------------------------
# The landmark design removes immortal time bias by DISCARDING everyone who
# died before the landmark. That is safe but wasteful, and it changes the
# estimand to conditional survival.
#
# The time-varying (Mantel-Byar) approach removes the same bias without
# discarding anyone. Every patient begins follow-up at transplant in the
# untreated state and CONTRIBUTES PERSON-TIME TO THE UNTREATED ARM until the
# day they are first treated, at which point they switch arms. A patient who
# died on day 40 having never been treated therefore contributes 40 days of
# untreated person-time and one untreated death, rather than being misfiled
# as a Control who survived a full year.
#
# Data is in counting-process (start, stop] format, so each patient may
# occupy more than one row. No cluster/robust variance is needed: the
# segments from a single patient are non-overlapping in time and the partial
# likelihood handles them correctly.
#===============================================================================
arm_all_time <- assign_arm_at_landmark(Inf)   # exposure over all available follow-up

tv_base <- df_survival %>%
  filter(!is.na(PTIME), PTIME > 0) %>%
  select(TRR_ID_CODE, PTIME, event) %>%
  left_join(pat_rej_first %>% select(TRR_ID_CODE, REJ_TX_DAY), by = "TRR_ID_CODE") %>%
  left_join(arm_all_time, by = "TRR_ID_CODE") %>%
  filter(!is.na(ARM))

# Segment 1: untreated person-time, from day 0 until first treatment (or
# until end of follow-up for patients never treated).
tv_seg_untreated <- tv_base %>%
  mutate(
    tstart = 0,
    tstop = case_when(
      is.na(REJ_TX_DAY)   ~ PTIME,        # never treated
      REJ_TX_DAY <= 0     ~ NA_real_,     # treated at baseline: no untreated time
      REJ_TX_DAY >= PTIME ~ PTIME,        # treatment recorded at/after last follow-up
      TRUE                ~ REJ_TX_DAY
    ),
    ev = case_when(
      is.na(REJ_TX_DAY)   ~ as.numeric(event),
      REJ_TX_DAY <= 0     ~ NA_real_,
      REJ_TX_DAY >= PTIME ~ as.numeric(event),
      TRUE                ~ 0             # censored at the moment of switching
    ),
    RX_STATE = "None"
  ) %>%
  filter(!is.na(tstop), tstop > tstart)

# Segment 2: treated person-time, from first treatment to end of follow-up.
tv_seg_treated <- tv_base %>%
  filter(!is.na(REJ_TX_DAY), REJ_TX_DAY < PTIME) %>%
  mutate(
    tstart = pmax(REJ_TX_DAY, 0),
    tstop  = PTIME,
    ev     = as.numeric(event),
    RX_STATE = as.character(ARM)
  ) %>%
  filter(tstop > tstart)

tv_data <- bind_rows(tv_seg_untreated, tv_seg_treated) %>%
  select(TRR_ID_CODE, tstart, tstop, ev, RX_STATE) %>%
  mutate(RX_STATE = factor(RX_STATE, levels = c("None", "Steroids", "Combined", "Dual Therapy", "Other Rejection"))) %>%
  arrange(TRR_ID_CODE, tstart)

stopifnot(all(tv_data$tstop > tv_data$tstart))
message("Time-varying dataset: ", nrow(tv_data), " rows for ",
        n_distinct(tv_data$TRR_ID_CODE), " patients; ", sum(tv_data$ev), " deaths")
table(tv_data$RX_STATE, tv_data$ev)

# Administrative censoring at a chosen horizon, measured from TRANSPLANT.
truncate_tv <- function(tv, horizon) {
  tv %>%
    filter(tstart < horizon) %>%
    mutate(ev = if_else(tstop > horizon, 0, ev), tstop = pmin(tstop, horizon)) %>%
    filter(tstop > tstart)
}

tv_2yr <- truncate_tv(tv_data, 730.5)

fit_tv_2yr <- coxph(Surv(tstart, tstop, ev) ~ RX_STATE, data = tv_2yr)
summary(fit_tv_2yr)
cox.zph(fit_tv_2yr)

tv_hr_table <- summary(fit_tv_2yr)$conf.int %>%
  as.data.frame() %>%
  tibble::rownames_to_column("term") %>%
  transmute(
    Comparison = paste0(str_remove(term, "^RX_STATE"), " vs untreated person-time"),
    `HR (95% CI)` = sprintf("%.2f (%.2f\u2013%.2f)", `exp(coef)`, `lower .95`, `upper .95`),
    `P value` = {
      p <- summary(fit_tv_2yr)$coefficients[, "Pr(>|z|)"]
      if_else(p < 0.001, "<0.001", sprintf("%.3f", p))
    }
  )

tv_hr_table %>%
  gt() %>%
  tab_header(
    title = "Time-Varying Exposure Cox Model, 2-Year Mortality",
    subtitle = "Sensitivity analysis -- no patients excluded"
  ) %>%
  tab_options(table.font.size = 13, data_row.padding = px(4), column_labels.font.weight = "bold") %>%
  tab_source_note("Anti-rejection therapy modelled as a time-dependent covariate: every patient contributes untreated person-time from transplant until their first anti-rejection treatment, then treated person-time thereafter. Unlike the landmark analysis this discards no patients, and unlike a naive transplant-anchored analysis it assigns no immortal time to the treated arms. Follow-up administratively censored at 2 years post-transplant. Treatment timing for therapy given during the index admission is approximated (see INPATIENT_RX_DAY).")

# --- Optional: quantify the bias by reproducing the naive analysis ---
# Set to TRUE to fit the ORIGINAL, BIASED model alongside the corrected ones.
# The point is not to report it but to show how far the estimate moves once
# the immortal time is removed -- useful for a supplement or reviewer
# response. Do not use this HR for anything else.
SHOW_NAIVE_COMPARISON <- FALSE

if (SHOW_NAIVE_COMPARISON) {
  df_naive <- df_survival %>%
    inner_join(arm_all_time, by = "TRR_ID_CODE") %>%
    filter(!is.na(PTIME)) %>%
    mutate(
      event_2yr = if_else(PTIME <= 730.5, event, 0),
      time_2yr  = pmin(PTIME, 730.5),
      ARM = relevel(factor(ARM), ref = "Control")
    ) %>%
    filter(ARM %in% c("Control", "Steroids", "Combined")) %>%
    mutate(ARM = droplevels(ARM))
  
  fit_naive <- coxph(Surv(time_2yr, event_2yr) ~ ARM, data = df_naive)
  
  message("\n--- BIASED (transplant-anchored) vs CORRECTED (landmark) ---")
  message("Biased HRs (immortal time present, DO NOT REPORT):")
  print(round(summary(fit_naive)$conf.int[, c(1, 3, 4)], 3))
  message("Landmark HRs (corrected):")
  print(round(summary(fit_lm_3arm)$conf.int[, c(1, 3, 4)], 3))
  message("Time-varying HRs (corrected, no exclusions):")
  print(round(summary(fit_tv_2yr)$conf.int[, c(1, 3, 4)], 3))
}


#===============================================================================
# 21. Year-2 Anti-Rejection Treatment, Stratified by First-Year Treatment Group
#-------------------------------------------------------------------------------
# ctrl_id_vect is the cleaned control cohort (see section 5), so the Control
# arm here does not contain patients who were treated for rejection later in
# year 1.
#===============================================================================

# --- Step 1: landmark cohort -- patients known to still be followed at day 365 ---
landmark_ids_yr1 <- df_liver_data_filtered %>%
  filter(PTIME >= 365.25) %>%
  pull(TRR_ID_CODE)

# --- Step 2: year-2-only follow-up window (not cumulative from transplant) ---
df_immuno_fol_yr2 <- df_immuno_fol_read %>%
  filter(TRR_ID_CODE %in% tx_ids_to_keep) %>%
  filter(TRR_ID_CODE %in% landmark_ids_yr1) %>%   # restrict to patients at risk through yr2
  left_join(df_liver_data_filtered %>% select(TRR_ID_CODE, TX_DATE, DISCHARGE_DATE), by = "TRR_ID_CODE") %>%
  filter(!is.na(TX_DATE)) %>%
  mutate(
    PX_STAT_DATE_FOL = as.Date(PX_STAT_DATE_FOL),
    TX_DATE = as.Date(TX_DATE)
  ) %>%
  mutate(FOL_DATE_DAYS_DELTA = time_length(interval(TX_DATE, PX_STAT_DATE_FOL), "days")) %>%
  filter(FOL_DATE_DAYS_DELTA > 365.25 & FOL_DATE_DAYS_DELTA <= 730.5) %>%   # year 2 only
  arrange(PX_STAT_DATE_FOL) %>%
  mutate(NUM_ANTI_REJ_RXED_ROW = rowSums(across(all_of(COLS_TO_CHECK)) == 1, na.rm = TRUE))

# --- Step 3: per-patient summary of year-2 anti-rejection treatment ---
df_yr2_patient_summary <- df_immuno_fol_yr2 %>%
  group_by(TRR_ID_CODE) %>%
  summarise(
    across(all_of(COLS_TO_CHECK), ~ as.integer(any(.x == 1, na.rm = TRUE))),
    NUM_FOLLOWUPS_YR2 = n(),
    .groups = "drop"
  ) %>%
  mutate(
    NUM_DRUGS_YR2    = rowSums(across(all_of(COLS_TO_CHECK))),
    ANY_ANTI_REJ_YR2 = as.integer(NUM_DRUGS_YR2 >= 1)
  )

# --- Step 4: attach first-year group label to the full landmark cohort ---
all_ids_by_group <- bind_rows(
  tibble(TRR_ID_CODE = arm2_ID_vect,        FIRST_YEAR_GROUP = "Combined"),
  tibble(TRR_ID_CODE = steroid_id_all_vect, FIRST_YEAR_GROUP = "Steroid"),
  tibble(TRR_ID_CODE = ctrl_id_vect,        FIRST_YEAR_GROUP = "Control")
) %>%
  distinct(TRR_ID_CODE, .keep_all = TRUE) %>%     # guard against an ID landing in two arms
  filter(TRR_ID_CODE %in% landmark_ids_yr1) %>%
  mutate(FIRST_YEAR_GROUP = factor(FIRST_YEAR_GROUP, levels = c("Steroid", "Combined", "Control")))

df_yr2_by_group <- all_ids_by_group %>%
  left_join(df_yr2_patient_summary, by = "TRR_ID_CODE") %>%
  mutate(
    HAS_YR2_FOLLOWUP = !is.na(NUM_FOLLOWUPS_YR2),
    ANY_ANTI_REJ_YR2 = coalesce(ANY_ANTI_REJ_YR2, 0L),
    across(all_of(COLS_TO_CHECK), ~ coalesce(.x, 0L))
  )
# NOTE: patients with HAS_YR2_FOLLOWUP == FALSE have no recorded follow-up
# visit in the year-2 window at all -- they're coded ANY_ANTI_REJ_YR2 = 0,
# which assumes "no visit" means "no rejection," not "unknown."

# --- Step 5: group-level summary ---
year2_group_summary <- df_yr2_by_group %>%
  group_by(FIRST_YEAR_GROUP) %>%
  summarise(
    N                   = n(),
    N_with_yr2_followup = sum(HAS_YR2_FOLLOWUP),
    N_rejected_yr2      = sum(ANY_ANTI_REJ_YR2),
    Pct_rejected_yr2    = 100 * N_rejected_yr2 / N,
    .groups = "drop"
  )

year2_group_summary %>%
  gt() %>%
  fmt_number(columns = Pct_rejected_yr2, decimals = 1) %>%
  cols_label(
    FIRST_YEAR_GROUP    = "First-Year Group",
    N                   = "N (landmark cohort)",
    N_with_yr2_followup = "N with Yr2 Follow-up",
    N_rejected_yr2      = "N Treated for Rejection in Yr2",
    Pct_rejected_yr2    = "% Treated in Yr2"
  ) %>%
  tab_header(title = "Anti-Rejection Treatment During Year 2, by First-Year Treatment Group") %>%
  tab_options(table.font.size = 13, data_row.padding = px(4), column_labels.font.weight = "bold") %>%
  tab_source_note("Landmark cohort restricted to patients with PTIME >= 365.25 days (still followed at 1 year). Year 2 defined as day 365.25-730.5 post-transplant.")

tab_yr2 <- table(df_yr2_by_group$FIRST_YEAR_GROUP, df_yr2_by_group$ANY_ANTI_REJ_YR2)
tab_yr2
safe_chisq_or_fisher(tab_yr2)

# --- Step 6: which drugs were used in year 2, by first-year group ---
drug_freq_by_group_yr2 <- df_yr2_by_group %>%
  select(FIRST_YEAR_GROUP, all_of(COLS_TO_CHECK)) %>%
  group_by(FIRST_YEAR_GROUP) %>%
  summarise(N = n(), across(all_of(COLS_TO_CHECK), sum), .groups = "drop") %>%
  pivot_longer(-c(FIRST_YEAR_GROUP, N), names_to = "Drug", values_to = "Frequency") %>%
  mutate(Drug = str_remove(Drug, COL_TAIL), Freq_Per_Patient = Frequency / N) %>%
  arrange(FIRST_YEAR_GROUP, desc(Freq_Per_Patient))

drug_freq_by_group_yr2 %>%
  filter(Frequency > 0) %>%
  select(FIRST_YEAR_GROUP, Drug, N, Frequency, Freq_Per_Patient) %>%
  arrange(FIRST_YEAR_GROUP, desc(Freq_Per_Patient)) %>%
  kable(
    caption = "Year-2 Anti-Rejection Drug Use per Patient, by First-Year Treatment Group",
    col.names = c("First-Year Group", "Drug", "Group N", "Patients Treated", "Rate per Patient"),
    digits = 3
  ) %>%
  kable_styling(bootstrap_options = c("striped", "hover", "condensed"))

# NOTE: coord_cartesian(ylim = c(0, 0.03)) zooms without dropping data (unlike
# scale_y_continuous(limits = ...), which would silently discard any bar
# above 3%).
drug_freq_by_group_yr2 %>%
  filter(Frequency > 0) %>%
  ggplot(aes(x = reorder(Drug, -Freq_Per_Patient), y = Freq_Per_Patient, fill = FIRST_YEAR_GROUP)) +
  geom_col(position = "dodge") +
  scale_y_continuous(labels = scales::percent_format(accuracy = 1)) +
  coord_cartesian(ylim = c(0, 0.03)) +
  labs(
    title = "Year-2 Anti-Rejection Drug Use per Patient, by First-Year Treatment Group",
    x = "Drug", y = "Fraction of Group Treated in Year 2", fill = "First-Year Group"
  ) +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1))

# --- Step 7: patient-level detail table ---
df_yr2_by_group %>%
  select(TRR_ID_CODE, FIRST_YEAR_GROUP, HAS_YR2_FOLLOWUP, ANY_ANTI_REJ_YR2, NUM_DRUGS_YR2, all_of(COLS_TO_CHECK)) %>%
  arrange(FIRST_YEAR_GROUP, desc(ANY_ANTI_REJ_YR2)) %>%
  head(20)


