#===============================================================================
# UNOS Liver Transplant Anti-Rejection Therapy Analysis
#
# Parses UNOS liver transplant patients into rejection-therapy groups
# (no rejection / steroid monotherapy / combined therapy / dual therapy) over
# the first year post-transplant, builds baseline demographic tables,
# propensity-score-matches treatment arms, and runs landmark + time-varying
# survival and year-2 outcome analyses.
#

# TO DO:
# 1.) histogram of when patients are treated for antirejection therayp s/p tx
# 2.) Landmark moved to 6 months, then analyze outcomes after 1 year
# 3.) "Survival curve" based on graft failure
# 4.) adjust at risk charts in kaplan meier so that the number at risk day 0 is 
# not cut off by axis


# CLEANED VERSION -- reorganized into labeled sections and de-duplicated.
# No analysis logic was changed from the reviewed/patched version; changes
# here are purely structural:
#   - package loading collapsed into one loop
#   - the old hand-built gt() Table 1-5 blocks (which computed their own
#     summary stats and p-values from scratch) were removed, since the
#     gtsummary-based Table 1-5 block later in the script was already written
#     to reproduce the same five comparisons from the same cohort data frames
#     and was explicitly intended to replace them
#   - the now-dead helper functions that only fed those old tables
#     (calc_demo_stats, calc_demo_std, build_mean_vector, build_std_vector,
#     calc_pvalues, fmt_count, is_median_row, and the demo_label1/ref_value1/
#     header_rows label vectors) were removed along with them
#   - the gtsummary Table 1-5 block was moved up to where the old tables used
#     to live, right after the propensity-matched cohorts it depends on exist
#   - the donor-ID duplicate check was moved next to the deceased-donor
#     processing step it is diagnosing
#   - inline "[FIX n]" review-point tags were converted to plain explanatory
#     comments describing *why* the code does what it does, since the
#     numbering was only meaningful in the context of the original review
#===============================================================================


#===============================================================================
# 0. Libraries
#===============================================================================
required_pkgs <- c(
  "ggplot2", "haven", "tidyr", "dplyr", "knitr", "kableExtra", "stringr",
  "lubridate", "gt", "tibble", "survminer", "survival", "scales",
  "MatchIt", "cobalt", "gtsummary"
)

invisible(lapply(required_pkgs, function(pkg) {
  if (!requireNamespace(pkg, quietly = TRUE)) install.packages(pkg)
  library(pkg, character.only = TRUE)
}))


#===============================================================================
# 1. Reading data
#===============================================================================
# Mac paths (active)
df_immuno_fol_read <- read.csv("~/Local Documents/AOT/Analysis/FilteredData/liver_immuno_followup.csv", stringsAsFactors = FALSE, na.strings = c("", " ", "NA", "."))
df_liver_data       <- read.csv("~/Local Documents/AOT/Analysis/FilteredData/liver_data.csv", stringsAsFactors = FALSE, na.strings = c("", " ", "NA", "."))
df_immuno_induc      <- read.csv("~/Local Documents/AOT/Analysis/FilteredData/liver-immuno-discharge_unfilter.csv", stringsAsFactors = FALSE, na.strings = c("", " ", "NA", "."))
df_hla               <- read.csv("~/Local Documents/AOT/Analysis/FilteredData/liver_addtl_hla.csv", stringsAsFactors = FALSE, na.strings = c("", " ", "NA", "."))
df_pra               <- read.csv("~/Local Documents/AOT/Analysis/FilteredData/liver_pra_crossmatch_data.csv", stringsAsFactors = FALSE, na.strings = c("", " ", "NA", "."))
df_deceased_don      <- read.csv("~/Local Documents/AOT/Analysis/FilteredData/deceased_donor_data.csv", stringsAsFactors = FALSE, na.strings = c("", " ", "NA", "."))
df_liver_fol         <- read.csv("~/Local Documents/AOT/Analysis/FilteredData/liver_followup_data.csv", stringsAsFactors = FALSE, na.strings = c("", " ", "NA", "."))
# TODO: living donor data still needs to be loaded

# Windows paths (kept for reference; swap the block above for this one on Windows)
# df_immuno_fol_read <- read.csv("C:/Users/lukas/Documents/Med School/AOT/R/Output/Filtered Data by Date/liver-immuno-follow-up_date-filtered.csv", stringsAsFactors = FALSE)
# df_liver_data       <- read.csv("C:/Users/lukas/Documents/Med School/AOT/R/Output/Filtered Data by Date/liver-data_date-filtered.csv", stringsAsFactors = FALSE)
# df_immuno_induc      <- read.csv("C:/Users/lukas/Documents/Med School/AOT/R/Output/Filtered Data by Date/liver-immuno-discharge_unfilter.csv")


#===============================================================================
# 2. Drug column definitions and numeric coercion
#===============================================================================
# Defined up front so the 0/1 indicator columns can be coerced to numeric
# immediately after reading. If any of these columns come in as character (a
# stray "Y"/"N", a quoted "1", a blank-padded field), `rowSums(across(...) ==
# 1)` silently evaluates to 0 for that whole column and the drug looks like it
# was never prescribed. Coercing once, at the source, avoids that failure mode
# everywhere downstream.
#
# GENERICMMF, GENERICTACROLIMUS, ASTAGRAFXL, NULOJIX are maintenance-only drugs
# and are intentionally excluded from this list.
RX_COLS <- c(
  "ALG", "CYCLOSPORIN", "OKT4", "CYTOXAN", "METHOTREXATE", "BREQUINARSODIUM",
  "MIZORIBINE", "ATGAM", "NRATGNRATS", "OKT3", "XOMAZYMECD5", "DAB486IL2",
  "ANTILFA1", "ANTIICAM1", "IL1RECEPTORANTAGONIST", "ANTIIL6", "ANTITNF",
  "SOLUBLEIL1RECEPTOR", "ALDESLEUKIN", "T10B9", "SANDIMMUNE",
  "DEOXYSPERGUALIN", "NEORAL", "SANGCYA", "THYMOGLOBULIN", "ZENAPAX",
  "SIMULECT", "GENGRAF", "ZORTRESS", "EON", "MYFORTIC", "GENERICCYCLOSPORIN",
  "STEROIDS", "PROGRAF", "CAMPATH", "FTY720", "RITUXAN", "GENERICMYFORTIC",
  "GENERICSIROLIMUS", "ENVARSUSXR", "RAPAMUNE", "LEFLUNOMIDE", "IMURAN",
  "CELLCEPT"
) # does not capture the "other drug" column

COL_TAIL <- "_ANTIREJ" # change based on whether this is induction, maintenance, or anti-rejection

COLS_TO_CHECK <- paste0(RX_COLS, COL_TAIL)

# any_of() so a missing column is skipped rather than erroring
coerce_rx_numeric <- function(df) {
  df %>% mutate(across(any_of(COLS_TO_CHECK), ~ suppressWarnings(as.numeric(.x))))
}

df_immuno_fol_read <- coerce_rx_numeric(df_immuno_fol_read)
df_immuno_induc    <- coerce_rx_numeric(df_immuno_induc)

# Report any drug column that is entirely NA after coercion -- a fast way to
# catch a source-encoding change (e.g. a column switching from 0/1 to Y/N).
rx_all_na <- names(which(sapply(
  intersect(COLS_TO_CHECK, names(df_immuno_fol_read)),
  function(cn) all(is.na(df_immuno_fol_read[[cn]]))
)))
if (length(rx_all_na)) {
  message("Drug columns entirely NA after numeric coercion (check source encoding): ",
          paste(rx_all_na, collapse = ", "))
}

# Numeric coercion for the continuous recipient variables used in medians,
# matching, and Cox/logistic models.
df_liver_data <- df_liver_data %>%
  mutate(across(any_of(c("AGE", "MELD_PELD_LAB_SCORE", "COLD_ISCH", "PTIME",
                         "BMI_CALC", "BMI_TCR", "HGT_CM_CALC", "WGT_KG_CALC")),
                ~ suppressWarnings(as.numeric(.x))))


#===============================================================================
# 3. Cohort filters
#===============================================================================
# --- Filter 1: recipient age ---
col_age_range <- "AGE"
age_min <- 18
age_max <- 80

df_liver_data$AGE <- as.numeric(df_liver_data$AGE)

df_liver_data_filtered <- df_liver_data %>%
  filter(.data[[col_age_range]] >= age_min & .data[[col_age_range]] <= age_max)

# --- Filter 2: transplant date window (03APR2015 - 03APR2025) ---
FILTER_DATE_COL_FOL <- "PX_STAT_DATE_FOL" # follow-up date column
FILTER_DATE_COL_TX  <- "TX_DATE"

tx_start_date <- "2015-04-03"
tx_end_date   <- "2025-04-03"

df_liver_data_filtered <- df_liver_data_filtered %>%
  filter(.data[[FILTER_DATE_COL_TX]] >= tx_start_date & .data[[FILTER_DATE_COL_TX]] <= tx_end_date)

# Prefer BMI at transplant, fall back to the listing value, then derive from
# height/weight. Kept as base assignment rather than mutate() so the "which
# spelling exists" branch is explicit rather than buried in tidy-eval.
bmi_src <- intersect(c("BMI_CALC", "BMI_TCR"), names(df_liver_data_filtered))

df_liver_data_filtered$BMI_REC <- if (length(bmi_src)) {
  suppressWarnings(as.numeric(df_liver_data_filtered[[bmi_src[1]]]))
} else NA_real_

if (all(c("HGT_CM_CALC", "WGT_KG_CALC") %in% names(df_liver_data_filtered))) {
  h <- suppressWarnings(as.numeric(df_liver_data_filtered$HGT_CM_CALC))
  w <- suppressWarnings(as.numeric(df_liver_data_filtered$WGT_KG_CALC))
  df_liver_data_filtered$BMI_REC <- coalesce(df_liver_data_filtered$BMI_REC, w / (h / 100)^2)
}

# A recorded height of 0 yields Inf rather than NA, which would propagate
# silently into the mean. Range-gate the obviously impossible values.
df_liver_data_filtered$BMI_REC[
  !is.finite(df_liver_data_filtered$BMI_REC) |
    df_liver_data_filtered$BMI_REC < 10 |
    df_liver_data_filtered$BMI_REC > 80
] <- NA_real_

message("Recipient BMI source: ", if (length(bmi_src)) bmi_src[1] else "derived from height/weight only",
        " | missing: ", sum(is.na(df_liver_data_filtered$BMI_REC)),
        " of ", nrow(df_liver_data_filtered))

# --- Apply the resulting ID list to every other table ---
tx_ids_to_keep  <- df_liver_data_filtered$TRR_ID_CODE
dnr_ids_to_keep <- df_liver_data_filtered$DONOR_ID

df_immuno_induc   <- df_immuno_induc  %>% filter(TRR_ID_CODE %in% tx_ids_to_keep)
df_liver_fol_fil  <- df_liver_fol     %>% filter(TRR_ID_CODE %in% tx_ids_to_keep)
df_immuno_fol     <- df_immuno_fol_read %>% filter(TRR_ID_CODE %in% tx_ids_to_keep)
df_deceased_don_fil <- df_deceased_don %>% filter(DONOR_ID %in% dnr_ids_to_keep)
df_hla_fil        <- df_hla           %>% filter(TRR_ID_CODE %in% tx_ids_to_keep)
df_pra_fil        <- df_pra           %>% filter(TRR_ID_CODE %in% tx_ids_to_keep)
# TODO: living donor data still needs to be loaded/filtered


#===============================================================================
# 4. Follow-up window and rejection-therapy running counts
#===============================================================================
# Merge in TX_DATE / rejection flags, then drop any follow-up row whose
# transplant fell outside the date-filtered cohort.
#
# Dropping any pre-existing TX_DATE/DISCHARGE_DATE/etc. from df_immuno_fol
# before the join (any_of() = no-op if they aren't present) avoids the same
# TX_DATE.x/TX_DATE.y column-name-collision problem fixed below for
# df_immuno_induc, in case the follow-up file ever carries its own copies.
df_immuno_fol <- df_immuno_fol %>%
  select(-any_of(c("TX_DATE", "DISCHARGE_DATE", "TRTREJ6M", "TRTREJ1Y"))) %>%
  left_join(df_liver_data_filtered %>%
              select(TRR_ID_CODE, TX_DATE, DISCHARGE_DATE, TRTREJ6M, TRTREJ1Y),
            by = "TRR_ID_CODE") %>%
  filter(!is.na(TX_DATE))

# Keep only follow-ups within the first post-transplant year.
df_immuno_fol <- df_immuno_fol %>%
  mutate(
    PX_STAT_DATE_FOL = as.Date(PX_STAT_DATE_FOL),
    TX_DATE = as.Date(TX_DATE)
  ) %>%
  mutate(FOL_DATE_DAYS_DELTA = time_length(interval(TX_DATE, PX_STAT_DATE_FOL), "days")) %>%
  filter(FOL_DATE_DAYS_DELTA >= 0 & FOL_DATE_DAYS_DELTA < 365.24219) %>%
  arrange(PX_STAT_DATE_FOL)

# Running count of rejection-therapy follow-up events per patient, plus a flag
# for whether combo (2+ drug) therapy was ever used.
df_immuno_fol <- df_immuno_fol %>%
  mutate(REJECT_RUNNING_COUNT = 0L) %>%
  group_by(TRR_ID_CODE) %>%
  mutate(REJECT_RUNNING_COUNT = cumsum(if_any(all_of(COLS_TO_CHECK), ~ !is.na(.) & . == 1))) %>%
  ungroup() %>%
  mutate(NUM_ANTI_REJ_RXED = 0L) |>
  mutate(NUM_ANTI_REJ_RXED = rowSums(across(all_of(COLS_TO_CHECK)) == 1, na.rm = TRUE))

# Cache so downstream sections don't have to recompute this.
df_immuno_fol_calc <- df_immuno_fol

# Per-drug frequency of use, overall and within the 6-month / 1-year windows.
freq_drug_fol_antirej_indiv <- data.frame(
  drug_name   = str_remove(COLS_TO_CHECK, COL_TAIL),
  drug_count  = sapply(df_immuno_fol[COLS_TO_CHECK], function(x) sum(x == 1, na.rm = TRUE)),
  rej6m_count = sapply(COLS_TO_CHECK, function(col) {
    sum(df_immuno_fol[[col]] == 1 & df_immuno_fol$FOL_DATE_DAYS_DELTA <= 182.62110, na.rm = TRUE)
  }),
  rej1y_count = sapply(COLS_TO_CHECK, function(col) {
    sum(df_immuno_fol[[col]] == 1 & df_immuno_fol$FOL_DATE_DAYS_DELTA <= 365.24219, na.rm = TRUE)
  })
)

# Inpatient (index-admission) anti-rejection therapy, plus length of stay.
#
# df_immuno_induc (read from the discharge/induction file) commonly already
# carries its own TX_DATE / DISCHARGE_DATE / DEATH_DATE columns natively.
# Left-joining df_liver_data_filtered's copies on top of those WITHOUT
# dropping the originals first doesn't error -- dplyr just silently renames
# the colliding, non-key columns to "TX_DATE.x"/"TX_DATE.y" etc. -- so there
# is then no plain "TX_DATE" column left for arrange()/mutate() to find.
# Dropping any pre-existing copies first (any_of() so this is a no-op if
# they aren't present) guarantees the join produces one clean, unsuffixed
# copy of each from the master file.
df_immuno_induc <- df_immuno_induc |>
  semi_join(df_liver_data_filtered, by = "TRR_ID_CODE") |>
  mutate(NUM_ANTI_REJ_RXED = 0L) |>
  mutate(NUM_ANTI_REJ_RXED = rowSums(across(all_of(COLS_TO_CHECK)) == 1, na.rm = TRUE)) |>
  select(-any_of(c("TX_DATE", "DISCHARGE_DATE", "DEATH_DATE"))) |>
  left_join(df_liver_data_filtered %>%
              select(TRR_ID_CODE, TX_DATE, DISCHARGE_DATE, DEATH_DATE), by = "TRR_ID_CODE") |>
  arrange(TX_DATE) |>
  mutate(DAYS_HOSP_SP_TX = 0L) |>
  mutate(
    DISCHARGE_DATE = as.Date(DISCHARGE_DATE),
    TX_DATE = as.Date(TX_DATE)
  ) %>%
  mutate(DAYS_HOSP_SP_TX = time_length(interval(TX_DATE, DISCHARGE_DATE), "days"))


#===============================================================================
# 5. Defining the rejection vs. no-rejection cohorts (year 1)
#===============================================================================
# Patients treated for rejection during the index admission.
# distinct() guards against a duplicated discharge record silently dropping a
# patient later on (see the n() > 1 fix in the demographic table step below).
pat_rej_array_dis <- df_immuno_induc %>%
  filter(NUM_ANTI_REJ_RXED >= 1) %>%
  mutate(DISCHARGE_DATE = as.Date(DISCHARGE_DATE)) %>%
  select(TRR_ID_CODE, TX_DATE, DISCHARGE_DATE, NUM_ANTI_REJ_RXED, all_of(COLS_TO_CHECK)) %>%
  distinct(TRR_ID_CODE, .keep_all = TRUE)

inpatient_reject_ID_vect <- pat_rej_array_dis |> pull(TRR_ID_CODE)

# First instance of rejection therapy recorded at a follow-up visit within
# year 1 (patients already flagged as inpatient rejectors get their running
# count bumped by one so they aren't double-counted as a "first" event here).
pat_rej_array_fol <- df_immuno_fol_calc %>%
  mutate(
    REJECT_RUNNING_COUNT = if_else(
      TRR_ID_CODE %in% inpatient_reject_ID_vect,
      REJECT_RUNNING_COUNT + 1,
      REJECT_RUNNING_COUNT
    )
  ) |>
  filter(REJECT_RUNNING_COUNT == 1, NUM_ANTI_REJ_RXED >= 1) %>%
  group_by(TRR_ID_CODE) %>%
  slice_min(order_by = PX_STAT_DATE_FOL, n = 1, with_ties = FALSE) %>%
  ungroup() %>%
  select(
    TRR_ID_CODE, TRR_FOL_ID_CODE, TX_DATE, DISCHARGE_DATE, PX_STAT_DATE_FOL,
    FOL_DATE_DAYS_DELTA, REJECT_RUNNING_COUNT, NUM_ANTI_REJ_RXED,
    all_of(COLS_TO_CHECK)
  ) %>%
  mutate(DISCHARGE_DATE = as.Date(DISCHARGE_DATE))

# Combine inpatient + follow-up rejection events into one array.
# source is coerced to integer so slice_min(source) elsewhere orders it
# numerically (1 = discharge event, 2 = follow-up event).
pat_rej_array <- bind_rows(pat_rej_array_dis, pat_rej_array_fol, .id = "source") %>%
  mutate(source = as.integer(source))

# Rejector IDs, defined once from the combined array, and used to define the
# control cohort BY EXCLUSION. A row-wise REJECT_RUNNING_COUNT == 0 filter
# alone would retain rows from patients who were rejection-free early but
# treated later in year 1, contaminating the control ID list that the year-2
# landmark analyses depend on.
rejector_ids <- unique(pat_rej_array$TRR_ID_CODE)

# Patients with no rejection at any year-1 follow-up.
pat_ctrl_array <- df_immuno_fol_calc %>%
  filter(!TRR_ID_CODE %in% rejector_ids) %>%
  filter(REJECT_RUNNING_COUNT == 0) %>%   # redundant given the exclusion above; kept as belt-and-braces
  select(
    TRR_ID_CODE, TRR_FOL_ID_CODE, TX_DATE, DISCHARGE_DATE, PX_STAT_DATE_FOL,
    FOL_DATE_DAYS_DELTA, REJECT_RUNNING_COUNT, NUM_ANTI_REJ_RXED, all_of(COLS_TO_CHECK)
  ) %>%
  mutate(FOLLOW_UP_NUM = 1L) |>
  group_by(TRR_ID_CODE) %>%
  slice_max(order_by = PX_STAT_DATE_FOL, n = 1, with_ties = FALSE) %>%
  ungroup()

# NOTE (flagged for awareness, behaviour unchanged): patients with NO
# follow-up rows at all never enter df_immuno_fol and are therefore neither
# cases nor controls. If that group is large, "no rejection" is partly
# "no data".
message("Patients in cohort with no year-1 follow-up rows: ",
        length(setdiff(tx_ids_to_keep,
                       union(rejector_ids, pat_ctrl_array$TRR_ID_CODE))))


#===============================================================================
# 6. Treatment-arm ID vectors
#===============================================================================
monotherapy_reject <- pat_rej_array |> filter(NUM_ANTI_REJ_RXED < 2)

rituxan_id_all_vect <- monotherapy_reject %>%
  filter(RITUXAN_ANTIREJ == 1) %>% pull(TRR_ID_CODE)

steroid_id_all_vect <- monotherapy_reject %>%
  filter(STEROIDS_ANTIREJ == 1) %>% pull(TRR_ID_CODE)

thymo_id_all_vect <- monotherapy_reject %>%
  filter(THYMOGLOBULIN_ANTIREJ == 1) %>% pull(TRR_ID_CODE)

simulect_id_all_vect <- monotherapy_reject %>%
  filter(SIMULECT_ANTIREJ == 1) %>% pull(TRR_ID_CODE)

# Steroid + combo (Simulect/Thymo/Rituxan) dual therapy.
dual_therapy_id_vect <- pat_rej_array %>%
  filter(STEROIDS_ANTIREJ == 1) %>%
  filter(SIMULECT_ANTIREJ == 1 | THYMOGLOBULIN_ANTIREJ == 1 | RITUXAN_ANTIREJ == 1) |>
  pull(TRR_ID_CODE)

# Any use of Rituxan, monotherapy or not.
rituxan_any_id_vect <- pat_rej_array %>%
  filter(RITUXAN_ANTIREJ == 1) %>% pull(TRR_ID_CODE)

# Combined-arm = Simulect OR Thymoglobulin OR Rituxan monotherapy.
arm2_ID_vect <- unique(c(simulect_id_all_vect, thymo_id_all_vect, rituxan_id_all_vect))

# Never treated for rejection, drawn from the cleaned control array.
ctrl_id_vect <- pat_ctrl_array %>% pull(TRR_ID_CODE)

# Sanity checks -- both should be empty.
stopifnot(length(intersect(arm2_ID_vect, ctrl_id_vect)) == 0)
stopifnot(length(intersect(steroid_id_all_vect, ctrl_id_vect)) == 0)


#===============================================================================
# 7. HLA mismatch calculation (A, B, DR loci; 0-6 scale)
#===============================================================================
# Use retyped donor HLA if available, else original typing.
df_hla_fil <- df_hla_fil %>%
  mutate(
    DA1_final  = coalesce(RT_DA1, DA1),
    DA2_final  = coalesce(RT_DA2, DA2),
    DB1_final  = coalesce(RT_DB1, DB1),
    DB2_final  = coalesce(RT_DB2, DB2),
    DDR1_final = coalesce(RT_DDR1, DDR1),
    DDR2_final = coalesce(RT_DDR2, DDR2)
  )

locus_mismatch <- function(r1, r2, d1, d2) {
  if (any(is.na(c(r1, r2, d1, d2)))) return(NA_integer_)
  rec_alleles <- c(r1, r2)
  don_alleles <- c(d1, d2)
  sum(!don_alleles %in% rec_alleles)
}

df_hla_calc <- df_hla_fil %>%
  rowwise() %>%
  mutate(
    MM_A  = locus_mismatch(RA1, RA2, DA1_final, DA2_final),
    MM_B  = locus_mismatch(RB1, RB2, DB1_final, DB2_final),
    MM_DR = locus_mismatch(RDR1, RDR2, DDR1_final, DDR2_final),
    MM_TOTAL = if_else(any(is.na(c(MM_A, MM_B, MM_DR))), NA_integer_, MM_A + MM_B + MM_DR)
  ) %>%
  ungroup() %>%
  select(TRR_ID_CODE, MM_A, MM_B, MM_DR, MM_TOTAL) |>
  distinct(TRR_ID_CODE, .keep_all = TRUE)


#===============================================================================
# 8. PRA data
#===============================================================================
