#===============================================================================
# 22. Statistical Analysis: Year-2 Anti-Rejection Treatment by First-Year Group
#===============================================================================
covariates_yr2 <- df_liver_data_filtered %>%
  select(TRR_ID_CODE, AGE, GENDER, MELD_PELD_LAB_SCORE, COLD_ISCH, DIAB) %>%
  mutate(
    DIAB_BIN = case_when(
      as.numeric(DIAB) %in% 2:5 ~ 1,
      as.numeric(DIAB) == 1     ~ 0,
      TRUE                      ~ NA_real_
    ),
    GENDER = factor(GENDER)
  ) %>%
  distinct(TRR_ID_CODE, .keep_all = TRUE) %>%
  left_join(df_hla_calc %>% select(TRR_ID_CODE, MM_TOTAL), by = "TRR_ID_CODE")

df_yr2_model <- df_yr2_by_group %>%
  left_join(covariates_yr2, by = "TRR_ID_CODE") %>%
  mutate(FIRST_YEAR_GROUP = relevel(FIRST_YEAR_GROUP, ref = "Control"))

stopifnot(nrow(df_yr2_model) == nrow(df_yr2_by_group))

# Adjustment covariate set for the year-2 logistic models, defined ONCE so the
# rejection and graft-failure models cannot drift apart.
#
# HLA mismatch (MM_TOTAL) is deliberately excluded, for the same reason it was
# removed from the propensity matching in section 13: it is missing for ~60% of
# the cohort, and glm() is complete-case. Including it silently fitted every
# "Adjusted" model on roughly 40% of the landmark cohort while the neighbouring
# "Unadjusted" model used all of it -- so the two were never estimated on the
# same patients and the difference between them could not be attributed to the
# adjustment. The retained sample was also selected on HLA-typing availability,
# which varies systematically by centre.
yr2_adj_covs <- "AGE + GENDER + MELD_PELD_LAB_SCORE + COLD_ISCH + DIAB_BIN"

# N is carried through to the output tables because the remaining covariates
# (COLD_ISCH and DIAB in particular) still have some missingness, so adjusted
# and unadjusted models may STILL be fitted on slightly different samples.
# Reporting it makes any such gap visible instead of silent.
tidy_glm_or <- function(fit) {
  co <- summary(fit)$coefficients
  ci <- suppressMessages(confint.default(fit))  # Wald CIs
  
  tibble(
    term     = rownames(co),
    N        = stats::nobs(fit),
    OR       = exp(co[, "Estimate"]),
    CI_lower = exp(ci[, 1]),
    CI_upper = exp(ci[, 2]),
    p_value  = co[, "Pr(>|z|)"]
  ) %>%
    filter(term != "(Intercept)")
}

fit_unadj <- glm(ANY_ANTI_REJ_YR2 ~ FIRST_YEAR_GROUP, data = df_yr2_model, family = binomial)
summary(fit_unadj)

fit_null <- glm(ANY_ANTI_REJ_YR2 ~ 1, data = df_yr2_model, family = binomial)
anova(fit_null, fit_unadj, test = "LRT")

or_unadj <- tidy_glm_or(fit_unadj) %>% mutate(Model = "Unadjusted")

fit_adj <- glm(
  as.formula(paste("ANY_ANTI_REJ_YR2 ~ FIRST_YEAR_GROUP +", yr2_adj_covs)),
  data = df_yr2_model, family = binomial
)
summary(fit_adj)

or_adj <- tidy_glm_or(fit_adj) %>%
  filter(str_detect(term, "^FIRST_YEAR_GROUP")) %>%
  mutate(Model = "Adjusted")

df_yr2_model_steroid_ref <- df_yr2_model %>% mutate(FIRST_YEAR_GROUP = relevel(FIRST_YEAR_GROUP, ref = "Steroid"))

fit_unadj_steroid_ref <- glm(ANY_ANTI_REJ_YR2 ~ FIRST_YEAR_GROUP, data = df_yr2_model_steroid_ref, family = binomial)
fit_adj_steroid_ref <- glm(
  as.formula(paste("ANY_ANTI_REJ_YR2 ~ FIRST_YEAR_GROUP +", yr2_adj_covs)),
  data = df_yr2_model_steroid_ref, family = binomial
)

or_unadj_combined_vs_steroid <- tidy_glm_or(fit_unadj_steroid_ref) %>%
  filter(term == "FIRST_YEAR_GROUPCombined") %>%
  mutate(term = "FIRST_YEAR_GROUPCombined (ref = Steroid)", Model = "Unadjusted")

or_adj_combined_vs_steroid <- tidy_glm_or(fit_adj_steroid_ref) %>%
  filter(term == "FIRST_YEAR_GROUPCombined") %>%
  mutate(term = "FIRST_YEAR_GROUPCombined (ref = Steroid)", Model = "Adjusted")

or_results_yr2 <- bind_rows(or_unadj, or_adj, or_unadj_combined_vs_steroid, or_adj_combined_vs_steroid) %>%
  mutate(
    Comparison = case_when(
      term == "FIRST_YEAR_GROUPSteroid"                 ~ "Steroid vs Control",
      term == "FIRST_YEAR_GROUPCombined"                 ~ "Combined vs Control",
      term == "FIRST_YEAR_GROUPCombined (ref = Steroid)" ~ "Combined vs Steroid",
      TRUE ~ term
    )
  ) %>%
  select(Comparison, Model, N, OR, CI_lower, CI_upper, p_value)

or_results_yr2

or_table_yr2 <- or_results_yr2 %>%
  mutate(
    `OR (95% CI)` = sprintf("%.2f (%.2f\u2013%.2f)", OR, CI_lower, CI_upper),
    `P value` = case_when(p_value < 0.001 ~ "<0.001", TRUE ~ sprintf("%.3f", p_value))
  ) %>%
  select(Comparison, Model, N, `OR (95% CI)`, `P value`) %>%
  arrange(Comparison, Model)

or_table_yr2 %>%
  gt(groupname_col = "Comparison") %>%
  cols_label(Model = "Model", N = "N in model",
             `OR (95% CI)` = "Odds Ratio (95% CI)", `P value` = "P value") %>%
  tab_header(title = "Odds of Anti-Rejection Treatment in Year 2, by First-Year Treatment Group") %>%
  tab_options(table.font.size = 13, data_row.padding = px(4),
              column_labels.font.weight = "bold", row_group.font.weight = "bold") %>%
  tab_source_note("PRIMARY ANALYSIS (covariate-adjusted, full landmark cohort). OR > 1 indicates higher odds of being treated for rejection in year 2 relative to the comparison group. Adjusted model controls for recipient age, gender, MELD score, cold ischemic time, and diabetes status. HLA mismatch is NOT included: it is missing for roughly 60% of the cohort and, because model fitting is complete-case, including it would restrict the adjusted models to a minority of patients selected on HLA-typing availability. N is reported per model so any remaining difference in analysed sample between the unadjusted and adjusted rows is visible. Landmark cohort restricted to patients followed through 1 year (PTIME >= 365.25). See section 25 for a propensity-matched sensitivity analysis of the same comparisons.")

# --- Model diagnostics ---
summary(fit_adj)$coefficients
fit_adj$converged

fit_adj_no_group <- glm(
  as.formula(paste("ANY_ANTI_REJ_YR2 ~", yr2_adj_covs)),
  data = df_yr2_model, family = binomial
)
anova(fit_adj_no_group, fit_adj, test = "LRT")


#===============================================================================
# 23. Year-2 Graft Failure, Stratified by First-Year Treatment Group
#===============================================================================
df_graft_time <- df_liver_data_filtered %>%
  select(TRR_ID_CODE, TX_DATE, GRF_FAIL_DATE, PX_STAT_DATE) %>%
  mutate(
    TX_DATE       = as.Date(TX_DATE),
    GRF_FAIL_DATE = as.Date(GRF_FAIL_DATE),
    PX_STAT_DATE  = as.Date(PX_STAT_DATE),
    GRF_FAIL_EVENT = as.integer(!is.na(GRF_FAIL_DATE)),
    GRF_TIME_DAYS  = if_else(
      GRF_FAIL_EVENT == 1,
      as.numeric(GRF_FAIL_DATE - TX_DATE),
      as.numeric(PX_STAT_DATE  - TX_DATE)   # censored at last known status date
    )
  )

summary(df_graft_time$GRF_TIME_DAYS)
sum(is.na(df_graft_time$GRF_TIME_DAYS))
table(df_graft_time$GRF_FAIL_EVENT, useNA = "ifany")

landmark_ids_grf_yr1 <- df_graft_time %>% filter(GRF_TIME_DAYS >= 365.25) %>% pull(TRR_ID_CODE)

df_graft_yr2 <- df_graft_time %>%
  filter(TRR_ID_CODE %in% landmark_ids_grf_yr1) %>%
  mutate(ANY_GRF_FAIL_YR2 = if_else(GRF_FAIL_EVENT == 1 & GRF_TIME_DAYS <= 730.5, 1L, 0L))

all_ids_by_group_grf <- bind_rows(
  tibble(TRR_ID_CODE = arm2_ID_vect,        FIRST_YEAR_GROUP = "Combined"),
  tibble(TRR_ID_CODE = steroid_id_all_vect, FIRST_YEAR_GROUP = "Steroid"),
  tibble(TRR_ID_CODE = ctrl_id_vect,        FIRST_YEAR_GROUP = "Control")
) %>%
  distinct(TRR_ID_CODE, .keep_all = TRUE) %>%
  filter(TRR_ID_CODE %in% landmark_ids_grf_yr1) %>%
  mutate(FIRST_YEAR_GROUP = factor(FIRST_YEAR_GROUP, levels = c("Steroid", "Combined", "Control")))

df_graft_yr2_by_group <- all_ids_by_group_grf %>%
  left_join(df_graft_yr2 %>%
              select(TRR_ID_CODE, ANY_GRF_FAIL_YR2, GRF_TIME_DAYS) %>%
              distinct(TRR_ID_CODE, .keep_all = TRUE),
            by = "TRR_ID_CODE")

