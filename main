# ADD-ON: DECEASED DONOR CHARACTERISTIC TABLES BY REJECTION GROUP
#
# Produces "Table 2. Characteristics of Deceased Organ Donors"-style tables
# (Characteristic / Group A / Group B / ... / P value) for every rejection-group
# comparison already defined in the main script.
#
# THREE EDITS TO THE MAIN SCRIPT, in order:
#   [A] Section 9  -- widen the donor select() so the extra donor fields survive
#                     into df_deceased_don_fil2 (and therefore into every
#                     pat_*_demo_table, which already left_join() it).
#   [B] Section 15 -- generalize build_gts_table() to take vars/labels/prep_fn
#                     (3 new arguments, all defaulted; existing calls unchanged).
#   [C] Section 15b -- NEW, paste after Table 6. Builds the donor tables by
#                     reusing the tbl1_df ... tbl6_df frames already assembled.
#
# WHY THIS WORKS WITH NO OTHER CHANGES: pat_rej_demo_table and
# pat_ctrl_demo_table already carry `left_join(df_deceased_don_fil2)`, and
# tbl1_df ... tbl6_df are built by bind_rows() from those. Widening the donor
# select() in section 9 is enough to make donor columns available everywhere.
#===============================================================================


#===============================================================================
# [A] REPLACEMENT FOR SECTION 9 (Deceased donor data)
#===============================================================================
# UNOS donor variable names differ slightly between DONOR_DECEASED file
# vintages (e.g. HGT_CM_DON_CALC vs HGT_CM_DON, HEP_C_ANTI_DON vs
# HEP_C_ANTIBODY_DON). Rather than hard-coding one spelling and getting a
# cryptic "column doesn't exist" error -- or worse, an any_of() that silently
# drops the variable and leaves an empty table row -- resolve each concept
# against a list of candidate names and REPORT which ones were not found.
donor_var_candidates <- list(
  AGE_DON        = c("AGE_DON"),
  GENDER_DON     = c("GENDER_DON"),
  HGT_CM_DON     = c("HGT_CM_DON_CALC", "HGT_CM_DON"),
  WGT_KG_DON     = c("WGT_KG_DON_CALC", "WGT_KG_DON"),
  BMI_DON        = c("BMI_DON_CALC", "BMI_DON"),
  ETHCAT_DON     = c("ETHCAT_DON"),
  HIST_HTN_DON   = c("HIST_HYPERTENS_DON"),
  HIST_DM_DON    = c("HIST_DIABETES_DON"),
  COD_DON        = c("COD_CAD_DON"),
  CREAT_DON      = c("CREAT_DON"),
  SGOT_DON       = c("SGOT_DON"),
  SGPT_DON       = c("SGPT_DON"),
  TBILI_DON      = c("TBILI_DON"),
  HCV_DON        = c("HEP_C_ANTI_DON", "HEP_C_ANTIBODY_DON", "HCV_SEROSTATUS"),
  DCD_DON        = c("NON_HRT_DON"),
  LI_FIBROSIS    = c("LI_FIBROSIS"),
  LI_MACHINE_PERFUSION    = c("LI_MACHINE_PERFUSION"),
  LI_MACHINE_PERFUSION_TY = c("LI_MACHINE_PERFUSION_TY")
)

resolve_donor_cols <- function(df, candidates) {
  found <- vapply(candidates, function(cands) {
    hit <- intersect(cands, names(df))
    if (length(hit)) hit[1] else NA_character_
  }, character(1))
  
  missing <- names(found)[is.na(found)]
  if (length(missing)) {
    message("Donor fields NOT found in the deceased donor file (rows will be omitted): ",
            paste(missing, collapse = ", "))
  }
  found[!is.na(found)]   # named vector: canonical name -> actual column name
}

donor_cols_found <- resolve_donor_cols(df_deceased_don_fil, donor_var_candidates)

# HAS_DECEASED_DON is the flag used downstream to restrict the donor tables to
# recipients who actually have a deceased-donor record. Living-donor recipients
# (and anyone whose donor row didn't join) would otherwise appear as an all-NA
# column and quietly deflate every donor denominator.
df_deceased_don_fil2 <- df_deceased_don_fil %>%
  left_join(df_liver_data_filtered |> select(DONOR_ID, TRR_ID_CODE), by = "DONOR_ID") |>
  filter(!is.na(TRR_ID_CODE)) |>
  select(TRR_ID_CODE, all_of(unname(donor_cols_found))) |>
  rename(!!!setNames(unname(donor_cols_found), names(donor_cols_found))) |>
  mutate(HAS_DECEASED_DON = 1L) |>
  distinct(TRR_ID_CODE, .keep_all = TRUE)

# Diagnostic: confirms whether the source file itself carries duplicate donor
# IDs (the reason distinct() above is necessary rather than optional).
df_deceased_don_fil %>% count(DONOR_ID) %>% filter(n > 1)

message("Recipients with a deceased-donor record: ", nrow(df_deceased_don_fil2),
        " of ", length(tx_ids_to_keep), " in cohort")


#===============================================================================
# [B] REPLACEMENT FOR build_gts_table() IN SECTION 15
#-------------------------------------------------------------------------------
# Three additions, all defaulted so every existing Table 1-6 call behaves
# identically:
#   vars / labels  -- swap in a different row set (recipient vs donor)
#   prep_fn        -- swap in a different recode step
#   cont_test      -- "auto" picks t.test for 2 arms, one-way ANOVA for 3+.
#
# That last one matters for the EXISTING code too: Table 1 is a 3-arm
# comparison (Rejection / Rituxan / Control) but hard-codes
# all_continuous() ~ "t.test". A t-test cannot compare three groups, so
# gtsummary catches the error per-variable and renders a BLANK p-value for
# every continuous row of Table 1. With cont_test = "auto" those rows get a
# one-way ANOVA p-value instead. (Use "kruskal.test" if MELD / cold ischemic
# time / donor creatinine are skewed enough to make ANOVA inappropriate.)
#===============================================================================
build_gts_table <- function(df_combined, group_col, group_lbls = NULL, caption = NULL,
                            vars     = gts_vars,
                            labels   = gts_labels,
                            prep_fn  = prep_gts_df,
                            cont_test = c("auto", "t.test", "aov", "wilcox.test", "kruskal.test"),
                            missing_disp = "no") {
  
  cont_test <- match.arg(cont_test)
  
  d <- prep_fn(df_combined)
  d <- d %>% filter(!is.na(.data[[group_col]]))
  
  n_groups <- nlevels(droplevels(factor(d[[group_col]])))
  if (cont_test == "auto") cont_test <- if (n_groups > 2) "aov" else "t.test"
  
  cont_lbl <- switch(cont_test,
                     "t.test"       = "Welch two-sample t-test",
                     "aov"          = "One-way ANOVA",
                     "wilcox.test"  = "Wilcoxon rank-sum test",
                     "kruskal.test" = "Kruskal-Wallis test")
  
  tbl <- d %>%
    select(all_of(group_col), all_of(vars)) %>%
    tbl_summary(
      by = all_of(group_col),
      label = labels,
      statistic = list(
        all_continuous()  ~ "{mean} ({sd})",
        all_categorical() ~ "{n} ({p}%)"
      ),
      digits = list(all_continuous() ~ 1),
      missing = missing_disp
    ) %>%
    add_p(
      test = list(
        all_continuous()  ~ cont_test,
        all_categorical() ~ "gts_safe_cat_test"    # chi-square / Fisher, per expected counts
      ),
      pvalue_fun = ~ style_pvalue(.x, digits = 3)
    ) %>%
    bold_labels() %>%
    modify_header(all_stat_cols() ~ "**{level}**, N = {n}") %>%
    modify_footnote(all_stat_cols() ~ "Mean (SD); n (%)") %>%
    modify_footnote(p.value ~ paste0(
      cont_lbl,
      "; Pearson's Chi-squared test / Fisher's exact test (simulated p-value where tables exceed 2x2)"))
  
  if (!is.null(group_lbls)) {
    for (lv in names(group_lbls)) {
      tbl <- tbl %>% modify_header(
        !!rlang::sym(paste0("stat_", which(levels(factor(d[[group_col]])) == lv))) :=
          paste0("**", group_lbls[[lv]], "**, N = {n}")
      )
    }
  }
  
  if (!is.null(caption)) tbl <- tbl %>% modify_caption(caption)
  
  tbl
}


#===============================================================================
# [C] NEW SECTION 15b -- DONOR TABLES (paste after Table 6)
#===============================================================================

# --- Step 0: donor-side recodes -------------------------------------------
# Restricting to HAS_DECEASED_DON == 1 here (rather than in each caller) means
# the "N = " in each column header is the DECEASED-DONOR N for that arm, not
# the arm's total N. Those two numbers differ by the living-donor recipients,
# so quote the donor-table N only alongside donor-table results.
#
# Unknown-code handling: UNOS uses out-of-range sentinels for "unknown"
# (HIST_DIABETES_DON == 998, "U" for the Y/N/U history fields, "U"/"I"/"ND"
# for serology). These are mapped to NA rather than being allowed to form
# their own level, because a level called "U" silently competes for
# percentage share with the real categories and drags an expected cell count
# under 5, which flips the whole row to a simulated Fisher test for no reason.
# missing = "ifany" below then shows how many are unknown, as its own row.
prep_donor_gts_df <- function(df) {
  donor_join_cols <- setdiff(names(df_deceased_don_fil2), "TRR_ID_CODE")
  df %>%
    select(-any_of(donor_join_cols)) %>%          # drop stale copies before joining
    left_join(df_deceased_don_fil2, by = "TRR_ID_CODE") %>%
    filter(!is.na(HAS_DECEASED_DON), HAS_DECEASED_DON == 1L) %>%
    mutate(
      across(any_of(c("AGE_DON", "HGT_CM_DON", "WGT_KG_DON", "BMI_DON",
                      "CREAT_DON", "SGOT_DON", "SGPT_DON", "TBILI_DON")),
             ~ suppressWarnings(as.numeric(.x))),
      
      DON_SEX_LBL = case_when(
        GENDER_DON == "M" ~ "Male",
        GENDER_DON == "F" ~ "Female",
        TRUE ~ NA_character_
      ),
      
      DON_RACE_LBL = case_when(
        as.character(ETHCAT_DON) == "1" ~ "White",
        as.character(ETHCAT_DON) == "2" ~ "Black/African American",
        as.character(ETHCAT_DON) == "4" ~ "Hispanic/Latino",
        as.character(ETHCAT_DON) == "5" ~ "Asian",
        !is.na(ETHCAT_DON)              ~ "Other",
        TRUE ~ NA_character_
      ),
      
      DON_HTN_LBL = case_when(
        HIST_HTN_DON == "Y" ~ "Yes",
        HIST_HTN_DON == "N" ~ "No",
        TRUE ~ NA_character_          # "U" / blank -> unknown
      ),
      
      # HIST_DIABETES_DON mirrors the recipient DIAB coding: 1 = No,
      # 2-5 = Yes (by duration), 998 = Unknown.
      DON_DM_LBL = case_when(
        suppressWarnings(as.numeric(HIST_DM_DON)) %in% 2:5 ~ "Yes",
        suppressWarnings(as.numeric(HIST_DM_DON)) == 1     ~ "No",
        HIST_DM_DON == "Y" ~ "Yes",                        # in case the field is Y/N
        HIST_DM_DON == "N" ~ "No",
        TRUE ~ NA_character_
      ),
      
      # COD_CAD_DON: 1 Anoxia, 2 Cerebrovascular/Stroke, 3 Head Trauma,
      # 4 CNS Tumor, 999 Other.
      DON_COD_LBL = case_when(
        as.character(COD_DON) == "1"   ~ "Anoxia",
        as.character(COD_DON) == "2"   ~ "Cerebrovascular/Stroke",
        as.character(COD_DON) == "3"   ~ "Head trauma",
        as.character(COD_DON) == "4"   ~ "CNS tumor",
        as.character(COD_DON) == "999" ~ "Other",
        !is.na(COD_DON)                ~ "Other",
        TRUE ~ NA_character_
      ),
      # Binary version, matching the reference table's single
      # "Cause of death: cerebrovascular/stroke" row.
      DON_COD_CVA_LBL = case_when(
        is.na(DON_COD_LBL) ~ NA_character_,
        DON_COD_LBL == "Cerebrovascular/Stroke" ~ "Yes",
        TRUE ~ "No"
      ),
      
      DON_HCV_LBL = case_when(
        HCV_DON == "P" ~ "Yes",
        HCV_DON == "N" ~ "No",
        TRUE ~ NA_character_          # I / ND / U -> unknown
      ),
      
      DON_DCD_LBL = case_when(
        DCD_DON == "Y" ~ "Yes",
        DCD_DON == "N" ~ "No",
        TRUE ~ NA_character_
      ),
      
      DON_PERFUSION_LBL = case_when(
        LI_MACHINE_PERFUSION == "Y" ~ "Yes",
        LI_MACHINE_PERFUSION == "N" ~ "No",
        TRUE ~ NA_character_
      ),
      DON_PERFUSION_TY_LBL = case_when(
        as.character(LI_MACHINE_PERFUSION_TY) == "1" ~ "Normothermic",
        as.character(LI_MACHINE_PERFUSION_TY) == "2" ~ "Hypothermic",
        TRUE ~ NA_character_
      ),
      DON_FIBROSIS_STAGE = factor(suppressWarnings(as.numeric(LI_FIBROSIS)), levels = 0:6),
      
      DON_FIBROSIS_ANY_LBL = case_when(
        suppressWarnings(as.numeric(LI_FIBROSIS)) == 0     ~ "No",
        suppressWarnings(as.numeric(LI_FIBROSIS)) %in% 1:6 ~ "Yes",
        TRUE ~ NA_character_
      )
    )
}

# --- Step 1: row set and labels -------------------------------------------
# Built by intersecting a wish-list against what actually resolved in [A], so
# a donor field absent from this data extract drops out of the table instead
# of erroring.
donor_vars_all <- c(
  "AGE_DON", "DON_SEX_LBL", "HGT_CM_DON", "WGT_KG_DON", "BMI_DON",
  "DON_RACE_LBL", "DON_HTN_LBL", "DON_DM_LBL", "DON_COD_CVA_LBL", "DON_COD_LBL",
  "CREAT_DON", "SGOT_DON", "SGPT_DON", "TBILI_DON",
  "DON_HCV_LBL", "DON_DCD_LBL", "DON_FIBROSIS_ANY_LBL", "DON_FIBROSIS_STAGE",
  "DON_PERFUSION_LBL", "DON_PERFUSION_TY_LBL"
)

donor_labels_all <- list(
  AGE_DON              ~ "Donor age, mean (SD), y",
  DON_SEX_LBL          ~ "Donor sex, n (%)",
  HGT_CM_DON           ~ "Height, mean (SD), cm",
  WGT_KG_DON           ~ "Weight, mean (SD), kg",
  BMI_DON              ~ "BMI, mean (SD), kg/m2",
  DON_RACE_LBL         ~ "Race/ethnicity, n (%)",
  DON_HTN_LBL          ~ "History of hypertension, n (%)",
  DON_DM_LBL           ~ "History of diabetes, n (%)",
  DON_COD_CVA_LBL      ~ "Cause of death: cerebrovascular/stroke, n (%)",
  DON_COD_LBL          ~ "Cause of death, n (%)",
  CREAT_DON            ~ "Serum creatinine, mean (SD), mg/dL",
  SGOT_DON             ~ "AST (SGOT), mean (SD), U/L",
  SGPT_DON             ~ "ALT (SGPT), mean (SD), U/L",
  TBILI_DON            ~ "Total bilirubin, mean (SD), mg/dL",
  DON_HCV_LBL          ~ "HCV+ status, n (%)",
  DON_DCD_LBL          ~ "Donation after circulatory death, n (%)",
  DON_FIBROSIS_ANY_LBL ~ "Any fibrosis on biopsy, n (%)",
  DON_FIBROSIS_STAGE   ~ "Fibrosis stage, n (%)",
  DON_PERFUSION_LBL    ~ "Machine perfusion used, n (%)",
  DON_PERFUSION_TY_LBL ~ "Perfusion type, n (%)"
)

# Keep only rows whose underlying source column actually resolved.
donor_row_requires <- c(
  AGE_DON = "AGE_DON", DON_SEX_LBL = "GENDER_DON", HGT_CM_DON = "HGT_CM_DON",
  WGT_KG_DON = "WGT_KG_DON", BMI_DON = "BMI_DON", DON_RACE_LBL = "ETHCAT_DON",
  DON_HTN_LBL = "HIST_HTN_DON", DON_DM_LBL = "HIST_DM_DON",
  DON_COD_CVA_LBL = "COD_DON", DON_COD_LBL = "COD_DON", CREAT_DON = "CREAT_DON",
  SGOT_DON = "SGOT_DON", SGPT_DON = "SGPT_DON", TBILI_DON = "TBILI_DON",
  DON_HCV_LBL = "HCV_DON", DON_DCD_LBL = "DCD_DON",
  DON_FIBROSIS_ANY_LBL = "LI_FIBROSIS", DON_FIBROSIS_STAGE = "LI_FIBROSIS", DON_PERFUSION_LBL = "LI_MACHINE_PERFUSION",
  DON_PERFUSION_TY_LBL = "LI_MACHINE_PERFUSION_TY"
)

donor_vars <- donor_vars_all[
  donor_row_requires[donor_vars_all] %in% names(donor_cols_found)
]

donor_labels <- donor_labels_all[
  vapply(donor_labels_all, function(f) all.vars(f)[1] %in% donor_vars, logical(1))
]

message("Donor table rows included: ", paste(donor_vars, collapse = ", "))

