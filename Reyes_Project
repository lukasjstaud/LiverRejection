# Both extractors return the FINAL display strings directly (HR_CI, P) rather
# than raw numbers -- this is what lets a flagged term become "NE" cleanly
# instead of a formatted-but-meaningless number.
extract_hr <- function(model, term, label, separation_terms = character(0)) {
  ci <- summary(model)$conf.int
  if (!term %in% rownames(ci)) {
    stop("extract_hr: term '", term, "' not found in model. Available terms:\n",
         paste(rownames(ci), collapse = "\n"),
         "\n(Check factor level spelling/encoding, or whether that level had ",
         "zero events and was dropped by coxph.)")
  }
  if (term %in% separation_terms) {
    return(tibble(Row = label, HR_CI = "NE", P = "NE"))
  }
  row <- ci[term, ]
  p   <- summary(model)$coefficients[term, "Pr(>|z|)"]
  tibble(Row = label,
         HR_CI = sprintf("%.2f (%.2f-%.2f)", row["exp(coef)"], row["lower .95"], row["upper .95"]),
         P = fmt_p(p))
}

# Prefix-based variant for terms whose factor levels contain non-ASCII
# characters (LDRI_cat's "\u2264" for example). Some R builds/locales fall
# back to a literal "<U+2264>"-style placeholder string when coxph names
# these coefficients, which silently breaks an exact string match against the
# original Unicode label even though nothing about the data or model is
# wrong. Matching on the guaranteed ASCII prefix and taking terms in the
# factor's own level order (which coxph always preserves) sidesteps the
# encoding question entirely rather than depending on this R session's locale
# agreeing with the one the code was written under.
extract_hr_by_prefix <- function(model, prefix, labels, separation_terms = character(0)) {
  ci     <- summary(model)$conf.int
  coefs  <- summary(model)$coefficients
  terms_matched <- grep(paste0("^", prefix), rownames(ci), value = TRUE)
  if (length(terms_matched) != length(labels)) {
    stop("extract_hr_by_prefix: expected ", length(labels), " terms with prefix '",
         prefix, "' but found ", length(terms_matched), ": ",
         paste(terms_matched, collapse = ", "),
         "\n(A factor level may have had zero events and been dropped -- check",
         " the relevant count table above before trusting this model.)")
  }
  bind_rows(lapply(seq_along(terms_matched), function(i) {
    t <- terms_matched[i]
    if (t %in% separation_terms) {
      return(tibble(Row = labels[i], HR_CI = "NE", P = "NE"))
    }
    row <- ci[t, ]
    p   <- coefs[t, "Pr(>|z|)"]
    tibble(Row = labels[i],
           HR_CI = sprintf("%.2f (%.2f-%.2f)", row["exp(coef)"], row["lower .95"], row["upper .95"]),
           P = fmt_p(p))
  }))
}

