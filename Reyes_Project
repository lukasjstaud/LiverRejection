#===============================================================================
# SECTION 30. WAITING TIME FROM KIDNEY LISTING TO KIDNEY TRANSPLANT, BY KDPI,
#             POST-POLICY ERA vs PRE-POLICY ERA
#===============================================================================
# ADDITIVE SECTION. Reads only; every object is prefixed `s30_` / `S30_`.
#
# DEPENDS ON SECTION 29 for s29_build_cohort() and the S29_KDPI_* tier
# definitions. That reuse is deliberate -- the whole difficulty of an era
# comparison is that the listing window is applied in Section 6.2 BEFORE
# de-duplication (7.3) and before the earliest-listing date is computed (7.1),
# so each era has to be rebuilt from the raw registrations rather than filtered
# out of a finished frame. Section 29 already solves that. If Section 29 is ever
# deleted, this section must be too (or s29_build_cohort() copied into it).
#
# THE QUESTION
#   Among patients who were listed for a kidney and eventually received one,
#   how long did they wait -- and does that differ by the quality of the kidney
#   they got, between the two allocation eras?
#
#   Rows    = era, then a between-era comparison block
#   Columns = KDPI <20 | KDPI 20-85 | KDPI >85 | All deceased donor |
#             Living donor (no KDPI)
#   Measure = days from kidney listing to kidney transplant
#
# THE ERAS ARE NOT DISJOINT SETS OF PATIENTS. A patient listed before
# 10AUG2017 who re-registers afterwards appears in BOTH era cohorts, with a
# different time origin in each (each era's earliest listing WITHIN that era).
# Section 30.3 counts the overlap. This is inherent to a registration-level
# era split, not a defect, but it means the two rows are not independent
# samples and the between-era p-values in 30.5 are approximate.
#
# TWO PANELS, AND WHY THE SECOND ONE EXISTS
#   [A] OBSERVED WAITING TIME -- every transplant that happened, however long
#       the wait. This is the table as requested, and it is the one to read for
#       "how long did people actually wait."
#       Caveat, stated rather than hidden: the post-policy era is
#       ADMINISTRATIVELY TRUNCATED. Someone listed in 2024 cannot be observed
#       waiting three years, because STUDY_END arrives first, while the
#       pre-policy era has had a decade for long waits to complete. Panel A's
#       post-policy waits are therefore biased SHORT, and part of any era
#       difference it shows is calendar time, not allocation policy.
#   [B] LANDMARK-MATCHED WAITING TIME -- restricted to patients with at least
#       S30_LANDMARK_DAYS of potential observation after listing, counting only
#       transplants that occurred within that same window in BOTH eras. Every
#       patient contributes the same observation length, so the comparison is
#       apples-to-apples. [B] is the panel to quote for an era CONTRAST.
#
# WHAT NEITHER PANEL IS
#   Waiting time among the transplanted is a SELECTED sample: patients who died
#   or were removed while waiting contribute nothing, and they are not missing
#   at random with respect to kidney quality. The unbiased version of this
#   question is a competing-risks model with "transplant with a KDPI <20 /
#   20-85 / >85 kidney" and "death or removal without transplant" as competing
#   events, giving a cumulative incidence for each transplant type (the
#   Aalen-Johansen machinery Section 20 already uses). Note that a plain
#   Kaplan-Meier "time to transplant" stratified by KDPI tier would be INVALID
#   -- the stratifying variable is only defined for those who had the event.
#   Both panels below print the number who died without a transplant so the
#   size of the selection is visible; neither corrects for it.
#===============================================================================

#--- 30.1 Configuration -------------------------------------------------------

# Requested eras, hardcoded because they were specified explicitly. The check
# below warns (rather than silently re-defining the table) if Section 1's
# window is edited so that era A no longer matches the cohort the rest of the
# manuscript uses.
S30_ERAS <- list(
  list(label = "Post-policy: 10AUG2017 - 03APR2025",
       start = as.Date("2017-08-10"), end = as.Date("2025-04-03")),
  list(label = "Pre-policy: 01JAN2010 - 09AUG2017",
       start = as.Date("2010-01-01"), end = as.Date("2017-08-09"))
)

if (!identical(S30_ERAS[[1]]$start, wl_start_date) ||
    !identical(S30_ERAS[[1]]$end, wl_end_date)) {
  warning("[Sec 30] The post-policy era (", format(S30_ERAS[[1]]$start), " to ",
          format(S30_ERAS[[1]]$end), ") no longer matches Section 1's ",
          "wl_start_date / wl_end_date (", format(wl_start_date), " to ",
          format(wl_end_date), "). Section 30 keeps the dates it was asked ",
          "for, so its post-policy row now describes a DIFFERENT cohort from ",
          "Tables 1-7. Reconcile these deliberately.")
}

# Which listing date starts the clock.
#   "first_listing" = the earliest kidney registration WITHIN THE ERA. Consistent
#                     with ESRD_DATE_SOURCE's default and with Section 29's time
#                     origin, and it is the honest answer to "how long was this
#                     patient waiting" when they have several registrations.
#   "dedup_row"     = the listing date carried on the single de-duplicated row,
#                     i.e. Section 10's INIT_DATE_KIDNEY. Use this to reconcile
#                     against Table 3's waiting_time_yrs, which is built that way.
S30_LISTING_SOURCE <- "first_listing"
stopifnot(S30_LISTING_SOURCE %in% c("first_listing", "dedup_row"))

# Panel B's common observation window, in days. 1095 = 3 years: long enough to
# capture the bulk of the waiting-time distribution, short enough that the
# post-policy era retains patients (it costs everyone listed after
# STUDY_END - 1095, i.e. after ~2022-04). Raise it for a fuller distribution at
# the price of post-policy n; lower it to keep more patients.
S30_LANDMARK_DAYS <- 1095

# Column order. The three KDPI tiers come from Section 29 so the two sections
# cannot drift; "All deceased donor" is those three pooled, NOT a separate
# classification.
S30_KDPI_COLS <- S29_KDPI_LABELS
S30_ALL_DD    <- "All deceased donor"
S30_LD        <- "Living donor (no KDPI)"
S30_COLS      <- c(S30_KDPI_COLS, S30_ALL_DD, S30_LD)


#--- 30.2 Waiting-time frame per era ------------------------------------------
s30_prepare <- function(era) {
  cohort <- s29_build_cohort(era$start, era$end, era$label)

  dat <- cohort |>
    mutate(
      listing_ref = if (identical(S30_LISTING_SOURCE, "first_listing"))
        kidney_listing_date else kidney_dedup_listing_date,
      wait_days = as.numeric(kidney_tx_date - listing_ref),
      # Column membership. A deceased-donor recipient whose KDPI is missing
      # belongs to no column and is counted as excluded rather than pooled.
      col_group = case_when(
        kidney_donor_type == "Living"                        ~ S30_LD,
        kidney_donor_type == "Deceased" & !is.na(kdpi_tier)   ~ as.character(kdpi_tier),
        TRUE                                                 ~ NA_character_
      )
    )

  n_listed <- nrow(dat)
  tx <- dat |> filter(!is.na(kidney_tx_date))

  # A negative wait is a window-boundary artifact, not bad data: the patient's
  # ORIGINAL registration predates era$start, so the earliest listing visible
  # inside the era falls after their transplant. There is no meaningful waiting
  # time for them in this era. Zero is kept -- a same-day transplant off a
  # pre-emptive listing is real.
  n_neg <- sum(!is.na(tx$wait_days) & tx$wait_days < 0)
  n_na  <- sum(is.na(tx$wait_days))
  tx <- tx |> filter(!is.na(wait_days), wait_days >= 0)

  # Deaths without a transplant -- the selection Panel A cannot see.
  n_died_no_tx <- dat |>
    filter(is.na(kidney_tx_date), !is.na(death_date)) |>
    nrow()

  cat("[Sec 30] ", era$label, "\n", sep = "")
  cat("  listed in era: ", n_listed,
      " | eventually transplanted: ", nrow(tx) + n_neg + n_na,
      " | usable waiting time: ", nrow(tx), "\n", sep = "")
  if (n_neg + n_na > 0) {
    cat("  dropped ", n_neg, " negative (transplant precedes the era's earliest ",
        "visible listing) and ", n_na, " undatable wait(s)\n", sep = "")
  }
  cat("  died without ever receiving a kidney: ", n_died_no_tx,
      " (", round(100 * n_died_no_tx / n_listed, 1), "% of those listed)\n", sep = "")
  n_no_col <- sum(is.na(tx$col_group))
  if (n_no_col > 0) {
    cat("  EXCLUDED from every column -- transplanted but unclassifiable (",
        n_no_col, "):\n", sep = "")
    print(tx |> filter(is.na(col_group)) |>
            count(kidney_donor_type, kdpi_missing = is.na(KDPI_num)))
  }
  print(tx |> filter(!is.na(col_group)) |> count(col_group))

  list(label = era$label, start = era$start, end = era$end,
       all = dat, tx = tx |> filter(!is.na(col_group)),
       n_listed = n_listed, n_died_no_tx = n_died_no_tx)
}

s30_eras <- lapply(S30_ERAS, s30_prepare)
names(s30_eras) <- vapply(S30_ERAS, function(e) e$label, character(1))


#--- 30.3 Era overlap ---------------------------------------------------------
# See the header note: a patient with registrations in both eras is in both
