lr_p(Surv(kg_time, kg_event) ~ KDPI_cat, df_km_kidney_kdpi)

# Pairwise log-rank, Holm-adjusted (3 tiers -> 3 comparisons)
print(pairwise_survdiff(Surv(kg_time, kg_event) ~ KDPI_cat,
                        data = df_km_kidney_kdpi, p.adjust.method = "holm"))

# KALT vs late kidney TX, within kidney recipients.
# [F7] droplevels() is required: df_km_kidney is restricted to patients who
