#--- Figures -------------------------------------------------------------------
# [F11] RISK TABLES WERE BEING DROPPED FROM EVERY EXPORTED KM FIGURE. Each
# ggsurvplot() call in this script passes risk.table = TRUE, and Section 2.6's
# km_pad_risk_table() exists solely to stop the outermost "Number at risk"
# values from being clipped. But these export lines used to write
# `<plot>$plot`, which is the CURVE PANEL ALONE -- ggsurvplot returns a list
# whose $table element holds the risk table, and $plot does not contain it. So
# print(plot_pt) showed curve + risk table on screen while
# fig1_patient_survival_tx.png contained only the curve, and the padding helper
# had no effect on any file on disk.
#
# save_km() prints the whole ggsurvplot object into the device, which is the
# same code path print() uses, so the exported PNG is exactly what the console
# renders -- risk table included, at the risk.table.height each figure was
# built with. Height is raised to 7in to give the table its own room without
# compressing the curve panel. Plain ggplots keep using ggsave().
# Section 31.5's CIF figure is a hand-assembled gtable rather than a
# ggsurvplot, and a grob is drawn, not printed -- print() on one is a no-op that
# would silently write a blank PNG. Dispatch on class so both kinds export.
save_km <- function(path, p, width = 8, height = 7, dpi = 300, bg = "white") {
  png(path, width = width, height = height, units = "in", res = dpi, bg = bg)
  on.exit(dev.off(), add = TRUE)
  if (inherits(p, c("gtable", "grob"))) grid::grid.draw(p) else print(p)
  invisible(path)
}

