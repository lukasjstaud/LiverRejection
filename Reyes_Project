  print_event_counts(df_b1_lg_c, "LDRI_cat2", "lg_event",
                     "liver graft survival, collapsed reference")
  r_b1_lg_c <- fit_coxph_checked(
    as.formula(paste("Surv(lg_time, lg_event) ~ LDRI_cat2 +",
                     paste(covariates_adjust, collapse = " + "))),
    df_b1_lg_c, "Block 1, liver graft survival (collapsed LDRI reference)"
  )
  fit_b1_lg_c <- r_b1_lg_c$fit
