#--- 24.3b Block 1 fallback -- collapsed LDRI reference, liver graft only ------
# The pre-specified contrast is against LDRI <= 1.1, but for the death-censored
# liver graft endpoint that tier has ZERO events (365 patients, 0 events -- see
# the event-count table printed just above). BOTH 3-tier HRs are computed
# relative to that empty cell, so neither has a finite partial-likelihood
# maximum and both come back NE -- even though the upper two tiers have
# perfectly workable counts of their own (20 and 34). This is one empty
# reference cell taking down the whole block, not two weak comparisons.
# Collapsing the reference to "LDRI <= 1.6" recovers a single estimable
# contrast from exactly the same data instead of reporting an all-NE block.
#
# Applied ONLY when the 3-tier fit actually separated, and ONLY to the liver
# graft endpoint -- patient survival keeps the pre-specified 3-tier contrast,
# where both levels are estimable. If a future data release gives the <= 1.1
# tier some liver graft events, this reverts to the 3-tier contrast
# automatically rather than silently keeping a coarser grouping that is no
# longer necessary.
ldri_lg_collapsed <- length(r_b1_lg$separation_terms) > 0

if (ldri_lg_collapsed) {
  cat("\n[Table 4, Block 1] LDRI <= 1.1 has zero liver graft events -- refitting\n",
      "  this endpoint only with a collapsed 'LDRI <= 1.6' reference:\n", sep = "")
  # Positional level test rather than a string match: LDRI_LABELS carries a
  # Unicode "≤" that some locales render as a "<U+2264>" placeholder --
  # the same encoding hazard extract_hr_by_prefix() exists to sidestep.
  top_ldri <- levels(df_b1_lg$LDRI_cat)[nlevels(df_b1_lg$LDRI_cat)]
  df_b1_lg_c <- df_b1_lg |>
    mutate(LDRI_cat2 = factor(if_else(LDRI_cat == top_ldri,
