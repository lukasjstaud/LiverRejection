lr_p(Surv(lg_time, lg_event) ~ LDRI_cat, df_km_ldri)

#--- 18.4 Death-censored kidney graft survival, by KDPI tier ------------------
df_km_kidney <- df_km_tx |>
  filter(!is.na(kidney_tx_date), !is.na(kg_time), kg_time >= 0)

df_km_kidney_kdpi <- df_km_kidney |> filter(!is.na(KDPI_cat))

# Tier n here MUST match Section 11 [4] minus anyone lost to a missing or
