# SECTION 29. WAITLIST-ERA COMPARISON -- 365-DAY MORTALITY HAZARD RATIOS FROM
#             KIDNEY LISTING, BY KIDNEY QUALITY, IN TWO LISTING WINDOWS
#===============================================================================
# ADDITIVE SECTION. Nothing above this line is modified, re-assigned or re-run.
# Every object created here is prefixed `s29_` / `S29_`, so it cannot collide
# with the primary analysis, and the section only READS upstream objects
# (df_kidpan_raw, df_liver_eligible, df_liver_dedup, df_death) and upstream
# helpers (is_blank_flag, kdpi_to_pct, min_date, make_patient_endpoint,
# fit_coxph_checked, fmt_p). Deleting this section restores the file exactly.
#
# THE QUESTION
#   Over the FIRST 365 DAYS AFTER KIDNEY WAITLISTING, what is the mortality
#   hazard of a KALT patient relative to an LTA patient, split by the quality
#   of the kidney the KALT patient received -- and does that answer change if
#   the cohort's kidney-listing window is widened from the specified
#   post-policy window to 01JAN2010 - 10AUG2025?
#
#   Rows    = listing window (S29_PERIODS)
#   Columns = LTA (reference), KDPI <20, KDPI 20-85, KDPI >85
#   Clock   = days since the patient's EARLIEST kidney registration, censored
#             administratively at 365 days
#   Event   = death (patient survival, same definition as
#             make_patient_endpoint() everywhere else in this pipeline)
#
# WHY THE COHORT IS REBUILT RATHER THAN SUBSET
#   The listing window is applied in Section 6.2, BEFORE de-duplication (7.3)
#   and before the earliest-listing date is computed (7.1). Widening the window
#   therefore adds registrations that can change which row wins de-duplication
#   and can move a patient's kidney_first_listing_date earlier -- i.e. it moves
#   the time origin itself. Filtering df_supp1 after the fact would silently
#   keep the narrow window's origins and de-dup winners and would not answer
#   the question asked. s29_build_cohort() re-runs 6.2 -> 7.1 -> 7.3 -> 8 -> 10
#   for one window at a time, reusing the same code idioms so the "specified
#   window" row is reconcilable against df_supp1 (checked in 29.4).
#
# TWO PANELS, AND WHY THE SECOND ONE EXISTS
#   [A] FIXED-GROUP HR -- Group is a fixed label from time 0, exactly as it is
#       used in Tables 1-3 and Section 19. This is the table as requested.
#       Caveat, stated rather than hidden: on a kidney-listing clock a KALT
#       patient must survive from listing to their kidney transplant in order
#       to be *classified* as KALT, so their pre-transplant survival time is
#       immortal by construction. Inside a 365-day window that immortal
#       stretch is a large fraction of the total follow-up, and it biases every
#       KALT/KDPI column DOWNWARD (protective).
#   [B] TIME-VARYING HR -- the same patients and the same clock, but transplant
#       status switches at the actual kidney transplant date via tmerge(),
#       the same counting-process construction Tables 4 and 5 use. Pre-
#       transplant KALT time is contributed to the reference state, so the
#       immortal time in [A] is removed. [B] is the defensible estimate; [A] is
#       reported alongside it because it is the one that is directly comparable
#       to the rest of the manuscript's fixed-Group tables.
#
# NOT ADJUSTED FOR COVARIATES. Both panels are crude. The adjustment set used
# in Section 24 (covariates_adjust) is built on df_esrd_cohort, whose labels
# exist only for the primary window; recreating them per window would duplicate
# Section 10 and is out of scope here. Read these as unadjusted.
#===============================================================================

#--- 29.1 Configuration -------------------------------------------------------

S29_HORIZON_DAYS <- 365          # follow-up is truncated here, in both panels

# Listing windows, in display order. The first entry deliberately POINTS AT the
# Section 1 tunables rather than copying their values, so it tracks
# wl_start_date / wl_end_date automatically. Add a row by adding a list entry
# -- e.g. to compare the PRE-policy era instead of the full span, append
#   list(label = "01JAN2010 - 09AUG2017", start = as.Date("2010-01-01"),
#        end = wl_start_date - 1)
S29_PERIODS <- list(
  list(label = paste0("Specified window (",
                      toupper(format(wl_start_date, "%d%b%Y")), " - ",
                      toupper(format(wl_end_date,   "%d%b%Y")), ")"),
       start = wl_start_date,
       end   = wl_end_date),
  # [F4] Label corrected. This entry read "01JAN2010 - 09AUG2017" while its
  # `end` was 10AUG2025 -- so the row was computed on the WIDENED 2010-2025
  # span (which is the comparison this section's header asks for) but printed
  # and exported under a PRE-POLICY-era heading. The window is right; the label
  # was wrong. Section 30's S30_ERAS defines the genuine pre-policy era as
  # 01JAN2010 - 09AUG2017, so the old label here also collided with a different
  # window of the same name two sections down.
  #
  # This window CONTAINS the first one rather than partitioning against it, so
  # the two rows are nested, not independent samples: read the second row as
  # "what happens to the same answer when the window is widened," and do not
  # test one against the other. For a true pre-policy contrast use Section 30's
  # eras, or append a third entry with end = wl_start_date - 1.
  list(label = "Widened window (01JAN2010 - 10AUG2025)",
       start = as.Date("2010-01-01"),
       end   = as.Date("2025-08-10"))
)

# KDPI tiers: <20, 20-85, >85. These now DERIVE from the pipeline-wide
# KDPI_BREAKS / KDPI_LABELS (Section 1.4) rather than defining a second cut.
# Sections 29 and 30 previously used a 20/80 split, which meant their columns
# could not be reconciled against KDPI_cat in Tables 2, 3 and 5. Pointing both
# sections at the same constants makes every KDPI-tiered table in the script
# use one set of cut points, and makes future drift impossible: change
# KDPI_BREAKS in Section 1.4 and every table follows.
S29_KDPI_BREAKS <- KDPI_BREAKS
S29_KDPI_LABELS <- KDPI_LABELS

# Interval closure at the 20 and 85 boundaries.
#   TRUE  = (-Inf,20], (20,85], (85,Inf] -- matches KDPI_cat's right = TRUE
#           convention elsewhere in this pipeline, so a KDPI of exactly 20
#           lands in the "KDPI <20" column and exactly 85 in "KDPI 20-85".
#   FALSE = [-Inf,20), [20,85), [85,Inf) -- matches the column LABELS literally.
# Section 29.3 prints how many patients sit exactly on each boundary so the
# choice is auditable rather than assumed.
S29_KDPI_RIGHT_CLOSED <- TRUE

# Administrative censoring. This is a property of the SAF release, not of the
# listing window, so both periods use the same value by default. [F4] This
# comment used to say the widened window's end (10AUG2025) fell AFTER
# STUDY_END; that was true when STUDY_END was 03APR2025 but is not now that
# Section 1 sets it to 03APR2026, so both windows close well inside the
# follow-up period. The positive-follow-up filter in 29.3 still reports
# whatever it drops.
S29_STUDY_END <- STUDY_END

# Panel [B] only: what happens to an LTA patient who gets a LATE kidney
# (KALT_STATUS_CALC == 2, i.e. >= 365 days after LIVER transplant)?
#
# This matters far more here than it does in Table 4, because of the clock. A
# kidney that is "late" relative to LIVER TRANSPLANT can be very early relative
# to KIDNEY LISTING -- a patient listed for a kidney five years after their
# liver transplant and transplanted three months later is late-TX by Group but
# transplanted on day ~90 of this table's 365-day window. Section 29.5 prints
# how many patients that is; it is not a rounding error.
#
#   "reference" = they stay in the pooled reference state for their whole
#                 follow-up. Matches TABLE4_LATE_TX_TIME_VARYING = FALSE and
#                 keeps Panel B on exactly the same patients as Panel A, but
#                 puts real post-transplant person-time in the reference,
#                 which biases the KDPI HRs UPWARD (toward/past 1).
#   "censor"    = they are censored at their own kidney transplant date. The
#                 reference state is then genuinely un-transplanted and the
#                 KDPI columns stay KALT-only -- the cleanest reference for
#                 this particular table -- at the cost of discarding their
#                 later follow-up (and of no longer matching Panel A's
#                 person-time exactly).
#   "switch"    = they switch into the KDPI tier of their own kidney, like a
#                 KALT patient. Matches TABLE4_LATE_TX_TIME_VARYING = TRUE,
#                 but the KDPI columns then mean "received a kidney of this
#                 quality at any time," not "KALT."
# Default inherits Section 1.3c so the two time-varying models in this file
# cannot silently disagree.
S29_LATE_TX_HANDLING <- if (TABLE4_LATE_TX_TIME_VARYING) "switch" else "reference"
stopifnot(S29_LATE_TX_HANDLING %in% c("reference", "censor", "switch"))

S29_MIN_EVENTS_WARN <- 5         # small-cell warning threshold

S29_GROUP_LABELS <- c("LTA", S29_KDPI_LABELS)

# Resolve the KDPI scale ONCE, on the full raw column, and pass it explicitly
# below. kdpi_to_pct(scale = "auto") re-detects from whatever subset it is
# handed; two windows could in principle detect differently, which would make
# the two rows of this table incomparable for a reason that has nothing to do
# with the data.
S29_KDPI_SCALE <- if (identical(KDPI_SCALE, "auto")) {
  s29_mx <- suppressWarnings(max(as.numeric(df_kidpan_raw$KDPI), na.rm = TRUE))
  if (is.finite(s29_mx) && s29_mx <= 1.5) "fraction" else "percent"
} else KDPI_SCALE
cat("\n[Sec 29] KDPI scale used for both periods:", S29_KDPI_SCALE, "\n")


#--- 29.2 Cohort builder, parameterised by listing window ----------------------
# Mirrors Sections 6.2, 7.1, 7.3, 8 and the Group / KDPI parts of 10, for one
# window. Only the columns this section needs are carried, so no renaming
# gymnastics (Section 7.3) or collision audit (7.4) is required.
s29_build_cohort <- function(win_start, win_end, label) {
  cat("\n", strrep("=", 70), "\n[Sec 29] BUILDING COHORT: ", label, "\n",
      strrep("=", 70), "\n", sep = "")

  # -- 6.2 equivalent: age + listing window + no simultaneous non-kidney TX
  kid_elig_pre <- df_kidpan_raw |>
    mutate(INIT_AGE = suppressWarnings(as.numeric(INIT_AGE))) |>
    filter(INIT_AGE >= age_min, INIT_AGE <= age_max) |>
    filter(!is.na(INIT_DATE), INIT_DATE >= win_start, INIT_DATE <= win_end) |>
    filter(if_all(all_of(SIM_TX_COLS_KIDNEY), is_blank_flag))

  # [F10] PATIENT-level donor-type exclusion, mirroring Section 6.2 exactly. This
  # section rebuilds 6.2 for its own listing window, so it inherited 6.2's old
  # row-level filter and its bug: a patient whose transplant row is dropped but
  # whose blank listing row survives is silently recast as never-transplanted and
  # pooled into this section's LTA reference. Fixed here for the same reason and
  # in the same way -- if these two ever diverge, Section 29.4's reconciliation
  # against df_supp1 is what will catch it.
  s29_dt  <- trimws(as.character(kid_elig_pre$DON_TY))
  s29_bad <- unique(kid_elig_pre$PT_CODE[
    !is.na(s29_dt) & s29_dt != "" & !s29_dt %in% KIDNEY_DON_TY_KEEP])
  kid_elig <- kid_elig_pre |> filter(!PT_CODE %in% s29_bad)

  cat("kidney registrations in window:", nrow(kid_elig),
      "| distinct patients:", dplyr::n_distinct(kid_elig$PT_CODE),
      "| patients excluded for donor type:", length(s29_bad), "\n")
  stopifnot(nrow(kid_elig) > 0)
  stopifnot(all(trimws(as.character(kid_elig$DON_TY)) %in%
                  c("", NA, KIDNEY_DON_TY_KEEP)))

  # -- 7.1 equivalent: earliest listing, computed BEFORE de-duplication
  first_list <- kid_elig |>
    group_by(PT_CODE) |>
    summarise(kidney_listing_date = min_date(INIT_DATE), .groups = "drop")

  # -- 7.3 equivalent: identical tie-break order (transplant row, then a
  #    KDPI-bearing row, then earliest TX, then earliest listing)
  kid_dedup <- kid_elig |>
    arrange(PT_CODE, desc(!is.na(TX_DATE)), desc(!is.na(KDPI)), TX_DATE, INIT_DATE) |>
    group_by(PT_CODE) |>
    slice(1) |>
    ungroup() |>
    left_join(first_list, by = "PT_CODE") |>
    transmute(PT_CODE,
              kidney_listing_date,
              # The de-duplicated row's OWN listing date, i.e. Section 10's
              # INIT_DATE_KIDNEY. Carried only so Section 30 can offer the
              # "dedup_row" waiting-time definition that Table 3 uses; nothing
              # in Section 29 reads it, and no Section 29 number depends on it.
              kidney_dedup_listing_date = INIT_DATE,
              kidney_tx_date = TX_DATE,
              DON_TY_KIDNEY  = DON_TY,
              KDPI)
  stopifnot(!any(duplicated(kid_dedup$PT_CODE)))

  # -- 8 + 10 equivalent: merge onto the index liver transplant, classify, label
  #    df_liver_dedup (Sec 7.2) and df_death (Sec 16) carry no date window, so
  #    they are reused as-is rather than rebuilt -- that keeps this section in
  #    lockstep with 6.1/16 if those are ever edited.
  out <- df_liver_dedup |>
    transmute(PT_CODE, liver_tx_date = TX_DATE) |>
    inner_join(kid_dedup, by = "PT_CODE") |>      # = Sec 10's !is.na(INIT_DATE_KIDNEY)
    left_join(df_death |> select(PT_CODE, death_date, last_fu_date), by = "PT_CODE") |>
    mutate(
      days_liver_to_kidney_tx = as.numeric(kidney_tx_date - liver_tx_date),
      KALT_STATUS_CALC = case_when(
        is.na(kidney_tx_date)                                        ~ 0L,
        days_liver_to_kidney_tx >= 0 & days_liver_to_kidney_tx < 365 ~ 1L,
        days_liver_to_kidney_tx >= 365                               ~ 2L,
        days_liver_to_kidney_tx <  0                                 ~ 3L,
        TRUE                                                         ~ NA_integer_
      )
    ) |>
    filter(KALT_STATUS_CALC != 3) |>              # = Sec 10's kidney-before-liver drop
    mutate(
      # Same is_kalt() as Section 10, so this cohort's exposure definition
      # cannot drift from the main cohort's ([K1], Section 1.3).
      Group = factor(if_else(is_kalt(days_liver_to_kidney_tx), "KALT", "LTA"),
                     levels = c("LTA", "KALT")),
      KDPI_num = kdpi_to_pct(KDPI, scale = S29_KDPI_SCALE, announce = FALSE),
      kdpi_tier = cut(KDPI_num, breaks = S29_KDPI_BREAKS, labels = S29_KDPI_LABELS,
                      right = S29_KDPI_RIGHT_CLOSED),
      kidney_donor_type = case_when(
        toupper(trimws(as.character(DON_TY_KIDNEY))) == "L" ~ "Living",
        toupper(trimws(as.character(DON_TY_KIDNEY))) == "C" ~ "Deceased",
        TRUE ~ NA_character_
      )
    )

  cat("patients after liver-side merge and kidney-before-liver drop:", nrow(out), "\n")
  print(out |> count(Group, KALT_STATUS_CALC))
  out
}


#--- 29.3 Endpoint, 365-day truncation, and the 4-column analysis group -------
s29_prepare <- function(cohort, label) {
  # Patient survival from kidney listing. Identical construction to
  # Sections 18.2 / 23.1 -- death is the event, nothing censors at death.
  ep <- make_patient_endpoint(cohort, "kidney_listing_date", study_end = S29_STUDY_END)
  dat <- cohort |> bind_cols(ep |> rename(pt_time = time, pt_event = event))

  n_start <- nrow(dat)
  n_na    <- sum(is.na(dat$pt_time))
  n_neg   <- sum(!is.na(dat$pt_time) & dat$pt_time <= 0)
  dat <- dat |> filter(!is.na(pt_time), pt_time > 0)
  if (n_na + n_neg > 0) {
    cat("dropped for unusable follow-up: ", n_na, " missing, ", n_neg,
        " zero/negative (death, last follow-up or STUDY_END at or before the\n",
        "  kidney listing date -- expected for anyone listed after STUDY_END = ",
        format(S29_STUDY_END), ")\n", sep = "")
  }

  # Administrative censoring at the horizon: an event AFTER day 365 becomes a
  # censoring at day 365. Order matters -- rewrite the indicator using the
  # UNtruncated time, then truncate the time.
  dat <- dat |>
    mutate(
      event_365 = if_else(pt_time <= S29_HORIZON_DAYS, as.integer(pt_event), 0L),
      time_365  = pmin(pt_time, S29_HORIZON_DAYS)
    )

  # Boundary audit for S29_KDPI_RIGHT_CLOSED
  n_at_20 <- sum(dat$KDPI_num == 20, na.rm = TRUE)
  n_at_85 <- sum(dat$KDPI_num == 85, na.rm = TRUE)
  cat("KDPI exactly 20: ", n_at_20, " | exactly 85: ", n_at_85,
      "  (right = ", S29_KDPI_RIGHT_CLOSED, ", so 20 -> '", S29_KDPI_LABELS[1],
      "' and 85 -> '", S29_KDPI_LABELS[if (S29_KDPI_RIGHT_CLOSED) 2 else 3],
      "')\n", sep = "")

  # The 4 columns. A KALT patient with no KDPI tier cannot be placed in any
  # column and is EXCLUDED from both panels rather than being quietly pooled
  # into the LTA reference (which would attribute their events to LTA).
  dat <- dat |>
    mutate(analysis_group = factor(
      case_when(
        Group == "LTA"                        ~ "LTA",
        Group == "KALT" & !is.na(kdpi_tier)   ~ as.character(kdpi_tier),
        TRUE                                  ~ NA_character_
      ), levels = S29_GROUP_LABELS))

  excl <- dat |> filter(is.na(analysis_group))
  if (nrow(excl) > 0) {
    cat("EXCLUDED -- KALT recipients with no KDPI tier (", nrow(excl), "):\n", sep = "")
    print(excl |> count(kidney_donor_type, kdpi_missing = is.na(KDPI_num)))
    cat("  (living-donor KALT have no KDPI by definition; deceased-donor rows\n",
        "   here are genuinely missing KDPI. Both are absent from every column.)\n", sep = "")
  }
  dat <- dat |> filter(!is.na(analysis_group))

  cat("ANALYSED n = ", nrow(dat), " of ", n_start, " built\n", sep = "")
  tab <- dat |>
    group_by(analysis_group) |>
    summarise(n = dplyr::n(), deaths_365 = sum(event_365),
              person_years = round(sum(time_365) / 365.25, 1), .groups = "drop")
  print(tab)
  thin <- tab |> filter(deaths_365 < S29_MIN_EVENTS_WARN)
  if (nrow(thin) > 0) {
    warning("[Sec 29 / ", label, "] fewer than ", S29_MIN_EVENTS_WARN,
            " deaths within ", S29_HORIZON_DAYS, " days in: ",
            paste(thin$analysis_group, collapse = ", "),
            " -- the corresponding HR is unstable, and a zero-event cell is ",
            "reported as NE.")
  }
  dat
}


#--- 29.4 Panel [A] -- fixed-group HR ------------------------------------------
# Reads one HR out of a fit without stopping the run when a level is absent
# (a narrow window can legitimately have an empty KDPI tier). extract_hr()
# stops in that situation, by design; this table needs to print a dash and
# carry on.
s29_hr_cell <- function(fit, term, sep_terms = character(0)) {
  ci <- summary(fit)$conf.int
  if (!term %in% rownames(ci)) {
    return(tibble(HR_CI = "--", P = "--", HR = NA_real_,
                  LCL = NA_real_, UCL = NA_real_, p_value = NA_real_))
  }
  if (term %in% sep_terms) {
    return(tibble(HR_CI = "NE", P = "NE", HR = NA_real_,
                  LCL = NA_real_, UCL = NA_real_, p_value = NA_real_))
  }
  row <- ci[term, ]
  p   <- summary(fit)$coefficients[term, "Pr(>|z|)"]
  tibble(HR_CI = sprintf("%.2f (%.2f-%.2f)",
                         row["exp(coef)"], row["lower .95"], row["upper .95"]),
         P     = fmt_p(p),
         HR    = as.numeric(row["exp(coef)"]),
         LCL   = as.numeric(row["lower .95"]),
         UCL   = as.numeric(row["upper .95"]),
         p_value = as.numeric(p))
}

s29_fit_fixed <- function(dat, label) {
  cat("\n[Sec 29 / ", label, "] PANEL A -- fixed-group Cox, 0-",
      S29_HORIZON_DAYS, " days from kidney listing:\n", sep = "")
  dat <- dat |> mutate(analysis_group = droplevels(analysis_group))
  r <- fit_coxph_checked(Surv(time_365, event_365) ~ analysis_group, dat,
                         paste0("Sec 29 fixed / ", label))
  print(summary(r$fit)$conf.int)

  counts <- dat |>
    group_by(analysis_group) |>
    summarise(n = dplyr::n(), events = sum(event_365), .groups = "drop") |>
    mutate(analysis_group = as.character(analysis_group))

  rows <- bind_rows(lapply(S29_GROUP_LABELS, function(g) {
    cnt <- counts |> filter(analysis_group == g)
    n_g <- if (nrow(cnt)) cnt$n[1]     else 0L
    e_g <- if (nrow(cnt)) cnt$events[1] else 0L
    cell <- if (identical(g, "LTA")) {
      tibble(HR_CI = "1.00 (reference)", P = "--", HR = 1, LCL = NA_real_,
             UCL = NA_real_, p_value = NA_real_)
    } else if (n_g == 0L) {
      tibble(HR_CI = "--", P = "--", HR = NA_real_, LCL = NA_real_,
             UCL = NA_real_, p_value = NA_real_)
    } else {
      s29_hr_cell(r$fit, paste0("analysis_group", g), r$separation_terms)
    }
    bind_cols(tibble(Group = g, count_cell = sprintf("%d (%d)", n_g, e_g)), cell)
  }))

  list(rows = rows, fit = r$fit)
}


#--- 29.5 Panel [B] -- time-varying HR (immortal time removed) -----------------
# Same tmerge() counting-process construction as Sections 24.4 and 25.4: one
# switch per patient, at their kidney transplant, from the pooled
# waitlist/pre-transplant reference into the KDPI tier of the kidney they
# actually received.
s29_fit_tv <- function(dat, label) {
  cat("\n[Sec 29 / ", label, "] PANEL B -- time-varying Cox, 0-",
      S29_HORIZON_DAYS, " days from kidney listing (late-TX handling = '",
      S29_LATE_TX_HANDLING, "'):\n", sep = "")

  base <- dat |>
    mutate(tx_offset_raw = as.numeric(kidney_tx_date - kidney_listing_date))

  # How much genuinely transplanted person-time is at stake in the
  # S29_LATE_TX_HANDLING choice? Print it rather than assume it is negligible.
  n_late_in_window <- base |>
    filter(KALT_STATUS_CALC == 2, !is.na(tx_offset_raw),
           tx_offset_raw > 0, tx_offset_raw < time_365) |>
    nrow()
  cat("  late-TX (>=365d post-liver, coded LTA) patients transplanted INSIDE\n",
      "  this 365-day window: ", n_late_in_window, " of ",
      sum(base$KALT_STATUS_CALC == 2), " late-TX patients\n", sep = "")

  # "censor": end follow-up at the late transplant, so the reference state is
  # genuinely un-transplanted. Done BEFORE the counting process is built.
  if (identical(S29_LATE_TX_HANDLING, "censor") && n_late_in_window > 0) {
    base <- base |>
      mutate(
        cens_here = KALT_STATUS_CALC == 2 & !is.na(tx_offset_raw) &
          tx_offset_raw > 0 & tx_offset_raw < time_365,
        event_365 = if_else(cens_here, 0L, event_365),
        time_365  = if_else(cens_here, tx_offset_raw, time_365)
      )
    cat("  censored ", sum(base$cens_here), " late-TX patient(s) at their own ",
        "kidney transplant date\n", sep = "")
    base <- base |> select(-cens_here)
  }

  base <- base |>
    transmute(
      PT_CODE, tstart = 0, tstop = time_365, event = event_365,
      # Who switches, and into which tier. LTA patients who never receive a
      # kidney (KALT_STATUS_CALC == 0) never switch, under any setting.
      eligible = KALT_STATUS_CALC == 1 |
        (identical(S29_LATE_TX_HANDLING, "switch") & KALT_STATUS_CALC == 2),
      tier      = if_else(eligible & !is.na(kdpi_tier), as.character(kdpi_tier),
                          NA_character_),
      tx_offset = if_else(!is.na(tier), tx_offset_raw, NA_real_)
    ) |>
    select(-eligible)

  # Same two guards as Section 24.4 / 25.4: tmerge needs 0 < cutpoint < tstop.
  # An offset <= 0 is a window-boundary artifact rather than bad data -- the
  # patient's ORIGINAL kidney registration predates win_start, so the earliest
  # listing visible inside the window falls after their transplant. There is no
  # correct time origin for them in this window; they keep the one the window
  # implies (as they do in df_supp1) and simply never switch.
  bad <- !is.na(base$tx_offset) &
    (base$tx_offset <= 0 | base$tx_offset >= base$tstop)
  if (any(bad)) {
    warning("[Sec 29 / ", label, "] ", sum(bad), " patient(s) have a kidney ",
            "transplant at/before their (window-truncated) time origin or ",
            "at/after their outcome time -- their switch is dropped, so they ",
            "spend all of Panel B's follow-up in the reference state. In ",
            "Panel A they remain in their KDPI column throughout; the two ",
            "panels therefore treat these patients differently by ",
            "construction.")
    base <- base |>
      mutate(tier      = if_else(bad, NA_character_, tier),
             tx_offset = if_else(bad, NA_real_,      tx_offset))
  }

  long <- tmerge(base, base, id = PT_CODE, tstop = tstop,
                 event = event(tstop, event))
  long <- tmerge(long, base, id = PT_CODE, tx_switch = tdc(tx_offset))

  long <- long |>
    mutate(tv_group = factor(
      if_else(!is.na(tx_offset) & tstart >= tx_offset, tier, "LTA"),
      levels = S29_GROUP_LABELS))
  stopifnot(!any(is.na(long$tv_group)), all(long$tstop > long$tstart))

  cat("  ", nrow(base), " patients -> ", nrow(long),
      " counting-process rows\n", sep = "")
  pt <- long |>
    group_by(tv_group) |>
    summarise(person_years = round(sum(tstop - tstart) / 365.25, 1),
              events = sum(event), .groups = "drop") |>
    mutate(tv_group = as.character(tv_group))
  print(pt)

  long <- long |> mutate(tv_group = droplevels(tv_group))
  r <- fit_coxph_checked(Surv(tstart, tstop, event) ~ tv_group, long,
                         paste0("Sec 29 time-varying / ", label))
  print(summary(r$fit)$conf.int)

  rows <- bind_rows(lapply(S29_GROUP_LABELS, function(g) {
    p <- pt |> filter(tv_group == g)
    py <- if (nrow(p)) p$person_years[1] else 0
    ev <- if (nrow(p)) p$events[1]       else 0L
    cell <- if (identical(g, "LTA")) {
      tibble(HR_CI = "1.00 (reference)", P = "--", HR = 1, LCL = NA_real_,
             UCL = NA_real_, p_value = NA_real_)
    } else if (py == 0) {
      tibble(HR_CI = "--", P = "--", HR = NA_real_, LCL = NA_real_,
             UCL = NA_real_, p_value = NA_real_)
    } else {
      s29_hr_cell(r$fit, paste0("tv_group", g), r$separation_terms)
    }
    bind_cols(tibble(Group = g, count_cell = sprintf("%.1f (%d)", py, ev)), cell)
  }))

  list(rows = rows, fit = r$fit, long = long)
}


