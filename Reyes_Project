#===============================================================================
# SECTION 32. PATIENT SURVIVAL FROM KIDNEY LISTING -- KAPLAN-MEIER,
#             PRE-POLICY vs POST-POLICY LISTING ERA
#===============================================================================
# ADDITIVE SECTION. Reads only; every object is prefixed `s32_` / `S32_`.
# DEPENDS ON SECTION 31 for s31_base (and, through it, on Sections 29-30).
#
# WHAT THIS IS, AND WHY IT IS THE CLEANEST OF THE ERA COMPARISONS
#   Time origin  = kidney listing.
#   Event        = death, from any cause, at any time.
#   Censoring    = last follow-up or STUDY_END.
#   TRANSPLANT IS NEITHER. A patient who receives a kidney stays in the risk set
#   and keeps contributing follow-up exactly as before; the transplant is simply
#   something that happens during follow-up. This is the same
#   make_patient_endpoint() definition used by Sections 18.2, 19.2 and 23.
#
#   That makes this the only era comparison in Sections 29-32 with no structural
#   bias to argue about:
#     - No immortal time. Era is fixed at listing (it IS the cohort definition),
#       so nobody has to survive to anything in order to be classified. Contrast
#       Section 29, where KALT status is only knowable after a transplant.
#     - No competing-risks problem. Nothing is censored at a competing event, so
#       there is no "would they have been transplanted anyway" assumption of the
#       kind Section 31.4 has to quantify.
#     - No selection on the outcome. Every listed patient contributes, unlike
#       Section 30's waiting times, which exist only for the transplanted.
#
# WHAT IT CANNOT TELL YOU
#   This is an intention-to-treat-style comparison of two calendar periods, so a
#   difference between the curves is attributable to the eras, NOT specifically
#   to kidney allocation. Secular change in liver transplant care, in candidate
#   selection, in MELD/dialysis practice and in case mix are all inside it. It
#   is the headline "did outcomes differ by era" number; Sections 29-31 are what
#   attribute a difference to kidney quality or transplant timing.
#
#   It is also NOT a treatment effect of transplantation. Because transplant is
#   left in, each era's curve is a blend of transplanted and never-transplanted
#   follow-up, weighted by how often and how quickly that era transplanted
#   people -- which Section 31 shows differs sharply between the eras. Read
#   alongside Section 31, not instead of it.
#
# HORIZON: 1/3/5 years via REPORT_TIMES, per Section 1. Section 32.3 checks the
# number at risk at each reported time before trusting it -- summary.survfit(
# extend = TRUE) does NOT error past the end of a curve, it silently returns the
# last event time's estimate with n.risk = 0, which is exactly how the old
# 10-year columns came to report end-of-follow-up survival under a 10-year label.
#===============================================================================

#--- 32.1 Configuration -------------------------------------------------------

# Reported horizons. Uses Section 1's REPORT_TIMES rather than a local vector so
# this section cannot drift from Supplementary Table 1 / Tables 5 and 6.
S32_REPORT_TIMES <- REPORT_TIMES        # c(365, 1095, 1825) -- 1, 3, 5 years
S32_XLIM         <- KM_XLIM             # c(0, 1825), shared with Sections 19/21/31


#--- 32.2 Endpoint ------------------------------------------------------------
# s31_base (Section 31.2) is already the one-row-per-patient, era-resolved frame:
# both eras stacked, S31_ERA_OVERLAP applied so no patient sits in two strata,
# Era a factor in chronological order, and listing_ref / death_date /
# last_fu_date all present. Reusing it -- rather than rebuilding from s30_eras --
# is deliberate: it guarantees this curve and Section 31's transplant-incidence
# curve describe the IDENTICAL patients, so the two can be read side by side.
# The endpoint is the only thing that differs.
#
# Era is re-declared as a FACTOR here. s31_base carries it as a character vector
# (Section 31 factors it one step later, when building s31_dat), and a character
# stratifier would be ordered by sort/appearance -- putting the POST-policy era
# first, which silently makes it the Cox reference level and reverses the
# direction of every era hazard ratio below. Levels come from s31_era_levels so
# the two sections order their strata identically: pre-policy first, hence
# pre-policy is the reference and the HR reads post-vs-pre.
s32_base <- s31_base |>
  mutate(Era = factor(Era, levels = s31_era_levels))
stopifnot(!any(is.na(s32_base$Era)), nlevels(s32_base$Era) == 2)

s32_dat <- s32_base |>
  bind_cols(
    make_patient_endpoint(s32_base, "listing_ref", study_end = S29_STUDY_END) |>
      rename(pt_time = time, pt_event = event)
  )

s32_n_pre <- nrow(s32_dat)
s32_drop  <- s32_dat |> filter(is.na(pt_time) | pt_time <= 0)
if (nrow(s32_drop) > 0) {
  cat("\n[Sec 32] dropped ", nrow(s32_drop), " patient(s) with no usable ",
      "follow-up (death or censoring on/before the listing date):\n", sep = "")
  print(s32_drop |> count(Era))
}
s32_dat <- s32_dat |> filter(!is.na(pt_time), pt_time > 0)

cat("\n[Sec 32] Patient survival from kidney listing -- ", nrow(s32_dat), " of ",
    s32_n_pre, " patients:\n", sep = "")
print(s32_dat |>
        group_by(Era) |>
        summarise(n            = dplyr::n(),
                  deaths       = sum(pt_event),
                  transplanted = sum(!is.na(kidney_tx_date)),
                  py           = round(sum(pt_time) / 365.25, 1),
                  max_fu_days  = max(pt_time),
                  .groups = "drop"))
cat("(transplanted is shown only to make the blend explicit -- transplant does",
    "NOT\nend follow-up here, so these patients are in the curve throughout.)\n")


#--- 32.3 Kaplan-Meier, log-rank, crude HR ------------------------------------
s32_fit <- survfit(Surv(pt_time, pt_event) ~ Era, data = s32_dat)
s32_fit$call$formula <- Surv(pt_time, pt_event) ~ Era   # for ggsurvplot
s32_fit$call$data    <- s32_dat

cat("\n[Sec 32] Median survival from kidney listing:\n")
s32_med_tab <- summary(s32_fit)$table
print(s32_med_tab)

s32_logrank_p <- lr_p(Surv(pt_time, pt_event) ~ Era, s32_dat)
cat("\n[Sec 32] Log-rank P (pre- vs post-policy era):", fmt_p(s32_logrank_p), "\n")

# Crude era HR. Unadjusted by design -- the adjustment set used elsewhere
# (covariates_adjust, Section 24.1) is built on df_esrd_cohort and exists only
# for the primary window, and the era cohorts here are rebuilt per window.
s32_cox <- fit_coxph_checked(Surv(pt_time, pt_event) ~ Era, s32_dat,
                             "Sec 32 era HR")
cat("\n[Sec 32] Crude HR, post-policy vs pre-policy era:\n")
print(summary(s32_cox$fit)$conf.int)
s32_hr_row <- s29_hr_cell(s32_cox$fit,
                          paste0("Era", levels(s32_dat$Era)[2]),
                          s32_cox$separation_terms)

s32_s <- summary(s32_fit, times = S32_REPORT_TIMES, extend = TRUE)
s32_km <- tibble(
  Era     = gsub("^Era=", "", as.character(s32_s$strata)),
  time_d  = s32_s$time,
  n_risk  = s32_s$n.risk,
  n_event = s32_s$n.event,
  surv    = s32_s$surv,
  lower   = s32_s$lower,
  upper   = s32_s$upper
)

# The n.risk == 0 guard described in the header. A stratum whose curve ends
# before a reported time gets a dash, not that stratum's end-of-follow-up
# estimate wearing the wrong label.
s32_km <- s32_km |> mutate(usable = n_risk > 0)
if (any(!s32_km$usable)) {
  warning("[Sec 32] ", sum(!s32_km$usable), " reported time/stratum cell(s) ",
          "have n.risk = 0, i.e. the curve ends before that horizon; they are ",
          "reported as '--' rather than as the last event time's estimate. ",
          "Inspect s32_km.")
}

cat("\n[Sec 32] Survival at", paste(S32_REPORT_TIMES, collapse = "/"), "days:\n")
print(s32_km |>
        mutate(estimate = if_else(usable,
                                  sprintf("%.1f%% (%.1f-%.1f)", 100 * surv,
                                          100 * lower, 100 * upper),
                                  "--")) |>
        select(Era, time_d, n_risk, n_event, estimate), n = 20)


#--- 32.4 Figure --------------------------------------------------------------
s32_plot <- km_pad_risk_table(ggsurvplot(
