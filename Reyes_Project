    "| after exclusion criteria =", nrow(df_liver_eligible_pre_era),
    "| after ", LT_LOOKBACK_YEARS, "y era floor (", format(lt_start_date), ") = ",
    nrow(df_liver_eligible), "\n", sep = "")
cat("  dropped by the era floor: ",
    nrow(df_liver_eligible_pre_era) - nrow(df_liver_eligible), " row(s); ",
    sum(is.na(df_liver_eligible_pre_era$TX_DATE)),
    " of those for a MISSING liver TX date (expected: 0)\n", sep = "")
cat("  liver TX date range retained: ",
    format(min_date(df_liver_eligible$TX_DATE)), " to ",
    format(max_date(df_liver_eligible$TX_DATE)), "\n", sep = "")
stopifnot(nrow(df_liver_eligible) > 0)

#--- 6.2 Kidney side: age + listing window ------------------------------------
df_kidpan_raw$INIT_AGE <- suppressWarnings(as.numeric(df_kidpan_raw$INIT_AGE))

df_kidpan_eligible_pre_donty <- df_kidpan_raw |>
  filter(INIT_AGE >= age_min, INIT_AGE <= age_max) |>
  filter(INIT_DATE >= wl_start_date, INIT_DATE <= wl_end_date) |>
  filter(if_all(all_of(SIM_TX_COLS_KIDNEY), is_blank_flag))

# [F10] The donor-type restriction is applied at the PATIENT level, not the row
# level. With KIDNEY_DON_TY_KEEP = c("C", "L") this currently excludes 0 patients
# -- every DON_TY value present in the eligible window is "", "C" or "L", and the
# undocumented "F" code (86 rows file-wide) does not survive the age/date/
# simultaneous-transplant filters above. So this is a no-op on today's data. It is
# written this way anyway, because the row-level version it replaces is WRONG in a
# way that only shows up when the list is narrowed:
#
#   The row-level filter kept any row whose DON_TY was blank -- correctly, since a
#   never-transplanted registration has no donor type and those patients ARE the
#   LTA arm. But patients have multiple registrations. Exclude a donor type at row
#   level and a recipient of that type who also has a plain listing row keeps the
#   blank row, loses their transplant row, and then sails through de-duplication
#   (7.3) as a patient with no TX_DATE at all -- silently RECLASSIFIED as
#   never-transplanted and pooled into the LTA reference rather than excluded.
#
# The scale, if living donors were ever excluded: 6,285 patients in this window
# have a living-donor transplant row plus another row that a row-level filter
# would keep, 5,957 of them via a blank row. That would have contaminated the
# reference arm with thousands of kidney recipients. Hence: any patient with a
# kidney transplant from a donor type NOT in KIDNEY_DON_TY_KEEP is removed
# entirely, decided once, here.
kid_don_ty_chr  <- trimws(as.character(df_kidpan_eligible_pre_donty$DON_TY))
pts_excl_don_ty <- df_kidpan_eligible_pre_donty$PT_CODE[
  !is.na(kid_don_ty_chr) & kid_don_ty_chr != "" &
    !kid_don_ty_chr %in% KIDNEY_DON_TY_KEEP]
pts_excl_don_ty <- unique(pts_excl_don_ty)

df_kidpan_eligible <- df_kidpan_eligible_pre_donty |>
  filter(!PT_CODE %in% pts_excl_don_ty)                              # [C2] [F10]

cat("\n[F10] Kidney donor types admitted: ", paste(KIDNEY_DON_TY_KEEP, collapse = ", "),
    "\n  patients excluded for a disallowed donor type: ", length(pts_excl_don_ty),
    "\n  (excluded at PATIENT level, so none can reappear as never-transplanted)\n",
    sep = "")
cat("  donor types remaining in the eligible frame:\n")
print(table(trimws(as.character(df_kidpan_eligible$DON_TY)), useNA = "ifany"))

# Assertion, not decoration: if a disallowed non-blank donor type survives here,
# the patient-level exclusion above did not do its job and the LTA arm is
# contaminated with kidney recipients.
stopifnot(all(
  trimws(as.character(df_kidpan_eligible$DON_TY)) %in% c("", NA, KIDNEY_DON_TY_KEEP)
))

# [C1] The KDPI filter is DELIBERATELY not here. Toggle it only to reproduce
#      the old, structurally-broken LTA arm.
if (RESTRICT_COHORT_TO_KDPI) {
  df_kidpan_eligible <- df_kidpan_eligible |>
    filter(!is.na(KDPI), trimws(as.character(KDPI)) != "")
  warning("RESTRICT_COHORT_TO_KDPI is TRUE: LTA can contain only >=365d kidney ",
          "recipients. Never-transplanted candidates are excluded.")
}

cat("Kidney rows: raw =", nrow(df_kidpan_raw),
    "| after filters =", nrow(df_kidpan_eligible), "\n")
stopifnot(nrow(df_kidpan_eligible) > 0)


#===============================================================================
# SECTION 7. DE-DUPLICATION -- ONE ROW PER PATIENT, DONE ONCE
#===============================================================================
# This is the single point of truth that the three original de-dup blocks were
# each re-deriving with slightly different inputs.

#--- 7.1 Earliest kidney listing across ALL registrations ---------------------
# Computed before de-duplication so it is not hostage to which row wins.
df_kidney_first_listing <- df_kidpan_eligible |>
  group_by(PT_CODE) |>
  summarise(kidney_first_listing_date = min_date(INIT_DATE), .groups = "drop")

#--- 7.2 Liver: the row tied to the index transplant --------------------------
df_liver_dedup <- df_liver_eligible |>
  group_by(PT_CODE) |>
  slice_min(TX_DATE, n = 1, with_ties = FALSE) |>
  ungroup()

#--- 7.3 Kidney: prefer a transplant row, then a KDPI-bearing row, then earliest
#         TX, then earliest listing.
# [C1] moved the !is.na(KDPI) cohort filter downstream (Sec 6.2), which fixed
# the LTA arm but exposed a new failure mode: a patient with two kidney
# registrations -- one with KDPI, one without -- could have slice(1) pick the
# blank one, silently dropping them from Tables 2/3/KDPI-tiered survival. The
# desc(!is.na(KDPI)) tie-break below (after the transplant preference) fixes
# that. Never-transplanted candidates have no TX_DATE at all, so this tie-break
# never reaches them and the LTA fix from [C1] is unaffected.
df_kidney_dedup <- df_kidpan_eligible |>
  arrange(PT_CODE, desc(!is.na(TX_DATE)), desc(!is.na(KDPI)), TX_DATE, INIT_DATE) |>
  group_by(PT_CODE) |>
  slice(1) |>
  ungroup() |>
  left_join(df_kidney_first_listing, by = "PT_CODE") |>
  rename(
    TX_DATE_KIDNEY     = TX_DATE,
    INIT_DATE_KIDNEY   = INIT_DATE,
    INIT_AGE_KIDNEY    = INIT_AGE,
    WL_ID_CODE_KIDNEY  = WL_ID_CODE,
    TRR_ID_CODE_KIDNEY = TRR_ID_CODE,
    DONOR_ID_KIDNEY    = DONOR_ID,
    DON_TY_KIDNEY      = DON_TY,
    REM_CD_KIDNEY      = REM_CD,
    NUM_PREV_TX_KIDNEY = NUM_PREV_TX,
    DGN_TCR_KIDNEY     = DGN_TCR,
    DGN2_TCR_KIDNEY    = DGN2_TCR,
    TXHRT_KIDNEY = TXHRT, TXINT_KIDNEY = TXINT,
    TXKID_KIDNEY = TXKID, TXLNG_KIDNEY = TXLNG, TXPAN_KIDNEY = TXPAN
  )

# Uniqueness guarantee -- if either of these trips, downstream joins will
# multiply rows and every n in the paper is wrong.
stopifnot(!any(duplicated(df_liver_dedup$PT_CODE)))
stopifnot(!any(duplicated(df_kidney_dedup$PT_CODE)))

# Any remaining name collision would be silently suffixed .x/.y by the join
collisions <- intersect(names(df_liver_dedup), names(df_kidney_dedup))
collisions <- setdiff(collisions, "PT_CODE")
if (length(collisions)) {
  warning("Unrenamed collisions before merge: ", paste(collisions, collapse = ", "))
  print(collisions)
}

#--- 7.4 Dedup-winner audit ---------------------------------------------------
# Confirms the desc(!is.na(KDPI)) tie-break above is doing its job: no patient
# should now lose a KDPI value to a blank row from a different registration.
df_dedup_audit <- df_kidpan_eligible |>
  group_by(PT_CODE) |>
  summarise(n_rows      = n(),
            any_kdpi     = any(!is.na(KDPI)),
            n_kdpi_rows  = sum(!is.na(KDPI)),
            .groups = "drop") |>
  left_join(df_kidney_dedup |> transmute(PT_CODE, winner_has_kdpi = !is.na(KDPI)),
            by = "PT_CODE")

cat("\nDedup-winner KDPI audit (winner_has_kdpi should be TRUE whenever ",
    "any_kdpi is TRUE):\n", sep = "")
print(df_dedup_audit |> count(any_kdpi, winner_has_kdpi))
n_lost_kdpi <- sum(df_dedup_audit$any_kdpi & !df_dedup_audit$winner_has_kdpi)
if (n_lost_kdpi > 0) {
  warning(n_lost_kdpi, " patient(s) still lost a KDPI value at de-duplication. ",
          "Inspect df_dedup_audit and the arrange() tie-break in Sec 7.3.")
} else {
  cat("0 patients lost a KDPI value at de-duplication.\n")
}


#===============================================================================
# SECTION 8. MERGE + KALT CLASSIFICATION
#===============================================================================
df_liver_kidney <- df_liver_dedup |>
  left_join(df_kidney_dedup, by = "PT_CODE") |>
  mutate(
    days_liver_to_kidney_tx = as.numeric(TX_DATE_KIDNEY - TX_DATE),
    KALT_STATUS_CALC = case_when(
      is.na(TX_DATE_KIDNEY)                                        ~ 0L,  # listed, no kidney TX
      days_liver_to_kidney_tx >= 0 & days_liver_to_kidney_tx < 365  ~ 1L,  # KALT
      days_liver_to_kidney_tx >= 365                                ~ 2L,  # late kidney TX
      days_liver_to_kidney_tx <  0                                  ~ 3L,  # kidney before liver
      TRUE                                                          ~ NA_integer_
    ),
    KALT_STATUS = recode(
      as.character(KALT_STATUS_CALC),
      "0" = "Kidney listed, no kidney TX",
      # [K1] Both of these are KALT under KALT_MAX_DAYS = Inf; the labels
      # describe the TIMING stratum, not two different exposure groups.
      "1" = "KALT, kidney <365 days after liver TX",
      "2" = "KALT, kidney >=365 days after liver TX",
      "3" = "Kidney TX before liver TX"
    )
  )

cat("\nKALT status distribution (pre-cohort-restriction):\n")
print(df_liver_kidney |> count(KALT_STATUS_CALC, KALT_STATUS))


#===============================================================================
# SECTION 9. LDRI (Feng et al. 2006, Am J Transplant 6:783-790)
#===============================================================================
LDRI_VAL_COL <- c("AGE_DON", "ETHCAT_DON", "HGT_CM_DON_CALC", "COD_CAD_DON",
                  "SHARE_TY", "NON_HRT_DON", "LITYP", "COLD_ISCH")

df_ldri_complete <- df_liver_eligible |>
  filter(if_all(all_of(LDRI_VAL_COL), ~ !is.na(.) & trimws(as.character(.)) != ""))

cat("\nLDRI: dropped for incomplete components =",
    nrow(df_liver_eligible) - nrow(df_ldri_complete), "of", nrow(df_liver_eligible), "\n")

df_ldri_scored <- df_ldri_complete |>
  mutate(
    AGE_DON         = as.numeric(AGE_DON),
    HGT_CM_DON_CALC = as.numeric(HGT_CM_DON_CALC),
    COLD_ISCH       = as.numeric(COLD_ISCH),
    
    # Age (reference: <40)
    age_component = case_when(
      AGE_DON >= 40 & AGE_DON < 50 ~ 0.154,
      AGE_DON >= 50 & AGE_DON < 60 ~ 0.274,
      AGE_DON >= 60 & AGE_DON < 70 ~ 0.424,
      AGE_DON >= 70                ~ 0.501,
      TRUE                         ~ 0
    ),
    # Cause of death (reference: trauma). ASSUMED 1=Anoxia 2=CVA 3=Trauma
    cod_component = case_when(
      COD_CAD_DON == 1 ~ 0.079,
      COD_CAD_DON == 2 ~ 0.145,
      COD_CAD_DON == 3 ~ 0,
      TRUE             ~ 0.184
    ),
    # Race (reference: White). ASSUMED 1=White 2=Black
    race_component = case_when(
      ETHCAT_DON == 1 ~ 0,
      ETHCAT_DON == 2 ~ 0.176,
      TRUE            ~ 0.126
    ),
    dcd_component = if_else(toupper(trimws(as.character(NON_HRT_DON))) == "Y", 0.411, 0),
    
    # [C4] Partial/split. Reference set = LITYP_WHOLE_CODES (Section 1).
    # The !is.na branch also catches out-of-dictionary codes (e.g. 998, the
    # Unknown bucket), scoring them as split. The guard below reports them.
    # The NA branch is unreachable -- df_ldri_complete already dropped NA and
    # blank LITYP -- and is kept only so the mapping is total.
    split_component = case_when(
      LITYP %in% LITYP_WHOLE_CODES ~ 0,
      !is.na(LITYP)                ~ 0.422,
      TRUE                         ~ NA_real_
    ),
    
    height_component = 0.066 * ((170 - HGT_CM_DON_CALC) / 10),
    
    # Sharing (reference: local). ASSUMED 3=Local 4=Regional 5=National
    share_component = case_when(
      SHARE_TY == 3 ~ 0,
      SHARE_TY == 4 ~ 0.105,
      SHARE_TY == 5 ~ 0.244,
      TRUE          ~ 0
    ),
    cit_component = 0.010 * COLD_ISCH,
    
    LDRI = exp(age_component + cod_component + race_component + dcd_component +
                 split_component + height_component + share_component + cit_component)
  )

#--- 9b [C4] Guard the LITYP whole-liver mapping -------------------------------
# LITYP_WHOLE_CODES is the single highest-leverage constant in the LDRI block:
# get it wrong and every affected LDRI moves by exp(0.422) = 1.53x, silently,
# in the exposure itself. These checks make that failure loud.
stopifnot(any(df_ldri_scored$LITYP %in% LITYP_WHOLE_CODES))

pct_whole <- mean(df_ldri_scored$split_component == 0)
cat(sprintf("\nLITYP: %.1f%% whole liver, %.1f%% partial/split (expect ~90%% whole).\n",
            100 * pct_whole, 100 * (1 - pct_whole)))
if (pct_whole < 0.5) {
  warning("Only ", sprintf("%.1f%%", 100 * pct_whole), " whole livers -- ",
          "LITYP_WHOLE_CODES (Section 1) is probably inverted.")
}

unknown_lityp <- setdiff(unique(df_ldri_scored$LITYP), 0:21)
if (length(unknown_lityp)) {
  warning("LITYP codes outside the 0-21 dictionary range, scored as split: ",
          paste(sort(unknown_lityp), collapse = ", "))
}

df_ldri_final <- df_ldri_scored |>
  group_by(PT_CODE) |>
  slice_min(TX_DATE, n = 1, with_ties = FALSE) |>   # one LDRI per patient
  ungroup() |>
  select(PT_CODE, LDRI, age_component, cod_component, race_component,
         dcd_component, split_component, height_component, share_component,
         cit_component)

cat("\nLDRI distribution (expect roughly 0.8 - 3.5; wild values = bad code mapping):\n")
print(summary(df_ldri_final$LDRI))

p_ldri <- ggplot(df_ldri_final, aes(x = LDRI)) +
  geom_histogram(bins = 30) +
  labs(title = "Distribution of LDRI scores", x = "LDRI", y = "Count") +
  theme_classic()
print(p_ldri)


#===============================================================================
# SECTION 10. ANALYTIC COHORT + ALL DERIVED LABELS
#===============================================================================
# Built ONCE. Tables 1, 2 and 3 and the survival analysis are all views onto
# this frame -- no parallel re-extraction anywhere.

df_esrd_cohort <- df_liver_kidney |>
  left_join(df_ldri_final |> select(PT_CODE, LDRI), by = "PT_CODE") |>
  # Deceased-donor HCV (HEP_C_ANTI_DON) lives in deceased_donor_data, keyed by
  # DONOR_ID -- joined here so recip_hcv_label/donor_hcv_label can be built
  # below alongside every other recipient/donor label. Living-donor HCV
  # (HCV_ANTIBODY_DON) needs no separate join: it is already a column on
  # df_liver_kidney via KIDPAN_COLS (Section 3).
  left_join(df_donor_raw |> select(DONOR_ID, HEP_C_ANTI_DON) |>
              distinct(DONOR_ID, .keep_all = TRUE),
            by = c("DONOR_ID_KIDNEY" = "DONOR_ID")) |>
  filter(!is.na(INIT_DATE_KIDNEY)) |>      # must have been listed for kidney (= ESRD)
  filter(KALT_STATUS_CALC != 3) |>         # drop kidney-before-liver
  mutate(
    #--- Grouping ------------------------------------------------------------
    # [F7] TWO grouping variables, and it matters which one an analysis uses.
    #
    # Group (binary) is the EXPOSURE: KALT vs LTA, defined by is_kalt() and
    # therefore by KALT_MAX_DAYS ([K1], Section 1.3). With KALT_MAX_DAYS = Inf
    # both timing strata are KALT, so:
    #   - "KALT" = received a kidney after their liver transplant, ANY interval
    #   - "LTA"  = TRUE liver-transplant-alone; listed for a kidney, never
    #              received one. The arm now means what its name says.
    #
    # Group3 is Group with the KALT arm SPLIT BY TIMING. It is a
    # sub-stratification of the exposure, not a competing definition of it:
    #   LTA (no kidney)  ==  Group "LTA"
    #   KALT (<1 y) + KALT (>=1 y)  ==  Group "KALT"
    # so the two variables always agree and `count(Group, Group3)` is block
    # diagonal. Section 11 [1] asserts this.
    #
    # Use Group3 for anything descriptive -- the two timing strata are not
    # exchangeable (crude mortality 35.5% of the never-transplanted vs 10.0%
    # of the <1-year and 14.5% of the >=1-year recipients, though see
    # [K2] on why that raw contrast is not a treatment effect). Use Group where
    # a two-arm contrast is structurally required: Section 21's matchit()
    # treatment, and Section 24's Block 3 summary HR.
    #
    # [K2] NEITHER VARIABLE IS A TIME-VARYING STATE. A patient in the KALT arm
    # was not KALT on the day of their liver transplant -- a >=1-year recipient
    # spends a median 4.0 years unexposed first. Any survival clock anchored at
    # liver transplant must therefore let patients ENTER the exposed state on
    # their kidney-TX date (Section 21b's Simon-Makuch expansion, Section 24's
    # time-varying Table 4, Section 21b.5's time-varying Cox). Stratifying a
    # KM on
    # this variable from t=0 fabricates a 14.5-point survival advantage; see
    # [K2] in Section 1.3 for the full arithmetic.
    #
    # The >=1-year level is deliberately last so Group3's first level
    # ("LTA (no kidney)") is the reference in any model.
    Group3 = factor(case_when(
      KALT_STATUS_CALC == 0 ~ "LTA (no kidney)",
      KALT_STATUS_CALC == 1 ~ "KALT (<1 y)",
      KALT_STATUS_CALC == 2 ~ "KALT (≥1 y)",
      TRUE                  ~ NA_character_
    ), levels = c("LTA (no kidney)", "KALT (<1 y)", "KALT (≥1 y)")),

    Group = factor(if_else(is_kalt(days_liver_to_kidney_tx), "KALT", "LTA"),
                   levels = c("LTA", "KALT")),

    #--- KDPI ----------------------------------------------------------------
    KDPI_num = kdpi_to_pct(KDPI),
    KDPI_cat = cut(KDPI_num, breaks = KDPI_BREAKS, labels = KDPI_LABELS,
                   right = TRUE),
    
    #--- Kidney donor type ---------------------------------------------------
    kidney_donor_type = case_when(
      toupper(trimws(as.character(DON_TY_KIDNEY))) == "L" ~ "Living",
      toupper(trimws(as.character(DON_TY_KIDNEY))) == "C" ~ "Deceased",
      TRUE ~ NA_character_
    ),
    
    #--- HCV serostatus, recipient and donor (SERSTAT-coded, Section 2) ------
    # Donor source differs by donor type: HCV_ANTIBODY_DON (kidpan_data)
    # for living donors, HEP_C_ANTI_DON (deceased_donor_data, joined above)
    # for deceased donors -- deceased_donor_data has no living-donor rows at
    # all, so there is no risk of the two sources colliding for one patient.
    recip_hcv_label = factor(serstat_to_label(HCV_SEROSTATUS), levels = c("No", "Yes")),
    donor_hcv_label = factor(case_when(
      kidney_donor_type == "Living"   ~ serstat_to_label(HCV_ANTIBODY_DON),
      kidney_donor_type == "Deceased" ~ serstat_to_label(HEP_C_ANTI_DON),
      TRUE ~ NA_character_
    ), levels = c("No", "Yes")),
    
    #--- Continuous ----------------------------------------------------------
    AGE                       = as.numeric(AGE),
    BMI_CALC                  = as.numeric(BMI_CALC),
    FINAL_MELD_PELD_LAB_SCORE = as.numeric(FINAL_MELD_PELD_LAB_SCORE),
    
    # [C6] ESRD onset date
    esrd_date = if (identical(ESRD_DATE_SOURCE, "first_listing"))
      kidney_first_listing_date else INIT_DATE_KIDNEY,
    years_to_esrd    = as.numeric(esrd_date - TX_DATE) / 365.25,
    waiting_time_yrs = as.numeric(TX_DATE_KIDNEY - INIT_DATE_KIDNEY) / 365.25,
    olt_to_kalt_yrs  = days_liver_to_kidney_tx / 365.25,
    
    HLAMIS       = suppressWarnings(as.numeric(HLAMIS)),
    cold_isch_hr = suppressWarnings(as.numeric(COLD_ISCH_KI)),
    
    #--- Sex -----------------------------------------------------------------
    sex_label = factor(case_when(
      toupper(trimws(as.character(GENDER))) == "M" ~ "Male",
      toupper(trimws(as.character(GENDER))) == "F" ~ "Female",
      TRUE ~ NA_character_
    ), levels = c("Female", "Male")),
    
    #--- Recipient race/ethnicity --------------------------------------------
    race_label = factor(case_when(
      ETHCAT == 1 ~ "White",
      ETHCAT == 2 ~ "Black/African American",
      ETHCAT == 4 ~ "Hispanic/Latino",
      ETHCAT == 5 ~ "Asian",
      ETHCAT %in% c(6, 7, 9) ~ "Other",
      TRUE ~ NA_character_
    ), levels = c("Asian", "Black/African American", "Hispanic/Latino",
                  "White", "Other")),
    
    #--- Recipient diabetes --------------------------------------------------
    diab_label = factor(case_when(
      DIAB == 1 ~ "No",
      DIAB %in% c(2, 3, 4, 5) ~ "Yes",
      TRUE ~ NA_character_
    ), levels = c("No", "Yes")),
    
    #--- Dialysis at kidney listing ------------------------------------------
    dialysis_label = factor(case_when(
      toupper(trimws(as.character(ON_DIALYSIS))) == "Y" ~ "Yes",
      toupper(trimws(as.character(ON_DIALYSIS))) == "N" ~ "No",
      TRUE ~ NA_character_
    ), levels = c("No", "Yes")),
    
    #--- Kidney donor comorbidities (from kidpan_data) -----------------------
    htn_don_label = factor(case_when(
      toupper(trimws(as.character(HIST_HYPERTENS_DON))) == "Y" ~ "Yes",
      toupper(trimws(as.character(HIST_HYPERTENS_DON))) == "N" ~ "No",
      TRUE ~ NA_character_
    ), levels = c("No", "Yes")),
    
    # numeric-coded: 1=No, 2-5=Yes/type, 998=Unknown (NOT Y/N like hypertension)
    diab_don_label = factor(case_when(
      suppressWarnings(as.numeric(HIST_DIABETES_DON)) == 1 ~ "No",
      suppressWarnings(as.numeric(HIST_DIABETES_DON)) %in% c(2, 3, 4, 5) ~ "Yes",
      TRUE ~ NA_character_
    ), levels = c("No", "Yes")),
    
    #--- LDRI category -------------------------------------------------------
    LDRI_cat = cut(LDRI, breaks = LDRI_BREAKS, labels = LDRI_LABELS, right = TRUE),
    
    #--- Etiology of liver failure (DGN_TCR, liver file) ---------------------
    liver_etiology = factor(case_when(
      DGN_TCR %in% c(4100, 4101, 4102, 4103, 4104, 4105,
                     4106, 4107, 4108, 4110) ~ "Acute hepatic necrosis",
      DGN_TCR %in% c(4270, 4271, 4272, 4275) ~ "Biliary atresia",
      DGN_TCR %in% c(4220, 4230, 4231, 4235, 4240, 4241, 4242, 4245,
                     4250, 4255, 4260, 4264, 4265, 4290) ~ "Cholestatic liver disease",
      DGN_TCR %in% c(4280, 4285) ~ "Congenital",
      DGN_TCR %in% c(4400, 4401, 4402, 4403, 4404, 4405,
                     4410, 4420, 4430) ~ "Malignant neoplasm",
      DGN_TCR %in% c(4300, 4301, 4302, 4303, 4304, 4305,
                     4306, 4307, 4308, 4315) ~ "Metabolic disease",
      DGN_TCR %in% c(4200, 4201, 4202, 4203, 4204, 4205, 4206, 4207,
                     4208, 4209, 4210, 4212, 4213, 4214, 4215, 4216,
                     4217, 4218, 4219, 4221, 4222,
                     4592, 4593) ~ "Non-cholestatic liver disease",
      DGN_TCR %in% c(999, 4500, 4510, 4520, 4597, 4598) ~ "Other",
      TRUE ~ NA_character_
    ), levels = c("Acute hepatic necrosis", "Biliary atresia",
                  "Cholestatic liver disease", "Congenital", "Malignant neoplasm",
                  "Metabolic disease", "Non-cholestatic liver disease", "Other")),
    
    #--- Etiology of ESRD (DGN_TCR_KIDNEY, kidney file) ----------------------
