#--- 2.1 Tolerant SAS reader --------------------------------------------------
# Both original scripts used col_select = all_of(cols), which throws a hard
# error if a single assumed column name is absent -- and these scripts are full
# of assumed names. This version reports what is missing and proceeds.
read_sas_cols <- function(file_path, cols = NULL, verbose = TRUE, label = NULL) {
  path <- path.expand(file_path)
  if (!file.exists(path)) stop("File not found: ", path)
  
  available <- names(haven::read_sas(path, n_max = 0))
  
  if (is.null(cols)) {
    keep <- available
    missing <- character(0)
  } else {
    keep    <- intersect(cols, available)
    missing <- setdiff(cols, available)
  }
  
  dat <- as.data.frame(haven::read_sas(path, col_select = dplyr::all_of(keep)))
  
  if (verbose) {
    cat("\n", strrep("-", 70), "\n", sep = "")
    cat("READ: ", if (is.null(label)) basename(path) else label, "\n", sep = "")
    cat("  rows x cols : ", paste(dim(dat), collapse = " x "), "\n", sep = "")
    if (length(missing)) {
      cat("  !! REQUESTED BUT ABSENT (", length(missing), "): ",
          paste(missing, collapse = ", "), "\n", sep = "")
      cat("     -> fix these names against the data dictionary; anything\n")
      cat("        downstream that references them will be all-NA.\n")
    }
  }
  attr(dat, "missing_cols") <- missing
  dat
}

# Backwards-compatible alias so old snippets still run
sas_to_array <- function(file_path, verbose = FALSE, cols = NULL) {
  read_sas_cols(file_path, cols = cols, verbose = verbose)
}

#--- 2.2 Blank test for the simultaneous-transplant flags ----------------------
# TXHRT/TXINT/TXKID/TXLNG/TXPAN may be stored as character ("Y"/"") or numeric
# (1/0/NA) depending on SAF release. trimws(0) == "0", not "", so a naive blank
# test silently deletes the ENTIRE cohort when these are numeric. Section 10
# prints the observed classes and values so you can confirm.
is_blank_flag <- function(x) {
  chr <- trimws(as.character(x))
  is.na(x) | chr == "" | chr == "."
}

#--- 2.2b KALT exposure test ---------------------------------------------------
# THE SINGLE DEFINITION OF THE EXPOSURE. Both places that build `Group`
# (Section 10 for the main cohort, Section 29.2 for the waitlist-era cohort)
# call this, so the two can never drift apart and KALT_MAX_DAYS ([K1],
# Section 1.3) is the only knob.
#
# Takes the interval in days rather than KALT_STATUS_CALC so that any cutoff
# works, not just the 365-day boundary the status codes happen to encode.
# NA (never transplanted) is FALSE, not NA -- a patient with no kidney is
# definitively not KALT, and returning NA here would silently propagate an
# unusable third level into `Group`.
is_kalt <- function(days_liver_to_kidney_tx, max_days = KALT_MAX_DAYS) {
  d <- suppressWarnings(as.numeric(days_liver_to_kidney_tx))
  !is.na(d) & d >= 0 & d < max_days
}

#--- 2.3 KDPI scaling ---------------------------------------------------------
kdpi_to_pct <- function(x, scale = KDPI_SCALE, announce = TRUE) {
  num <- suppressWarnings(as.numeric(x))
  if (identical(scale, "auto")) {
    mx <- suppressWarnings(max(num, na.rm = TRUE))
    scale <- if (is.finite(mx) && mx <= 1.5) "fraction" else "percent"
    if (announce) {
      message("KDPI scale auto-detected as '", scale, "' (observed max = ",
              round(mx, 4), "). Override with KDPI_SCALE if wrong.")
    }
  }
  if (identical(scale, "fraction")) num * 100 else num
}

#--- 2.4 Safe extrema over dates ---------------------------------------------
# base min()/max() with na.rm return -Inf/Inf on all-NA input and can drop the
# Date class. These always return a proper Date (NA when there is nothing).
min_date <- function(x) {
  x <- x[!is.na(x)]
  if (!length(x)) as.Date(NA) else min(x)
}

max_date <- function(x) {
  x <- x[!is.na(x)]
  if (!length(x)) as.Date(NA) else max(x)
}

#--- 2.5 Survival helpers -----------------------------------------------------
km_at <- function(fit, label, times = REPORT_TIMES) {
  s <- summary(fit, times = times, extend = TRUE)
  tibble(
    endpoint = label,
    stratum  = if (is.null(s$strata)) "Overall" else as.character(s$strata),
    time_d   = s$time,
    n_risk   = s$n.risk,
    n_event  = s$n.event,
    surv     = paste0(round(100 * s$surv, 1), "% (",
                      round(100 * s$lower, 1), "-", round(100 * s$upper, 1), ")")
  )
}

lr_p <- function(formula, data) {
  sd <- survdiff(formula, data = data)
  signif(1 - pchisq(sd$chisq, length(sd$n) - 1), 3)
}

# Standard clinical-table p-value formatting: fixed decimal notation, never
# scientific. p < 0.001 -> "<0.001" (extremely small p-values, e.g. 3.6e-36
# from a large-n log-rank/Cox test, are not more informative printed to more
# digits, and "3.60e-36" reads as a typo in a manuscript table regardless).
# 0.001 <= p < 0.01 gets 3 decimals so it doesn't round to "0.00"; everything
# >= 0.01 gets the conventional 2 decimals used in Tables 1-4 throughout this
# pipeline.
fmt_p <- function(p) {
  dplyr::case_when(
    is.na(p)  ~ NA_character_,
    p < 0.001 ~ "<0.001",
    p < 0.01  ~ sprintf("%.3f", p),
    TRUE      ~ sprintf("%.2f", p)
  )
}

# OPTN SERSTAT coding (verified): P = Positive, N = Negative; C (Cannot
# Disclose), I (Indeterminate/Equivocal), ND (Not Done), PD (Pending), U
# (Unknown), and missing all collapse to NA -- none of these mean "negative,"
# and treating them as such would understate true positivity. Used for both
# recipient (HCV_SEROSTATUS) and donor (HCV_ANTIBODY_DON, HEP_C_ANTI_DON)
# serostatus fields, which all share this coding.
serstat_to_label <- function(x) {
  x <- toupper(trimws(as.character(x)))
  dplyr::case_when(
    x == "P" ~ "Yes",
    x == "N" ~ "No",
    TRUE ~ NA_character_
  )
}

# Fits a Cox model while catching (quasi-)complete separation -- the failure
# mode where a covariate level has zero events on one side, so the partial
# likelihood is monotone and the "coefficient" coxph reports has actually
# diverged to +-Inf rather than converged. This produces exactly the kind of
# output that LOOKS like a number (e.g. an HR of 3e7, or exactly 0, with a
# p-value near 1 and a CI touching 0 or Inf) but is not a real estimate and
# will not become one by rounding or reformatting -- it has to be caught and
# reported honestly (as "not estimable") instead.
#
# coxph already detects this internally and emits a specific warning
# ("Loglik converged before variable X; coefficient may be infinite"); rather
# than re-implementing that detection with a magnitude heuristic, this
# intercepts coxph's own warning and parses out exactly which term(s) it
# flagged.
fit_coxph_checked <- function(formula, data, label = "") {
  flagged_idx <- integer(0)
  fit <- withCallingHandlers(
    coxph(formula, data = data),
    warning = function(w) {
      msg <- conditionMessage(w)
      if (grepl("coefficient may be infinite|beta may be infinite", msg)) {
        nums <- regmatches(msg, gregexpr("[0-9]+", msg))[[1]]
        flagged_idx <<- c(flagged_idx, as.integer(nums))
      }
      invokeRestart("muffleWarning")
    }
  )
  # Same fix as supp1_km_block (Section 23): fit$call$formula/$data otherwise
  # hold the unresolvable SYMBOLS `formula`/`data` -- this function's own
  # argument names -- which cox.zph(), ggsurvplot(), etc. cannot look up once
  # this function has returned. Replacing them with the already-evaluated
  # objects fixes this without changing anything about the fitted model.
  fit$call$formula <- formula
  fit$call$data <- data
  coef_names <- names(coef(fit))
  flagged_terms <- if (length(flagged_idx)) coef_names[flagged_idx] else character(0)

  # coxph's own warning is a heuristic and does not fire for every case of
  # (quasi-)complete separation -- e.g. when it "runs out of iterations"
  # before ever emitting the per-term "beta may be infinite" message, or
  # several terms diverge in the same fit. A magnitude-based fallback catches
  # what the warning misses: a coefficient (or its SE) that has diverged
  # produces |coef| or SE far outside anything a real hazard ratio takes
  # (exp(10) ~= 22,000), so anything past that is separation, not a real
  # estimate, regardless of whether coxph's own message caught it.
  coefs <- coef(fit)
  ses   <- sqrt(diag(vcov(fit)))
  extreme_terms <- coef_names[!is.finite(coefs) | !is.finite(ses) |
                              abs(coefs) > 10 | ses > 10]
  flagged_terms <- union(flagged_terms, extreme_terms)

  if (length(flagged_terms)) {
    warning("[", label, "] (Quasi-)complete separation detected for: ",
            paste(flagged_terms, collapse = ", "),
            " -- these terms will be reported as not estimable (NE) rather ",
            "than as the divergent coefficient coxph actually returned. ",
            "This means a covariate level has zero events on one side; check ",
            "the event-count diagnostic printed just above this model.")
  }
  list(fit = fit, separation_terms = flagged_terms)
}

# Death-censored graft survival. A patient who dies with a functioning graft is
# CENSORED at death, not counted as an event.
# [C5] Uses class-preserving indexing instead of as.Date(ifelse(...)).
make_endpoint <- function(data, origin, event_date, death_censor = TRUE,
                          study_end = STUDY_END) {
  t0    <- data[[origin]]
  ev    <- data[[event_date]]
  dth   <- if (death_censor) data$death_date else rep(as.Date(NA), nrow(data))
  lastf <- data$last_fu_date

  # [F1] A known death is itself proof of follow-up THROUGH that date. Without
  # the pmax below, a patient whose death date postdates their last follow-up
  # form is censored at the stale form, and any graft failure recorded between
  # the two is discarded. The pmin with study_end is unchanged, so a death
  # after the administrative censoring date is still a censoring, not an event.
  fu_end <- pmax(lastf, dth, na.rm = TRUE)
  cens   <- pmin(dth, fu_end, rep(study_end, nrow(data)), na.rm = TRUE)

  had_event <- !is.na(ev) & !is.na(t0) & ev > t0 & (is.na(cens) | ev <= cens)
  had_event[is.na(had_event)] <- FALSE
  
  stop_date <- cens
  stop_date[had_event] <- ev[had_event]
  
  tibble(time  = as.numeric(stop_date - t0),
         event = as.integer(had_event))
}

# Patient survival: death IS the event, so nothing is censored at death.
make_patient_endpoint <- function(data, origin, study_end = STUDY_END) {
  t0    <- data[[origin]]
  dth   <- data$death_date
  lastf <- data$last_fu_date

  # [F1] Same correction as make_endpoint above, and it bites harder here
  # because the event IS death: with cens = pmin(lastf, study_end), any death
  # recorded after the last follow-up form failed the `dth <= cens` test below
  # and the patient was censored ALIVE at the stale form. In this cohort that
  # silently discarded 119 LTA deaths (9.5% of all LTA deaths) and 0 KALT
  # deaths -- LTA patients reach ESRD years after their liver transplant and
  # are then followed by the kidney program, so their liver-side form is the
  # one that goes stale. The bias was therefore entirely one-armed, and in the
  # direction that flatters LTA survival.
  fu_end <- pmax(lastf, dth, na.rm = TRUE)
  cens   <- pmin(fu_end, rep(study_end, nrow(data)), na.rm = TRUE)

  had_event <- !is.na(dth) & !is.na(t0) & dth > t0 & (is.na(cens) | dth <= cens)
  had_event[is.na(had_event)] <- FALSE
  
  stop_date <- cens
  stop_date[had_event] <- dth[had_event]
  
  tibble(time  = as.numeric(stop_date - t0),
         event = as.integer(had_event))
}


#--- 2.6 KM figure post-processing --------------------------------------------
# ggsurvplot() draws the risk-table entries with geom_text centred on each x
# break. With axes.offset = FALSE the panel now ends exactly AT the first and
# last break, so half of each outermost value falls outside the panel and is
# clipped away. survminer already nudges the time-0 column inward by
# max(xlim)/30 when axes.offset = FALSE, but it does nothing for the final
# column, which is the one that visibly loses digits.
#
# Fix: turn clipping off for the TABLE ONLY -- the curve panel keeps
# clip = "on" so no step line or confidence ribbon is drawn past xlim -- and
# give both panels the SAME left/right plot margin. Equal margins matter: the
# two panels are aligned by width when the figure is assembled, so padding one
# and not the other would knock the risk-table columns out of register with
# the x-axis above them.
km_pad_risk_table <- function(g, xlim, pad_pt = KM_TABLE_PAD_PT) {
  m <- ggplot2::margin(t = 5.5, r = pad_pt, b = 5.5, l = pad_pt, unit = "pt")
  g$plot <- g$plot + theme(plot.margin = m)
  if (!is.null(g$table)) {
    # This intentionally replaces the coord_cartesian(xlim = xlim) survminer
    # already put on the table -- same xlim, clipping off -- so ggplot's
    # "replacing the existing coordinate system" message is expected and
    # muffled rather than printed once per figure. Passing xlim through
    # unchanged is what keeps the table in register with the curve panel.
    g$table <- suppressMessages(
      g$table + coord_cartesian(xlim = xlim, clip = "off")
    ) + theme(plot.margin = m)
  }
  g
}

# survminer derives its default p-value coordinate from the fitted survival
# range. Under the old ylim = c(40, 100) that coordinate fell BELOW the window
# and the annotation was silently dropped from every figure; under a 0-100
# window it lands on top of the x-axis. Both are fixed by placing it
# explicitly in the empty bottom-left corner.
km_pval_coord        <- function(xlim, ylim = KM_YLIM) {
  c(0.02 * diff(xlim), ylim[1] + 0.06 * diff(ylim))
}
km_pval_method_coord <- function(xlim, ylim = KM_YLIM) {
  c(0.02 * diff(xlim), ylim[1] + 0.13 * diff(ylim))
}


