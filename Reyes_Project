STUDY_END     <- as.Date("2026-04-03")   # administrative censoring date

# [F9] LIVER-TRANSPLANT ERA FLOOR. Until now the only date window in this
# pipeline was on the KIDNEY listing (wl_start_date/wl_end_date); the liver
# transplant itself was unrestricted, so the cohort contained liver transplants
# from 1988 onward -- a 38-year span -- and OLT-to-kidney intervals up to 37
# years. That is not "kidney after liver transplantation" in any clinically
# coherent sense, and it loaded the late-kidney group with patients whose liver
# transplant predates modern immunosuppression, allocation and MELD-era practice.
#
# The floor is a CALENDAR era restriction anchored at the end of the kidney
# listing window, parallel to how wl_start_date/wl_end_date bound the kidney
# side. It is not a per-patient cap on the OLT-to-kidney interval -- that would
# make eligibility depend on the kidney listing date, which is downstream of the
# exposure, and would be a different (and harder to justify) design.
#
# No upper bound is needed: liver transplants cannot postdate STUDY_END.
#
# EFFECT, for reference: a 20-year floor (2005-04-03) drops 645 of 5,072
# patients -- 296 never-transplanted and 349 late-kidney recipients, and ZERO
# KALT patients. The KALT arm is structurally immune, since a patient listed for
# a kidney in 2017 or later whose kidney arrived within a year of their liver
# transplant must have been transplanted around 2016 or later anyway. So this
# filter acts almost entirely on the comparison arms, and it removes exactly the
# long-interval patients that make the pooled "LTA" label incoherent.
LT_LOOKBACK_YEARS <- 20
lt_start_date     <- wl_end_date - years(LT_LOOKBACK_YEARS)   # 2005-04-03

#--- 1.3 Analytic switches ----------------------------------------------------

# [K1] WHAT COUNTS AS "KALT" -- the exposure definition for the whole pipeline.
#
# Maximum liver-TX-to-kidney-TX interval, in days, for a kidney transplant to
# count as KALT. Every `Group` assignment in this file derives from this
# constant via is_kalt() (Section 2), so it is the ONE place the exposure is
# defined.
#
#   Inf = CURRENT SETTING. KALT means "kidney after liver transplant at ANY
#         interval". KALT_STATUS_CALC 1 (<365 d) and 2 (>=365 d) are ONE
#         category, and the comparator arm `LTA` is therefore TRUE LTA --
#         patients who were listed for a kidney and never received one.
#   365 = previous behaviour. Only <365-day recipients were KALT, and the
#         "LTA" arm pooled the 2,140 never-transplanted patients with the 1,467
#         >=1-year recipients -- i.e. "LTA" was false for 41% of that arm.
#
# WHY THIS CHANGED. The pooled comparator was incoherent: it was labelled
# "liver transplant alone" while containing patients who did receive a kidney,
# and their post-kidney survival was credited to the untransplanted arm. Merging
# on the exposure side instead of the comparator side makes both arms mean what
# they say.
#
# [K2] THE TRAP THIS SETTING OPENS, AND HOW THE PIPELINE AVOIDS IT.
# Widening KALT to any interval is ONLY safe because the time-to-event analyses
# treat the exposure as TIME-VARYING.
#
# ALL FIGURES BELOW WERE RECOMPUTED FROM THIS PIPELINE'S OWN OUTPUT (cohort
# n = 4,347: 2,140 LTA / 740 KALT <1 y / 1,467 KALT >=1 y). Earlier drafts of
# this block carried numbers from a superseded cohort build (2,476 / 1,850,
# median 2,276 d); those were stale and are gone. If you change
# LT_LOOKBACK_YEARS, the eligibility filters, or KALT_MAX_DAYS, RE-DERIVE these
# rather than trusting them -- that is exactly how the previous set went wrong.
#
# A >=1-year recipient waits a median 1,467 days (4.0 years, IQR 1.5-9.0) for
# their kidney; 67.5% of their post-liver-TX follow-up precedes it, and 0 of
# their 213 deaths occur before it -- necessarily, since you must be alive to be
# transplanted. Labelling them KALT from time zero on a liver-TX clock injects
# ~8,385 event-free person-years into the KALT arm and manufactures a
# 14.5-point 5-year survival advantage (78.4% vs 92.9%, p<0.001) out of what the
# old <365-day definition showed as a null (85.6% vs 87.5%, p=0.19).
#
# Measured directly in the matched cohort (Section 21b/34), the same artifact
# moves the patient-survival HR from 0.29 (0.24-0.37) under a fixed label to
# 0.71 (0.49-1.03) for KALT <1 y and 0.81 (0.58-1.14) for KALT >=1 y once the
# clock is handled correctly -- i.e. from a spectacular "71% mortality
# reduction" to two estimates whose confidence intervals both cross 1.
#
# So: `Group` is a BASELINE STRATUM (who is in which arm), never a statement
# that the patient held that status from day 0. Anything that puts KALT on a
# survival clock anchored at liver transplant MUST let patients enter the
# exposed state on their actual kidney-TX date. Section 24's Table 4 does this
# with TABLE4_LATE_TX_TIME_VARYING, and Section 21b.5 is the pair-stratified
# time-varying Cox.
#
# THE ONE SANCTIONED EXCEPTION is Figures 7-9, which ARE fixed-label KM curves
# on the liver-TX clock -- because Section 21 first restricts that analysis to
# KALT <1 y vs true LTA ([K3]), where the unexposed window is a median 250 days
# rather than 4 years. Do not add a fixed-label KM on the liver-TX clock for the
# MERGED KALT arm; that is the construction [K2] exists to forbid.
KALT_MAX_DAYS <- Inf

# TRUE  = old behaviour: cohort membership requires a non-missing KDPI, which
#         means everyone in the cohort received a deceased-donor kidney and the
#         LTA arm can only contain late (>=365d) kidney recipients.
# FALSE = corrected: KDPI is required only where KDPI is actually analysed.
RESTRICT_COHORT_TO_KDPI <- FALSE

# Which kidney donor types may enter the cohort. "C" = deceased, "L" = living.
# Old script effectively allowed only "C". LD-KALT patients are real KALT
# patients, so both are kept.
#
# [F10] Living donors ARE included in the cohort. They have no KDPI, so they
# cannot be placed in a kidney-quality tier and are absent from anything that
# tiers on KDPI (Table 2, the KDPI-stratified curves, Section 29's columns) --
# but they have their own dedicated LD-KALT column in Table 3, and excluding
# them from the cohort outright would discard real kidney-after-liver patients
# to tidy up a reconciliation. Where a specific table needs them gone, it says
# so at that table: Section 25's Table 5 excludes them explicitly ([F5]),
# because its whole axis is kidney quality.
#
# The DONOR-TYPE RESTRICTION IS APPLIED AT THE PATIENT LEVEL in Section 6.2, not
# the row level. With both types admitted that exclusion currently matches 0
# patients, so it is a no-op on today's data -- but it is the correct structure
# rather than a decorative one, and Section 6.2 explains the failure mode it
# prevents. Narrowing this list to "C" would make it load-bearing immediately.
KIDNEY_DON_TY_KEEP <- c("C", "L")

# Population shown in Table 2 (deceased-donor kidney characteristics by KDPI
# tier).
#   "KALT" = KALT recipients only. Makes Table 2's tier n directly comparable
#            to Table 3's deceased-donor columns (both describe the same
#            patients) -- this is what the reference manuscript's matching Ns
