#===============================================================================
# SECTION 33. NATIONAL TRENDS -- KIDNEY TRANSPLANTS BY TRANSPLANT TYPE,
#             PERCENT PER YEAR, 2010-2025
#===============================================================================
# ADDITIVE SECTION. Reads only; every object is prefixed `s33_` / `S33_`.
#
# THIS SECTION USES A DIFFERENT POPULATION FROM THE REST OF THE FILE. Sections
# 6-32 are about ONE cohort: liver transplant recipients who developed ESRD.
# This figure is national background epidemiology -- EVERY kidney transplant in
# the SAF, whatever the recipient's liver history -- because "percent of kidney
# transplants per year" only means something against that denominator. Nothing
# here touches df_esrd_cohort, df_index or any cohort object, and no cohort
# number depends on it.
#
# WHY IT RE-READS kidpan_data
#   The pipeline's premise is that each SAS file is read exactly once (Section 4)
#   so patient counts reconcile. That premise is about the ANALYTIC COHORT, and
#   this section is not part of it. The re-read is also unavoidable: KIDPAN_COLS
#   (Section 3) never pulled TXLIV, ORGAN or PREV_KI_TX, and without TXLIV a
#   simultaneous liver-kidney transplant cannot be identified at all. The read is
#   narrow (12 columns) and lands in s33_kidpan_tx. df_kidpan_raw is NOT touched,
#   re-assigned, or filtered.
#
# CLASSIFICATION -- what identifies a kidney transplant and its type
#   A kidney transplant is a row with a non-blank TXKID and a TX_DATE. Verified
#   against the file: non-blank TXKID occurs on exactly 663,973 rows, which is
#   precisely ORGAN in {KI, KP}; the 9,633 ORGAN == "PA" rows are pancreas-alone
#   transplants and carry a blank TXKID, so they are excluded by construction
#   rather than by a separate rule.
#
#   The organ flags are NOT Y/N. They are coded by graft detail -- TXKID is
#   L/R/E (left, right, en bloc), TXLIV is W/S (whole, split), TXPAN is W/S,
#   TXLNG is D/R/L, TXINT is W/S, TXHRT and TXVCA are Y. Blank means the organ
#   was not transplanted, which is why is_blank_flag() (Section 2.2) is the right
#   test here and a naive == "Y" would silently return nothing for most organs.
#
# TWO PANELS, BECAUSE ONE AXIS CANNOT SHOW BOTH
#   Kidney-alone is ~92% of kidney transplants; the other five categories run
#   0.01-4.6%. On a single 0-100% axis all five are flat lines on the floor. The
#   figure is therefore two panels stacked on a shared year axis -- 0-100% for
#   kidney-alone, and a zoomed panel for everything else. This is the documented
#   alternative to a dual y-axis, which is never acceptable.
#===============================================================================

#--- 33.1 Configuration -------------------------------------------------------

S33_YEARS <- 2010:2025

# How long after a liver transplant a kidney still counts as "kidney after liver
# transplant". Inf = any interval, which is what this figure asks for: any
# recipient whose liver transplant precedes their kidney transplant.
#
# [K1] THIS NOW AGREES WITH THE COHORT BY DEFAULT. When KALT_MAX_DAYS (Section
# 1.3) is Inf, this figure's "kidney after liver transplant" category means
# exactly what Tables 1-7 mean by KALT, and the two constants should be changed
# together. They are kept separate because the populations differ -- this figure
# is national background epidemiology over every kidney transplant in the SAF,
# not the ESRD cohort -- so a deliberate mismatch remains possible.
S33_KAL_MAX_DAYS <- KALT_MAX_DAYS

# Kidney RE-transplants are excluded from this figure entirely -- from the
# numerator AND the denominator -- so every percentage below is a percentage of
# FIRST kidney transplants. Two independent rules, because neither alone is
# complete: PREV_KI_TX catches a prior kidney transplant that happened before
# this SAF's coverage, and the in-file check catches repeat transplants where
# both events are present as separate rows. Section 33.3 reports each.
S33_DROP_KIDNEY_RETX <- TRUE

# Collapse the categories the request did not name (kidney+intestine,
# kidney+VCA, and any recipient of two or more extra organs such as
# liver+pancreas+intestine) into one bucket, so the categories are mutually
# exclusive AND exhaustive and each year's percentages sum to 100. It is a small
# group -- about 0.03-0.07% of kidney transplants per year. FALSE drops them
# instead, and the yearly percentages then sum to slightly under 100.
S33_KEEP_OTHER <- TRUE

S33_CAT_KTA   <- "Kidney transplant alone"
S33_CAT_KAL   <- "Kidney after liver transplant"
S33_CAT_SLK   <- "Simultaneous liver-kidney"
S33_CAT_SPK   <- "Simultaneous pancreas-kidney"
S33_CAT_KHRT  <- "Simultaneous kidney-heart"
S33_CAT_KLNG  <- "Simultaneous kidney-lung"
S33_CAT_OTHER <- "Other / multiple organs"

# Fixed hue order from the project's categorical palette -- assigned in a fixed
# order and never cycled. The assignment is COMPUTED, not chosen by eye: the six
# lower-panel series share one panel and their lines cross, so they were
# validated as an ALL-PAIRS set (worst normal-vision OKLab dE 15.6 against a
# floor of 15; worst simulated protan/deutan dE 6.9 against a floor of 6). Two
# pairs sit in the 6-8 CVD warn band and three hues fall below 3:1 contrast on a
# white surface, and both of those oblige a second, non-colour encoding -- hence
# the per-series point SHAPES below and the table view in 33.6/33.7. Identity is
# never carried by colour alone here.
#
# Kidney-alone takes the remaining hue rather than the leading one because it is
# the only series in its own panel, so it never shares a visual field with the
# other six; the six that DO share one get the set that validates together.
S33_COLOURS <- c(
  "#e87ba4",  # kidney alone      -- magenta
  "#2a78d6",  # kidney after liver-- blue
  "#1baf7a",  # sim liver-kidney  -- aqua
  "#eda100",  # sim pancreas-kidney- yellow
  "#008300",  # sim kidney-heart  -- green
  "#4a3aa7",  # sim kidney-lung   -- violet
  "#e34948"   # other/multiple    -- red
)
S33_SHAPES <- c(16, 15, 17, 18, 8, 4, 3)   # secondary encoding, see above

S33_INK_PRIMARY   <- "#0b0b0b"
S33_INK_SECONDARY <- "#52514e"


#--- 33.2 Targeted read -------------------------------------------------------
S33_COLS <- c("PT_CODE", "TX_DATE", "ORGAN",
              "TXKID", "TXLIV", "TXHRT", "TXLNG", "TXPAN", "TXINT", "TXVCA",
              "PREV_KI_TX", "NUM_PREV_TX")

s33_kidpan_tx <- read_sas_cols(KIDPAN_MAIN_PATH, S33_COLS,
                               label = "kidpan_data (Section 33, national trends)") |>
  mutate(TX_DATE = as.Date(TX_DATE))


#--- 33.3 Kidney transplants, first-only --------------------------------------
s33_all_ktx <- s33_kidpan_tx |>
  filter(!is_blank_flag(TXKID), !is.na(TX_DATE)) |>
  mutate(tx_year = as.integer(format(TX_DATE, "%Y")))

cat("\n[Sec 33] kidney transplants in file (any year):", nrow(s33_all_ktx), "\n")
cat("  cross-check -- ORGAN among these rows (expect only KI and KP):\n")
print(table(trimws(as.character(s33_all_ktx$ORGAN)), useNA = "ifany"))

# Rule 1: registry says a kidney transplant preceded this one.
# Rule 2: an earlier kidney transplant for this patient exists in the file.
#         Computed over ALL years, before the 2010-2025 window is applied, so a
#         2008 first transplant correctly demotes a 2012 one.
s33_all_ktx <- s33_all_ktx |>
  group_by(PT_CODE) |>
  mutate(ktx_seq = rank(TX_DATE, ties.method = "first")) |>
  ungroup() |>
  mutate(prev_ki_registry = toupper(trimws(as.character(PREV_KI_TX))) == "Y",
         prev_ki_infile    = ktx_seq > 1,
         is_retx           = prev_ki_registry | prev_ki_infile)

cat("\n[Sec 33] kidney re-transplant detection (all years):\n")
print(s33_all_ktx |> count(prev_ki_registry, prev_ki_infile))
cat("  registry flag only:", sum(s33_all_ktx$prev_ki_registry & !s33_all_ktx$prev_ki_infile),
    "| in-file only:", sum(!s33_all_ktx$prev_ki_registry & s33_all_ktx$prev_ki_infile),
    "| both:", sum(s33_all_ktx$prev_ki_registry & s33_all_ktx$prev_ki_infile), "\n")
cat("  (neither rule subsumes the other, which is why both are applied.)\n")

if (S33_DROP_KIDNEY_RETX) {
  s33_first_ktx <- s33_all_ktx |> filter(!is_retx)
  cat("  EXCLUDED", sum(s33_all_ktx$is_retx), "re-transplant(s);",
      nrow(s33_first_ktx), "first kidney transplants remain.\n")
} else {
  s33_first_ktx <- s33_all_ktx
  cat("  S33_DROP_KIDNEY_RETX is FALSE -- re-transplants retained.\n")
}


#--- 33.4 Prior liver transplant ----------------------------------------------
# From df_liver_raw (Section 4), registration-level and UNFILTERED: the question
# here is simply "did this person ever receive a liver before this kidney",
# which must not inherit Section 6.1's eligibility criteria. PT_CODE is the
# cross-file patient key this pipeline already relies on (Sections 8, 17).
s33_liver_tx <- df_liver_raw |>
  filter(!is.na(TX_DATE)) |>
  group_by(PT_CODE) |>
  summarise(first_liver_tx = min_date(TX_DATE), .groups = "drop")

cat("\n[Sec 33] patients with a liver transplant in liver_data:",
    nrow(s33_liver_tx), "\n")

s33_class <- s33_first_ktx |>
  left_join(s33_liver_tx, by = "PT_CODE") |>
  mutate(
    liv = !is_blank_flag(TXLIV), hrt = !is_blank_flag(TXHRT),
    lng = !is_blank_flag(TXLNG), pan = !is_blank_flag(TXPAN),
    int = !is_blank_flag(TXINT), vca = !is_blank_flag(TXVCA),
    n_extra = liv + hrt + lng + pan + int + vca,
    # Strictly BEFORE the kidney transplant: a liver on the same day is a
    # simultaneous liver-kidney, which the TXLIV branch below already claims.
    days_liver_to_kidney = as.numeric(TX_DATE - first_liver_tx),
    prior_liver = !is.na(days_liver_to_kidney) & days_liver_to_kidney > 0 &
      days_liver_to_kidney <= S33_KAL_MAX_DAYS,
    tx_category = case_when(
      # Two or more extra organs, or an organ the request did not name, is not
      # forced into one of the named pairs by a priority rule -- it is reported
      # as what it is.
      n_extra >= 2 | int | vca ~ S33_CAT_OTHER,
      liv                      ~ S33_CAT_SLK,
      pan                      ~ S33_CAT_SPK,
      hrt                      ~ S33_CAT_KHRT,
      lng                      ~ S33_CAT_KLNG,
      prior_liver              ~ S33_CAT_KAL,
      TRUE                     ~ S33_CAT_KTA
    )
  )

S33_CAT_LEVELS <- c(S33_CAT_KTA, S33_CAT_KAL, S33_CAT_SLK, S33_CAT_SPK,
                    S33_CAT_KHRT, S33_CAT_KLNG, S33_CAT_OTHER)

s33_class <- s33_class |>
  mutate(tx_category = factor(tx_category, levels = S33_CAT_LEVELS))
stopifnot(!any(is.na(s33_class$tx_category)))   # categories must be exhaustive

cat("\n[Sec 33] category counts, all years:\n")
print(s33_class |> count(tx_category))

if (!S33_KEEP_OTHER) {
  n_other <- sum(s33_class$tx_category == S33_CAT_OTHER)
  s33_class <- s33_class |> filter(tx_category != S33_CAT_OTHER) |>
    mutate(tx_category = droplevels(tx_category))
  cat("S33_KEEP_OTHER is FALSE --", n_other,
      "transplant(s) dropped; yearly percentages will sum to <100.\n")
}


#--- 33.5 Year completeness ----------------------------------------------------
# The SAF extends past this pipeline's STUDY_END. STUDY_END (2025-04-03) is a
# CHOSEN administrative censoring date for the survival analyses, not the end of
# the data -- so 2025 is a complete transplant year here even though the cohort
# sections censor in April 2025. A year with fewer than 12 distinct months is a
# partial year whose percentages are still valid but whose counts are not
# comparable, so it is reported and excluded rather than silently plotted.
s33_month_cover <- s33_class |>
  group_by(tx_year) |>
  summarise(n_tx = dplyr::n(),
            months = dplyr::n_distinct(format(TX_DATE, "%m")), .groups = "drop")

cat("\n[Sec 33] month coverage by year (12 = complete):\n")
print(s33_month_cover |> filter(tx_year >= min(S33_YEARS) - 1,
                                tx_year <= max(S33_YEARS) + 1), n = 30)

s33_partial <- s33_month_cover |> filter(tx_year %in% S33_YEARS, months < 12)
if (nrow(s33_partial) > 0) {
  warning("[Sec 33] partial year(s) inside S33_YEARS: ",
          paste(s33_partial$tx_year, collapse = ", "),
          " -- these have fewer than 12 months of transplants. Their ",
          "percentages remain valid but their counts are not comparable to a ",
          "full year; consider narrowing S33_YEARS.")
}

s33_dat <- s33_class |> filter(tx_year %in% S33_YEARS)
cat("\n[Sec 33] ANALYSED:", nrow(s33_dat), "first kidney transplants,",
    min(s33_dat$tx_year), "-", max(s33_dat$tx_year), "\n")


#--- 33.6 Percent per year ----------------------------------------------------
# complete = TRUE fills year x category combinations with no transplants, so a
# zero year is drawn as a zero rather than as a gap in the line.
s33_pct <- s33_dat |>
  count(tx_year, tx_category, name = "n", .drop = FALSE) |>
  tidyr::complete(tx_year = S33_YEARS,
                  tx_category = factor(levels(s33_dat$tx_category),
                                       levels = levels(s33_dat$tx_category)),
                  fill = list(n = 0)) |>
  group_by(tx_year) |>
  mutate(year_total = sum(n), pct = 100 * n / year_total) |>
  ungroup()

# With the Other bucket kept, the categories are exhaustive, so every year must
# sum to exactly 100%. This is the check that would catch a classification gap.
if (S33_KEEP_OTHER) {
  s33_year_sums <- s33_pct |>
    group_by(tx_year) |>
    summarise(pct_sum = sum(pct), .groups = "drop")
  stopifnot(all(abs(s33_year_sums$pct_sum - 100) < 1e-8))
  cat("\n[Sec 33] every year's categories sum to 100% -- classification is",
      "exhaustive.\n")
}

cat("\n[Sec 33] percent of first kidney transplants per year:\n")
print(s33_pct |>
        mutate(pct = round(pct, 2)) |>
        select(tx_year, tx_category, pct) |>
        tidyr::pivot_wider(names_from = tx_category, values_from = pct),
      n = 30, width = 250)

cat("\n[Sec 33] denominator (first kidney transplants) by year:\n")
print(s33_pct |> distinct(tx_year, year_total), n = 30)


#--- 33.7 Figure --------------------------------------------------------------
# Kidney-alone gets the full 0-100% panel; everything else a zoomed panel on the
# same year axis. Panel assignment is by category, so each series appears in
# exactly one panel and no series is split across the scale break.
s33_zoom_max <- ceiling(max(s33_pct$pct[s33_pct$tx_category != S33_CAT_KTA]))

S33_PANEL_TOP    <- "Kidney transplant alone (0-100%)"
S33_PANEL_BOTTOM <- paste0("All other categories (0-", s33_zoom_max, "%)")

s33_plot_dat <- s33_pct |>
  mutate(panel = factor(if_else(tx_category == S33_CAT_KTA,
                                S33_PANEL_TOP, S33_PANEL_BOTTOM),
                        levels = c(S33_PANEL_TOP, S33_PANEL_BOTTOM)))

# Pin each panel's y range explicitly. facet_grid(scales = "free_y") otherwise
# fits each panel to its own data, which zoomed the top panel to roughly
# 89.8-91.5% and turned a 1.7-point wobble into a dramatic-looking decline. On a
# "percent of transplants" axis that is misleading, so the top panel is held at
# the full 0-100% and only the bottom panel is a deliberate, labelled zoom.
s33_limits <- tibble(
  panel = factor(c(S33_PANEL_TOP, S33_PANEL_TOP,
                   S33_PANEL_BOTTOM, S33_PANEL_BOTTOM),
                 levels = c(S33_PANEL_TOP, S33_PANEL_BOTTOM)),
  tx_year     = min(S33_YEARS),
  pct         = c(0, 100, 0, s33_zoom_max),
  tx_category = factor(S33_CAT_KTA, levels = S33_CAT_LEVELS)
)

s33_fig <- ggplot(s33_plot_dat,
                  aes(x = tx_year, y = pct,
                      colour = tx_category, shape = tx_category)) +
  geom_blank(data = s33_limits) +
  geom_line(linewidth = 0.8) +
  geom_point(size = 2.1) +
  facet_grid(panel ~ ., scales = "free_y") +
  scale_colour_manual(values = setNames(S33_COLOURS, S33_CAT_LEVELS),
                      drop = FALSE, name = NULL) +
  scale_shape_manual(values = setNames(S33_SHAPES, S33_CAT_LEVELS),
                     drop = FALSE, name = NULL) +
  scale_x_continuous(breaks = S33_YEARS, expand = expansion(mult = 0.02)) +
  scale_y_continuous(labels = function(x) paste0(x, "%"),
                     expand = expansion(mult = c(0.02, 0.04))) +
  labs(
    title = "Kidney Transplants by Transplant Type, United States, 2010-2025",
    subtitle = paste0("Percent of first kidney transplants per year (kidney ",
                      "re-transplants excluded). Note the change of scale ",
                      "between panels."),
    x = "Year of kidney transplant", y = "Percent of kidney transplants"
  ) +
  guides(colour = guide_legend(nrow = 3, byrow = TRUE),
         shape  = guide_legend(nrow = 3, byrow = TRUE)) +
  theme_classic(base_size = 11) +
  theme(
    plot.title       = element_text(face = "bold", colour = S33_INK_PRIMARY),
    plot.subtitle    = element_text(colour = S33_INK_SECONDARY, size = 9),
    axis.title       = element_text(colour = S33_INK_SECONDARY, size = 10),
    axis.text        = element_text(colour = S33_INK_SECONDARY, size = 8),
    axis.text.x      = element_text(size = 7.5),
    # Recessive grid: a light horizontal rule only, so the marks carry the ink.
    panel.grid.major.y = element_line(colour = "#e8e8e6", linewidth = 0.3),
    axis.line        = element_line(colour = "#9a9a97", linewidth = 0.3),
    axis.ticks       = element_line(colour = "#9a9a97", linewidth = 0.3),
    strip.background = element_blank(),
    strip.text       = element_text(face = "bold", colour = S33_INK_PRIMARY,
                                    size = 9, hjust = 0),
    panel.spacing.y  = unit(14, "pt"),
    legend.position  = "bottom",
    legend.text      = element_text(colour = S33_INK_SECONDARY, size = 8.5),
    legend.key.width = unit(22, "pt")
  )

print(s33_fig)


#--- 33.8 Table view ----------------------------------------------------------
# Required, not optional: three of the palette's hues fall below 3:1 contrast on
# a white surface, and the relief rule for that is visible direct labels OR a
# table view. This is the table view.
s33_table <- s33_pct |>
  mutate(pct = sprintf("%.2f", pct)) |>
  select(tx_year, tx_category, pct) |>
  tidyr::pivot_wider(names_from = tx_category, values_from = pct) |>
  left_join(s33_pct |> distinct(tx_year, year_total), by = "tx_year") |>
  rename(Year = tx_year, `Total, n` = year_total)

s33_gt <- s33_table |>
  gt(rowname_col = "Year") |>
  tab_header(
    title = "Kidney Transplants by Transplant Type, United States, 2010-2025",
    subtitle = "Percent of first kidney transplants per year"
  ) |>
  tab_spanner(label = "Percent of that year's first kidney transplants",
              columns = all_of(intersect(S33_CAT_LEVELS, names(s33_table)))) |>
  tab_footnote(footnote = paste0(
    "Denominator is every first kidney transplant recorded that year (non-blank ",
    "TXKID with a transplant date), so the categories are mutually exclusive and ",
    "exhaustive and each row sums to 100%. Kidney re-transplants are excluded ",
    "from both numerator and denominator (S33_DROP_KIDNEY_RETX), identified by ",
    "the registry's PREV_KI_TX flag and by an earlier kidney transplant for the ",
    "same patient in the file.")) |>
  tab_footnote(footnote = paste0(
    "'", S33_CAT_KAL, "' is an isolated kidney transplant in a recipient whose ",
    "liver transplant preceded it (liver_data, any interval; S33_KAL_MAX_DAYS = ",
    S33_KAL_MAX_DAYS, "), the same interval rule this pipeline's KALT ",
    "definition uses (KALT_MAX_DAYS, Section 1.3). A liver transplanted on the SAME day is a ",
    "simultaneous liver-kidney instead.")) |>
  tab_footnote(footnote = paste0(
    "'", S33_CAT_OTHER, "' holds kidney+intestine, kidney+VCA and any recipient ",
    "of two or more additional organs (most often liver+pancreas+intestine); ",
    "these are not assigned to a named pair by a priority rule.")) |>
  tab_footnote(footnote = paste(
    "NATIONAL DENOMINATOR, NOT THIS STUDY'S COHORT. Every kidney transplant in",
    "the SAF is counted, regardless of liver history, so these figures do not",
    "reconcile against Tables 1-7 and are not meant to -- they are background",
    "epidemiology for the cohort's context.")) |>
  tab_source_note(source_note = paste(
    "Transplant type from the OPTN organ flags (TXKID/TXLIV/TXHRT/TXLNG/TXPAN/",
    "TXINT/TXVCA), which are coded by graft detail rather than Y/N; a blank",
    "means the organ was not transplanted."))

s33_gt

