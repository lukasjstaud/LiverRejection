#--- 22.3 Format each block into the reference table's row layout ------------
fmt_est <- function(x) ifelse(is.na(x), "--", sprintf("%.2f", x))
fmt_ci  <- function(lo, hi) ifelse(is.na(lo) | is.na(hi), "--",
                                   sprintf("(%.2f-%.2f)", lo, hi))

supp1_format_block <- function(block, label) {
  km <- block$km |>
    mutate(year = case_when(time_d == 365 ~ "1y", time_d == 1095 ~ "3y",
                            time_d == 1825 ~ "5y", TRUE ~ NA_character_))
  
  rows <- bind_rows(lapply(block$level_order, function(lv) {
    sub <- km |> filter(LDRI_cat == lv)
    n_here <- block$n$n[block$n$LDRI_cat == lv]
    
    v <- function(yr, col) sub[[col]][sub$year == yr][1]
    # The 5-year estimate is now well inside this cohort's follow-up, so the
    # reference table's "unchanged from the previous interval" asterisk no
    # longer carries information and is dropped -- an identical 3y/5y pair
    # here genuinely means no events occurred, not that the curve ran out.
    tibble(
      Category = sprintf("%s (n=%d)", lv, n_here),
      `1y`     = fmt_est(v("1y", "surv")),
      `1y CI`  = fmt_ci(v("1y", "lower"), v("1y", "upper")),
      `3y`     = fmt_est(v("3y", "surv")),
      `3y CI`  = fmt_ci(v("3y", "lower"), v("3y", "upper")),
      `5y`     = fmt_est(v("5y", "surv")),
      `5y CI`  = fmt_ci(v("5y", "lower"), v("5y", "upper"))
    )
  }))
  
  rows$`P value` <- c(fmt_p(block$p_overall), rep("", nrow(rows) - 1))
  rows$Endpoint  <- label
  rows
}

