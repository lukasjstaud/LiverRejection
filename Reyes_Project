#--- 22.2 Per-Group, per-endpoint KM + log-rank builder -----------------------
supp1_km_block <- function(data, time_var, event_var, times = SUPP1_TIMES) {
  data <- data |> mutate(LDRI_cat = droplevels(LDRI_cat))
  fmla <- as.formula(paste0("Surv(", time_var, ", ", event_var, ") ~ LDRI_cat"))
  fit  <- survfit(fmla, data = data)
  # ggsurvplot() (Section 22.6) needs to resolve fit$call$formula/$data itself;
  # by default that slot holds the unevaluated SYMBOLS `fmla`/`data`, which
  # only exist inside this function's local scope and cannot be resolved once
  # the fit object is returned and used elsewhere. Replacing them with the
  # actual (already-evaluated) objects fixes this without changing anything
  # about the fitted model itself.
  fit$call$formula <- fmla
  fit$call$data <- data
  s    <- summary(fit, times = times, extend = TRUE)
  
  strata_lab <- if (is.null(s$strata)) rep(levels(data$LDRI_cat)[1], length(s$time))
  else gsub("^LDRI_cat=", "", as.character(s$strata))
  
  km <- tibble(LDRI_cat = strata_lab, time_d = s$time,
               surv = s$surv, lower = s$lower, upper = s$upper)
  
  p_overall <- lr_p(fmla, data)
  
  levs  <- levels(data$LDRI_cat)
  pairs <- utils::combn(levs, 2, simplify = FALSE)
  p_pairs <- bind_rows(lapply(pairs, function(pr) {
    tibble(comparison = paste(pr, collapse = " vs. "),
           p = lr_p(fmla, data |> filter(LDRI_cat %in% pr)))
  }))
  
  list(km = km, p_overall = p_overall, p_pairs = p_pairs,
       n = data |> count(LDRI_cat), level_order = levs,
       fit = fit, fit_data = data)
}

