}

#--- 24.4 Block 2 -- post-KALT time-varying HRs -------------------------------
# Build the tstart/tstop/event base, expand via tmerge(), then adaptively
# merge sparse intervals (per endpoint) before fitting.

# Greedily merges consecutive intervals (in temporal order, never touching the
# reference "Waitlist/dialysis" state) until each has >= min_events events.
# Any too-small remainder at the tail folds back into the last completed
# group rather than being silently dropped or left sub-threshold.
adaptive_merge_intervals <- function(long, labels, min_events = TABLE4_MIN_EVENTS_PER_INTERVAL) {
  ec <- tibble(interval = factor(labels[-1], levels = labels[-1])) |>
    left_join(
      long |> filter(interval != labels[1]) |>
        group_by(interval) |> summarise(events = sum(event), .groups = "drop") |>
        mutate(interval = factor(as.character(interval), levels = labels[-1])),
      by = "interval"
    ) |>
    mutate(events = tidyr::replace_na(events, 0)) |>
    arrange(interval)
  
  grp_id <- integer(nrow(ec)); g <- 1; running <- 0
  for (i in seq_len(nrow(ec))) {
    running <- running + ec$events[i]
    grp_id[i] <- g
    if (running >= min_events) { g <- g + 1; running <- 0 }
  }
  if (running > 0 && running < min_events && g > 1) {
    grp_id[grp_id == g] <- g - 1
  }
  ec$group_id <- grp_id
  
  merged_labels <- ec |> group_by(group_id) |>
    summarise(label = if (dplyr::n() == 1) as.character(interval[1])
              else paste(dplyr::first(interval), "to", dplyr::last(interval)),
              total_events = sum(events), .groups = "drop")
  
  map <- setNames(merged_labels$label[ec$group_id], as.character(ec$interval))
  map <- c(setNames(labels[1], labels[1]), map)
  
  list(map = map, merged_labels = merged_labels$label, events = merged_labels$total_events)
}

build_table4_tv <- function(time_var, event_var, label) {
  cat("\n[Table 4, Block 2] Building time-varying frame for", label, "\n")
  
  base <- df_supp1_covars |>
    filter(if_all(all_of(c(time_var, event_var, covariates_adjust, "LDRI")), ~ !is.na(.))) |>
    transmute(
      PT_CODE,
      tstart = 0,
      tstop  = .data[[time_var]],
      event  = .data[[event_var]],
      # kalt_offset: days from kidney listing to kidney TX, ONLY for patients
      # whose transplant switch should be modeled as time-varying.
      eligible_for_switch = KALT_STATUS_CALC == 1 |
        (TABLE4_LATE_TX_TIME_VARYING & KALT_STATUS_CALC == 2),
      kalt_offset = if_else(eligible_for_switch,
                            as.numeric(kidney_tx_date - kidney_listing_date), NA_real_),
      AGE, race_label, sex_label, diab_label, dialysis_label,
      liver_etiology, esrd_etiology, LDRI
    ) |>
    select(-eligible_for_switch)
  
  # Guard against a transplant date at/after the outcome time (should not
  # happen given how kalt_offset and tstop are both anchored at listing, but
  # cheap to confirm rather than assume).
  n_bad <- sum(!is.na(base$kalt_offset) & base$kalt_offset >= base$tstop, na.rm = TRUE)
  if (n_bad > 0) {
    warning(n_bad, " patient(s) have a KALT offset at/after their outcome time ",
            "for ", label, " -- dropping them from the time-varying model.")
    base <- base |> filter(is.na(kalt_offset) | kalt_offset < tstop)
  }
  
  # Guard against zero-length (or negative) follow-up: tmerge requires
  # tstop > tstart (0), so a patient whose death/censoring date coincides
  # exactly with their kidney listing date -- a same-day event, or a data
  # artifact -- would otherwise crash the merge below rather than being
  # reported and excluded.
  n_zero <- sum(base$tstop <= 0)
  if (n_zero > 0) {
    warning(n_zero, " patient(s) have zero or negative follow-up time for ",
            label, " (event/censoring on the same day as kidney listing) -- ",
            "excluded from the time-varying model. Inspect these directly; ",
            "they remain in every other table/analysis in this pipeline.")
    base <- base |> filter(tstop > 0)
  }
  
  long <- tmerge(base, base, id = PT_CODE, tstop = tstop, event = event(tstop, event))
  long <- tmerge(long, base, id = PT_CODE, kalt_start = tdc(kalt_offset))
  for (cp in TABLE4_CUT_DAYS) {
    cutdat <- base |> mutate(cutp = kalt_offset + cp)
    long <- tmerge(long, cutdat, id = PT_CODE, dummy = event(cutp))
  }
  long <- long |> select(-dummy)
  
  long <- long |>
    mutate(
      days_since_kalt = if_else(!is.na(kalt_offset) & tstart >= kalt_offset,
                                tstart - kalt_offset, NA_real_),
      interval = case_when(
        is.na(kalt_offset) | tstart < kalt_offset ~ TABLE4_INTERVAL_LABELS[1],
        days_since_kalt < TABLE4_CUT_DAYS[1] ~ TABLE4_INTERVAL_LABELS[2],
        days_since_kalt < TABLE4_CUT_DAYS[2] ~ TABLE4_INTERVAL_LABELS[3],
        days_since_kalt < TABLE4_CUT_DAYS[3] ~ TABLE4_INTERVAL_LABELS[4],
        days_since_kalt < TABLE4_CUT_DAYS[4] ~ TABLE4_INTERVAL_LABELS[5],
        days_since_kalt < TABLE4_CUT_DAYS[5] ~ TABLE4_INTERVAL_LABELS[6],
        days_since_kalt < TABLE4_CUT_DAYS[6] ~ TABLE4_INTERVAL_LABELS[7],
        days_since_kalt < TABLE4_CUT_DAYS[7] ~ TABLE4_INTERVAL_LABELS[8],
        TRUE ~ TABLE4_INTERVAL_LABELS[9]
      ),
      interval = factor(interval, levels = TABLE4_INTERVAL_LABELS)
    )
  
  stopifnot(!any(is.na(long$interval)), all(long$tstop > long$tstart))
  
  cat("  rows: ", nrow(base), " patients ->  ", nrow(long), " counting-process rows\n", sep = "")
  cat("  person-time and events by ORIGINAL (unmerged) interval:\n")
  print(long |> group_by(interval) |>
          summarise(person_years = round(sum(tstop - tstart) / 365.25, 1),
                    events = sum(event), .groups = "drop"))
  
  merge_result <- adaptive_merge_intervals(long, TABLE4_INTERVAL_LABELS)
  long <- long |>
    mutate(interval_merged = factor(merge_result$map[as.character(interval)],
                                    levels = unique(c(TABLE4_INTERVAL_LABELS[1],
                                                      merge_result$merged_labels))))
  
  if (!identical(merge_result$merged_labels,
                 setdiff(TABLE4_INTERVAL_LABELS, TABLE4_INTERVAL_LABELS[1]))) {
    cat("  ADAPTIVE MERGE applied for", label, "(events per merged window):\n")
    print(tibble(window = merge_result$merged_labels, events = merge_result$events))
  } else {
    cat("  No merging needed for", label, "-- every interval already has >= ",
        TABLE4_MIN_EVENTS_PER_INTERVAL, " events.\n")
  }
  
  list(long = long, interval_labels = merge_result$merged_labels)
}

