    " -- these contribute to both rows of the table.\n", sep = "")


#--- 30.4 Summary helpers -----------------------------------------------------
# Pulls the waiting-time vector for one column of one era. S30_ALL_DD is the
# three KDPI tiers pooled, so it is derived rather than looked up.
s30_vec <- function(era_obj, col) {
  if (identical(col, S30_ALL_DD)) {
    era_obj$tx$wait_days[era_obj$tx$col_group %in% S30_KDPI_COLS]
  } else {
    era_obj$tx$wait_days[era_obj$tx$col_group == col]
  }
}

s30_fmt_med <- function(x) {
  if (!length(x)) return("--")
  q <- stats::quantile(x, c(0.25, 0.5, 0.75), names = FALSE, type = 7)
  sprintf("%.0f [%.0f-%.0f]", q[2], q[1], q[3])
}
s30_fmt_mean <- function(x) {
  if (!length(x)) return("--")
  if (length(x) == 1) return(sprintf("%.0f (--)", x))
  sprintf("%.0f (%.0f)", mean(x), stats::sd(x))
}
s30_fmt_yrs <- function(x) {
  if (!length(x)) return("--")
  sprintf("%.2f", stats::median(x) / 365.25)
}
s30_fmt_range <- function(x) {
  if (!length(x)) return("--")
  sprintf("%.0f-%.0f", min(x), max(x))
}
s30_fmt_n <- function(x, denom) {
  if (!denom) return("--")
  sprintf("%d (%.1f%%)", length(x), 100 * length(x) / denom)
}

# Wilcoxon rank-sum, guarded. Needs both groups non-empty and not identical
# constants; anything else returns NA rather than an error or a bogus p.
s30_wilcox_p <- function(a, b, min_n = 3) {
  if (length(a) < min_n || length(b) < min_n) return(NA_real_)
  suppressWarnings(stats::wilcox.test(a, b, exact = FALSE)$p.value)
}

# Kruskal-Wallis across the three KDPI tiers within one era.
s30_kruskal_p <- function(era_obj, min_n = 3) {
  sub <- era_obj$tx |> filter(col_group %in% S30_KDPI_COLS)
  keep <- sub |> count(col_group) |> filter(n >= min_n)
  if (nrow(keep) < 2) return(NA_real_)
  sub <- sub |> filter(col_group %in% keep$col_group)
  suppressWarnings(stats::kruskal.test(wait_days ~ factor(col_group), data = sub)$p.value)
}


#--- 30.5 Panel A -- observed waiting time ------------------------------------
s30_panel <- function(era_objs, vec_fun, denom_fun, panel_label) {
  # One block of statistic rows per era ...
  era_rows <- bind_rows(lapply(era_objs, function(eo) {
    vs    <- lapply(S30_COLS, function(c) vec_fun(eo, c))
    names(vs) <- S30_COLS
    denom <- denom_fun(eo)
    kp    <- s30_kruskal_p(eo)

    mk <- function(row_label, f) {
      vals <- vapply(S30_COLS, function(c) f(vs[[c]]), character(1))
      as_tibble(as.list(vals)) |> mutate(Block = eo$label, Row = row_label)
    }
    bind_rows(
      mk("Transplanted, n (% of listed)", function(x) s30_fmt_n(x, denom)),
      mk("Median wait, days [IQR]",       s30_fmt_med),
      mk("Mean wait, days (SD)",          s30_fmt_mean),
      mk("Median wait, years",            s30_fmt_yrs),
      mk("Range, days",                   s30_fmt_range)
    ) |>
      # The across-tier test is one value per era, not one per column; it is
      # placed in the pooled column, which is the only one it describes.
      bind_rows(
        as_tibble(setNames(as.list(c(rep("", length(S30_KDPI_COLS)),
                                     ifelse(is.na(kp), "--", fmt_p(kp)), "")),
                           S30_COLS)) |>
          mutate(Block = eo$label, Row = "P across KDPI tiers")
      )
  }))

  # ... then the between-era block.
  a <- era_objs[[1]]; b <- era_objs[[2]]
  cmp_p   <- vapply(S30_COLS, function(c)
    s30_wilcox_p(vec_fun(a, c), vec_fun(b, c)), numeric(1))
  cmp_dif <- vapply(S30_COLS, function(c) {
    va <- vec_fun(a, c); vb <- vec_fun(b, c)
    if (!length(va) || !length(vb)) return(NA_real_)
    stats::median(va) - stats::median(vb)
  }, numeric(1))

  cmp_rows <- bind_rows(
    as_tibble(as.list(vapply(S30_COLS, function(c)
      ifelse(is.na(cmp_dif[[c]]), "--", sprintf("%+.0f", cmp_dif[[c]])),
      character(1)))) |>
      mutate(Block = "Post- vs pre-policy", Row = "Median difference, days"),
    as_tibble(as.list(vapply(S30_COLS, function(c)
      ifelse(is.na(cmp_p[[c]]), "--", fmt_p(cmp_p[[c]])),
      character(1)))) |>
      mutate(Block = "Post- vs pre-policy", Row = "Wilcoxon rank-sum P")
  )

  out <- bind_rows(era_rows, cmp_rows) |> select(Block, Row, all_of(S30_COLS))
  cat("\n[Sec 30] ", panel_label, ":\n", sep = "")
  print(out, width = 250)
  out
}

s30_display_A <- s30_panel(
