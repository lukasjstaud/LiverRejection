#===============================================================================
# SECTION 34. PATIENT SURVIVAL BY KDPI TIER, ANCHORED AT KIDNEY TRANSPLANT
#===============================================================================
# ADDITIVE SECTION. Reads only; every object is prefixed `s34_` / `S34_`. No
# cohort object is modified and no existing figure or table number changes.
#
# WHAT THIS FILLS. The pipeline had kidney GRAFT survival by KDPI on the
# kidney-TX clock (Fig 4, Section 19) but no PATIENT survival counterpart on the
# same clock. KDPI-and-patient-survival existed only:
#   - inside Table 7, as one adjusted coefficient among many (no curve), and
#   - in Section 29 / Table 5 / Supp Table 1, all anchored at kidney LISTING,
#     which is a different question and a different denominator.
# This section is the missing figure: same population and same time origin as
# Fig 4, patient survival instead of graft survival, so the two read as a pair.
#
# POPULATION. Every kidney recipient in df_esrd_cohort with a non-missing KDPI,
# regardless of timing stratum -- so BOTH KALT <1 y and KALT >=1 y are here.
# That is deliberate and it is safe, for a reason worth stating:
#
# [K2] WHY THERE IS NO IMMORTAL TIME HERE, DESPITE THE MERGED POPULATION.
# Elsewhere in this pipeline, mixing the timing strata on a LIVER-TX clock is
# fatal, because a >=1-year recipient spends a median 4.0 years unexposed and
# a fixed label credits that time to the exposed arm. On the KIDNEY-TX clock
# that failure mode cannot occur: every patient here has already received a
# kidney at t = 0, KDPI tier is a property of the organ they received, and no
# patient can enter or leave their tier. Time zero is the same event for
# everyone and the strata are fixed at it. This is an ordinary baseline-stratum
# KM and needs no time-varying treatment.
#
# The trade-off is what the clock EXCLUDES rather than what it biases: patients
# who died before ever receiving a kidney are not in this figure at all, so it
# describes outcomes AMONG RECIPIENTS and says nothing about whether
# transplantation helped. For that contrast use Figures 7/9 or Table 4.
#
# Living-donor recipients carry no KDPI and are absent by construction ([F10]).
#===============================================================================

#--- 34.1 Configuration --------------------------------------------------------
S34_REPORT_TIMES <- REPORT_TIMES   # c(365, 1095, 1825) -- 1, 3, 5 years
S34_MIN_TIER_N   <- 10             # tiers smaller than this cannot carry a curve

#--- 34.2 Population and endpoint ----------------------------------------------
# Built from df_index (Section 16) rather than df_km_kidney, because
# df_km_kidney is filtered on a usable GRAFT window (kg_time) -- the wrong
# restriction for a patient-survival endpoint, and it would silently drop
# recipients whose graft window is missing but whose vital status is known.
s34_pop <- df_index |>
  filter(!is.na(kidney_tx_date), !is.na(KDPI_cat)) |>
  mutate(KDPI_cat = droplevels(KDPI_cat))

s34_dat <- s34_pop |>
  bind_cols(make_patient_endpoint(s34_pop, "kidney_tx_date") |>
              rename(pt_time_k = time, pt_event_k = event))

cat("\n########## SECTION 34: PATIENT SURVIVAL BY KDPI, FROM KIDNEY TX ##########\n")
cat("\nNegative/missing post-kidney-TX follow-up (inspect, do not drop silently):\n")
print(s34_dat |> summarise(neg = sum(pt_time_k <  0, na.rm = TRUE),
                           na  = sum(is.na(pt_time_k))))
s34_dat <- s34_dat |> filter(!is.na(pt_time_k), pt_time_k >= 0)

cat("\n[Sec 34] Population: ", nrow(s34_dat),
    " kidney recipients with a KDPI.\n", sep = "")
print(s34_dat |> count(KDPI_cat, Group3))

# Same sparsity guard as Fig 8 (Section 21b.3), for the same reason: a tier of
# two patients still plots, as a flat line with no events, and reads as "these
# kidneys never fail". On the FULL cohort the high-KDPI tier should be well
# populated -- it is the <1-year-restricted view where it collapses -- so this
# firing at all is a signal worth reading, not routine.
s34_small <- s34_dat |> count(KDPI_cat) |> filter(n < S34_MIN_TIER_N)
S34_DROPPED <- if (nrow(s34_small) > 0) {
  paste0(as.character(s34_small$KDPI_cat), " (n=", s34_small$n, ")", collapse = ", ")
} else NA_character_
if (nrow(s34_small) > 0) {
  warning("[Sec 34] KDPI tier(s) below n=", S34_MIN_TIER_N, " dropped: ", S34_DROPPED)
  s34_dat <- s34_dat |> filter(!KDPI_cat %in% s34_small$KDPI_cat) |>
    mutate(KDPI_cat = droplevels(KDPI_cat))
}
stopifnot(nlevels(s34_dat$KDPI_cat) >= 2, sum(s34_dat$pt_event_k) > 0)

#--- 34.3 KM, log-rank, and unadjusted Cox -------------------------------------
s34_fit <- survfit(Surv(pt_time_k, pt_event_k) ~ KDPI_cat, data = s34_dat)
s34_km  <- km_at(s34_fit, "Patient survival by KDPI (from kidney TX)",
                 times = S34_REPORT_TIMES)
print(s34_km, n = 100)

s34_lr <- lr_p(Surv(pt_time_k, pt_event_k) ~ KDPI_cat, s34_dat)
cat("\n[Sec 34] Overall log-rank p across KDPI tiers:", s34_lr, "\n")

cat("\n[Sec 34] Pairwise log-rank, Holm-adjusted:\n")
print(pairwise_survdiff(Surv(pt_time_k, pt_event_k) ~ KDPI_cat,
                        data = s34_dat, p.adjust.method = "holm"))

# Unadjusted, reference = lowest KDPI tier. This is a CRUDE contrast: recipients
# of high-KDPI kidneys differ systematically from recipients of low-KDPI ones
# (older, longer-waiting, more comorbid), and none of that is adjusted here.
# Table 7 is the adjusted version of this same question.
s34_cox <- coxph(Surv(pt_time_k, pt_event_k) ~ KDPI_cat, data = s34_dat)
cat("\n[Sec 34] Unadjusted Cox by KDPI tier (crude -- see Table 7 for adjusted):\n")
print(summary(s34_cox))

s34_hr <- local({
  ci <- summary(s34_cox)$conf.int
  pv <- summary(s34_cox)$coefficients[, 5]
  tibble(
    Contrast = paste0(sub("^KDPI_cat", "", rownames(ci)), " vs ",
                      levels(s34_dat$KDPI_cat)[1]),
    HR_CI    = sprintf("%.2f (%.2f-%.2f)", ci[, 1], ci[, 3], ci[, 4]),
    P        = vapply(pv, fmt_p, character(1))
  )
})
print(s34_hr, width = 200)

#--- 34.4 Figure ---------------------------------------------------------------
s34_caption <- paste0(
  "FULL COHORT, every kidney recipient with a KDPI (n=", nrow(s34_dat),
  "), both timing strata pooled. Companion to Figure 4, which shows GRAFT\n",
  "survival for the same patients on the same clock.\n",
  "TIME ORIGIN IS THE KIDNEY TRANSPLANT, so KDPI tier is fixed at t=0 and no patient can change tier -- this is an\n",
  "ordinary baseline-stratum comparison and carries no immortal time, unlike a liver-TX-anchored KALT contrast ([K2]).\n",
  "Patients who died before receiving a kidney are NOT represented: this describes outcomes AMONG RECIPIENTS and is\n",
