cat("A group with 0 deaths in the first year is not a healthier group; it is a\n",
    "group whose membership requires surviving that year. See the block comment\n",
    "at the head of Section 19.\n", sep = "")

df_km_ldri <- df_km_tx |> filter(!is.na(LDRI_cat))
