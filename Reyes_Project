#===============================================================================
#===============================================================================
# PART II -- SURVIVAL ENDPOINTS
#===============================================================================
#===============================================================================
# ENDPOINTS
#   1. Patient survival
#   2. Death-censored liver graft survival
#   3. Death-censored kidney graft survival
#
#   Graft failure = FIRST registry date of re-listing, re-transplant, or
#                   resumed maintenance dialysis (kidney only).
#   Time origin   = listing date OR transplant date (both built; see Sec 17).
#   Follow-up ends at death, graft failure, or STUDY_END.
#
# STANDING CAVEATS
#   * Resumed dialysis is captured on follow-up forms, so its date resolves only
#     to the follow-up interval. Re-listing and re-transplant dates are exact.
#     Worth a limitations sentence.
#   * Anchoring at LISTING is the fix for immortal time bias: at listing nobody
#     has been classified yet, so KALT patients accrue no protected time. If the
#     manuscript reports listing-anchored curves as primary, that objection is
#     handled. Both anchors are built below.
#   * Death-censored graft survival treats death-with-function as
#     non-informative censoring. Standard, but a standard reviewer objection.
#     Section 20 adds the competing-risks version.
#
# NOTE: This part no longer re-reads any SAS file. It uses the registration-
#       level frames from Section 4, so a re-listing found here is guaranteed
#       to belong to the same patient row that Tables 1-3 describe.
#===============================================================================


#===============================================================================
# SECTION 16. INDEX DATES
#===============================================================================
df_index <- df_esrd_cohort |>
  transmute(
    PT_CODE,
    TRR_ID_CODE,
    TRR_ID_CODE_KIDNEY,
    Group, Group3, KALT_STATUS_CALC,
    KDPI_num, KDPI_cat, LDRI, LDRI_cat,
    kidney_donor_type,
    liver_tx_date       = TX_DATE,
    kidney_tx_date      = TX_DATE_KIDNEY,
    kidney_listing_date = kidney_first_listing_date
  )

#--- 15.1 Liver candidate listing date ----------------------------------------
# From the registration-level liver frame (one row per WL_ID_CODE), so
# re-listings are additional rows and the minimum is the original listing.
df_liver_listing <- df_liver_raw |>
  group_by(PT_CODE) |>
  summarise(liver_listing_date = min_date(INIT_DATE), .groups = "drop")

df_index <- df_index |> left_join(df_liver_listing, by = "PT_CODE")

#--- 15.2 Vital status --------------------------------------------------------
# Summarised rather than sliced: COMPOSITE_DEATH_DATE and the latest
# PX_STAT_DATE do not necessarily sit on the same registration row, so picking
# a single "best" row can drop one or the other.
df_vital_liver <- df_liver_raw |>
  group_by(PT_CODE) |>
  summarise(
    death_date       = min_date(COMPOSITE_DEATH_DATE),
    last_fu_liver    = max_date(PX_STAT_DATE),
    px_stat          = paste(unique(na.omit(PX_STAT)), collapse = "/"),
    .groups          = "drop"
  )

# [F2] last_fu_date must pool EVERY source that carries a PX_STAT_DATE, not
# just liver_data. Deriving it from the liver file alone made the censoring
# date stale for precisely the patients this study is about: someone who
# reaches ESRD years after their liver transplant is followed by the KIDNEY
# program, and their liver centre may have stopped filing forms long before.
# Two one-armed consequences, both measured on this cohort:
#   (a) 196 LTA vs 1 KALT patient had last_fu_date BEFORE their own kidney
#       listing date, i.e. negative follow-up on the kidney-listing clock, and
#       were silently removed by Section 23's pt_time >= 0 filter -- taking 57
#       real post-listing deaths with them.
#   (b) it compounded the [F1] problem above by making the stale form the
#       binding censoring date far more often in LTA than in KALT.
# Pooling liver_data + liver_followup + kidney_followup extends last_fu_date
# for 743 LTA and 219 KALT patients (median +157 and +140 days) and cuts (a)
# from 256/1 to 149/0 patients; adding [F1]'s death-extends-follow-up rule
# takes it to 88/0. The residual 88 have no recorded observation of any kind
# after their kidney listing and are reported by arm in Section 23 rather than
# dropped quietly.
#
# NOTE: PX_STAT_DATE is not clean -- the observed maximum across these files is
# in 2029, i.e. years past any plausible SAF cut. Nothing here trusts it
# directly; every endpoint builder caps follow-up at STUDY_END via pmin().
df_fu_pooled <- bind_rows(
  df_liver_raw |> transmute(PT_CODE, fu_date = PX_STAT_DATE),
  df_liver_fu  |> transmute(PT_CODE, fu_date = PX_STAT_DATE),
  df_kidney_fu |> transmute(PT_CODE, fu_date = PX_STAT_DATE)
) |>
  group_by(PT_CODE) |>
  summarise(last_fu_date = max_date(fu_date), .groups = "drop")

df_death <- df_vital_liver |>
  left_join(df_fu_pooled, by = "PT_CODE") |>
  mutate(last_fu_date = pmax(last_fu_date, last_fu_liver, na.rm = TRUE))

cat("\n[F2] last_fu_date sources: liver_data only vs pooled with both",
    "follow-up files\n")
print(df_death |> summarise(
  n                = n(),
  liver_only_na    = sum(is.na(last_fu_liver)),
  pooled_na        = sum(is.na(last_fu_date)),
  extended         = sum(!is.na(last_fu_date) &
                           (is.na(last_fu_liver) | last_fu_date > last_fu_liver)),
  median_gain_days = median(as.numeric(last_fu_date - last_fu_liver)[
    !is.na(last_fu_date) & !is.na(last_fu_liver) & last_fu_date > last_fu_liver])
))

# last_fu_liver was only needed for the audit above; dropping it keeps df_death
# to the same three columns every downstream section (including Section 29's
# select) already expects.
df_death <- df_death |> select(PT_CODE, death_date, last_fu_date, px_stat)

df_index <- df_index |> left_join(df_death, by = "PT_CODE")

cat("\nPX_STAT vs. presence of a death date (should be near-perfectly aligned):\n")
print(table(df_index$px_stat, has_death_date = !is.na(df_index$death_date), useNA = "always"))

cat("\nDate-ordering sanity:\n")
print(df_index |> summarise(
  n                       = n(),
  liver_listing_after_tx  = sum(liver_listing_date  > liver_tx_date,  na.rm = TRUE),
  kidney_listing_after_tx = sum(kidney_listing_date > kidney_tx_date, na.rm = TRUE),
  missing_liver_listing   = sum(is.na(liver_listing_date)),
  missing_last_fu         = sum(is.na(last_fu_date))
))


#===============================================================================
# SECTION 17. COMPOSITE GRAFT-FAILURE DATES
#===============================================================================

#--- 16.1 Liver re-listing ----------------------------------------------------
df_liver_relist <- df_liver_raw |>
  inner_join(df_index |> select(PT_CODE, liver_tx_date), by = "PT_CODE") |>
  filter(!is.na(INIT_DATE), INIT_DATE > liver_tx_date) |>
  group_by(PT_CODE) |>
  summarise(liver_relist_date = min(INIT_DATE), .groups = "drop")

#--- 16.2 Liver re-transplant -------------------------------------------------
df_liver_retx_main <- df_liver_raw |>
  inner_join(df_index |> select(PT_CODE, liver_tx_date), by = "PT_CODE") |>
  filter(!is.na(RETXDATE), RETXDATE > liver_tx_date) |>
  group_by(PT_CODE) |>
  summarise(retx_main = min(RETXDATE), .groups = "drop")

# Follow-up files key on TRR_ID_CODE in some SAF releases and PT_CODE in
# others. Branch explicitly: dropping the left-hand copy of the non-key id
# prevents a .x/.y collision that would break the group_by(PT_CODE) below.
if ("PT_CODE" %in% names(df_liver_fu)) {
  df_liver_fu_linked <- df_liver_fu |>
    select(-any_of("TRR_ID_CODE")) |>
    inner_join(df_index |> select(PT_CODE, liver_tx_date), by = "PT_CODE")
} else if ("TRR_ID_CODE" %in% names(df_liver_fu)) {
  df_liver_fu_linked <- df_liver_fu |>
    inner_join(df_index |> select(PT_CODE, TRR_ID_CODE, liver_tx_date),
               by = "TRR_ID_CODE")
} else {
  stop("liver follow-up file carries neither PT_CODE nor TRR_ID_CODE")
}

df_liver_retx_fu <- df_liver_fu_linked |>
  filter(!is.na(RETXDATE), RETXDATE > liver_tx_date) |>
  group_by(PT_CODE) |>
  summarise(retx_fu = min(RETXDATE), .groups = "drop")

df_liver_retx <- full_join(df_liver_retx_main, df_liver_retx_fu, by = "PT_CODE") |>
  mutate(liver_retx_date = pmin(retx_main, retx_fu, na.rm = TRUE)) |>
  select(PT_CODE, liver_retx_date)

#--- 16.2b Cross-check: RETXDATE vs. a later TX_DATE registration row ----------
# Systematic disagreement means one source captures something other than re-TX.
df_liver_retx_inferred <- df_liver_raw |>
  inner_join(df_index |> select(PT_CODE, liver_tx_date), by = "PT_CODE") |>
  filter(!is.na(TX_DATE), TX_DATE > liver_tx_date) |>
  group_by(PT_CODE) |>
  summarise(retx_inferred = min(TX_DATE), .groups = "drop")

cat("\nLiver re-transplant source agreement:\n")
print(full_join(df_liver_retx, df_liver_retx_inferred, by = "PT_CODE") |>
        summarise(
          n_retxdate_only = sum(!is.na(liver_retx_date) & is.na(retx_inferred)),
          n_inferred_only = sum(is.na(liver_retx_date) & !is.na(retx_inferred)),
          n_both          = sum(!is.na(liver_retx_date) & !is.na(retx_inferred)),
          median_day_diff = median(as.numeric(liver_retx_date - retx_inferred), na.rm = TRUE)
        ))

#--- 16.3 Kidney re-listing ---------------------------------------------------
df_kidney_relist <- df_kidpan_raw |>
  inner_join(df_index |> select(PT_CODE, kidney_tx_date), by = "PT_CODE") |>
  filter(!is.na(INIT_DATE), !is.na(kidney_tx_date), INIT_DATE > kidney_tx_date) |>
  group_by(PT_CODE) |>
  summarise(kidney_relist_date = min(INIT_DATE), .groups = "drop")

#--- 16.4 Kidney re-transplant ------------------------------------------------
df_kidney_retx_main <- df_kidpan_raw |>
  inner_join(df_index |> select(PT_CODE, kidney_tx_date), by = "PT_CODE") |>
  filter(!is.na(RETXDATE_KI), !is.na(kidney_tx_date), RETXDATE_KI > kidney_tx_date) |>
  group_by(PT_CODE) |>
  summarise(kretx_main = min(RETXDATE_KI), .groups = "drop")

# Same branch as the liver side. Note the kidney transplant id lives on
# df_index as TRR_ID_CODE_KIDNEY, so the join is cross-named.
if ("PT_CODE" %in% names(df_kidney_fu)) {
  df_kidney_fu_linked <- df_kidney_fu |>
    select(-any_of("TRR_ID_CODE")) |>
    inner_join(df_index |> select(PT_CODE, kidney_tx_date), by = "PT_CODE")
} else if ("TRR_ID_CODE" %in% names(df_kidney_fu)) {
  df_kidney_fu_linked <- df_kidney_fu |>
    inner_join(df_index |> select(PT_CODE, TRR_ID_CODE_KIDNEY, kidney_tx_date),
               by = c("TRR_ID_CODE" = "TRR_ID_CODE_KIDNEY"))
} else {
  stop("kidney follow-up file carries neither PT_CODE nor TRR_ID_CODE")
}

df_kidney_retx_fu <- df_kidney_fu_linked |>
  filter(!is.na(RETXDATE_KI), !is.na(kidney_tx_date), RETXDATE_KI > kidney_tx_date) |>
  group_by(PT_CODE) |>
  summarise(kretx_fu = min(RETXDATE_KI), .groups = "drop")

df_kidney_retx <- full_join(df_kidney_retx_main, df_kidney_retx_fu, by = "PT_CODE") |>
  mutate(kidney_retx_date = pmin(kretx_main, kretx_fu, na.rm = TRUE)) |>
  select(PT_CODE, kidney_retx_date)

#--- 16.5 Resumed maintenance dialysis ----------------------------------------
df_dial_main <- df_kidpan_raw |>
  inner_join(df_index |> select(PT_CODE, kidney_tx_date), by = "PT_CODE") |>
  filter(!is.na(RESUM_MAINT_DIAL_DT), !is.na(kidney_tx_date),
         RESUM_MAINT_DIAL_DT > kidney_tx_date) |>
  group_by(PT_CODE) |>
  summarise(dial_main = min(RESUM_MAINT_DIAL_DT), .groups = "drop")

df_dial_fu <- df_kidney_fu_linked |>
  filter(!is.na(RESUM_MAINT_DIAL_DATE), !is.na(kidney_tx_date),
         RESUM_MAINT_DIAL_DATE > kidney_tx_date) |>
  group_by(PT_CODE) |>
  summarise(dial_fu = min(RESUM_MAINT_DIAL_DATE), .groups = "drop")

cat("\nDialysis-resumption source agreement (big gaps = one file is stale):\n")
print(full_join(df_dial_main, df_dial_fu, by = "PT_CODE") |>
        summarise(n_main_only = sum(!is.na(dial_main) & is.na(dial_fu)),
                  n_fu_only   = sum(is.na(dial_main) & !is.na(dial_fu)),
                  n_both      = sum(!is.na(dial_main) & !is.na(dial_fu)),
                  median_diff = median(as.numeric(dial_main - dial_fu), na.rm = TRUE)))

df_dialysis <- full_join(df_dial_main, df_dial_fu, by = "PT_CODE") |>
  mutate(dialysis_date = pmin(dial_main, dial_fu, na.rm = TRUE)) |>
  select(PT_CODE, dialysis_date)

#--- 16.5b Delayed graft function guard ---------------------------------------
# RESUM_MAINT_DIAL should exclude DGF by definition, but some centres report
# early dialysis here. Inspect the early tail before accepting it as failure.
cat("\nDialysis resumption timing relative to kidney TX:\n")
print(df_dialysis |>
        inner_join(df_index |> select(PT_CODE, kidney_tx_date), by = "PT_CODE") |>
        mutate(days_post_tx = as.numeric(dialysis_date - kidney_tx_date)) |>
        summarise(n_total = n(),
                  n_within_7  = sum(days_post_tx <= 7),
                  n_within_30 = sum(days_post_tx <= 30),
                  n_within_90 = sum(days_post_tx <= 90),
                  median_days = median(days_post_tx)))

# Anyone flagged for first-week dialysis whose "resumption" also falls in that
# window is almost certainly DGF, not graft loss.
#
# FIXED: this block used to join df_dialysis onto df_kidpan_raw, which is the
# PRE-dedup frame (one row per kidney registration), so a patient with several
# registrations was counted once per row -- 9 early-resumption patients printed
# as 17. It also measured days_post_tx from that row's own TX_DATE, which for a
# second registration or a KP row is not the transplant this cohort follows.
# Both are now keyed to the de-duplicated kidney_tx_date used everywhere else,
# and FIRST_WK_DIAL is reduced to one value per patient first.
if ("FIRST_WK_DIAL" %in% names(df_kidpan_raw)) {
  cat("\nEarly resumptions cross-checked against FIRST_WK_DIAL (one row/patient):\n")

  df_first_wk <- df_kidpan_raw |>
    mutate(fwd = toupper(trimws(as.character(FIRST_WK_DIAL)))) |>
    filter(!is.na(fwd), fwd != "") |>
    group_by(PT_CODE) |>
    # "Y" on ANY registration wins -- first-week dialysis anywhere is the flag
    # we are testing for. Falls back to N only when no row says Y.
    summarise(FIRST_WK_DIAL = if (any(fwd == "Y")) "Y" else fwd[1],
              .groups = "drop")

  print(df_dialysis |>
          inner_join(df_index |> select(PT_CODE, kidney_tx_date), by = "PT_CODE") |>
          mutate(days_post_tx = as.numeric(dialysis_date - kidney_tx_date)) |>
          filter(days_post_tx <= 7) |>
          left_join(df_first_wk, by = "PT_CODE") |>
          count(FIRST_WK_DIAL))
}

# Apply the threshold set in Section 1
df_dialysis <- df_dialysis |>
  inner_join(df_index |> select(PT_CODE, kidney_tx_date), by = "PT_CODE") |>
  filter(as.numeric(dialysis_date - kidney_tx_date) > DIAL_MIN_DAYS) |>
  select(PT_CODE, dialysis_date)

#--- 16.5c Completeness check using DIAL_TY -----------------------------------
# Dialysis reported on follow-up but no resumption DATE = potential missed
# event. This is the real limitation to quantify in the manuscript.
#
# FIXED: this check used to count ANY non-blank DIAL_TY as "dialysis recorded".
# DIAL_TY is not free text -- it is "Any Dialysis Since Last Follow-Up", format
# MNTDIAL (verified in star-file-data-dictionary.xlsx, KIDNEY_FOLLOWUP_DATA):
#   1   = NO                                   <- 96% of all non-missing rows
#   2   = YES, resumed maintenance dialysis
#   3   = YES, no maintenance resumption
#   4   = YES, maintenance resumption unknown
#   5   = Yes, returned to chronic maintenance dialysis (ESRD)
#   6   = Yes, returned to (or continued on) temporary dialysis
#   998 = UNKNOWN
# Because code 1 means NO, the old test was TRUE for essentially every patient
# with any follow-up form, and its "2,050 recorded but no date" cell was almost
# entirely patients explicitly recorded as NOT on dialysis. Meaningless.
#
# Codes are now graded by what they actually assert. Only 2 and 5 are
# maintenance dialysis, i.e. the thing that constitutes kidney graft failure.
# 6 is TEMPORARY dialysis -- that is DGF/ATN and must NOT count as graft loss.
DIAL_TY_MAINT     <- c(2, 5)      # definite maintenance resumption = graft loss
DIAL_TY_AMBIGUOUS <- c(3, 4)      # dialysis occurred, maintenance status unclear
DIAL_TY_TEMPORARY <- c(6)         # temporary dialysis; NOT graft loss

if ("DIAL_TY" %in% names(df_kidney_fu_linked)) {
  cat("\nDIAL_TY (graded) vs. resumption date captured:\n")
  print(df_kidney_fu_linked |>
          mutate(dt = suppressWarnings(as.numeric(DIAL_TY))) |>
          group_by(PT_CODE) |>
          summarise(dial_ty_class = case_when(
                      any(dt %in% DIAL_TY_MAINT,     na.rm = TRUE) ~ "maintenance (2,5)",
                      any(dt %in% DIAL_TY_AMBIGUOUS, na.rm = TRUE) ~ "ambiguous (3,4)",
                      any(dt %in% DIAL_TY_TEMPORARY, na.rm = TRUE) ~ "temporary (6)",
                      any(dt == 998,                 na.rm = TRUE) ~ "unknown (998)",
                      TRUE                                         ~ "no dialysis (1)/none"),
                    .groups = "drop") |>
          left_join(df_dialysis, by = "PT_CODE") |>
          count(dial_ty_class, has_date = !is.na(dialysis_date)))

  cat("The row that matters: dial_ty_class = 'maintenance (2,5)' with",
      "has_date = FALSE.\nThose are graft failures the date-based capture",
      "missed. Report that count as the\nascertainment limitation.\n")
}

#--- 16.6 Assemble --------------------------------------------------------------
df_index <- df_index |>
  left_join(df_liver_relist,  by = "PT_CODE") |>
  left_join(df_liver_retx,    by = "PT_CODE") |>
  left_join(df_kidney_relist, by = "PT_CODE") |>
  left_join(df_kidney_retx,   by = "PT_CODE") |>
  left_join(df_dialysis,      by = "PT_CODE") |>
  mutate(
    liver_fail_date  = pmin(liver_relist_date, liver_retx_date, na.rm = TRUE),
    kidney_fail_date = pmin(kidney_relist_date, kidney_retx_date, dialysis_date,
                            na.rm = TRUE)
  )

stopifnot(!any(duplicated(df_index$PT_CODE)))   # joins must not have multiplied

cat("\nEvent counts:\n")
print(df_index |> summarise(
  n                 = n(),
  liver_failures    = sum(!is.na(liver_fail_date)),
  kidney_recipients = sum(!is.na(kidney_tx_date)),
