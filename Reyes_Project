#===============================================================================
# SECTION 13. TABLE 1 -- Baseline characteristics by three-level group
#===============================================================================
# [F7] Now split THREE ways on Group3 rather than two ways on the binary Group.
# The old two-column version put never-transplanted patients and patients
# transplanted 365+ days out in a single "LTA" column, which hid the fact that
# they differ on almost everything in this table -- including the 35.5% vs 14.5%
# mortality split. The p-value is correspondingly a 3-group test (chi-square /
# one-way ANOVA-style t.test extension via gtsummary), not a two-group one.
table1 <- df_esrd_cohort |>
  select(Group3, AGE, sex_label, BMI_CALC, race_label, diab_label,
         dialysis_label, years_to_esrd, FINAL_MELD_PELD_LAB_SCORE,
         LDRI_cat, liver_etiology, esrd_etiology) |>
  tbl_summary(
    by = Group3,
    statistic = list(all_continuous()  ~ "{mean} ({sd})",
                     all_categorical() ~ "{n} ({p}%)"),
    digits = all_continuous() ~ 1,
    label = list(
      AGE                       ~ "Age, mean (SD), y",
      sex_label                 ~ "Sex, n (%)",
      BMI_CALC                  ~ "BMI, mean (SD), kg/m\u00b2",
      race_label                ~ "Race/ethnicity, n (%)",
      diab_label                ~ "History of diabetes, n (%)",
      dialysis_label            ~ "Dialysis, n (%)",
      years_to_esrd             ~ "Time between OLT and ESRD, mean (SD), y",
      FINAL_MELD_PELD_LAB_SCORE ~ "MELD, mean (SD)",
      LDRI_cat                  ~ "Liver donor risk index, n (%)",
      liver_etiology            ~ "Etiology of liver failure, n (%)",
      esrd_etiology             ~ "Etiology of ESRD, n (%)"
    ),
    missing = "no"
  ) |>
  # [F7] "t.test" is a two-sample test and errors on a three-level `by`.
  # "oneway.test" is its three-group analogue -- and specifically Welch's
  # version, which does not assume equal variances. That matters here: the three
  # arms are 2,140 / 740 / 1,467 patients with visibly different spreads, which
  # is exactly the situation classical ANOVA handles badly. ("aov" would also
  # work but is deprecated as of gtsummary 2.0.0.) chisq.test already
  # generalises to a 3-column contingency table.
  add_p(test = list(all_continuous()  ~ "oneway.test",
                    all_categorical() ~ "chisq.test")) |>
  modify_header(label ~ "**Characteristic**") |>
  modify_caption(paste("**Table 1. Baseline Characteristics: LTA (no kidney)",
                       "vs. KALT (<1 y) vs. KALT (≥1 y)**")) |>
  bold_labels()

