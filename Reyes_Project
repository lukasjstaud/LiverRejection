# Export for this section's tables is consolidated in the final Section
# (EXPORT), so every section is defined before its own export runs.


#===============================================================================
# SECTION 31. TIME FROM KIDNEY LISTING TO KIDNEY TRANSPLANT -- KAPLAN-MEIER,
#             PRE-POLICY vs POST-POLICY LISTING ERA
#===============================================================================
# ADDITIVE SECTION. Reads only; every object is prefixed `s31_` / `S31_`.
# DEPENDS ON SECTION 30 for the two era cohorts (s30_eras) and on Section 29 for
# s29_build_cohort(). Delete those and this must go too.
#
# WHY THIS STRATIFICATION IS LEGITIMATE AND THE KDPI ONE WAS NOT
#   Listing era is fixed at time zero -- it IS the cohort definition -- so every
#   patient can be assigned to a stratum the moment they are listed, whether or
#   not they are ever transplanted. KDPI cannot: it is a property of a kidney
#   that only exists if the transplant happens, so stratifying a time-to-
#   transplant curve by KDPI tier would condition the stratum on the outcome.
#   That is the whole reason Section 30 reports waiting time among the
#   transplanted rather than a KM by tier.
#
# WHAT THIS ADDS OVER SECTION 30
#   Section 30's medians are medians AMONG THE TRANSPLANTED -- patients who died
#   or were removed while waiting simply are not in them. Here everyone who was
#   listed contributes follow-up from listing until transplant, and those who
#   die or run out of follow-up are CENSORED rather than dropped. The KM median
#   is therefore a median over the whole listed cohort and will be LONGER than
#   Section 30's, which is the correct direction: Section 30 answers "given that
#   you got a kidney, how long did you wait," this answers "having been listed,
#   how long until a kidney arrives."
#
# THE ASSUMPTION THIS MAKES, AND IT IS NOT A SMALL ONE
#   A plain KM treats death-without-transplant as CENSORING, i.e. it assumes
#   those patients would have gone on to be transplanted at the same rate as
#   comparable survivors. They would not -- the sickest candidates both die
#   sooner and are transplanted differently -- so this curve OVERSTATES the
#   probability of transplant, and it overstates it more in the era with more
#   waitlist mortality (the pre-policy era, at 40.8% vs 18.6%). The absolute
#   percentages below are therefore upper bounds, and the era CONTRAST is
#   biased by the differing amounts of censoring.
#   Section 31.4 computes the competing-risks (Aalen-Johansen) cumulative
#   incidence alongside it, which makes no such assumption, purely so the size
#   of the gap is visible. The KM is what was asked for and is what the table
#   and figures report; the CIF numbers are printed and footnoted next to them.
#===============================================================================

#--- 31.1 Configuration -------------------------------------------------------

# Section 30.3 found patients with registrations in BOTH eras. In Section 30 they
# legitimately contribute a waiting time to both rows, but a two-sample KM and
# log-rank require each patient in ONE stratum, or the strata are not
# independent and the p-value is not valid.
#   "first" = assign each such patient to the EARLIER era (their first-ever
#             listing defines their era) and drop them from the later cohort.
#             Default: it keeps the log-rank honest and matches how one would
#             describe these patients clinically.
#   "keep"  = leave them in both strata, reproducing Section 30's population
#             exactly at the cost of a log-rank whose p-value is anticonservative.
S31_ERA_OVERLAP <- "first"
stopifnot(S31_ERA_OVERLAP %in% c("first", "keep"))

# A transplant recorded ON the listing date is a real pre-emptive transplant,
# not a zero-information observation. make_endpoint() (Section 2.5) tests
# `ev > t0` strictly and would censor these at time zero instead of counting
# them, so this section builds its own endpoint and places a same-day
# transplant at this many days. Set to 0 to leave them at the origin.
S31_SAMEDAY_EPS <- 0.5

S31_REPORT_TIMES <- c(365, 730, 1095, 1825)   # 1, 2, 3, 5 years
S31_XLIM         <- KM_XLIM                   # 5 years, shared with Sections 19/21


#--- 31.2 Pooled two-era frame with a time-to-transplant endpoint --------------
# Chronological factor order (pre, then post) so the figure legend and the table
# read left to right in time. Section 30's S30_ERAS is ordered post-first for
# its own display reasons; this does not change either section's numbers.
s31_era_levels <- c(S30_ERAS[[2]]$label, S30_ERAS[[1]]$label)

s31_base <- bind_rows(lapply(s30_eras, function(eo) {
  eo$all |>
    mutate(listing_ref = if (identical(S30_LISTING_SOURCE, "first_listing"))
      kidney_listing_date else kidney_dedup_listing_date) |>
    transmute(PT_CODE, Era = eo$label, listing_ref, kidney_tx_date,
              death_date, last_fu_date, Group, KALT_STATUS_CALC,
              kidney_donor_type, KDPI_num, kdpi_tier)
}))

# Resolve the both-eras patients BEFORE building the endpoint, so the counts
# printed below describe the frame actually analysed.
if (identical(S31_ERA_OVERLAP, "first")) {
  s31_dupe <- s31_base |> count(PT_CODE) |> filter(n > 1)
  if (nrow(s31_dupe) > 0) {
    s31_base <- s31_base |>
      arrange(PT_CODE, listing_ref) |>
      group_by(PT_CODE) |>
      slice(1) |>              # earliest listing wins -> the earlier era
      ungroup()
    cat("\n[Sec 31] ", nrow(s31_dupe), " patient(s) had registrations in both ",
        "eras; each is assigned to their earlier era (S31_ERA_OVERLAP = ",
        "'first') so no patient appears in two strata.\n", sep = "")
  }
} else {
  cat("\n[Sec 31] S31_ERA_OVERLAP = 'keep': patients listed in both eras appear ",
      "in BOTH strata. The log-rank p-value below is anticonservative.\n", sep = "")
}

# Endpoint: transplant is the EVENT; death, loss to follow-up and STUDY_END all
# CENSOR. Same censoring rule as make_endpoint(death_censor = TRUE); only the
# same-day handling differs (see S31_SAMEDAY_EPS).
s31_dat <- s31_base |>
  mutate(
    cens_date = pmin(death_date, last_fu_date,
                     rep(S29_STUDY_END, dplyr::n()), na.rm = TRUE),
    got_tx = !is.na(kidney_tx_date) & !is.na(listing_ref) &
      kidney_tx_date >= listing_ref &
      (is.na(cens_date) | kidney_tx_date <= cens_date),
    tx_time   = as.numeric(kidney_tx_date - listing_ref),
    cens_time = as.numeric(cens_date - listing_ref),
    time  = if_else(got_tx, pmax(tx_time, S31_SAMEDAY_EPS), cens_time),
    event = as.integer(got_tx),
    # Event type for the competing-risks cross-check in 31.4.
    etype = factor(case_when(
      got_tx ~ "transplant",
      !is.na(death_date) & !is.na(cens_date) & death_date == cens_date ~ "death",
      TRUE ~ "censor"
    ), levels = c("censor", "transplant", "death")),
    Era = factor(Era, levels = s31_era_levels)
  )

s31_n_pre <- nrow(s31_dat)
s31_drop  <- s31_dat |> filter(is.na(time) | (event == 0 & time <= 0))
if (nrow(s31_drop) > 0) {
  cat("[Sec 31] dropped ", nrow(s31_drop), " patient(s) with no usable follow-up ",
      "(undatable, or censored on/before their listing date -- e.g. listed after ",
      "STUDY_END = ", format(S29_STUDY_END), "):\n", sep = "")
  print(s31_drop |> count(Era))
}
s31_dat <- s31_dat |> filter(!is.na(time), event == 1 | time > 0)

cat("\n[Sec 31] Analysis frame -- ", nrow(s31_dat), " of ", s31_n_pre,
    " listed patients:\n", sep = "")
print(s31_dat |>
        group_by(Era) |>
        summarise(n = dplyr::n(),
                  transplanted = sum(event),
                  died_no_tx   = sum(etype == "death"),
                  censored     = sum(etype == "censor"),
                  py_waiting   = round(sum(time) / 365.25, 1),
                  .groups = "drop"))


#--- 31.3 Kaplan-Meier, log-rank, and reporting times -------------------------
s31_fit <- survfit(Surv(time, event) ~ Era, data = s31_dat)
s31_fit$call$formula <- Surv(time, event) ~ Era   # so ggsurvplot can resolve it
s31_fit$call$data    <- s31_dat

cat("\n[Sec 31] Median time from listing to transplant (KM, censoring-aware):\n")
s31_med_tab <- summary(s31_fit)$table
print(s31_med_tab)

s31_logrank_p <- lr_p(Surv(time, event) ~ Era, s31_dat)
cat("\n[Sec 31] Log-rank P (pre- vs post-policy era):", fmt_p(s31_logrank_p), "\n")

# Cumulative incidence of transplant = 1 - S(t).
s31_s <- summary(s31_fit, times = S31_REPORT_TIMES, extend = TRUE)
s31_km <- tibble(
  Era    = gsub("^Era=", "", as.character(s31_s$strata)),
  time_d = s31_s$time,
  n_risk = s31_s$n.risk,
  # KM confidence limits are on the survival scale, so 1 - upper becomes the
  # LOWER limit of cumulative incidence and vice versa.
  cif      = 1 - s31_s$surv,
  cif_low  = 1 - s31_s$upper,
  cif_high = 1 - s31_s$lower
)
cat("\n[Sec 31] Cumulative incidence of transplant, 1 - KM (%):\n")
print(s31_km |>
        mutate(estimate = sprintf("%.1f%% (%.1f-%.1f)",
                                  100 * cif, 100 * cif_low, 100 * cif_high)) |>
        select(Era, time_d, n_risk, estimate), n = 20)


#--- 31.4 Competing-risks cross-check (NOT the requested table) ---------------
# Aalen-Johansen cumulative incidence with death-without-transplant as a
# competing event rather than as censoring. This quantifies how much the KM
# above overstates transplant probability -- and, since [F12], s31_cr_fit is
# also the estimator BEHIND FIG13, so this is no longer a print-only check.
s31_cr_fit <- survfit(Surv(time, etype) ~ Era, data = s31_dat)
s31_cr_s   <- summary(s31_cr_fit, times = S31_REPORT_TIMES, extend = TRUE)
s31_tx_col <- which(s31_cr_fit$states == "transplant")

s31_cif_cr <- tibble(
  Era    = gsub("^Era=", "", as.character(s31_cr_s$strata)),
  time_d = s31_cr_s$time,
  cif_cr = s31_cr_s$pstate[, s31_tx_col]
)

s31_cif_compare <- s31_km |>
  select(Era, time_d, cif_km = cif) |>
  left_join(s31_cif_cr, by = c("Era", "time_d")) |>
  mutate(overstatement_pp = 100 * (cif_km - cif_cr))

cat("\n[Sec 31] KM vs competing-risks cumulative incidence of transplant.\n",
    "The KM column is what the table and figures report; the gap is the amount\n",
    "by which treating waitlist death as censoring inflates it:\n", sep = "")
print(s31_cif_compare |>
        mutate(KM = sprintf("%.1f%%", 100 * cif_km),
               `Competing risks` = sprintf("%.1f%%", 100 * cif_cr),
               Gap = sprintf("%+.1f pp", overstatement_pp)) |>
        select(Era, time_d, KM, `Competing risks`, Gap), n = 20)


#--- 31.5 Figures -------------------------------------------------------------
# Two views of the same cohort, from two DIFFERENT estimators -- deliberately.
#
# [F12] THIS FIGURE USED TO PLOT THE WRONG ESTIMATOR FOR ITS OWN TITLE. It was
# built from s31_fit with fun = 100 * (1 - y), i.e. 1 - Kaplan-Meier, while
# being titled "Cumulative Incidence" and labelled "Received a kidney
# transplant (%)". With death-without-transplant present as a COMPETING event,
# 1 - KM is not the cumulative incidence of transplant: it treats those deaths
# as censoring, i.e. as though the patient could still go on to be
# transplanted, and therefore systematically OVERSTATES the probability of
# transplant. That overstatement is precisely what 31.4's s31_cif_compare
# already measures in its Gap column -- the corrected estimate was being
# computed, printed, and then not plotted.
#
# The curve is now the Aalen-Johansen cumulative incidence taken from
# s31_cr_fit, so the figure's title, its axis label and its data agree. The
# accompanying test is Gray's test (the competing-risks analogue of the
# log-rank), not the log-rank, for the same reason.
#
# s31_plot_km below is UNCHANGED by [F12] and remains a Kaplan-Meier: "% still
# waiting" is a survival-scale quantity, it is labelled as a KM, and it is
# correct as such. (Referred to as "fig14" when [F12] was written; the export
# section renumbered it to fig15 when the matched block gained a figure. Named
# by object here so the two cannot drift again.)
#
# ggsurvplot() cannot render a multi-state survfit (it assumes a single
# survival curve per stratum), so the panel is assembled directly from
# s31_cr_fit and paired with a risk table built from s31_fit -- "number still
# waiting" is n.risk, which is identical in the two fits because they share the
# same data and the same censoring.
#
# [F13] BOTH SECTION 31 FIGURES WERE HORIZONTALLY MISALIGNED -- the curve panel
# sat roughly a third of the figure's width to the right of where it belonged,
# and in the CIF figure it overflowed the device entirely, clipping the title
# and the right-hand end of both curves.
#
# The cause is the era labels, not the assembly code. s31_era_levels carries
# the full date ranges ("Pre-policy: 01JAN2010 - 09AUG2017"), and those strings
# were passed straight through as legend.labs, which is ALSO what survminer
# uses for the risk table's row stubs. The stub column is sized to its widest
# label, and both the ggsurvplot path (which aligns $plot to $table) and the
# hand-assembled path below (rbind(..., size = "max"), which takes the wider of
# the two left margins by design) then propagate that width to the curve panel.
# So a ~33-character row label silently became the curve panel's left offset in
# both figures. km_pad_risk_table()'s KM_TABLE_PAD_PT could not help: it pads
# both panels equally, which is what keeps the columns in register, and the
# problem was never the padding.
#
# Fix: the FIGURES use short stub/legend labels ("Pre-policy" / "Post-policy")
# and carry the date ranges in the subtitle, where they cost no panel width.
# s31_era_levels itself is untouched, so every table, model and P value in this
# section still keys off the full labels and no number changes.
s31_era_short <- sub(":.*$", "", s31_era_levels)
s31_era_sub   <- paste(s31_era_levels, collapse = "  |  ")

# Gray's test for equality of the transplant CIFs across eras. fstatus uses the
# same as.numeric(factor) - 1 coding as Section 20, so censor = 0, transplant =
# 1, death = 2; the test row we want is the transplant cause.
s31_tx_code  <- which(levels(s31_dat$etype) == "transplant") - 1L
s31_gray_tab <- cmprsk::cuminc(ftime   = s31_dat$time,
                               fstatus = as.numeric(s31_dat$etype) - 1,
                               group   = s31_dat$Era)$Tests
s31_gray_p   <- unname(s31_gray_tab[as.character(s31_tx_code), "pv"])
cat("\n[Sec 31] Gray's test P (transplant CIF, pre- vs post-policy era):",
    fmt_p(s31_gray_p), "\n")

# Tidy the Aalen-Johansen estimate. A multi-state survfit stacks its strata end
# to end, so the stratum label is rep()ed out by $strata exactly as
# summary()$strata does in 31.4. A t = 0 row per era pins each curve to the
# origin, matching axes.offset = FALSE elsewhere.
s31_cif_curve <- local({
  s   <- s31_cr_fit
  txc <- which(s$states == "transplant")
  d <- tibble(
    Era   = factor(rep(gsub("^Era=", "", names(s$strata)), times = s$strata),
                   levels = levels(s31_dat$Era)),
    time  = s$time,
    cif   = 100 * s$pstate[, txc],
    lower = 100 * s$lower[, txc],
    upper = 100 * s$upper[, txc]
  ) |>
    # survfit leaves the confidence limits NA where the CIF is still 0; carrying
    # the point estimate there keeps the ribbon from breaking at the origin.
    mutate(lower = dplyr::coalesce(lower, cif),
           upper = dplyr::coalesce(upper, cif))
  bind_rows(
    tibble(Era = factor(levels(s31_dat$Era), levels = levels(s31_dat$Era)),
           time = 0, cif = 0, lower = 0, upper = 0),
    d
  ) |> arrange(Era, time)
})

# geom_ribbon interpolates linearly between vertices, which would round off a
# step function. Duplicating each vertex at the start of the next interval makes
# the ribbon step in register with geom_step().
s31_cif_ribbon <- s31_cif_curve |>
  group_by(Era) |>
  arrange(time, .by_group = TRUE) |>
  mutate(t_end = dplyr::lead(time, default = max(S31_XLIM))) |>
  ungroup()
s31_cif_ribbon <- bind_rows(mutate(s31_cif_ribbon, tt = time),
                            mutate(s31_cif_ribbon, tt = t_end)) |>
  arrange(Era, tt)

s31_cif_pcoord <- km_pval_coord(S31_XLIM)
s31_cif_panel <- ggplot() +
  geom_ribbon(data = s31_cif_ribbon,
              aes(x = tt, ymin = lower, ymax = upper, fill = Era), alpha = 0.15) +
  geom_step(data = s31_cif_curve, aes(x = time, y = cif, colour = Era),
            linewidth = 0.8) +
  annotate("text", x = s31_cif_pcoord[1], y = s31_cif_pcoord[2], hjust = 0,
           size = 3.5, label = paste0("Gray's test P = ", fmt_p(s31_gray_p))) +
  coord_cartesian(xlim = S31_XLIM, ylim = KM_YLIM, expand = FALSE, clip = "off") +
  scale_x_continuous(breaks = seq(S31_XLIM[1], S31_XLIM[2], 365)) +
  # [F13] The curve panel's legend keys are relabelled to the short era names so
  # the legend matches the risk-table stubs below it; the full date ranges move
  # to the subtitle. Both scales must be relabelled or the ribbon and the line
  # split into two legends. The title is also split into title + subtitle: the
  # single-line version overran the 8in device even once the panel was back in
  # position.
  scale_colour_discrete(labels = s31_era_short) +
