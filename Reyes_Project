options(dplyr.summarise.inform = FALSE)

# BATCH-RUN GRAPHICS DEVICE. Affects non-interactive runs ONLY -- in RStudio
# this is a no-op and the normal plot pane is untouched.
#
# This script calls print() on ~18 figures as it goes. Interactively those go to
# the RStudio device. Under Rscript there is no device open, so R falls back to
# pdf(), which (a) writes a junk Rplots.pdf into the working directory and (b)
# cannot encode the UTF-8 math glyphs used in several factor levels -- it emits
# "in 'mbcsToSbcs': >= substituted for >=" for every label containing >= or <=
# (KALT (>=1 y), LDRI <= 1.1, >=10 years), roughly 15 warnings per run.
#
# THOSE WARNINGS ARE ABOUT Rplots.pdf, NOT ABOUT THE EXPORTED FIGURES, and this
# distinction cost a wrong diagnosis once already. The exported PNGs are written
# by save_km()'s png() and by ggsave()'s ragg backend, both of which render the
# glyphs correctly and emit nothing. Do NOT "fix" this by rewriting the factor
# levels to ASCII -- that degrades every figure and CSV to solve a problem that
# only ever existed in a file nobody reads. Verified by rendering both paths and
# inspecting the output.
#
# Routing incidental print() output to a null PNG device kills both problems:
# no stray Rplots.pdf, and no false warnings masking real ones.
if (!interactive()) {
  options(device = function(...) grDevices::png(nullfile()))
}


