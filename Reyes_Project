#             High-Risk Kidney (KDPI >85%) vs LTA
#===============================================================================
# Reproduces the reference "Table 5. Patient Survival Analysis and Time-Varying
# Mortality Hazard for KALT with KDPI >85% Compared to LTA."
#
# [F5] Living-donor recipients are EXCLUDED from THIS TABLE (313 patients). They
# remain in the cohort and in every other table -- KIDNEY_DON_TY_KEEP admits them
# (Section 1.3 [F10]) -- but this table's only axis is kidney quality, and a
# living-donor kidney has no KDPI, so they cannot be assigned to a group here.
# The exclusion is therefore local and explicit, done in 25.1 rather than
# upstream, and it is load-bearing: nothing else removes these patients.
#
# Note this is not the reference design either: the reference censored them at
# their kidney transplant date, letting them contribute pre-transplant
# person-time to the unexposed reference; excluding them drops that person-time
# too.
#
# [F6] THE EXPOSURE IS NOW DEFINED BY KIDNEY QUALITY AT ANY DELAY, NOT BY KALT
# STATUS. A patient who receives a KDPI >85% deceased-donor kidney becomes
# exposed AT THAT TRANSPLANT, whether it arrived within a year of their liver
# transplant or a decade later. Restricting the exposure to KALT (<365 day)
# recipients left only 2 patients with 0 deaths, which made both the KM curve
# and the hazard ratio non-estimable -- the HR came back as NE from
# fit_coxph_checked()'s separation guard (coef -12.0, SE 453). Counting
# high-KDPI transplants at any delay raises that to 41 patients with 6 deaths
# and yields a real estimate.
#
# This is safe to do here precisely BECAUSE the model is time-varying: the
# switch happens on the actual transplant date, so a patient who waited six
# years for their kidney spends those six years in the reference state. That is
# what distinguishes it from relabeling late recipients as KALT, which would
# credit those six event-free years to the exposed group (see [F6] in Section
# 1.3c for the arithmetic on why that is fatal).
#
# The gap between the two components below makes the point concretely. The
# fixed-label KM shows the high-risk group at 75.9% five-year survival against
# 45.9% for patients who never received a kidney -- an apparent 30-point
# advantage for the WORST kidneys. The time-varying HR on the same patients is
# 0.99 (95% CI 0.44-2.20). Almost the entire KM gap is immortal time and
# selection: you have to live long enough, and be well enough, to be offered a
# kidney at all.
#
#   THREE FIXED GROUPS (25.1)                 TIME-VARYING STATE (25.4)
#   -----------------------------------       -----------------------------------
#   High-risk: KDPI >85% deceased,            unexposed until their kidney TX,
#   any delay (n=41)                          exposed from then on
#
#   KDPI <=85% deceased, any delay            unexposed throughout
#   (n=2,242)
#
#   No kidney transplant (n=2,140)            unexposed throughout
#
#   Living donor, any delay (n=313)           EXCLUDED
#
# Two components:
#   (1) Descriptive KM patient survival at 1/3/5 years, high-risk vs the
#       never-transplanted group, anchored at kidney listing (reuses Section
#       23's endpoint construction -- same pt_time/pt_event as every other
#       patient-survival analysis here). This is a FIXED-label comparison and
#       carries immortal time by construction; it is reported because the
#       reference table reports it, not because it is the estimate to quote.
#   (2) The time-varying HR for the high-risk exposure -- THE PRIMARY RESULT --
#       built via the same tmerge() counting-process technique as Table 4
#       (Section 24) with a single exposed/unexposed switch, and checked with
#       the same fit_coxph_checked() separation safety net.
#===============================================================================

# Reference table reports 1/5/10 years; 10 years is not supportable here.
# Kidney listing spans 10AUG2017-03APR2025 with follow-up censored at
# STUDY_END; the longest pt_time observed in this table's KM population is
# 2,921 days (8.0 years). A 3650-day request to summary.survfit(extend=TRUE)
# returns each stratum's estimate at its last event time with n.risk = 0,
# labelled "10 years". See Section 23.
TABLE5_TIMES <- REPORT_TIMES   # c(365, 1095, 1825) -- 1, 3, 5 years

# [F5] Single source of truth for the group labels, so the classification, the
# KM strata, the display column and the gt() column header cannot drift.
TABLE5_HI_LABEL  <- "High-risk kidney (KDPI >85%)"
TABLE5_MID_LABEL <- "KDPI \u226485% deceased-donor kidney"
TABLE5_NOK_LABEL <- "No kidney transplant"

#--- 25.1 Group classification -------------------------------------------------
# [F6] Grouped by KIDNEY QUALITY AT ANY DELAY (KALT_STATUS_CALC 1 or 2), not by
# KALT status. See the header block for why that is only defensible because
# 25.4's model is time-varying.
df_table5_group <- df_esrd_cohort |>
  transmute(
    PT_CODE, Group, KALT_STATUS_CALC, kidney_donor_type, KDPI_cat,
    table5_group = case_when(
      # never received a kidney -- the genuinely transplant-free reference, and
      # narrower than this pipeline's "LTA", which also contains late recipients
      KALT_STATUS_CALC == 0 ~ TABLE5_NOK_LABEL,
      KALT_STATUS_CALC %in% c(1, 2) & kidney_donor_type == "Deceased" &
        KDPI_cat == "KDPI >85" ~ TABLE5_HI_LABEL,
      KALT_STATUS_CALC %in% c(1, 2) & kidney_donor_type == "Deceased" &
        KDPI_cat %in% c("KDPI <20", "KDPI 20-85") ~ TABLE5_MID_LABEL,
      # living donors (no KDPI) and deceased donors with a missing KDPI
      TRUE ~ NA_character_
    )
  )

cat("\n[Table 5] Group classification (exposure = KDPI >85% at ANY delay):\n")
print(df_table5_group |> count(table5_group))

n_hi <- sum(df_table5_group$table5_group == TABLE5_HI_LABEL, na.rm = TRUE)
cat("\n[F6] High-risk group n =", n_hi, "-- restricting this to KALT (<365 day)",
    "recipients would leave only",
    sum(df_table5_group$KALT_STATUS_CALC == 1 &
          df_table5_group$table5_group == TABLE5_HI_LABEL, na.rm = TRUE),
    "patient(s), which is not estimable.\n")
cat("[F5] Excluded from this table (no assignable KDPI):\n")
print(df_table5_group |> filter(is.na(table5_group)) |>
        count(kidney_donor_type, kdpi_missing = is.na(KDPI_cat)))
if (n_hi < 10) {
  warning("[Table 5] The high-risk (KDPI >85%) group has only ", n_hi,
          " patient(s). The KM curve and the time-varying HR below are not ",
          "interpretable at this n and must not be reported without it.")
}

#--- 25.2 Attach listing-anchored patient-survival time -----------------------
# [F3] df_supp1_all, not df_supp1: this table never uses LDRI, so it must not
# inherit Supplementary Table 1's LDRI-tier requirement (which would drop 244
# LTA vs 2 KALT patients for reasons unrelated to this comparison).
df_table5 <- df_supp1_all |>
  select(PT_CODE, pt_time, pt_event, kidney_listing_date, kidney_tx_date) |>
  left_join(df_table5_group |> select(PT_CODE, table5_group), by = "PT_CODE") |>
  filter(!is.na(table5_group))

cat("\n[Table 5] Analysis population after the follow-up filter:\n")
print(df_table5 |> group_by(table5_group) |>
        summarise(n = n(), deaths = sum(pt_event), .groups = "drop"))

#--- 25.3 Descriptive KM: high-risk vs never-transplanted ----------------------
# [F6] The comparator is the never-transplanted group, not "LTA": under the
# quality-at-any-delay exposure definition, "LTA" would straddle two of this
# table's three groups. THIS COMPARISON CARRIES IMMORTAL TIME BY CONSTRUCTION
# -- a patient must survive to their transplant to be classified high-risk --
# and is reported only because the reference table reports it. Quote 25.4's
# time-varying HR instead.
df_table5_km <- df_table5 |>
  filter(table5_group %in% c(TABLE5_HI_LABEL, TABLE5_NOK_LABEL)) |>
  mutate(table5_group = factor(table5_group,
                               levels = c(TABLE5_NOK_LABEL, TABLE5_HI_LABEL)))

cat("\n[Table 5] Descriptive KM population:\n")
print(df_table5_km |> count(table5_group))

fit_table5_km <- survfit(Surv(pt_time, pt_event) ~ table5_group, data = df_table5_km)
s5 <- summary(fit_table5_km, times = TABLE5_TIMES, extend = TRUE)
km5 <- tibble(
  stratum = gsub("^table5_group=", "", as.character(s5$strata)),
  time_d  = s5$time,
  surv_ci = sprintf("%.2f (%.2f-%.2f)", s5$surv, s5$lower, s5$upper)
)
print(km5, n = 20)

#--- 25.4 Time-varying HR: high-risk exposure vs unexposed --------------------
base5 <- df_table5 |>
  filter(!is.na(pt_time), !is.na(pt_event)) |>
  transmute(
    PT_CODE, tstart = 0, tstop = pt_time, event = pt_event,
    # [F6] NA (never switches) for the never-transplanted group and for KDPI
    # <=85% recipients -- both correctly stay unexposed for their whole
    # follow-up. For the high-risk group the offset is measured from KIDNEY
    # LISTING to their own kidney transplant, so a late recipient's long
    # pre-transplant stretch is credited to the UNEXPOSED state. That is the
    # whole reason the exposure can safely be defined at any delay.
    exposure_offset = if_else(
      table5_group == TABLE5_HI_LABEL,
      as.numeric(kidney_tx_date - kidney_listing_date), NA_real_
    )
  )

# Same guards as Table 4's build_table4_tv, for the same reasons.
n_bad <- sum(!is.na(base5$exposure_offset) & base5$exposure_offset >= base5$tstop, na.rm = TRUE)
if (n_bad > 0) {
  warning(n_bad, " patient(s) have a transplant date at/after their outcome ",
          "time in Table 5 -- dropping them from the time-varying model.")
  base5 <- base5 |> filter(is.na(exposure_offset) | exposure_offset < tstop)
}
n_zero <- sum(base5$tstop <= 0)
if (n_zero > 0) {
  warning(n_zero, " patient(s) have zero or negative follow-up time in Table 5 ",
          "-- excluded from the time-varying model.")
  base5 <- base5 |> filter(tstop > 0)
}

long5 <- tmerge(base5, base5, id = PT_CODE, tstop = tstop, event = event(tstop, event))
long5 <- tmerge(long5, base5, id = PT_CODE, exposed = tdc(exposure_offset))

cat("\n[Table 5] Person-time and events by exposure state:\n")
print(long5 |> group_by(exposed) |>
        summarise(person_years = round(sum(tstop - tstart) / 365.25, 1),
                  events = sum(event), .groups = "drop"))

long5 <- long5 |>
  mutate(exposure_label = factor(if_else(exposed == 1, "Exposed", "Unexposed"),
                                 levels = c("Unexposed", "Exposed")))

r_table5 <- fit_coxph_checked(Surv(tstart, tstop, event) ~ exposure_label, long5, "Table 5 HR")
fit_table5 <- r_table5$fit
cat("\n[Table 5] Time-varying HR, high-risk kidney vs unexposed:\n")
print(summary(fit_table5)$conf.int)

#--- 25.5 Assemble Table 5 ------------------------------------------------------
table5_hr_row <- extract_hr(fit_table5, "exposure_labelExposed",
                            "HR of a KDPI >85% kidney (any delay)",
                            r_table5$separation_terms)

table5_km_wide <- km5 |>
  mutate(year = case_when(time_d == 365 ~ "1y", time_d == 1095 ~ "3y",
                          time_d == 1825 ~ "5y", TRUE ~ NA_character_)) |>
  select(stratum, year, surv_ci) |>
  tidyr::pivot_wider(names_from = stratum, values_from = surv_ci)

n_nok    <- sum(df_table5_km$table5_group == TABLE5_NOK_LABEL)
n_hi_km  <- sum(df_table5_km$table5_group == TABLE5_HI_LABEL)
# The HR's unexposed state is every non-high-risk patient in df_table5, which is
# wider than the KM's comparator column -- it also contains the KDPI <=85%
# recipients. Reported so the two halves of the table cannot be misread as
# describing the same reference group.
n_unexp  <- sum(df_table5$table5_group != TABLE5_HI_LABEL)

table5_display <- bind_rows(
  table5_km_wide |> rename(Row = year),
  tibble(Row = "HR (95% CI)",
         !!TABLE5_HI_LABEL := table5_hr_row$HR_CI,
         !!TABLE5_NOK_LABEL := "1.00 (reference)")
) |>
  mutate(Row = recode(Row, "1y" = "Patient survival, 1 year",
                      "3y" = "Patient survival, 3 years",
                      "5y" = "Patient survival, 5 years"))

cat("\n[Table 5] Final display:\n")
print(table5_display, width = 200)

table5_gt <- table5_display |>
  gt(rowname_col = "Row") |>
  tab_header(
    title = "Table 5",
    subtitle = paste0("Patient Survival and Time-Varying Mortality Hazard: ",
                      "High-Risk Kidney (KDPI >85%, any delay, n=", n_hi_km,
                      ") vs No Kidney Transplant (n=", n_nok, ")")
  ) |>
  cols_label(!!TABLE5_HI_LABEL :=
               paste0("KDPI >85%, any delay (n=", n_hi_km, ")"),
             !!TABLE5_NOK_LABEL := paste0("No kidney transplant (n=", n_nok, ")")) |>
  tab_footnote(footnote = paste0(
    "EXPOSURE IS TIME-VARYING AND DEFINED AT ANY DELAY. A patient becomes ",
    "exposed on the date they receive a KDPI >85% deceased-donor kidney, ",
    "whether that is within a year of their liver transplant or years later; ",
    "all of their pre-transplant follow-up is contributed to the unexposed ",
    "state. Restricting the exposure to KALT (<365 day) recipients leaves 2 ",
    "patients with 0 deaths and no estimable hazard ratio. The unexposed state ",
    "for the HR comprises all ", n_unexp, " non-high-risk patients (those who ",
    "never received a kidney plus recipients of a KDPI \u226485% kidney at any ",
    "delay), which is WIDER than the Kaplan-Meier comparator column.")) |>
  tab_footnote(footnote = paste(
    "The Kaplan-Meier rows are a FIXED-label comparison and carry immortal-time",
    "bias by construction: a patient must survive from kidney listing to their",
    "kidney transplant in order to be classified high-risk at all. They are",
    "reported because the reference table reports them. The hazard ratio, which",
    "is free of that bias, is the estimate to quote -- and the gap between the",
    "two is large here, which is itself the finding.")) |>
  tab_footnote(footnote = paste(
    "DEVIATION FROM THE ORIGINAL TABLE: living-donor recipients are EXCLUDED",
    "from this table entirely, rather than censored at their kidney transplant",
    "date as in the original methodology. They have no KDPI and so cannot be",
    "assigned to a kidney-quality group; excluding them also removes the",
    "pre-transplant person-time they would have contributed to the unexposed",
    "reference under the original design.")) |>
  tab_footnote(footnote = paste(
    "DEVIATION FROM THE ORIGINAL TABLE: the reference group is patients who",
    "NEVER received a kidney, which is narrower than this pipeline's \"LTA\"",
    "label (that label also contains patients transplanted 365 days or more",
    "after their liver transplant, who appear in this table's other two",
    "columns instead).")) |>
  tab_footnote(footnote = paste(
    "Reported at 1, 3 and 5 years rather than the reference table's 1, 5 and",
    "10 years. Kidney listing spans 10AUG2017-03APR2025; the longest observed",
    "follow-up from listing is 2,921 days (8.0 years), so a 10-year column",
    "would report an end-of-follow-up estimate with no patients at risk rather",
    "than a 10-year one."))

table5_gt


#===============================================================================
# SECTION 26. TABLE 6 -- Patient Survival by Period Between OLT and
#             Successive Kidney Transplant, INCLUDING KALT (<1 year)
#===============================================================================
# Reproduces "Table 6. Overall Patient Survival Analysis Based on the Period
# Between OLT and Successive Kidney Transplant," WITH ONE ADDITION: the
# reference table's six bins (<=2, 2-4, 4-6, 6-8, 8-10, >=10 years) describe
# only LATE successive kidney transplants -- by this pipeline's Group
# definition, KALT_STATUS_CALC == 2. Patients who received their kidney within
# the first year (true KALT, KALT_STATUS_CALC == 1) were not part of that
# picture at all. This section adds a "KALT (<1 year)" bin at the head of the
# spectrum and reports the same descriptive KM survival for it, so the full
# range from immediate to very delayed kidney transplantation is visible in
# one table. The original six intervals are kept as-is (relabeled "1-2 years"
# in place of "<=2" for precision, since <=2 years is only non-overlapping
# with the new bin if its true floor is 1 year, not 0).
#
# [F8] The first bin's boundary is TABLE6_KALT_BIN_DAYS = 365.25 days, i.e. one
# Julian year, matching the scale of every other boundary in the row. It is a
# quarter-day wider than KALT_STATUS_CALC == 1 (< 365 days), so this table's
# first column is not exactly the KALT arm -- see the constant's definition
# below and the reconciliation printed in 26.1 for the exact patient count.
#
# TIME ORIGIN: unlike patient survival elsewhere in this pipeline (anchored at
# kidney LISTING to avoid immortal time bias -- Sections 18/19/23-25), this
# table is a LANDMARK analysis anchored at the (successive) KIDNEY TRANSPLANT
# DATE itself. That is what the reference table's numbers require: 1-year
# survival is ~97-99% in EVERY bin including ">=10 years", which is only
# coherent if "1 year" means one year after that patient's own kidney
# transplant -- a patient in the ">=10 years" bin has not even reached that
# transplant yet at the 1-year-post-OLT mark, so "1-year survival from OLT"
# could not be reported for them. This is therefore a conditional/landmark
# analysis: given a patient survived to receive a successive kidney transplant
# at a given delay after OLT, what is their survival FROM THAT TRANSPLANT
# forward. It answers "does the timing of the second transplant predict
# subsequent survival," not "does timing affect survival measured from a
# common clock" -- the latter is what Sections 18/19's listing-anchored
# analyses already cover for the KALT-vs-LTA comparison specifically.
#
# Population: everyone who ever received a successive kidney transplant, at
# any delay after OLT (KALT_STATUS_CALC %in% c(1, 2)) -- built directly from
# df_index (Section 16), which already carries liver_tx_date, kidney_tx_date,
# death_date, and last_fu_date; no join back to df_esrd_cohort is needed since
# this table is purely descriptive (no covariate adjustment).
#===============================================================================

# Reference table reports 1/5/10 years; 10 years is not supportable here.
# Survival is landmarked at the kidney transplant date (see TIME ORIGIN
# above), and with the 10AUG2017-03APR2025 listing window and 03APR2025
# censoring date the observed maximum pt_time_k is 2,906 days (7.96 years).
# Per bin the maxima run 2,557-2,906 days, so a 3650-day request returns each
# bin's estimate at its own last event time -- a different real time point in
# every column, with n.risk = 0 -- all printed under one "10 y" row label.
# See Section 23.
TABLE6_TIMES <- REPORT_TIMES   # c(365, 1095, 1825) -- 1, 3, 5 years

# [F8] First-bin boundary, in DAYS, stated explicitly as a decision rather than
# left to fall out of `days / 365.25 < 1`. 365.25 is the chosen value: this
# table's remaining bins are all multiples of the Julian year (2, 4, 6, 8, 10 x
# 365.25 days), so a 365-day first boundary would be the only non-Julian cut in
# the row and would leave a quarter-day gap between bin 1 and bin 2.
#
# CONSEQUENCE, ACCEPTED DELIBERATELY: this is a quarter-day wider than the
# pipeline's KALT definition (KALT_STATUS_CALC == 1 is days < 365, Section 8), so
# a patient transplanted on exactly day 365 falls in this table's first bin while
# Group/Group3 classify them as a late kidney recipient. 26.1 prints exactly how
# many patients that is; in this cohort it is 2. Nothing else in the pipeline
# uses this boundary, so the discrepancy is confined to this table's first
# column and does not propagate.
TABLE6_KALT_BIN_DAYS <- 365.25

TABLE6_FIRST_BIN  <- "KALT (<1 year)"
TABLE6_BIN_LEVELS <- c(TABLE6_FIRST_BIN, "1-2 years", "2-4 years", "4-6 years",
                       "6-8 years", "8-10 years", "\u226510 years")

#--- 26.1 Bin classification ---------------------------------------------------
df_table6_pop <- df_index |>
  filter(KALT_STATUS_CALC %in% c(1, 2), !is.na(kidney_tx_date), !is.na(liver_tx_date)) |>
  mutate(
    olt_to_kidney_days  = as.numeric(kidney_tx_date - liver_tx_date),
    olt_to_kidney_years = olt_to_kidney_days / 365.25,
    table6_bin = case_when(
      # [F8] first bin cut in days against the explicit constant; the rest stay
      # in Julian years, which is the same scale expressed differently
      olt_to_kidney_days < TABLE6_KALT_BIN_DAYS ~ TABLE6_FIRST_BIN,
      olt_to_kidney_years < 2  ~ "1-2 years",
      olt_to_kidney_years < 4  ~ "2-4 years",
      olt_to_kidney_years < 6  ~ "4-6 years",
      olt_to_kidney_years < 8  ~ "6-8 years",
      olt_to_kidney_years < 10 ~ "8-10 years",
      TRUE                     ~ "\u226510 years"
    ),
    table6_bin = factor(table6_bin, levels = TABLE6_BIN_LEVELS)
  )

cat("\n[Table 6] Bin n (", TABLE6_FIRST_BIN,
    " is the addition to the reference table):\n", sep = "")
print(df_table6_pop |> count(table6_bin))

# [F8] Reconciliation against the pipeline's KALT definition. Any patient listed
# here is in Table 6's first bin but is NOT KALT by Group3 -- i.e. transplanted
# on exactly day 365 -- and is the entire cost of using a 365.25-day boundary.
t6_boundary <- df_table6_pop |>
  filter(table6_bin == TABLE6_FIRST_BIN, KALT_STATUS_CALC != 1)
cat("[F8] First-bin boundary (", TABLE6_KALT_BIN_DAYS, " days) vs KALT (<365 days): ",
    nrow(t6_boundary), " patient(s) in the '", TABLE6_FIRST_BIN,
    "' column are classified as late kidney by Group3.\n", sep = "")
if (nrow(t6_boundary) > 0) {
  print(t6_boundary |> count(olt_to_kidney_days, Group3, KALT_STATUS_CALC))
}

#--- 26.2 Post-kidney-transplant patient survival (landmarked at kidney TX) ---
# Reuses make_patient_endpoint() (Section 2) exactly as everywhere else in
# this pipeline -- only the origin argument changes.
df_table6 <- df_table6_pop |>
  bind_cols(make_patient_endpoint(df_table6_pop, "kidney_tx_date") |>
              rename(pt_time_k = time, pt_event_k = event))

cat("\nNegative/missing post-kidney-TX follow-up (inspect, don't drop silently):\n")
print(df_table6 |> summarise(neg = sum(pt_time_k < 0, na.rm = TRUE),
                             na  = sum(is.na(pt_time_k))))
df_table6 <- df_table6 |> filter(pt_time_k >= 0)

#--- 26.3 KM survival by bin + overall and pairwise log-rank ------------------
fit_table6 <- survfit(Surv(pt_time_k, pt_event_k) ~ table6_bin, data = df_table6)
s6 <- summary(fit_table6, times = TABLE6_TIMES, extend = TRUE)
km6 <- tibble(
  bin = factor(gsub("^table6_bin=", "", as.character(s6$strata)), levels = TABLE6_BIN_LEVELS),
  time_d = s6$time,
  surv_ci = sprintf("%.2f (%.2f-%.2f)", s6$surv, s6$lower, s6$upper)
)

p_overall6 <- lr_p(Surv(pt_time_k, pt_event_k) ~ table6_bin, df_table6)
cat("\n[Table 6] Overall log-rank p (7-group, including the new KALT bin):",
    p_overall6, "\n")

# The specific question this section was added to answer: does the new first bin
# differ from any of the original six. Not shown in the reference table's layout
# (which reports one overall p only), so printed here rather than folded into the
# display table. [F8] Label now comes from TABLE6_FIRST_BIN so it cannot drift
# from the factor level it filters on.
cat("\n[Table 6] Pairwise log-rank: ", TABLE6_FIRST_BIN, " vs each other bin",
    " (unadjusted -- this is exploratory, not the paper's primary comparison):\n",
    sep = "")
other_bins6 <- setdiff(TABLE6_BIN_LEVELS, TABLE6_FIRST_BIN)
pairwise_kalt6 <- bind_rows(lapply(other_bins6, function(b) {
  sub <- df_table6 |> filter(table6_bin %in% c(TABLE6_FIRST_BIN, b))
  tibble(comparison = paste(TABLE6_FIRST_BIN, "vs", b),
         p = lr_p(Surv(pt_time_k, pt_event_k) ~ table6_bin, sub))
}))
print(pairwise_kalt6)

#--- 26.4 Assemble Table 6 -----------------------------------------------------
n_by_bin6 <- df_table6 |> count(table6_bin)

table6_wide <- km6 |>
  mutate(year = case_when(time_d == 365 ~ "1 y", time_d == 1095 ~ "3 y",
                          time_d == 1825 ~ "5 y", TRUE ~ NA_character_)) |>
  select(bin, year, surv_ci) |>
  pivot_wider(names_from = bin, values_from = surv_ci) |>
  mutate(year = factor(year, levels = c("1 y", "3 y", "5 y"))) |>
  arrange(year) |>
  select(year, all_of(TABLE6_BIN_LEVELS))

table6_wide$`P value` <- c(fmt_p(p_overall6), "", "")

cat("\n[Table 6] Final display:\n")
print(table6_wide, width = 200)

col_labels6 <- setNames(
  paste0(TABLE6_BIN_LEVELS, " (n=", n_by_bin6$n[match(TABLE6_BIN_LEVELS, n_by_bin6$table6_bin)], ")"),
  TABLE6_BIN_LEVELS
)

table6_gt <- table6_wide |>
  gt(rowname_col = "year") |>
  tab_header(
    title = "Table 6",
    subtitle = paste("Overall Patient Survival by Period Between OLT and",
