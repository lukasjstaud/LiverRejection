extract_block <- function(fit_pt, fit_kg, sep_pt, sep_kg, prefix, labels, ref_label, block_name) {
  ref_row <- tibble(Row = ref_label, HR_CI = "1.00 (reference)", P = "",
                    Endpoint = rep(c("Patient survival", "Kidney graft survival"), 1))
  bind_rows(
    tibble(Row = ref_label, HR_CI = "1.00 (reference)", P = "", Endpoint = "Patient survival"),
    tibble(Row = ref_label, HR_CI = "1.00 (reference)", P = "", Endpoint = "Kidney graft survival"),
    extract_hr_by_prefix(fit_pt, prefix, labels, sep_pt) |> mutate(Endpoint = "Patient survival"),
    extract_hr_by_prefix(fit_kg, prefix, labels, sep_kg) |> mutate(Endpoint = "Kidney graft survival")
  ) |> mutate(Block = block_name)
}

