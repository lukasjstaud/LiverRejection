  vec_fun   = s30_vec,
  denom_fun = function(eo) eo$n_listed,
  panel_label = "PANEL A -- observed waiting time (all transplants)"
)


#--- 30.6 Panel B -- landmark-matched waiting time ----------------------------
# Restrict to patients who had a full S30_LANDMARK_DAYS of potential
# observation after listing, and count only transplants inside that window, so
# both eras are observed over the same length of time.
s30_landmark <- function(era_obj) {
  cutoff <- S29_STUDY_END - S30_LANDMARK_DAYS
  elig   <- era_obj$all |> filter(!is.na(kidney_listing_date))
  elig   <- elig |>
    mutate(listing_ref = if (identical(S30_LISTING_SOURCE, "first_listing"))
      kidney_listing_date else kidney_dedup_listing_date) |>
    filter(listing_ref <= cutoff)

  tx <- era_obj$tx |> filter(PT_CODE %in% elig$PT_CODE,
                             wait_days <= S30_LANDMARK_DAYS)
  died <- elig |>
    filter(is.na(kidney_tx_date), !is.na(death_date),
           as.numeric(death_date - listing_ref) <= S30_LANDMARK_DAYS) |>
    nrow()

  cat("[Sec 30 / ", era_obj$label, "] landmark ", S30_LANDMARK_DAYS, "d: ",
      nrow(elig), " of ", era_obj$n_listed,
      " listed patients have full potential observation (listed on or before ",
      format(cutoff), "); ", nrow(tx), " transplanted within the window; ",
      died, " died within it without a transplant\n", sep = "")

  # Rebuilt field by field rather than via modifyList(): both `all` and `tx` are
  # tibbles, i.e. lists, so modifyList() recurses INTO them and tries to merge
  # them column-wise instead of replacing them.
  list(label = era_obj$label, start = era_obj$start, end = era_obj$end,
       all = era_obj$all, tx = tx,
       n_listed = nrow(elig), n_died_no_tx = died)
}

cat("\n[Sec 30] Building Panel B (landmark-matched):\n")
s30_eras_lm <- lapply(s30_eras, s30_landmark)

s30_display_B <- s30_panel(
  s30_eras_lm,
  vec_fun   = s30_vec,
  denom_fun = function(eo) eo$n_listed,
  panel_label = paste0("PANEL B -- landmark-matched waiting time (",
                       S30_LANDMARK_DAYS, " days)")
)


