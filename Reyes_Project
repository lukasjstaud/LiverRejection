#===============================================================================
# SECTION 20. COMPETING-RISKS SENSITIVITY (death as competing event)
#===============================================================================
# Death-censored KM assumes patients who die would have carried the same graft
# failure risk as survivors. With meaningful early mortality that is optimistic.
# The Aalen-Johansen CIF makes no such assumption. Report as a sensitivity; if
# the two agree, the death-censored primary analysis is on solid ground.

df_cr <- df_km_kidney_kdpi |>
  mutate(
    admin_stop = pmin(death_date, last_fu_date, STUDY_END, na.rm = TRUE),
    cr_time    = pmin(kg_time, as.numeric(admin_stop - kidney_tx_date), na.rm = TRUE),
    cr_outcome = factor(case_when(
      kg_event == 1                                ~ "Graft failure",
      !is.na(death_date) & death_date <= STUDY_END ~ "Death with function",
      TRUE                                         ~ "censored"
    ), levels = c("censored", "Graft failure", "Death with function"))
  ) |>
  filter(cr_time > 0)

fit_cr <- survfit(Surv(cr_time, cr_outcome) ~ KDPI_cat, data = df_cr)
print(summary(fit_cr, times = REPORT_TIMES, extend = TRUE))

# Gray's test for equality of CIFs across KDPI tiers
print(cmprsk::cuminc(ftime   = df_cr$cr_time,
                     fstatus = as.numeric(df_cr$cr_outcome) - 1,
                     group   = df_cr$KDPI_cat)$Tests)


#===============================================================================
# SECTION 21. PROPENSITY SCORE MATCHING (KALT <1 y vs true LTA)
#===============================================================================
# [K3] THE CONTRAST THIS SECTION SUPPORTS:
#   treated = KALT <1 y -- kidney within 365 days of the liver transplant
#   control = TRUE LTA  -- listed for a kidney, never received one
#
# BOTH arms are clean, and that is the whole point. The comparator contains no
# future kidney recipients (asserted in 21.2), and the treated arm contains no
# patient who spent years unexposed before their transplant (the >=1-year
# stratum is filtered out in 21.2). That is what makes an ordinary fixed-label
# Kaplan-Meier on the liver-TX clock legitimate here, which is what Figures 7-9
# are. Contrast with [K2]: the merged KALT arm could not be drawn that way.
#
# RESIDUAL IMMORTAL TIME -- SMALL, NOT ZERO. To be classified KALT <1 y a
# patient must survive to their kidney transplant, a median 250 days (IQR
# 172-314). Deaths in that window land in the LTA arm by construction, so the
# fixed-label comparison still slightly favours KALT. This is the standard
# KALT-vs-LTA design in the literature and the bias is roughly a sixth of what
# the >=1-year stratum carried, but it is NOT nil -- Section 21b.4 quantifies it
# with a Simon-Makuch sensitivity analysis and prints the fixed-vs-time-varying
# HR gap. Report the sensitivity alongside the primary result.
#
# CONSEQUENCE FOR SAMPLE SIZE. Restricting to <1 y makes KALT much the smaller
# arm again (740 vs 2,140 true LTA), so controls are plentiful, matching
# discards surplus LTA rather than treated patients, and essentially every KALT
# patient should find a partner within the caliper. 21.3 prints retention; a
# large KALT discard now means the caliper is too tight, not that the arms are
# mismatched in size.
#
# 1:1 (or MATCH_RATIO:1) nearest-neighbor matching on the logit propensity
# score, treated = KALT, control = true LTA. Matching variables: ethnicity,
# sex, LDRI, recipient diabetes, dialysis status, cause of liver disease, and
# cause of ESRD -- plus recipient hypertension once RECIP_HTN_COL (Sec 1.3b) is
# set.
#
# This is a SENSITIVITY analysis alongside the unadjusted comparisons in
# Sections 13/19/20, not a replacement for them: matching trades some
# statistical efficiency (unmatched patients are dropped) for confidence that
# the two groups are comparable on observed covariates before comparing
# outcomes.
#
# NOTE ON PROPENSITY SCORE DIRECTION. MatchIt matches CONTROLS to TREATED, and
# KALT <1 y is the treated group. With 740 treated against 2,140 controls, this
# discards surplus LTA patients, not KALT ones -- every KALT patient is either
# matched or explicitly reported as discarded in 21.3. Report that count in the
# methods (e.g. "X of 740 KALT <1 y patients [Z%] were matched"). A material
# KALT discard implicates MATCH_CALIPER or the covariate set, since controls are
# not the scarce resource here.
#===============================================================================

#--- 21.1 Recipient hypertension column discovery -----------------------------
# Neither this pipeline's manifests (Section 3) nor either source script ever
# pulled a recipient hypertension field -- only donor hypertension exists
# (HIST_HYPERTENS_DON). Peek both raw files for candidates before proceeding.
cat("\n[Sec 21.1] Candidate recipient-hypertension columns -- liver_data:\n")
print(grep("HTN|HYPERTENS", names(haven::read_sas(LIVER_MAIN_PATH, n_max = 0)),
           ignore.case = TRUE, value = TRUE))
cat("\n[Sec 21.1] Candidate recipient-hypertension columns -- kidpan_data:\n")
print(grep("HTN|HYPERTENS", names(haven::read_sas(KIDPAN_MAIN_PATH, n_max = 0)),
           ignore.case = TRUE, value = TRUE))
cat("\nIf either list above contains the right field: add it to LIVER_COLS or\n",
    "KIDPAN_COLS in Section 3, add it to the recipient-label mutate() block in\n",
    "Section 10, re-run from Section 4, and set RECIP_HTN_COL in Section 1.3b.\n",
    "Proceeding without it for now if RECIP_HTN_COL is still NA.\n", sep = "")

include_htn <- !is.na(RECIP_HTN_COL) && RECIP_HTN_COL %in% names(df_esrd_cohort)
if (!include_htn) {
  warning("Recipient hypertension is NOT included in propensity matching -- ",
          "RECIP_HTN_COL is unset or not found on df_esrd_cohort. See Sec 21.1.")
}

#--- 21.2 Matching covariate frame ---------------------------------------------
match_covariates <- c("race_label", "sex_label", "LDRI", "diab_label",
                      "dialysis_label", "liver_etiology", "esrd_etiology")
if (include_htn) match_covariates <- c(match_covariates, RECIP_HTN_COL)

# [K3] THE MATCHED ANALYSIS USES A NARROWER POPULATION THAN THE TABLES.
# Tables 1-7 use the merged KALT definition (KALT_MAX_DAYS = Inf, [K1]). The
# matched figures do NOT: they are restricted to true LTA vs the KALT <1 y
# timing stratum, and the 1,467 >=1-year recipients are dropped here entirely.
#
# WHY THE TWO POPULATIONS DIFFER ON PURPOSE. A fixed-label KM on the liver-TX
# clock is only defensible when the exposure begins near time zero. That holds
# for <1-year recipients (median 250 days to transplant) and emphatically does
# not for >=1-year recipients (median 1,467 days, 67.5% of follow-up unexposed);
# including the latter in a fixed-label figure is what fabricates a 14.5-point
# survival advantage ([K2]). Restricting the population is what BUYS the right
# to draw Figures 7-9 as ordinary Kaplan-Meier curves.
#
# CONSEQUENCE FOR REPORTING: Figure 7-9 arm sizes will NOT match any table's
# KALT n, and they are not supposed to. Every matched figure caption states its
# own n and says the >=1-year stratum is excluded.
df_match_input <- df_esrd_cohort |>
  filter(Group3 %in% c("LTA (no kidney)", "KALT (<1 y)")) |>
  mutate(Group = droplevels(Group)) |>
  select(PT_CODE, Group, Group3, TX_DATE_KIDNEY, all_of(match_covariates))

cat("\n[K3] Matched-analysis population (>=1 y recipients excluded):\n")
print(df_match_input |> count(Group, Group3))
stopifnot(nlevels(df_match_input$Group) == 2,
          !any(df_match_input$Group3 == "KALT (≥1 y)"))

# [K1] The control arm must be uncontaminated by construction now. Under
# KALT_MAX_DAYS = Inf anyone who ever received a kidney is Group == "KALT", so a
# control holding a kidney-TX date means is_kalt() and the cohort disagree.
s21_bad_ctrl <- sum(df_match_input$Group == "LTA" &
                      !is.na(df_match_input$TX_DATE_KIDNEY), na.rm = TRUE)
if (s21_bad_ctrl > 0) {
  stop("[Sec 21.2] ", s21_bad_ctrl, " control-arm patients have a kidney ",
       "transplant date. Under KALT_MAX_DAYS = Inf the LTA arm must be ",
       "never-transplanted; check is_kalt() and Section 8's date merge.")
}
cat("\n[Sec 21.2] OK -- control arm is true LTA: 0 of ",
    sum(df_match_input$Group == "LTA", na.rm = TRUE),
    " controls ever received a kidney.\n", sep = "")

cat("\n[Sec 21.2] Missingness per matching covariate (MatchIt requires complete\n",
    "cases; anyone missing ANY of these is dropped from the matched analysis\n",
    "-- they remain in every other table and analysis in this pipeline):\n", sep = "")
print(sapply(df_match_input |> select(all_of(match_covariates)),
             function(x) sum(is.na(x))))

df_match_complete <- df_match_input |>
  filter(if_all(all_of(match_covariates), ~ !is.na(.)))

cat("\nComplete cases available for matching: ", nrow(df_match_complete),
    " of ", nrow(df_match_input), " (", nrow(df_match_input) - nrow(df_match_complete),
    " excluded for missing covariate data)\n", sep = "")
print(df_match_complete |> count(Group, Group3))

#--- 21.3 Fit the propensity model and match -----------------------------------
match_formula <- as.formula(
  paste("Group ~", paste(match_covariates, collapse = " + "))
)

set.seed(MATCH_SEED)
m.out <- matchit(match_formula, data = df_match_complete, method = "nearest",
                 distance = "glm", caliper = MATCH_CALIPER, ratio = MATCH_RATIO)

print(summary(m.out))
# Sample Sizes table in the printout above shows how many KALT patients were
# discarded for lack of a comparable LTA match within the caliper -- report
# this in the methods (e.g. "X of Y KALT patients [Z%] were matched").

# [K3] RETENTION. Controls outnumber treated roughly 3:1 here, so unmatched
# patients should be almost entirely LTA. Any substantial KALT loss means the
# caliper is rejecting treated patients who have no comparable control -- a
# statement about overlap, not about arm sizes -- and it makes the matched KALT
# arm unrepresentative of KALT <1 y as a whole. Print it rather than discovering
# it in the figure.
# Summarised rather than pivoted: a pivot on the logical drops the "FALSE"
# column entirely when every patient in the arm matched, and the downstream
# arithmetic then fails on a column that does not exist.
s21_retention <- df_match_complete |>
  mutate(matched = !is.na(m.out$weights) & m.out$weights > 0) |>
  group_by(Group, Group3) |>
  summarise(total = n(), matched = sum(matched),
            unmatched = total - matched, .groups = "drop") |>
  mutate(pct_matched = round(100 * matched / total, 1))
cat("\n[Sec 21.3] Match retention by arm:\n")
print(s21_retention, width = 200)
if (any(s21_retention$pct_matched[s21_retention$Group == "KALT"] < 90)) {
  warning("[Sec 21.3] Under 90% of KALT <1 y patients were matched. With ",
          "controls outnumbering treated ~3:1 this points at MATCH_CALIPER or ",
          "poor covariate overlap, not at arm sizes. The matched KALT arm is ",
          "then not representative of KALT <1 y as a whole -- say so in the ",
          "methods, or loosen the caliper.")
}

#--- 21.4 Balance assessment ---------------------------------------------------
# Prefer cobalt if available (nicer defaults, handles multi-level factors as a
# single row per covariate); otherwise fall back to a Love plot built directly
# from summary(m.out), which needs no extra package.
if (requireNamespace("cobalt", quietly = TRUE)) {
  print(cobalt::bal.tab(m.out, un = TRUE, stats = c("mean.diffs")))
  
  p_love <- cobalt::love.plot(
    m.out, stats = "mean.diffs", abs = TRUE, thresholds = c(m = 0.1),
    var.order = "unadjusted",
    title = "Covariate Balance Before and After Matching (KALT vs LTA)"
  )
} else {
  message("cobalt not installed -- building the Love plot from summary(m.out) directly.")
  s_bal <- summary(m.out, standardize = TRUE)
  smd_all     <- as.data.frame(s_bal$sum.all)
  smd_matched <- as.data.frame(s_bal$sum.matched)
  
  love_df <- tibble(
    covariate = rownames(smd_all),
    Unmatched = smd_all[["Std. Mean Diff."]],
    Matched   = smd_matched[["Std. Mean Diff."]][match(rownames(smd_all), rownames(smd_matched))]
  ) |>
    tidyr::pivot_longer(c(Unmatched, Matched), names_to = "sample", values_to = "smd") |>
    filter(!is.na(smd), covariate != "distance") |>
    mutate(sample = factor(sample, levels = c("Unmatched", "Matched")))
  
  p_love <- ggplot(love_df, aes(x = abs(smd), y = reorder(covariate, abs(smd)),
                                color = sample)) +
    geom_vline(xintercept = 0.1, linetype = "dashed", color = "grey50") +
    geom_point(size = 2) +
    labs(x = "Absolute standardized mean difference", y = NULL, color = NULL,
         title = "Covariate Balance Before and After Matching (KALT vs LTA)") +
    theme_classic()
}
print(p_love)
# Rule of thumb: |SMD| < 0.1 after matching indicates adequate balance on that
# covariate (Austin, 2011). Any covariate still above 0.1 in the "Matched"
# series is worth reporting as a residual imbalance / limitation.

#--- 21.5 Propensity score distribution (the requested "propensity score plot")
if (requireNamespace("cobalt", quietly = TRUE)) {
  p_ps <- cobalt::bal.plot(m.out, var.name = "distance", which = "both",
                           sample.names = c("Unmatched", "Matched")) +
    labs(title = "Propensity Score Overlap, KALT vs LTA")
} else {
  ps_df <- tibble(
    ps      = m.out$distance,
    Group   = df_match_complete$Group,
    matched = !is.na(m.out$weights) & m.out$weights > 0
  ) |>
    mutate(sample = factor(if_else(matched, "Matched", "Unmatched (all)"),
                           levels = c("Unmatched (all)", "Matched")))
  
  p_ps <- ggplot(ps_df, aes(x = ps, fill = Group)) +
    geom_density(alpha = 0.5) +
    facet_wrap(~ sample, ncol = 1) +
    labs(x = "Propensity score", y = "Density",
         title = "Propensity Score Distribution, KALT vs LTA") +
    theme_classic()
}
print(p_ps)
# Substantial non-overlap in the "Unmatched (all)" panel is expected -- it is
# exactly the imbalance being corrected. The "Matched" panel should show close
# overlap between the two groups; a persistent gap there means the caliper (or
# the covariate set) is not achieving good balance and MATCH_CALIPER,
# MATCH_RATIO, or the covariate list may need adjustment.


#===============================================================================
# SECTION 21b. OUTCOMES IN THE MATCHED COHORT
#===============================================================================
# Re-runs the primary endpoints (patient survival, death-censored liver graft
# survival) within the matched sample, using the SAME composite failure dates
# and endpoint builders as Sections 17-19 -- nothing about the endpoint
# definitions changes, only the population and the addition of pair-matching.
#
# [K3] THREE FIGURES, 5-YEAR KAPLAN-MEIER, MATCHED KALT <1 y vs TRUE LTA.
#
#   Fig 7  Patient survival                 clock: liver transplant   2 arms
#   Fig 8  Death-censored kidney graft      clock: KIDNEY transplant  KALT only
#   Fig 9  Death-censored liver graft       clock: liver transplant   2 arms
#
# These are ordinary fixed-label KM curves, which is legitimate HERE and was not
# legitimate for the merged KALT arm -- see [K3] in Section 21 for why the
# population restriction is what earns it.
#
# WHY FIG 8 IS DIFFERENT ON BOTH AXES, AND IT IS NOT AN OVERSIGHT:
#
#   NO LTA ARM. An LTA patient never received a kidney, so they have no kidney
#   graft that can fail. kg_time/kg_event are NA for every one of them (they are
#   built off kidney_tx_date in Section 18). A two-arm "kidney graft survival,
#   LTA vs KALT" is not a comparison with a missing arm -- it is a comparison
#   that does not exist. Fig 8 therefore shows the matched KALT <1 y arm alone,
#   stratified by KDPI tier, which is this project's actual question (does donor
#   kidney quality drive KALT outcomes).
#
#   DIFFERENT CLOCK. The other two panels run from liver transplant. Fig 8 runs
#   from KIDNEY transplant, because a graft cannot fail before it exists:
#   anchoring it at liver transplant would place the graft "at risk" over the
#   median 250 days before it was implanted, which is immortal time on the graft
#   endpoint specifically. The offset is under a year for every patient in this
#   arm, but the correct anchor is still the kidney.
#
# Reported for each two-arm endpoint:
#   (1) an unadjusted KM + log-rank within the matched sample (the figure), and
#   (2) a Cox model STRATIFIED BY MATCHED PAIR (coxph(... + strata(subclass))),
#       which is the correct way to analyse pair-matched survival data and is
#       the primary matched result to report.
#
# 21b.4 is the SENSITIVITY analysis for the residual immortal time that survives
# the population restriction (a KALT <1 y patient must live to their transplant,
# median 250 days). It is not optional reading: it is what tells you how much of
# Figure 7's separation is definitional.
#===============================================================================

df_matched <- match.data(m.out) |>
  select(PT_CODE, Group, subclass, weights)

# Bring back transplant-anchored dates and composite failure dates from
# df_index (Section 16) -- built once there, reused here unchanged.
df_matched_index <- df_matched |>
  left_join(df_index |> select(-Group), by = "PT_CODE")

# Same three endpoint builders as Section 18, so the matched figures and the
# full-cohort figures cannot disagree about what an event is. kg_* is anchored
# at kidney_tx_date and is therefore NA for every LTA patient by construction --
# that is the intended behaviour, and Fig 8 filters on it rather than trying to
# impute a graft that does not exist.
df_matched_km <- df_matched_index |>
  bind_cols(make_patient_endpoint(df_matched_index, "liver_tx_date") |>
              rename(pt_time = time, pt_event = event)) |>
  bind_cols(make_endpoint(df_matched_index, "liver_tx_date", "liver_fail_date") |>
              rename(lg_time = time, lg_event = event)) |>
  bind_cols(make_endpoint(df_matched_index, "kidney_tx_date", "kidney_fail_date") |>
              rename(kg_time = time, kg_event = event))

cat("\n[Sec 21b] Matched-cohort n and event counts:\n")
print(df_matched_km |> count(Group))
print(df_matched_km |> summarise(patient_deaths = sum(pt_event),
                                 liver_failures = sum(lg_event)))

#--- 21b.1 Composition of the matched arms -------------------------------------
# [K3] Both arms are clean by construction: the control arm never received a
# kidney (asserted in 21.2) and the treated arm contains only <1-year
# recipients (filtered in 21.2). The assertion below is what keeps that true if
# anyone widens the matching population later without revisiting Figures 7-9.
cat("\n[K3] Composition of the matched arms:\n")
print(df_matched_km |> count(Group, Group3))
stopifnot(!any(df_matched_km$Group3 == "KALT (≥1 y)", na.rm = TRUE))

n_ctrl         <- sum(df_matched_km$Group == "LTA",  na.rm = TRUE)
n_kalt_matched <- sum(df_matched_km$Group == "KALT", na.rm = TRUE)
cat("  matched: ", n_kalt_matched, " KALT <1 y vs ", n_ctrl,
    " true-LTA controls.\n", sep = "")

cat("\n[Sec 21b] Event counts in the matched cohort:\n")
print(df_matched_km |>
        group_by(Group) |>
        summarise(n              = n(),
                  patient_deaths = sum(pt_event, na.rm = TRUE),
                  liver_failures = sum(lg_event, na.rm = TRUE),
                  kidney_grafts  = sum(!is.na(kg_time)),
                  kidney_failures = sum(kg_event, na.rm = TRUE),
                  .groups = "drop"))
# The kidney_grafts column should read 0 for LTA and n for KALT. Anything else
# means a patient with no kidney transplant acquired a kidney follow-up window.
stopifnot(sum(!is.na(df_matched_km$kg_time[df_matched_km$Group == "LTA"])) == 0)

MATCHED_ARM_LABS <- c(sprintf("LTA, no kidney (n=%d)", n_ctrl),
                      sprintf("KALT <1 y (n=%d)", n_kalt_matched))

MATCHED_FIG_CAPTION <- paste0(
  "Propensity-matched 1:1 on the Section 21 covariates: ", n_kalt_matched,
  " KALT <1 y vs ", n_ctrl, " true-LTA controls (listed for a kidney, never transplanted).\n",
  "Kidney recipients transplanted >=1 year after their liver transplant are EXCLUDED from this figure -- their ",
  "median 4.0-year\nunexposed period makes a fixed-label curve uninterpretable ([K2]). Arm sizes therefore do not ",
  "match any table's KALT n.\n",
  "RESIDUAL IMMORTAL TIME: a KALT patient must survive to their transplant (median 250 d, IQR 172-314), so deaths ",
  "in that\nwindow fall to the LTA arm by construction and this comparison mildly favours KALT. Section 21b.4 ",
  "quantifies it.")

#--- 21b.2 Fig 7 -- patient survival, matched ----------------------------------
fit_pt_matched <- survfit(Surv(pt_time, pt_event) ~ Group, data = df_matched_km)
print(km_at(fit_pt_matched, "Patient survival, matched (KALT <1 y vs true LTA)"))
cat("Unadjusted log-rank p (matched sample, ignores pairing):",
    lr_p(Surv(pt_time, pt_event) ~ Group, df_matched_km), "\n")

fit_pt_cox <- coxph(Surv(pt_time, pt_event) ~ Group + strata(subclass),
                    data = df_matched_km)
cat("\nPair-stratified Cox, patient survival -- PRIMARY matched result:\n")
print(summary(fit_pt_cox))

plot_pt_matched <- km_pad_risk_table(ggsurvplot(
  fit_pt_matched, data = df_matched_km, fun = "pct", conf.int = TRUE,
  pval = TRUE, pval.method = TRUE, risk.table = TRUE, risk.table.height = 0.25,
  pval.coord = km_pval_coord(KM_XLIM),
  pval.method.coord = km_pval_method_coord(KM_XLIM),
  xlim = KM_XLIM, break.time.by = 365, ylim = KM_YLIM, axes.offset = FALSE,
  xlab = "Days from liver transplant", ylab = "Patient survival (%)",
  legend.title = "Arm", legend.labs = MATCHED_ARM_LABS,
  title = "Fig 7. Patient Survival, Propensity-Matched KALT <1 y vs LTA",
  caption = MATCHED_FIG_CAPTION, ggtheme = theme_classic()
), KM_XLIM)
print(plot_pt_matched)

#--- 21b.3 Fig 8 -- kidney graft failure, KALT <1 y only, by KDPI tier ---------
# ONE ARM BY NECESSITY, NOT BY CHOICE. See this section's header: LTA patients
# have no kidney graft, so there is no comparator curve to draw. The stratifier
# is KDPI tier, which is the project's own research question.
#
# CLOCK: kidney transplant, not liver transplant -- a graft cannot fail before
# it is implanted.
#
# Living donors carry no KDPI and so cannot be tiered; they drop out here and
# the count is printed rather than left implicit ([F10]).
df_matched_kg <- df_matched_km |>
  filter(Group == "KALT", !is.na(kg_time), kg_time >= 0)

cat("\n[Fig 8] Matched KALT <1 y patients with a usable kidney-graft window: ",
    nrow(df_matched_kg), " of ", n_kalt_matched, "\n", sep = "")
df_matched_kg_kdpi <- df_matched_kg |> filter(!is.na(KDPI_cat)) |>
  mutate(KDPI_cat = droplevels(KDPI_cat))
cat("[Fig 8] Of those, tierable by KDPI: ", nrow(df_matched_kg_kdpi),
    " (", nrow(df_matched_kg) - nrow(df_matched_kg_kdpi),
    " dropped -- living donors have no KDPI)\n", sep = "")
print(df_matched_kg_kdpi |> count(KDPI_cat))

# [K3] DROP KDPI TIERS TOO SMALL TO CARRY A CURVE.
# Measured on this cohort, the highest-KDPI tier nearly vanishes once the arm is
# restricted to <1-year recipients (n = 2). That is not noise, it is selection:
# high-KDPI kidneys go disproportionately to patients who wait longer, so they
# concentrate in the >=1-year stratum this figure excludes.
#
# A 2-patient stratum still PLOTS -- as a flat line at 100% survival with no
# events -- and reads as "the worst kidneys never fail", which is the opposite
# of what the data say. survfit will not warn. Drop such tiers explicitly and
# name them in the caption instead of letting them draw.
S21B_KG_MIN_N <- 10
s21b_kg_small <- df_matched_kg_kdpi |> count(KDPI_cat) |> filter(n < S21B_KG_MIN_N)
S21B_KG_DROPPED <- if (nrow(s21b_kg_small) > 0) {
  paste0(as.character(s21b_kg_small$KDPI_cat), " (n=", s21b_kg_small$n, ")",
         collapse = ", ")
} else NA_character_
if (nrow(s21b_kg_small) > 0) {
  cat("[Fig 8] Dropping KDPI tier(s) with n < ", S21B_KG_MIN_N, ": ",
      S21B_KG_DROPPED, "\n", sep = "")
  df_matched_kg_kdpi <- df_matched_kg_kdpi |>
    filter(!KDPI_cat %in% s21b_kg_small$KDPI_cat) |>
    mutate(KDPI_cat = droplevels(KDPI_cat))
}

S21B_KG_OK <- nrow(df_matched_kg_kdpi) > 0 &&
  nlevels(df_matched_kg_kdpi$KDPI_cat) >= 2 &&
  sum(df_matched_kg_kdpi$kg_event) > 0

if (!S21B_KG_OK) {
  warning("[Fig 8] Not enough tierable kidney-graft data in the matched KALT ",
          "arm to draw a KDPI-stratified curve. Figure 8 is skipped.")
  plot_kg_matched <- NULL
} else {
  fit_kg_matched <- survfit(Surv(kg_time, kg_event) ~ KDPI_cat,
                            data = df_matched_kg_kdpi)
  print(km_at(fit_kg_matched, "Kidney graft survival, matched KALT <1 y, by KDPI"))
  cat("Log-rank p across KDPI tiers:",
      lr_p(Surv(kg_time, kg_event) ~ KDPI_cat, df_matched_kg_kdpi), "\n")

  # NOT pair-stratified: the matched pairs are broken here, because each pair's
  # LTA member has no kidney graft and is absent from this frame. strata(subclass)
  # would leave one patient per stratum and contribute nothing to the partial
  # likelihood. This is an unmatched within-KALT comparison and is labelled so.
  fit_kg_cox <- coxph(Surv(kg_time, kg_event) ~ KDPI_cat, data = df_matched_kg_kdpi)
  cat("\nCox by KDPI tier (NOT pair-stratified -- pairs are broken, see comment):\n")
  print(summary(fit_kg_cox))

  plot_kg_matched <- km_pad_risk_table(ggsurvplot(
    fit_kg_matched, data = df_matched_kg_kdpi, fun = "pct", conf.int = TRUE,
    pval = TRUE, pval.method = TRUE, risk.table = TRUE, risk.table.height = 0.25,
    pval.coord = km_pval_coord(KM_XLIM),
    pval.method.coord = km_pval_method_coord(KM_XLIM),
    xlim = KM_XLIM, break.time.by = 365, ylim = KM_YLIM, axes.offset = FALSE,
    xlab = "Days from KIDNEY transplant", ylab = "Kidney graft survival (%)",
    legend.title = "KDPI", legend.labs = levels(df_matched_kg_kdpi$KDPI_cat),
    title = "Fig 8. Death-Censored Kidney Graft Survival, Matched KALT <1 y, by KDPI",
    caption = paste0(
      "MATCHED KALT <1 y ARM ONLY (n=", nrow(df_matched_kg_kdpi),
      "). There is no LTA curve because LTA patients never received a kidney and have no graft that\n",
      "can fail -- this panel is a within-KALT comparison of donor quality, not a KALT-vs-LTA contrast.\n",
      "TIME ORIGIN IS THE KIDNEY TRANSPLANT, unlike Figures 7 and 9, because a graft cannot fail before it exists.\n",
      "Living-donor recipients carry no KDPI and are excluded. Death-censored: patients dying with a functioning ",
      "graft are censored.",
      if (!is.na(S21B_KG_DROPPED)) paste0(
        "\nEXCLUDED FOR SPARSITY: ", S21B_KG_DROPPED,
        ". High-KDPI kidneys concentrate in the >=1-year stratum this figure does not cover,\n",
        "so the highest tier is too small here to estimate. Do NOT read its absence as an absence of risk.")
      else ""),
    ggtheme = theme_classic()
  ), KM_XLIM)
  print(plot_kg_matched)
}

#--- 21b.4 Fig 9 -- death-censored liver graft survival, matched ---------------
fit_lg_matched <- survfit(Surv(lg_time, lg_event) ~ Group, data = df_matched_km)
print(km_at(fit_lg_matched, "Liver graft survival, matched (KALT <1 y vs true LTA)"))
cat("Unadjusted log-rank p (matched sample, ignores pairing):",
    lr_p(Surv(lg_time, lg_event) ~ Group, df_matched_km), "\n")

fit_lg_cox <- coxph(Surv(lg_time, lg_event) ~ Group + strata(subclass),
                    data = df_matched_km)
cat("\nPair-stratified Cox, liver graft survival -- PRIMARY matched result:\n")
print(summary(fit_lg_cox))

plot_lg_matched <- km_pad_risk_table(ggsurvplot(
  fit_lg_matched, data = df_matched_km, fun = "pct", conf.int = TRUE,
  pval = TRUE, pval.method = TRUE, risk.table = TRUE, risk.table.height = 0.25,
  pval.coord = km_pval_coord(KM_XLIM),
  pval.method.coord = km_pval_method_coord(KM_XLIM),
  xlim = KM_XLIM, break.time.by = 365, ylim = KM_YLIM, axes.offset = FALSE,
  xlab = "Days from liver transplant", ylab = "Liver graft survival (%)",
  legend.title = "Arm", legend.labs = MATCHED_ARM_LABS,
  title = "Fig 9. Death-Censored Liver Graft Survival, Propensity-Matched KALT <1 y vs LTA",
  caption = MATCHED_FIG_CAPTION, ggtheme = theme_classic()
), KM_XLIM)
print(plot_lg_matched)

#--- 21b.5 SENSITIVITY -- how much of Fig 7 is immortal time? ------------------
# [K3] Figures 7 and 9 are fixed-label: a KALT patient is drawn in the KALT arm
# from their liver transplant onward, including the median 250 days before their
# kidney arrived. Restricting to <1-year recipients made that window small, but
# it did not make it zero, and "small" is an assertion until it is measured.
#
# Same matched cohort, same pairing, exposure made TIME-VARYING: every patient
# begins kidney-free and switches on their actual kidney-TX date. The gap
# between this HR and fit_pt_cox's is the part of Figure 7's separation that is
# definitional rather than clinical. Report both.
s21b_base <- df_matched_km |>
  transmute(PT_CODE, subclass, pt_time, pt_event,
            k_raw = as.numeric(kidney_tx_date - liver_tx_date)) |>
  filter(!is.na(pt_time), pt_time > 0) |>
  mutate(exposed_at_0 = !is.na(k_raw) & k_raw <= 0,
         switch_day   = if_else(!is.na(k_raw) & k_raw > 0 & k_raw < pt_time,
                                k_raw, NA_real_))

s21b_split <- s21b_base |> filter(!is.na(switch_day))
s21b_long <- bind_rows(
  s21b_base |> filter(is.na(switch_day)) |>
    transmute(PT_CODE, subclass, tstart = 0, tstop = pt_time,
              event = pt_event, kidney = as.integer(exposed_at_0)),
  s21b_split |>
    transmute(PT_CODE, subclass, tstart = 0, tstop = switch_day,
              event = 0L, kidney = 0L),
  s21b_split |>
    transmute(PT_CODE, subclass, tstart = switch_day, tstop = pt_time,
              event = pt_event, kidney = 1L)
) |>
  arrange(PT_CODE, tstart) |>
  mutate(kidney = factor(kidney, levels = c(0, 1),
                         labels = c("No kidney yet", "Kidney received")))

stopifnot(all(s21b_long$tstop > s21b_long$tstart))
if (!identical(as.integer(sum(s21b_base$pt_event)),
               as.integer(sum(s21b_long$event)))) {
  stop("[Sec 21b.5] expansion changed the event count: ",
       sum(s21b_base$pt_event), " -> ", sum(s21b_long$event))
}
cat("\n[Sec 21b.5] Sensitivity expansion: ", nrow(s21b_base), " patients -> ",
    nrow(s21b_long), " rows (", nrow(s21b_split), " switch state); ",
    sum(s21b_long$event), " deaths preserved.\n", sep = "")
print(s21b_long |> group_by(kidney) |>
        summarise(person_years = round(sum(tstop - tstart) / 365.25, 1),
                  deaths = sum(event), .groups = "drop"))

s21b_tvcox <- coxph(Surv(tstart, tstop, event) ~ kidney + strata(subclass),
                    data = s21b_long)
cat("\n[Sec 21b.5] Time-varying pair-stratified Cox (patient survival):\n")
print(summary(s21b_tvcox))

s21b_fx <- summary(fit_pt_cox)$conf.int
s21b_tv <- summary(s21b_tvcox)$conf.int
s21b_sensitivity <- tibble(
  Model = c("Fig 7 fixed label from liver TX (primary)",
            "Time-varying kidney status (sensitivity)"),
  HR_CI = c(sprintf("%.2f (%.2f-%.2f)", s21b_fx[1, 1], s21b_fx[1, 3], s21b_fx[1, 4]),
            sprintf("%.2f (%.2f-%.2f)", s21b_tv[1, 1], s21b_tv[1, 3], s21b_tv[1, 4])),
  P     = c(fmt_p(summary(fit_pt_cox)$coefficients[1, 5]),
            fmt_p(summary(s21b_tvcox)$coefficients[1, 5]))
)
cat("\n[Sec 21b.5] IMMORTAL-TIME SENSITIVITY -- same cohort, same pairing.\n")
cat("The gap between these two rows is the definitional component of Fig 7:\n")
print(s21b_sensitivity, width = 200)


#===============================================================================
# SECTION 22. SUMMARY TABLES
#===============================================================================
table_endpoints <- bind_rows(
  km_at(fit_pt_tx,   "Patient survival (from liver TX)"),
  km_at(fit_pt_list, "Patient survival (from liver listing)"),
  km_at(fit_lg,      "Death-censored liver graft survival"),
  km_at(fit_lg_ldri, "Death-censored liver graft survival by LDRI"),
  km_at(fit_kg,      "Death-censored kidney graft survival by KDPI")
) |>
  mutate(years = round(time_d / 365.25, 0)) |>
  select(endpoint, stratum, years, n_risk, n_event, surv)

print(table_endpoints, n = 200)

# [F7] The first three rows are now 3-group (2 df) omnibus tests on Group3, not
# 2-group tests on the pooled binary Group. `groups` records the arm count so a
# reader cannot mistake a 3-group omnibus p for a pairwise contrast; the
# pairwise breakdowns are printed in Section 18.3b.
table_logrank <- tibble(
  endpoint = c("Patient survival (TX-anchored, 3 groups)",
               "Patient survival (listing-anchored, 3 groups)",
               "Liver graft survival (3 groups)",
               "Liver graft survival (by LDRI)",
               "Kidney graft survival (by KDPI)"),
  groups = c(nlevels(droplevels(df_km_tx$Group3)),
             nlevels(droplevels(df_km_list$Group3)),
             nlevels(droplevels(df_km_tx$Group3)),
             nlevels(droplevels(df_km_ldri$LDRI_cat)),
             nlevels(droplevels(df_km_kidney_kdpi$KDPI_cat))),
  logrank_p = c(lr_p(Surv(pt_time, pt_event) ~ Group3, df_km_tx),
                lr_p(Surv(pt_time_list, pt_event_list) ~ Group3, df_km_list),
                lr_p(Surv(lg_time, lg_event) ~ Group3, df_km_tx),
                lr_p(Surv(lg_time, lg_event) ~ LDRI_cat, df_km_ldri),
                lr_p(Surv(kg_time, kg_event) ~ KDPI_cat, df_km_kidney_kdpi))
)
print(table_logrank)


#===============================================================================
# SECTION 23. SUPPLEMENTARY TABLE 1 -- Survival by LDRI tier, LTA vs KALT,
#             anchored at date of KIDNEY LISTING
#===============================================================================
# Reproduces the layout of the reference "Supplementary Table 1: Survival
# Outcomes in Kidney after Liver Transplantation and Liver Transplantation
# Alone Based on LDRI":
#   - Time origin = date of KIDNEY LISTING for BOTH endpoints below. This is
#     deliberately different from Section 19's transplant-anchored curves --
#     it is what the reference table's header specifies, and it avoids
#     conditioning survival on having lived long enough to reach a later
#     kidney transplant.
#   - Two endpoints, each split by Group (LTA / KALT), stratified by LDRI tier
#     within each Group: (a) patient survival, (b) death-censored liver graft
#     survival. Kidney graft survival is not part of this table because LTA
#     patients (by definition) have no kidney transplant to anchor a kidney
#     graft endpoint on.
#   - KM estimates at 1 / 3 / 5 years with 95% CI, an overall (3-group)
#     log-rank p per Group x endpoint block, and all three pairwise log-rank
#     comparisons (unadjusted, matching the reference table's footnote style).
#
# REPORTING HORIZON: the reference table reports 1 / 5 / 10 years, but this
# cohort cannot support a 10-year estimate. Kidney listing is restricted to
# wl_start_date (2017-08-10) through wl_end_date (2025-04-03) in Section 6.2
# and follow-up is administratively censored at STUDY_END (2025-04-03). The
# longest pt_time actually observed is 2,921 days (8.0 years) -- longer than
# the listing window alone implies, because the window filters INIT_DATE while
# kidney_listing_date is the EARLIEST listing date, derived later and able to
# fall before wl_start_date. Either way, nothing reaches 3,650 days.
#
# This matters because summary.survfit(extend=TRUE) does not error on times
# past the end of a curve: it returns the KM estimate at that stratum's LAST
# EVENT TIME, carried forward, with n.risk = 0. A "10-year" column therefore
# reported end-of-follow-up survival at a DIFFERENT real time point in every
# stratum, all under one label -- e.g. LTA patient survival read 0.74 at 5
# years but 0.63 in the "10-year" cell, an estimate belonging to ~8 years with
# nobody left at risk. Horizon is therefore 1 / 3 / 5 years, matching
# REPORT_TIMES (Section 1) and Table 4's cutpoints; 5 years sits inside
# observed follow-up for every stratum in this table.
#===============================================================================

