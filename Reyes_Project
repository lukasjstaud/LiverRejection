fit_complete <- function(data, vars) {
  cc <- data |> filter(if_all(all_of(vars), ~ !is.na(.)))
  cat("  complete cases:", nrow(cc), "of", nrow(data), "\n")
  cc
}

# Prints events vs. non-events by level of a grouping variable, for whichever
# endpoint is about to be fit. This is what makes a zero-event cell visible
# BEFORE the model runs, rather than discovering it only via a divergent HR.
print_event_counts <- function(data, group_var, event_var, label) {
  cat("  event counts by ", group_var, " (", label, "):\n", sep = "")
  tab <- data |> group_by(.data[[group_var]]) |>
    summarise(n = n(), events = sum(.data[[event_var]]), .groups = "drop")
  print(tab)
  zero <- tab |> filter(events == 0)
  if (nrow(zero) > 0) {
    cat("  !! ZERO events in: ", paste(zero[[group_var]], collapse = ", "),
        " -- any HR involving this level will be reported as NE.\n", sep = "")
  }
  invisible(tab)
}

