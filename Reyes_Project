pkgs <- c("ggplot2", "haven", "tidyr", "dplyr", "knitr", "kableExtra",
          "stringr", "lubridate", "gt", "tibble", "survminer", "survival",
          "scales", "MatchIt", "cobalt", "gtsummary", "cmprsk")

for (p in pkgs) {
  if (!requireNamespace(p, quietly = TRUE)) install.packages(p)
}
