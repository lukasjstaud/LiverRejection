#--- 31.6 Display table -------------------------------------------------------
s31_fmt_med <- function(row) {
  # summary(survfit)$table gives median / 0.95LCL / 0.95UCL on the TIME scale;
  # NA means the curve never reached 50%, which is a real answer ("not reached"),
  # not a missing value.
  m <- row[["median"]]; lo <- row[["0.95LCL"]]; hi <- row[["0.95UCL"]]
  if (is.na(m)) return("Not reached")
  sprintf("%.0f (%s-%s)", m,
          if (is.na(lo)) "NA" else sprintf("%.0f", lo),
          if (is.na(hi)) "NA" else sprintf("%.0f", hi))
}

s31_rows <- lapply(s31_era_levels, function(er) {
  rn  <- paste0("Era=", er)
  med <- s31_med_tab[rn, ]
  km  <- s31_km |> filter(Era == er)
  cr  <- s31_cif_compare |> filter(Era == er)
  n_here <- s31_dat |> filter(Era == er)

  at <- function(d, col) {
    v <- km[[col]][km$time_d == d]
    if (!length(v)) NA_real_ else v[1]
  }
  cell <- function(d) {
    if (is.na(at(d, "cif"))) return("--")
    sprintf("%.1f (%.1f-%.1f)", 100 * at(d, "cif"),
            100 * at(d, "cif_low"), 100 * at(d, "cif_high"))
  }
  crcell <- function(d) {
    v <- cr$cif_cr[cr$time_d == d]
    if (!length(v) || is.na(v[1])) "--" else sprintf("%.1f", 100 * v[1])
  }

  tibble(
    Era = er,
    `Listed, n`                  = as.character(nrow(n_here)),
    `Transplanted, n (%)`        = sprintf("%d (%.1f%%)", sum(n_here$event),
                                           100 * mean(n_here$event)),
    `Died waiting, n (%)`        = sprintf("%d (%.1f%%)",
                                           sum(n_here$etype == "death"),
                                           100 * mean(n_here$etype == "death")),
    `Median days to TX (95% CI)` = s31_fmt_med(med),
    `1 y`  = cell(365),  `2 y` = cell(730),
    `3 y`  = cell(1095), `5 y` = cell(1825),
    `3 y, competing risks` = crcell(1095)
  )
})

