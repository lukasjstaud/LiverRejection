# --- Common Etiology Function to keep mappings DRY ---
map_esrd_etiology <- function(dgn_vec) {
  case_when(
    dgn_vec %in% c(3025, 3036, 3052, 3061, 3065) ~ "Congenital",
    dgn_vec %in% c(3011, 3012, 3038, 3039, 3069, 3070, 3071) ~ "Diabetes",
    dgn_vec %in% c(3000, 3001, 3002, 3003, 3004, 3005, 3006, 3009, 3018,
                   3033, 3035, 3041, 3042, 3043, 3054, 3055, 3067, 3068, 3074) ~ "Glomerular disease",
    dgn_vec %in% c(3034, 3040, 3051) ~ "Hypertensive nephrosclerosis",
    dgn_vec %in% c(3020, 3021, 3022, 3023, 3058) ~ "Neoplasm",
    dgn_vec %in% c(3008, 3028) ~ "Polycystic kidney disease",
    dgn_vec %in% c(3050, 3056, 3059, 3060, 3066) ~ "Renovascular related disease",
    dgn_vec %in% c(3007, 3010, 3024, 3026, 3027, 3029, 3030, 3031, 3032,
                   3044, 3045, 3046, 3047, 3048, 3049, 3053, 3062, 3063,
                   3064, 3072, 3073) ~ "Tubular and interstitial disease",
    dgn_vec %in% c(999, 3013, 3014, 3015, 3016, 3017, 3037, 3057) ~ "Other",
    TRUE ~ NA_character_
  )
}

