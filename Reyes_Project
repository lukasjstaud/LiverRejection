#===============================================================================
# SECTION 35. WAITLIST-ENTRY TO KIDNEY TRANSPLANT BY KDPI AND ERA -- MEDIAN
#              [IQR] WAIT, AND PERCENT TRANSPLANTED AT 1 / 3 / 5 YEARS
#===============================================================================
# ADDITIVE SECTION. Reads only; every object is prefixed `s35_` / `S35_`.
# DEPENDS ON Section 31 for s31_dat (the de-duplicated two-era analysis frame)
# and on Sections 29-30 for the KDPI tier labels and the column set.
#
# WHAT THIS ADDS OVER SECTIONS 30 AND 31
#   Section 30 gives median [IQR] wait by KDPI tier, but on the Section 30
#   population, where a patient listed in both eras contributes a waiting time
#   to BOTH rows. Section 31 gives death-censored time-to-transplant by era with
#   each patient in exactly one stratum, but pooled over all kidney types -- it
#   has no KDPI breakdown. This section is the intersection of the two: KDPI
#   breakdown, on the one-patient-one-era frame.
#
# THE TWO PANELS HAVE DIFFERENT DENOMINATORS, ON PURPOSE. Read this before
# comparing a number in Panel A to a number in Panel B.
#
#   PANEL A -- median [IQR] observed wait, among the TRANSPLANTED.
#     Denominator is patients who received a kidney of that tier. KDPI is a
#     property of a kidney, so it exists only for someone who got one; there is
#     no KDPI tier to assign to a patient who died waiting. "Death censored"
#     is therefore vacuous in this panel -- patients who died without a
#     transplant are not censored, they are simply absent, and the same is true
#     of everyone still waiting at STUDY_END. This is a description of the waits
#     that were actually observed, NOT an estimate of how long a listed patient
#     waits. It is a selected sample and the selection is not random with
#     respect to kidney quality: the patients who wait longest are exactly the
#     ones most likely to die first and drop out of this panel, so every median
#     here is biased SHORT, and more so in the era with more waitlist deaths.
#
#   PANEL B -- percent transplanted by 1 / 3 / 5 years, CAUSE-SPECIFIC KM.
#     Denominator is every patient LISTED in that era. A percentage at a fixed
#     horizon cannot be computed from Panel A's population, so this panel is a
#     Kaplan-Meier estimate: for a given tier the event is "received a kidney in
#     THAT tier", and death, loss to follow-up, STUDY_END, and receipt of a
#     kidney in ANY OTHER tier all CENSOR. That is the death-censored reading,
#     and it is the estimator Section 31 uses for the pooled endpoint.
#     Consequence, stated plainly: censoring death assumes a patient who died
#     waiting would have gone on to be transplanted at the same rate as a
#     comparable survivor. They would not. Every percentage in Panel B is
#     therefore an UPPER BOUND, and the bound is looser in the pre-policy era,
#     which lost more candidates while waiting. Section 31.4 quantifies the size
#     of that overstatement for the pooled endpoint (its Gap column); the
#     tier-specific competing-risks analogue is not computed here.
#
#   Because of the above, the two panels do not reconcile arithmetically and are
#   not meant to. Panel A answers "how long did the people who got a kidney
#   wait for it"; Panel B answers "what fraction of those listed had a kidney by
#   year 3". A tier can have a short Panel A median and a low Panel B percentage
#   at the same time -- that is the signature of a kidney type that is rarely
#   offered but goes quickly when it is.
#
# 5-year horizon: the cohort supports about 8 years of follow-up at most, so
# 1 / 3 / 5 years is the reporting grid throughout, matching S31_REPORT_TIMES.

#--- 35.1 Configuration -------------------------------------------------------

# Horizons for Panel B. 1, 3 and 5 years, as requested.
S35_REPORT_TIMES <- c(365, 1095, 1825)

# Column set, taken from Section 30 so the three sections cannot drift:
# the three KDPI tiers, the three pooled, and living donors separately.
S35_COLS <- S30_COLS

# Minimum events in a tier x era cell before its KM estimate is printed rather
# than suppressed. A KM built on one or two events is not an estimate.
S35_MIN_EVENTS <- 5


#--- 35.2 Analysis frame ------------------------------------------------------
# s31_dat is already: one row per patient, one era per patient (S31_ERA_OVERLAP
# = "first"), time = days to transplant or to censoring, event = transplant,
# and patients with no usable follow-up dropped. All this section adds is the
# KDPI column assignment, using exactly Section 30.2's rule -- a deceased-donor
# recipient with a missing KDPI belongs to no column and is counted as
# unclassifiable rather than silently pooled.
s35_dat <- s31_dat |>
  mutate(col_group = case_when(
    event == 0                                           ~ NA_character_,
    kidney_donor_type == "Living"                        ~ S30_LD,
    kidney_donor_type == "Deceased" & !is.na(kdpi_tier)  ~ as.character(kdpi_tier),
    TRUE                                                 ~ NA_character_
  ),
  # Panel A's clock. tx_time is the raw listing-to-transplant interval; s31_dat's
  # `time` column nudges same-day transplants to S31_SAMEDAY_EPS so they are not
  # placed at the origin of a KM. That nudge is right for Panel B and wrong for
  # Panel A, where a pre-emptive transplant genuinely is a 0-day wait.
  wait_days = if_else(event == 1L, tx_time, NA_real_))

cat("\n########## SECTION 35: WAIT TO KIDNEY TX BY KDPI AND ERA ##########\n")
s35_unclass <- s35_dat |> filter(event == 1L, is.na(col_group))
if (nrow(s35_unclass) > 0) {
  cat("[Sec 35] Transplanted but unclassifiable -- in NO column of either panel (",
      nrow(s35_unclass), "):\n", sep = "")
  print(s35_unclass |> count(Era, kidney_donor_type,
                             kdpi_missing = is.na(KDPI_num)))
}
cat("[Sec 35] Analysis frame:\n")
print(s35_dat |>
        group_by(Era) |>
        summarise(listed = dplyr::n(), transplanted = sum(event),
                  classifiable = sum(event == 1L & !is.na(col_group)),
                  died_no_tx = sum(etype == "death"), .groups = "drop"))
cat("[Sec 35] Transplants by era x column:\n")
print(s35_dat |> filter(event == 1L, !is.na(col_group)) |> count(Era, col_group),
      n = 40)

s35_era_levels <- levels(s35_dat$Era)

# Membership test shared by both panels. S30_ALL_DD is the three KDPI tiers
# pooled, not a fourth classification, so it is derived rather than looked up.
s35_in_col <- function(cg, col) {
  if (identical(col, S30_ALL_DD)) cg %in% S30_KDPI_COLS else cg == col
}


#--- 35.3 Panel A -- median [IQR] observed wait among the transplanted --------
s35_waits <- function(era, col) {
  d <- s35_dat |> filter(Era == era, event == 1L, !is.na(col_group))
  d$wait_days[s35_in_col(d$col_group, col)]
}

s35_fmt_iqr <- function(x) {
  if (!length(x)) return("--")
  q <- stats::quantile(x, c(0.25, 0.5, 0.75), names = FALSE, type = 7)
  sprintf("%.0f [%.0f-%.0f]", q[2], q[1], q[3])
}
s35_fmt_iqr_yrs <- function(x) {
  if (!length(x)) return("--")
  q <- stats::quantile(x, c(0.25, 0.5, 0.75), names = FALSE, type = 7) / 365.25
  sprintf("%.2f [%.2f-%.2f]", q[2], q[1], q[3])
}
s35_fmt_n <- function(x, denom) {
  if (!denom) return("--")
  sprintf("%d (%.1f%%)", length(x), 100 * length(x) / denom)
}

s35_panelA <- local({
  era_rows <- bind_rows(lapply(s35_era_levels, function(er) {
    vs <- lapply(S35_COLS, function(cl) s35_waits(er, cl))
    names(vs) <- S35_COLS
    denom <- sum(s35_dat$Era == er)

    mk <- function(row_label, f) {
      as_tibble(as.list(vapply(S35_COLS, function(cl) f(vs[[cl]]), character(1)))) |>
        mutate(Block = er, Row = row_label)
    }
    bind_rows(
      mk("Transplanted, n (% of listed)", function(x) s35_fmt_n(x, denom)),
      mk("Median wait, days [IQR]",       s35_fmt_iqr),
      mk("Median wait, years [IQR]",      s35_fmt_iqr_yrs)
    )
  }))

  # Between-era contrast. Wilcoxon rank-sum on the raw waits, guarded exactly as
  # Section 30.4 guards it -- both arms need >= 3 observations or the test is
  # not attempted and the cell reads "--" rather than carrying a bogus p.
  pre  <- s35_era_levels[1]; post <- s35_era_levels[2]
  dif <- vapply(S35_COLS, function(cl) {
    a <- s35_waits(post, cl); b <- s35_waits(pre, cl)
    if (!length(a) || !length(b)) NA_real_ else stats::median(a) - stats::median(b)
  }, numeric(1))
  pv <- vapply(S35_COLS, function(cl)
    s30_wilcox_p(s35_waits(post, cl), s35_waits(pre, cl)), numeric(1))

  cmp <- bind_rows(
    as_tibble(as.list(vapply(S35_COLS, function(cl)
      if (is.na(dif[[cl]])) "--" else sprintf("%+.0f", dif[[cl]]),
      character(1)))) |>
      mutate(Block = "Post- vs pre-policy", Row = "Median difference, days"),
    as_tibble(as.list(vapply(S35_COLS, function(cl)
      if (is.na(pv[[cl]])) "--" else fmt_p(pv[[cl]]),
      character(1)))) |>
      mutate(Block = "Post- vs pre-policy", Row = "Wilcoxon rank-sum P")
  )

  bind_rows(era_rows, cmp) |> select(Block, Row, all_of(S35_COLS))
})

cat("\n[Sec 35] PANEL A -- median [IQR] wait, listing to kidney TX, among the ",
    "transplanted:\n", sep = "")
print(s35_panelA, width = 250)


#--- 35.4 Panel B -- percent transplanted at 1 / 3 / 5 y, cause-specific KM ---
# For one era x column: event = transplant with a kidney in that column;
# everything else -- death, loss to follow-up, STUDY_END, and transplant with a
# kidney in a DIFFERENT column -- censors, at the time it happened. s31_dat's
# `time` is already the time of first exit for every patient, so recoding the
# event indicator alone gives the correct cause-specific censoring: a patient
# transplanted with another tier's kidney is censored at their transplant date,
# which is exactly right.
s35_km_cell <- function(era, col) {
  d <- s35_dat |>
    filter(Era == era) |>
    mutate(ev = as.integer(event == 1L & !is.na(col_group) &
                             s35_in_col(col_group, col)))
  n_ev <- sum(d$ev)
  if (n_ev < S35_MIN_EVENTS) {
    return(tibble(Era = era, Column = col, time_d = S35_REPORT_TIMES,
                  n_event_total = n_ev, n_risk = NA_integer_,
                  cif = NA_real_, cif_low = NA_real_, cif_high = NA_real_,
                  suppressed = TRUE))
  }
  f <- survfit(Surv(time, ev) ~ 1, data = d)
  s <- summary(f, times = S35_REPORT_TIMES, extend = TRUE)
  tibble(
    Era = era, Column = col, time_d = s$time,
    n_event_total = n_ev, n_risk = s$n.risk,
    # KM limits are on the survival scale, so inverting swaps upper and lower.
    cif      = 1 - s$surv,
    cif_low  = 1 - s$upper,
    cif_high = 1 - s$lower,
    suppressed = FALSE
  )
}

s35_km <- bind_rows(lapply(s35_era_levels, function(er)
  bind_rows(lapply(S35_COLS, function(cl) s35_km_cell(er, cl)))))

s35_suppressed <- s35_km |> filter(suppressed) |> distinct(Era, Column, n_event_total)
if (nrow(s35_suppressed) > 0) {
  cat("\n[Sec 35] SUPPRESSED -- fewer than ", S35_MIN_EVENTS,
      " events, no KM estimate reported:\n", sep = "")
  print(s35_suppressed)
}

s35_fmt_cell <- function(cif, lo, hi) {
  if (is.na(cif)) return("--")
  sprintf("%.1f (%.1f-%.1f)", 100 * cif, 100 * lo, 100 * hi)
}

s35_panelB <- local({
  rows <- bind_rows(lapply(s35_era_levels, function(er) {
    bind_rows(lapply(S35_REPORT_TIMES, function(td) {
      vals <- vapply(S35_COLS, function(cl) {
        r <- s35_km |> filter(Era == er, Column == cl, time_d == td)
        if (!nrow(r)) "--" else s35_fmt_cell(r$cif[1], r$cif_low[1], r$cif_high[1])
      }, character(1))
      as_tibble(as.list(vals)) |>
        mutate(Block = er,
               Row = sprintf("%g year%s", td / 365, if (td > 365) "s" else ""))
    }))
  }))

  # Between-era contrast at each horizon: difference in percentage points,
  # post minus pre. No test -- these are two KM estimates from independent
  # strata and the honest comparison is the pooled log-rank Section 31 already
  # reports, not a per-tier test on the same data at three time points.
  pre <- s35_era_levels[1]; post <- s35_era_levels[2]
  dif <- bind_rows(lapply(S35_REPORT_TIMES, function(td) {
    vals <- vapply(S35_COLS, function(cl) {
      a <- s35_km |> filter(Era == post, Column == cl, time_d == td)
      b <- s35_km |> filter(Era == pre,  Column == cl, time_d == td)
      if (!nrow(a) || !nrow(b) || is.na(a$cif[1]) || is.na(b$cif[1])) return("--")
      sprintf("%+.1f", 100 * (a$cif[1] - b$cif[1]))
    }, character(1))
    as_tibble(as.list(vals)) |>
      mutate(Block = "Post- vs pre-policy",
             Row = sprintf("%g year%s, difference (pp)",
                           td / 365, if (td > 365) "s" else ""))
  }))

  bind_rows(rows, dif) |> select(Block, Row, all_of(S35_COLS))
})

cat("\n[Sec 35] PANEL B -- % transplanted by 1 / 3 / 5 y (cause-specific KM, ",
    "death censored), % (95% CI):\n", sep = "")
print(s35_panelB, width = 250)


